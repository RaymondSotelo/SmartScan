@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
    if (ViewData["HeaderTitle"] == null)
    {
        ViewData["HeaderTitle"] = "Security";
    }
}

<!-- Viewport-Locked Outer Card -->
<div class="card shadow border-0 rounded-4 d-flex flex-column mt-2 mt-md-3 bg-white"
     style="height: calc(100dvh - 130px); min-height: 540px;">

    <!-- Pinned Top Brand Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex justify-content-between align-items-center"
         style="background-color: #1162a3;">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-shield-halved fs-5"></i>
            <h5 class="mb-0 fw-bold">Access Denied</h5>
        </div>
    </div>

    <!-- Interior Centered Content -->
    <div class="card-body p-4 flex-grow-1 d-flex flex-column align-items-center justify-content-center"
         style="min-height: 0; background-color: #f8fafc; border-bottom-left-radius: var(--bs-border-radius-xl); border-bottom-right-radius: var(--bs-border-radius-xl);">

        <div class="text-center p-4 p-md-5 bg-white shadow-sm rounded-4 border border-secondary border-opacity-10" style="max-width: 500px; width: 100%;">

            <!-- Graphic / Icon -->
            <div class="rounded-circle d-inline-flex p-4 mb-4 border shadow-sm"
                 style="background-color: #fee2e2; border-color: #fecaca !important;">
                <i class="fa-solid fa-lock fa-3x text-danger opacity-75"></i>
            </div>

            <!-- Message -->
            <h4 class="fw-bold text-danger mb-2">Access Restricted</h4>
            <p class="text-muted mb-4 fw-medium" style="font-size: 0.95rem; line-height: 1.5;">
                You do not have permission to view this resource. Please contact your store administrator if you believe this is an error.
            </p>

            <!-- Action Buttons -->
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <button type="button"
                        class="btn btn-outline-secondary fw-semibold px-4 py-2 rounded-pill shadow-sm d-inline-flex align-items-center gap-2"
                        onclick="history.back();">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Go Back</span>
                </button>

                <a asp-area="" asp-controller="Home" asp-action="Index"
                   class="btn btn-primary fw-semibold px-4 py-2 rounded-pill shadow-sm d-inline-flex align-items-center gap-2"
                   style="background-color: #1162a3; border-color: #1162a3;">
                    <i class="fa-solid fa-house"></i>
                    <span>Return Home</span>
                </a>
            </div>
        </div>
    </div>
</div>