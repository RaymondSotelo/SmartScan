@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(346deg, #0052D4 0%, #65C7F7 50%, #9CECFB 100%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="con bg-white col-md-5 position-absolute top-50 start-50 translate-middle mt-4 border border-0 rounded-4 shadow-lg">
    <div class="p-4">
        <h1 class="text-center fs-3 fw-bold" style="color:#387bd6">@ViewData["Title"]</h1>
        <br />
        <p class="fw-medium fs-5 text-secondary">Enter your email</p>
        <div class="row">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3 text-secondary">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label"></label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <br />
                <button type="submit" class="w-100 btn btn-lg btn-primary">Reset Password</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if(Model.ShowConfirmationAlert)
    {
        <script>
            alert("Please check your email. A reset link has been sent to your email address.");
        </script>
    }
}
