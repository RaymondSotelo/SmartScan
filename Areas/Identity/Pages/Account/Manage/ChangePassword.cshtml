@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<style>
    /* Mobile Adjustments (Desktop >= 768px stays untouched) */
    @@media (max-width: 767.98px) {
        .manage-form-wrapper {
            min-height: auto !important;
            align-items: flex-start !important;
            padding-top: 0.75rem !important;
            padding-bottom: 1rem !important;
        }
    }

    @@media (max-width: 575.98px) {
        .manage-submit-btn {
            width: 100% !important;
        }
    }
</style>

<div class="d-flex justify-content-center align-items-center w-100 py-4 manage-form-wrapper" style="min-height: 75vh;">
    <div style="width: 100%; max-width: 580px;">
        <h3 class="fw-medium mb-3" style="color:#1162a3;">@ViewData["Title"]</h3>
        <partial name="_StatusMessage" for="StatusMessage" />

        <form id="change-password-form" method="post" class="mt-3">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <hr class="mb-4 mb-md-5" />

            <!-- Old Password -->
            <div class="form-floating mb-4">
                <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Please enter your old password." />
                <label asp-for="Input.OldPassword" class="form-label"></label>
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>

            <!-- New Password -->
            <div class="form-floating mb-4">
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Please enter your new password." />
                <label asp-for="Input.NewPassword" class="form-label"></label>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>

            <!-- Confirm Password -->
            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Please confirm your new password." />
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <!-- Update Password Button -->
            <div class="text-center mt-3">
                <button type="submit" class="w-50 btn btn-lg btn-primary fw-semibold manage-submit-btn" style="font-size: 18px;">Update password</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}