@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

@{
    ViewData["Title"] = "Manage Account";
    ViewData["HeaderTitle"] = "Account Settings";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(180deg, #95CCDD 0%, #eef6f9 100%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="card shadow border-0 rounded-4 mt-4">
    <div class="card-header rounded-top-4 text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-circle-user"></i> Manage your Account</h5>
    </div>
    <div class="p-3">
        <div>
            <div class="row">
                <div class="col-md-3">
                    <partial name="_ManageNav" />
                </div>
                <div class="col-md-9">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
