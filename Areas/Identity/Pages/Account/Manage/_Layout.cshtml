@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

@{
    ViewData["Title"] = "Manage Account";
    ViewData["HeaderTitle"] = "Account Settings";
}

<style>
    /* Mobile & Tablet Stacking Adjustments (Desktop >= 768px stays untouched) */
    @@media (max-width: 767.98px) {
        .manage-layout-body,
        .manage-layout-row,
        .manage-content-col {
            height: auto !important;
            overflow: visible !important;
        }

        .manage-nav-col {
            width: 100%;
            border-bottom: 1px solid #e9ecef;
            padding-bottom: 0.75rem;
        }

        .manage-content-col {
            padding-right: 0 !important;
        }
    }
</style>

<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 pos-viewport-card"
     style="height: calc(100dvh - 130px); min-height: 500px;">

    <!-- Top Card Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0" style="background-color: #1162a3;">
        <h5 class="mb-0"><i class="fa-solid fa-circle-user me-2"></i>Manage your Account</h5>
    </div>

    <!-- Body Area -->
    <div class="card-body p-3 p-md-4 d-flex flex-column flex-grow-1 overflow-hidden manage-layout-body">
        <div class="row g-3 g-md-4 flex-grow-1 overflow-hidden manage-layout-row">

            <!-- Left Navigation -->
            <div class="col-12 col-md-3 flex-shrink-0 manage-nav-col">
                <partial name="_ManageNav" />
            </div>

            <!-- Right Content Area -->
            <div class="col-12 col-md-9 flex-grow-1 overflow-y-auto pe-md-2 h-100 manage-content-col">
                @RenderBody()
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}