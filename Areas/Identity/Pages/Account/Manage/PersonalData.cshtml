@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="d-flex justify-content-center align-items-center w-100 py-4" style="min-height: 75vh;">
    <div style="width: 100%; max-width: 580px;">
        <h3 style="color:#1162a3">@ViewData["Title"]</h3>

        <hr class="mb-4" />

        <p class="fw-medium text-secondary text-justify">
            Your account contains personal data that you have given us. This page allows you to have the option to close your account.
            If your account was currently assigned to a retail store, then your account will temporarily be disabled.
            </p>
        <p class="text-danger">
            <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
        </p>
        
        <!-- Delete Button -->
        <div class="text-center mb-4">
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-lg btn-danger fw-medium" style="font-size: 18px;">Delete Account</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
