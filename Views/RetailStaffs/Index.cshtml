@model IEnumerable<SmartScan.Models.RetailStaff>
@inject SmartScan.Data.ApplicationDbContext DbContext
@using System.Security.Claims

@{
    ViewData["Title"] = "Register Retail Staff";
    ViewData["HeaderTitle"] = "Retail Management";
    Layout = "_RetailLayout";

    int currentRetailId = ViewBag.RetailId != null ? (int)ViewBag.RetailId : 0;
    string currentFilter = ViewData["CurrentFilter"]?.ToString()?.Trim() ?? "";

    // Current Logged-in User
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    // 1. Fetch Store and Head Admin
    var retailStore = DbContext.Retails.FirstOrDefault(r => r.RetailId == currentRetailId);
    var headAdminUser = retailStore != null && !string.IsNullOrEmpty(retailStore.AdminOwner)
        ? DbContext.Users.FirstOrDefault(u => u.Id == retailStore.AdminOwner)
        : null;

    bool isHeadAdmin = retailStore != null && retailStore.AdminOwner == currentUserId;

    // Filter Head Admin if a search query is active
    bool matchesHeadAdmin = headAdminUser != null &&
        (string.IsNullOrWhiteSpace(currentFilter) ||
         (headAdminUser.UserName != null && headAdminUser.UserName.Contains(currentFilter, StringComparison.OrdinalIgnoreCase)) ||
         (headAdminUser.Email != null && headAdminUser.Email.Contains(currentFilter, StringComparison.OrdinalIgnoreCase)));

    // Categorize Co-Admins vs Cashiers
    var staffIds = Model.Select(m => m.StaffId).Where(id => !string.IsNullOrEmpty(id)).Distinct().ToList();
    var adminRoleIds = DbContext.Roles.Where(r => r.Name == "Admin").Select(r => r.Id).ToList();
    var coAdminUserIds = DbContext.UserRoles
        .Where(ur => staffIds.Contains(ur.UserId) && adminRoleIds.Contains(ur.RoleId))
        .Select(ur => ur.UserId)
        .ToHashSet();

    bool isCoAdmin = !isHeadAdmin && !string.IsNullOrEmpty(currentUserId) && coAdminUserIds.Contains(currentUserId);

    var coAdmins = Model.Where(m => !string.IsNullOrEmpty(m.StaffId) && coAdminUserIds.Contains(m.StaffId)).ToList();
    var cashiers = Model.Where(m => !string.IsNullOrEmpty(m.StaffId) && !coAdminUserIds.Contains(m.StaffId)).ToList();

    // Batch fetch Profile Pictures
    var allUserIds = staffIds.ToList();
    if (headAdminUser != null && !allUserIds.Contains(headAdminUser.Id))
    {
        allUserIds.Add(headAdminUser.Id);
    }

    var profileMap = DbContext.UserProfiles
        .Where(up => allUserIds.Contains(up.UserId))
        .ToDictionary(up => up.UserId, up => up.ProfilePicture);

    int totalCount = (matchesHeadAdmin ? 1 : 0) + coAdmins.Count + cashiers.Count;
    bool hasAnyMatches = matchesHeadAdmin || coAdmins.Any() || cashiers.Any();
}

<div class="d-flex flex-column h-100">

    <!-- Header & Badge Bar -->
    <div class="d-flex justify-content-between align-items-center mb-2 flex-shrink-0">
        <div>
            <h4 class="fw-bold mb-0" style="color: #1162a3;">Store Staff Members</h4>
            <p class="text-secondary fw-medium mb-0">Manage authorized users, role assignments, and permissions for this branch.</p>
        </div>
        <span class="badge rounded-pill fw-semibold px-3 py-2 shadow-sm text-white flex-shrink-0" style="background-color: #1162a3; font-size: 13px;">
            <i class="fa-solid fa-users-gear me-1"></i>Total Staff: @totalCount
        </span>
    </div>

    <!-- Action Bar & Search -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 py-3 flex-shrink-0">
        <a class="btn btn-primary fw-medium rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1"
           asp-action="Create"
           asp-route-retailId="@ViewBag.RetailId"
           style="background-color: #1162a3; border-color: #1162a3; font-size: 14px;">
            <i class="fa-solid fa-user-plus"></i>
            <span>Assign Staff</span>
        </a>

        <!-- Search Feature -->
        <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 320px; width: 100%;">
            <input type="hidden" name="retailId" value="@ViewBag.RetailId" />

            <div class="input-group shadow-sm rounded-3 overflow-hidden border">
                <span class="input-group-text bg-white border-0">
                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                </span>
                <input type="text"
                       name="search"
                       value="@ViewData["CurrentFilter"]"
                       class="form-control border-0 bg-white shadow-none ps-0 fw-semibold"
                       placeholder="Search staff..."
                       aria-label="Search" />
            </div>

            @if (!string.IsNullOrEmpty(currentFilter))
            {
                <a asp-action="Index" asp-route-retailId="@ViewBag.RetailId" class="btn btn-outline-secondary rounded-3" title="Clear Search">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            }
        </form>
    </div>

    <!-- Overhead TempData Alert -->
    @if (TempData["RetailStaffMessage"] != null)
    {
        <div id="autoCloseAlert" class="alert alert-success alert-dismissible fade show shadow-sm fw-medium d-flex align-items-center mb-3 flex-shrink-0" role="alert">
            <i class="fa-solid fa-circle-check fs-5 me-2 flex-shrink-0"></i>
            <div>@TempData["RetailStaffMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <script>
            setTimeout(function () {
                var alertNode = document.getElementById('autoCloseAlert');
                if (alertNode) {
                    // Use Bootstrap's native Alert API to close it smoothly
                    var bsAlert = new bootstrap.Alert(alertNode);
                    bsAlert.close();
                }
            }, 2000); // 2000 milliseconds = 2 seconds
        </script>
    }

    <!-- Scrollable Unified List Area -->
    <div class="flex-grow-1 overflow-y-auto pe-1">
        @if (!hasAnyMatches)
        {
            @if (!string.IsNullOrEmpty(currentFilter))
            {
                <div class="alert alert-warning text-center my-3 fw-semibold shadow-sm" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>No staff member found matching "<strong>@currentFilter</strong>".
                </div>
            }
            else
            {
                <div class="text-center py-5 my-auto">
                    <div class="text-muted mb-3">
                        <i class="fa-solid fa-user-group fa-3x text-secondary opacity-50"></i>
                    </div>
                    <h5 class="fw-semibold text-secondary">No Assigned Staff</h5>
                    <p class="text-muted small">Click "Assign Staff" above to authorize cashiers or managers for this store.</p>
                </div>
            }
        }
        else
        {
            <div class="d-flex flex-column gap-2 pb-2">

                <!-- HEAD ADMIN (STORE OWNER) -->
                @if (matchesHeadAdmin && headAdminUser != null)
                {
                    profileMap.TryGetValue(headAdminUser.Id, out var headPic);
                    var headAvatar = string.IsNullOrWhiteSpace(headPic) ? "/images/default-pfp.jpg" : headPic;

                    <div class="d-flex align-items-center justify-content-between py-2 px-3 rounded-3 shadow-sm border"
                         style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
                        <div class="d-flex align-items-center gap-3">
                            <img src="@headAvatar"
                                 onerror="this.onerror=null; this.src='/images/default-pfp.jpg';"
                                 alt="@headAdminUser.UserName"
                                 class="rounded-circle border border-2 border-white object-fit-cover shadow-sm bg-white"
                                 style="width: 44px; height: 44px; flex-shrink: 0;" />
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fw-semibold" style="color: #1162a3;">@headAdminUser.UserName</span>
                                    <span class="badge rounded-pill fw-semibold px-2 py-1 text-white shadow-sm" style="background-color: #f59e0b; font-size: 11px;">
                                        <i class="fa-solid fa-crown me-1"></i>Head Admin
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            <span class="badge rounded-pill bg-white text-success border border-success-subtle fw-semibold px-3 py-2 shadow-sm" style="font-size: 11px;">
                                <i class="fa-solid fa-circle-check me-1"></i>Active
                            </span>
                            <span class="badge bg-light text-muted border rounded-pill px-3 py-2 small">
                                <i class="fa-solid fa-lock me-1"></i>Owner
                            </span>
                        </div>
                    </div>
                }

                <!-- CO-ADMINS -->
                @foreach (var item in coAdmins)
                {
                    profileMap.TryGetValue(item.StaffId ?? "", out var pic);
                    var avatar = string.IsNullOrWhiteSpace(pic) ? "/images/default-pfp.jpg" : pic;

                    <div class="d-flex align-items-center justify-content-between py-2 px-3 rounded-3 shadow-sm border"
                         style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
                        <div class="d-flex align-items-center gap-3">
                            <img src="@avatar"
                                 onerror="this.onerror=null; this.src='/images/default-pfp.jpg';"
                                 alt="@item.Staff?.UserName"
                                 class="rounded-circle border border-2 border-white object-fit-cover shadow-sm bg-white"
                                 style="width: 44px; height: 44px; flex-shrink: 0;" />
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fw-semibold" style="color: #1162a3;">@(item.Staff?.UserName ?? "Unknown User")</span>
                                    <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle fw-semibold px-2 py-1 shadow-sm" style="font-size: 11px;">
                                        <i class="fa-solid fa-user-shield me-1"></i>Co-Admin
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            @if (item.Status?.StatusName == "Active")
                            {
                                <span class="badge rounded-pill bg-white text-success border border-success-subtle fw-semibold px-3 py-2 shadow-sm" style="font-size: 11px;">
                                    <i class="fa-solid fa-circle-check me-1"></i>Active
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-white text-secondary border border-secondary-subtle fw-semibold px-3 py-2 shadow-sm" style="font-size: 11px;">
                                    <i class="fa-solid fa-circle-xmark me-1"></i>@(item.Status?.StatusName ?? "Inactive")
                                </span>
                            }

                            @if (isHeadAdmin)
                            {
                                <form asp-action="Delete"
                                      asp-route-retailstaffid="@item.RetailStaffId"
                                      asp-route-retailId="@ViewBag.RetailId"
                                      method="post"
                                      id="deleteStaffForm-@item.RetailStaffId"
                                      class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm fw-medium rounded-pill px-3 shadow-sm"
                                            onclick="confirmStaffRemoval('@item.RetailStaffId', '@Html.Raw(item.Staff?.UserName?.Replace("'", "\\'") ?? "this Co-Admin")')">
                                        <i class="fa-solid fa-xmark me-1"></i>Remove
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border rounded-pill px-3 py-2 small">
                                    <i class="fa-solid fa-lock me-1"></i>Protected
                                </span>
                            }
                        </div>
                    </div>
                }

                <!-- CASHIERS -->
                @foreach (var item in cashiers)
                {
                    profileMap.TryGetValue(item.StaffId ?? "", out var pic);
                    var avatar = string.IsNullOrWhiteSpace(pic) ? "/images/default-pfp.jpg" : pic;

                    <div class="d-flex align-items-center justify-content-between py-2 px-3 rounded-3 shadow-sm border"
                         style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
                        <div class="d-flex align-items-center gap-3">
                            <img src="@avatar"
                                 onerror="this.onerror=null; this.src='/images/default-pfp.jpg';"
                                 alt="@item.Staff?.UserName"
                                 class="rounded-circle border border-2 border-white object-fit-cover shadow-sm bg-white"
                                 style="width: 44px; height: 44px; flex-shrink: 0;" />
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fw-semibold" style="color: #1162a3;">@(item.Staff?.UserName ?? "Unknown User")</span>
                                    <span class="badge rounded-pill bg-light text-secondary border fw-semibold px-2 py-1 shadow-sm" style="font-size: 11px;">
                                        <i class="fa-solid fa-cash-register me-1"></i>Cashier
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            @if (item.Status?.StatusName == "Active")
                            {
                                <span class="badge rounded-pill bg-white text-success border border-success-subtle fw-semibold px-3 py-2 shadow-sm" style="font-size: 11px;">
                                    <i class="fa-solid fa-circle-check me-1"></i>Active
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-white text-secondary border border-secondary-subtle fw-semibold px-3 py-2 shadow-sm" style="font-size: 11px;">
                                    <i class="fa-solid fa-circle-xmark me-1"></i>@(item.Status?.StatusName ?? "Inactive")
                                </span>
                            }

                            @if (isHeadAdmin || isCoAdmin)
                            {
                                <form asp-action="Delete"
                                      asp-route-retailstaffid="@item.RetailStaffId"
                                      asp-route-retailId="@ViewBag.RetailId"
                                      method="post"
                                      id="deleteStaffForm-@item.RetailStaffId"
                                      class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm fw-medium rounded-pill px-3 shadow-sm"
                                            onclick="confirmStaffRemoval('@item.RetailStaffId', '@Html.Raw(item.Staff?.UserName?.Replace("'", "\\'") ?? "this Cashier")')">
                                        <i class="fa-solid fa-xmark me-1"></i>Remove
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small fst-italic px-2">Restricted</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmStaffRemoval(retailStaffId, userName) {
            Swal.fire({
                title: 'Revoke Staff Access?',
                text: `Are you sure you want to remove "${userName}" from this store?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, remove',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(`deleteStaffForm-${retailStaffId}`).submit();
                }
            });
        }
    </script>
}