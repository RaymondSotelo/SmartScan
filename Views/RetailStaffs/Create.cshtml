@model SmartScan.Models.RetailStaff
@using Microsoft.AspNetCore.Identity
@inject SmartScan.Data.ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Assign Retail Staff";
    ViewData["HeaderTitle"] = "Retail Management";

    // 1. Cast ViewBag.CashierList and extract user IDs
    var cashierList = ViewBag.CashierList as IEnumerable<IdentityUser> ?? Enumerable.Empty<IdentityUser>();
    var cashierIds = cashierList.Select(c => c.Id).Distinct().ToList();

    // 2. Fetch all matching profile pictures in one single roundtrip query
    var profileMap = DbContext.UserProfiles
        .Where(up => cashierIds.Contains(up.UserId))
        .ToDictionary(up => up.UserId, up => up.ProfilePicture);
}

@section Styles {
    <style>
        body {
            background: linear-gradient(180deg, #95CCDD 0%, #eef6f9 100%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="card shadow border-0 rounded-4 mt-4">
    <div class="card-header rounded-top-4 text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-user-plus"></i> Assigning Staff</h5>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <!-- Decorator -->
            <div class="bg-light py-2 p-2" style="color:#1162a3;">
                <h3 class="mb-0 fw-semibold"><i class="fa-solid fa-user-group me-1"></i> Available Cashiers</h3>
                <p class="fw-medium pt-1 text-secondary">Select a cashier from the catalog below to assign it to your retail.</p>
            </div>

            <!-- Staff Search Bar -->
            <div class="p-2" style="max-width: 500px; width: 100%;">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text"
                           id="cashierSearchInput"
                           class="form-control"
                           placeholder="Search staff by email..." />
                </div>
                <span asp-validation-for="CashierId" class="text-danger small"></span>
            </div>
        </div>

        <!-- Cashier Table -->
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle" id="cashierTable">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th style="width: 150px;">Action</th>
                    </tr>
                </thead>
                @if (cashierList.Any())
                {
                    <tbody>
                        @foreach (var cashier in cashierList)
                        {
                            profileMap.TryGetValue(cashier.Id, out var customPic);
                            var avatarPath = string.IsNullOrWhiteSpace(customPic)
                            ? "/images/default-pfp.jpg"
                            : customPic;

                            <tr>
                                <td class="searchable">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@avatarPath"
                                             onerror="this.onerror=null; this.src='/images/default-profile-pic.png';"
                                             alt="@cashier.UserName"
                                             class="rounded-circle border border-1 object-fit-cover shadow-sm bg-white"
                                             style="width: 34px; height: 34px; flex-shrink: 0;" />
                                        <span class="fw-semibold text-dark">@cashier.UserName</span>
                                    </div>
                                </td>
                                <td>
                                    <form asp-action="Create" method="post" class="d-inline">
                                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                                        <input type="hidden" asp-for="CashierId" value="@cashier.Id" />
                                        <input type="hidden" asp-for="RetailId" value="@ViewBag.RetailId" />

                                        <button type="submit" class="btn btn-outline-primary fw-medium">
                                            <i class="fa-solid fa-user-plus"></i> Assign
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                }
            </table>
        </div>

        <!-- Alert Div | Hide on default -->
        <div id="noResultsAlert" class="alert alert-warning text-center my-4 fw-semibold" role="alert" style="display: none;">
            <i class="fa-solid fa-circle-exclamation me-2"></i>No staff found matching "<strong id="searchQueryDisplay"></strong>".
        </div>

        <!-- Return Button -->
        <div class="text-start pt-3">
            <a asp-action="Index" asp-route-retailId="@ViewBag.RetailId" class="btn btn-outline-secondary fw-medium">Back to List</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('cashierSearchInput').addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            const rows = document.querySelectorAll('#cashierTable tbody tr');
            const noResultsAlert = document.getElementById('noResultsAlert');
            const searchQueryDisplay = document.getElementById('searchQueryDisplay');

            let visibleCount = 0;

            rows.forEach(row => {
                const searchableText = Array.from(row.querySelectorAll('.searchable'))
                    .map(td => td.textContent.toLowerCase())
                    .join(' ');

                if (searchableText.includes(query)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (visibleCount === 0 && query !== '') {
                searchQueryDisplay.textContent = this.value.trim();
                noResultsAlert.style.display = '';
            } else {
                noResultsAlert.style.display = 'none';
            }
        });
    </script>
}