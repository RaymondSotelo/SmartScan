@{
    Layout = "_Layout";
    var retailId = ViewContext.RouteData.Values["retailid"]
                   ?? Context.Request.Query["retailid"].ToString()
                   ?? ViewData["RetailId"];

    // Set the default return URL to Retails/Index
    string returnUrl = Url.Action("Index", "Retails") ?? "/Retails/Index";

    // Read the previous page URL from the request headers
    string referer = Context.Request.Headers["Referer"].ToString();

    // If they came from anywhere in the Users controller, change the return URL
    if (!string.IsNullOrEmpty(referer) && referer.Contains("/Users", StringComparison.OrdinalIgnoreCase))
    {
        returnUrl = Url.Action("Index", "Users") ?? "/Users/Index";
    }
}

@section Styles {
    @await RenderSectionAsync("Styles", required: false)
}

<!-- Outer Card locked to viewport height -->
<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white"
     style="min-height: max(520px, calc(100dvh - 130px)); height: auto;">

    <!-- Top Card Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex justify-content-between align-items-center"
         style="background-color: #1162a3;">
        <h5 class="mb-0">
            <i class="fa-solid fa-shop me-2"></i>@(ViewData["RetailName"] ?? "Store Management")
        </h5>

        <!-- Return Link -->
        <a href="@returnUrl" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold text-primary"
           style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
            <i class="fa-solid fa-arrow-left me-1"></i>Return
        </a>
    </div>

    <!-- Interior Layout Body -->
    <div class="card-body p-4 flex-grow-1 overflow-hidden d-flex flex-column">
        <div class="row g-4 h-100">
            <!-- Left Side: Retail Sub-Navigation -->
            <div class="col-md-3 col-lg-3 h-100 overflow-y-auto pe-md-2 border-end">
                <partial name="_RetailNav" />
            </div>

            <!-- Right Side: Injected View Content -->
            <div class="col-md-9 col-lg-9 h-100 overflow-y-auto ps-md-3">
                @RenderBody()
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}