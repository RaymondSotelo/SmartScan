@{
    Layout = "_Layout";
    var retailId = ViewContext.RouteData.Values["retailid"] 
                   ?? Context.Request.Query["retailid"].ToString() 
                   ?? ViewData["RetailId"];
}

@section Styles {
    @await RenderSectionAsync("Styles", required: false)
}

<div class="card shadow border-0 rounded-4 mt-4 mb-5 ">
    <div class="card-header rounded-top-4 text-white p-3 d-flex justify-content-between align-items-center" style="background-color:#1162a3">
        <h5 class="mb-0">
            <i class="fa-solid fa-shop me-2"></i> @(ViewData["RetailName"] ?? "Store Management")
        </h5>
        <a asp-controller="Retails" asp-action="Index" class="btn btn-sm btn-outline-light fw-medium ">
            <i class="fa-solid fa-left-long me-1"></i> Back
        </a>
    </div>
    <div class="p-4">
        <div class="row g-4">
            <!-- Sidebar Navigation -->
            <div class="col-md-3">
                <partial name="_RetailNav" />
            </div>

            <!-- Main Content Area where views render -->
            <div class="col-md-9">
                @RenderBody()
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}