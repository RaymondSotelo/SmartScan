@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using SmartScan.Data
@using SmartScan.Models

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject ApplicationDbContext DbContext

@functions {
    // Dynamic Time Formatter
    public string GetRelativeTime(DateTime createdAt)
    {
        var span = DateTime.Now - createdAt;

        if (span.TotalMinutes < 1)
            return $"{(int)span.TotalSeconds} seconds ago";
        if (span.TotalHours < 1)
            return $"{(int)span.TotalMinutes} mins ago";
        if (span.TotalDays < 1)
            return $"{(int)span.TotalHours} hrs, {span.Minutes} mins ago";
        if (span.TotalDays < 30)
            return $"{(int)span.TotalDays} days, {span.Hours} hrs ago";
        if (span.TotalDays < 365)
            return $"{(int)(span.TotalDays / 30)} months, {(int)(span.TotalDays % 30)} days ago";

        return createdAt.ToString("MMM dd, yyyy");
    }
}

@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var currentUserName = User.Identity?.Name;
    var isCashier = User.IsInRole("Cashier");
    var isAdmin = User.IsInRole("Admin");

    // Get user's retail IDs
    var userRetailIds = DbContext.Retails
        .Where(r => r.AdminOwner == currentUserId ||
                    DbContext.RetailStaffs.Any(rs => rs.RetailId == r.RetailId && rs.StaffId == currentUserId))
        .Select(r => r.RetailId)
        .ToList();

    // Base query for unread alerts (checks the AdminAlertReads table)
    var alertsQuery = DbContext.SecurityAlerts
        .Include(a => a.AlertType)
        .Where(a => a.RetailId.HasValue && userRetailIds.Contains(a.RetailId.Value))
        .Where(a => !DbContext.AdminAlertReads.Any(read => read.AlertId == a.AlertId && read.AdminId == currentUserId && read.IsRead));

    // Filter out alerts where the description contains the current user's username
    if (!string.IsNullOrEmpty(currentUserName))
    {
        alertsQuery = alertsQuery.Where(a => !a.Description.Contains(currentUserName));
    }

    // Role-Based Filtering
    if (isCashier && !isAdmin)
    {
        // Cashiers only see: 4 (Low Stock), 5 (Depleted), 6 (Anomaly)
        var allowedTypes = new List<int> { 4, 5, 6 };
        alertsQuery = alertsQuery.Where(a => allowedTypes.Contains(a.AlertTypeId));
    }

    // Execute query and sort by exact timestamp
    var topAlerts = alertsQuery
        .OrderByDescending(a => a.CreatedAt)
        .ThenByDescending(a => a.AlertId)
        .ToList();

    bool isCustomerDisplay = Context.Request.Path.StartsWithSegments("/Home/CustomerDisplay", StringComparison.OrdinalIgnoreCase);
}

@if (!isCustomerDisplay)
{
    <ul class="navbar-nav align-items-center">
        @if (SignInManager.IsSignedIn(User))
        {
            var currentUser = await UserManager.GetUserAsync(User);
            const string fallbackAvatar = "/images/default-pfp.jpg";
            string profilePfpPath = fallbackAvatar;

            if (currentUser != null)
            {
                var userProfile = await DbContext.UserProfiles
                .AsNoTracking()
                .FirstOrDefaultAsync(up => up.UserId == currentUser.Id);

                if (!string.IsNullOrWhiteSpace(userProfile?.ProfilePicture))
                {
                    var pic = userProfile.ProfilePicture.Trim();
                    profilePfpPath = pic.StartsWith("~") ? pic.Substring(1) : (pic.StartsWith("/") ? pic : "/" + pic);
                }
            }

            <!-- User Profile Dropdown -->
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle d-flex align-items-center fw-semibold text-white text-decoration-none" href="#" id="userProfileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding-top: 24px; padding-bottom: 10px;">
                    <span class="me-2" style="padding-right: 8px; font-size: 18px;">@User.Identity?.Name</span>
                    <img src="@profilePfpPath" onerror="this.onerror=null; this.src='@fallbackAvatar';" asp-append-version="true" alt="Profile" class="rounded-circle border border-white border-1 object-fit-cover shadow-sm bg-white" style="width: 42px; height: 42px;" />
                </a>

                <ul class="dropdown-menu dropdown-menu-end shadow border-1 rounded-3 mt-1 p-0 overflow-hidden" aria-labelledby="userProfileDropdown" style="width: 190px; z-index: 1050;">
                    <li>
                        <a class="dropdown-item py-2 fw-medium d-flex align-items-center text-primary" asp-area="Identity" asp-page="/Account/Manage/Index">
                            <i class="fa-solid fa-gear me-2 text-primary" style="width: 20px;"></i>Account Settings
                        </a>
                    </li>
                    <li>
                        <form class="d-block w-100 m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Account/Login", new { area = "Identity" })" method="post">
                            <button type="submit" class="dropdown-item py-2 fw-medium text-danger d-flex align-items-center w-100">
                                <i class="fa-solid fa-arrow-right-from-bracket me-2 text-danger" style="width: 20px;"></i>Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </li>

            <!-- Notification Bell Dropdown -->
            <li class="nav-item dropdown me-3" style="padding-top: 14px;">
                <a class="nav-link dropdown-toggle position-relative text-white" href="#" id="alertsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fa-solid fa-bell fs-5"></i>
                    @if (topAlerts.Any())
                    {
                        <!-- ADDED IDs to target with JavaScript -->
                        <span id="alertBadge" class="position-absolute top-25 start-75 translate-middle badge rounded-pill bg-danger border border-light" style="font-size: 0.65rem; padding: 0.25em 0.45em;">
                            <span id="alertCount">@(topAlerts.Count() > 9 ? "9+" : topAlerts.Count())</span>
                            <span class="visually-hidden">New alerts</span>
                        </span>
                    }
                </a>

                <ul class="dropdown-menu dropdown-menu-end shadow border-1 rounded-3 mt-4 p-0 overflow-hidden" aria-labelledby="alertsDropdown" style="width: 340px; z-index: 1050;">
                    <li>
                        <div class="dropdown-header fw-bold text-primary bg-light border-bottom py-2 d-flex justify-content-between align-items-center">
                            <span>Notifications</span>

                            <!-- Read All Button -->
                            <button type="button"
                                    id="readAllBtn"
                                    class="btn btn-sm btn-link text-decoration-none p-0 fw-semibold fw-bold"
                                    onclick="markAllAlertsAsRead(event)"
                                    title="Mark all as read"
                                    style="display: @(topAlerts.Any() ? "block" : "none");">
                                    Read All <i class="fa-solid fa-check"></i>
                            </button>
                        </div>
                    </li>

                    <li>
                        <!-- Scrollable Container for ALL unread alerts -->
                        <div id="alertListContainer" style="max-height: 380px; overflow-y: auto;">
                            @if (!topAlerts.Any())
                            {
                                <div class="dropdown-item py-4 text-muted text-center">
                                    <i class="fa-solid fa-bell-slash fa-2x mb-2 text-secondary opacity-50"></i><br />
                                    No unread alerts.
                                </div>
                            }
                            else
                            {
                                foreach (var alert in topAlerts)
                                {
                                    var alertTypeName = alert.AlertType?.AlertTypeName ?? $"Type {alert.AlertTypeId}";

                                    <a class="dropdown-item py-3 border-bottom text-wrap alert-dropdown-item"
                                       href="@(string.IsNullOrEmpty(alert.ActionUrl) ? "#" : alert.ActionUrl)"
                                       id="alert-item-@alert.AlertId">

                                        <!-- Title -->
                                        <div class="fw-bold fs-6 alert-item-title">
                                            @alertTypeName
                                        </div>

                                        <!-- Description -->
                                        <div class="small alert-item-desc mt-1 lh-sm">
                                            @alert.Description
                                        </div>

                                        <!-- Footer -->
                                        <div class="d-flex justify-content-between align-items-end mt-2">
                                            <div class="alert-item-time" style="font-size: 11px;">
                                                <i class="fa-regular fa-clock me-1"></i>@GetRelativeTime(alert.CreatedAt)
                                            </div>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill btn-read shadow-sm"
                                                    style="font-size: 11px;"
                                                    title="Mark as Read"
                                                    onclick="markAlertAsRead(event, @alert.AlertId)">
                                                <i class="fa-solid fa-check text-success"></i> Read
                                            </button>
                                        </div>
                                    </a>
                                }
                            }
                        </div>
                    </li>

                    <li>
                        <a class="dropdown-item text-center fw-semibold py-2 bg-light border-top" asp-controller="SecurityAlerts" asp-action="Index" style="color: #1162a3;">
                            See all alerts
                        </a>
                    </li>
                </ul>
            </li>
        }
        else
        {
            <li class="nav-item d-flex align-items-center pt-4 pe-2">
                <a class="nav-link fw-semibold p-0 nav-auth-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
                <span class="mx-2 fw-medium user-select-none" style="color: #387bd6;">|</span>
                <a class="nav-link fw-semibold p-0 nav-auth-link" asp-area="Identity" asp-page="/Account/Register">Sign Up</a>
            </li>
        }
    </ul>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const dropdownEl = document.getElementById('userProfileDropdown');
        if (dropdownEl) {
            const dropdownMenu = dropdownEl.nextElementSibling;
            let isClosing = false;

            dropdownEl.parentElement.addEventListener('hide.bs.dropdown', function (e) {
                if (isClosing) return;
                e.preventDefault();
                isClosing = true;
                dropdownMenu.classList.add('collapsing-out');

                setTimeout(() => {
                    dropdownMenu.classList.remove('collapsing-out');
                    const bsDropdown = bootstrap.Dropdown.getInstance(dropdownEl);
                    if (bsDropdown) bsDropdown.hide();
                    isClosing = false;
                }, 170);
            });
        }
    });

    // --- GLOBAL HELPER: Move Row to Read Table ---
    function transitionRowToReadTable(row) {
        const tbodyRead = document.getElementById('tbody-read');
        const tbodyUnread = document.getElementById('tbody-unread');
        if (!tbodyRead || !row) return;

        // 1. Remove empty state from Read table if it exists
        const emptyReadRow = document.getElementById('emptyReadRow');
        if (emptyReadRow) emptyReadRow.remove();

        // 2. Morph the row's styling to match "Read" alerts
        row.className = 'bg-light log-row';
        row.style.opacity = '1';
        row.style.transform = 'none';

        const cells = row.querySelectorAll('td');
        if (cells.length >= 5) {
            // Time cell
            const timeSpan = cells[0].querySelector('span');
            if (timeSpan) {
                timeSpan.classList.remove('text-dark', 'fw-bold');
                timeSpan.classList.add('text-secondary', 'fw-semibold');
            }
            // Store cell
            cells[1].className = 'text-muted';
            // Badge cell
            const badgeSpan = cells[2].querySelector('.badge');
            if (badgeSpan) {
                badgeSpan.className = 'badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-3 py-2 shadow-sm';
            }
            // Description cell (Spans across the empty button space)
            cells[3].className = 'text-muted text-truncate pe-4';
            cells[3].setAttribute('colspan', '2');
            // Remove Action button cell
            cells[4].remove();
        }

        // 3. Prepend to top of Read table
        tbodyRead.prepend(row);

        // 4. If Unread is now empty, inject empty state UI
        if (tbodyUnread && tbodyUnread.querySelectorAll('.log-row').length === 0) {
            tbodyUnread.innerHTML = `
                <tr id="emptyUnreadRow">
                    <td colspan="5" class="text-center py-5 bg-white">
                        <i class="fa-solid fa-check-double fa-3x text-success opacity-50 mb-3"></i>
                        <h5 class="fw-bold text-secondary">All Caught Up!</h5>
                        <p class="text-muted small">You have no unread security logs.</p>
                    </td>
                </tr>
            `;
        }
    }

    // --- AJAX: Mark Single Alert As Read (From Dropdown) ---
    function markAlertAsRead(event, alertId) {
        event.preventDefault();
        event.stopPropagation();

        fetch(`/SecurityAlerts/MarkAsRead?alertId=${alertId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // 1. Clear from Dropdown
                const alertElement = document.getElementById(`alert-item-${alertId}`);
                if (alertElement) alertElement.remove();

                const remainingAlerts = document.querySelectorAll('.alert-dropdown-item').length;
                const badge = document.getElementById('alertBadge');
                const countSpan = document.getElementById('alertCount');
                const readAllBtn = document.getElementById('readAllBtn');

                if (remainingAlerts === 0) {
                    if (badge) badge.remove();
                    if (readAllBtn) readAllBtn.style.display = 'none';
                    const scrollContainer = document.getElementById('alertListContainer');
                    if (scrollContainer) {
                        scrollContainer.innerHTML = `
                            <div class="dropdown-item py-4 text-muted text-center">
                                <i class="fa-solid fa-bell-slash fa-2x mb-2 text-secondary opacity-50"></i><br />
                                No unread alerts.
                            </div>`;
                    }
                } else if (countSpan) {
                    countSpan.textContent = remainingAlerts > 9 ? "9+" : remainingAlerts;
                }
                currentAlertCount = remainingAlerts;

                // 2. Sync with Index Page (Animate & Move)
                const indexRow = document.getElementById('alert-row-' + alertId);
                if (indexRow) {
                    let unreadCountBtn = document.getElementById('unreadCountBtn');
                    let readCountBtn = document.getElementById('readCountBtn');
                    if (unreadCountBtn && readCountBtn) {
                        unreadCountBtn.innerText = Math.max(0, parseInt(unreadCountBtn.innerText) - 1);
                        readCountBtn.innerText = parseInt(readCountBtn.innerText) + 1;
                    }

                    indexRow.style.opacity = '0';
                    indexRow.style.transform = 'translateX(20px)';
                    setTimeout(() => transitionRowToReadTable(indexRow), 300);
                }
            }
        })
        .catch(error => console.error('Error:', error));
    }

    // --- AJAX: Mark ALL Alerts As Read (From Dropdown) ---
    function markAllAlertsAsRead(event) {
        event.preventDefault();
        event.stopPropagation();

        fetch('/SecurityAlerts/MarkAllAsRead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // 1. Clear Dropdown UI completely
                const badge = document.getElementById('alertBadge');
                if (badge) badge.remove();

                const readAllBtn = document.getElementById('readAllBtn');
                if (readAllBtn) readAllBtn.style.display = 'none';

                const listContainer = document.getElementById('alertListContainer');
                if (listContainer) {
                    listContainer.innerHTML = `
                        <div class="dropdown-item py-4 text-muted text-center">
                            <i class="fa-solid fa-bell-slash fa-2x mb-2 text-secondary opacity-50"></i><br />
                            No unread alerts.
                        </div>`;
                }
                currentAlertCount = 0;

                // 2. Sync with Index Page (Bulk Move)
                const tbodyUnread = document.getElementById('tbody-unread');
                if (tbodyUnread) {
                    const rows = Array.from(tbodyUnread.querySelectorAll('.log-row'));
                    const rowCount = rows.length;

                    if (rowCount > 0) {
                        // Rapidly move all rows over using our helper
                        rows.forEach(r => transitionRowToReadTable(r));

                        let unreadCountBtn = document.getElementById('unreadCountBtn');
                        let readCountBtn = document.getElementById('readCountBtn');
                        if (unreadCountBtn && readCountBtn) {
                            readCountBtn.innerText = parseInt(readCountBtn.innerText) + rowCount;
                            unreadCountBtn.innerText = "0";
                        }
                    }
                }
            }
        })
        .catch(err => console.error("Error marking all alerts as read", err));
    }

    // --- NEW: LIVE POLLING SYSTEM ---
    let currentAlertCount = @(topAlerts.Count());

    function getRelativeTimeJS(dateString) {
        const date = new Date(dateString);
        const now = new Date();
        const diffInSeconds = Math.floor((now - date) / 1000);

        if (diffInSeconds < 60) return `${diffInSeconds} seconds ago`;
        const diffInMinutes = Math.floor(diffInSeconds / 60);
        if (diffInMinutes < 60) return `${diffInMinutes} mins ago`;
        const diffInHours = Math.floor(diffInMinutes / 60);
        if (diffInHours < 24) return `${diffInHours} hrs, ${diffInMinutes % 60} mins ago`;
        const diffInDays = Math.floor(diffInHours / 24);
        if (diffInDays < 30) return `${diffInDays} days, ${diffInHours % 24} hrs ago`;

        return date.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
    }

    function fetchLiveAlerts() {
        fetch('/SecurityAlerts/GetLiveAlerts')
            .then(response => response.json())
            .then(data => {
                if (data.count > currentAlertCount) {
                    currentAlertCount = data.count;

                    // 1. Update or Create Badge
                    let badge = document.getElementById('alertBadge');
                    const bellLink = document.getElementById('alertsDropdown');

                    if (!badge && data.count > 0) {
                        badge = document.createElement('span');
                        badge.id = 'alertBadge';
                        badge.className = 'position-absolute top-25 start-75 translate-middle badge rounded-pill bg-danger border border-light';
                        badge.style = 'font-size: 0.65rem; padding: 0.25em 0.45em;';
                        badge.innerHTML = `<span id="alertCount">${data.count > 9 ? "9+" : data.count}</span><span class="visually-hidden">New alerts</span>`;
                        bellLink.appendChild(badge);
                    } else if (badge) {
                        document.getElementById('alertCount').textContent = data.count > 9 ? "9+" : data.count;
                    }

                    // 2. Rebuild the List Container
                    const listContainer = document.getElementById('alertListContainer');
                    if (listContainer && data.alerts.length > 0) {
                        listContainer.innerHTML = '';
                        data.alerts.forEach(alert => {
                            const html = `
                                <a class="dropdown-item py-3 border-bottom text-wrap alert-dropdown-item" href="${alert.actionUrl}" id="alert-item-${alert.alertId}">
                                    <div class="fw-bold fs-6 alert-item-title">${alert.alertTypeName}</div>
                                    <div class="small alert-item-desc mt-1 lh-sm">${alert.description}</div>
                                    <div class="d-flex justify-content-between align-items-end mt-2">
                                        <div class="alert-item-time" style="font-size: 11px;">
                                            <i class="fa-regular fa-clock me-1"></i>${getRelativeTimeJS(alert.timeString)}
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill btn-read shadow-sm" style="font-size: 11px;" title="Mark as Read" onclick="markAlertAsRead(event, ${alert.alertId})">
                                            <i class="fa-solid fa-check text-success"></i> Read
                                        </button>
                                    </div>
                                </a>
                            `;
                            listContainer.insertAdjacentHTML('beforeend', html);
                        });
                    }
                }
            })
            .catch(err => console.error("Error fetching live alerts:", err));
    }

    // Poll the server every 15 seconds (15000 ms)
    setInterval(fetchLiveAlerts, 15000);
</script>