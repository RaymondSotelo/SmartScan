<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartScan</title>
    <script type="importmap"></script>
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartScan.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="d-flex" id="wrapper">
        @if(User.Identity != null && User.Identity.IsAuthenticated)
        {
            <nav id="sidebar" class="collapsed" style="background-color:#1665a0;">
                <div class="sidebar-header d-flex align-items-center p-3" style="min-height: 60px;">
                    <i class="fa-solid fa-bars menu-toggle-icon me-3" id="menuToggle" style="cursor: pointer; font-size: 1.3rem; color:white"></i>
                    <a class="navbar-brand fw-semibold project-name text-truncate" asp-area="" asp-controller="Users" asp-action="Index" style="font-size: 22px; color:white; font-family:Tahoma; text-decoration: none;">
                        <i class="fa-solid fa-basket-shopping" style="color: white"></i> SmartScan
                        @if (User.IsInRole("Admin"))
                        {
                            <span style="font-size:16px; width:40px; background-color:white; padding-left:4px; padding-right:4px; color:#1665a0"
                              class="rounded-1">Admin</span> <!--[Admin tag]-->
                        }
                    </a>
                </div>
                <ul class="list-unstyled components px-2">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="mb-2"> <!-- [CURRENTLY NOT WORKING!] -->
                            <a asp-area="" asp-controller="" asp-action="" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-border-all sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Dashboard</span>
                            </a>
                        </li>
                        <hr />
                        <li style="padding-bottom:6px"> <!-- [ACCOUNT MAMANGERMENT Header] -->
                            <span class="menu-text ms-3 text-white fw-semibold text-center" style="font-size:18px">ACCOUNT MANAGEMENT</span>
                        </li>
                        <li class="mb-2"> <!-- [ADMIN APPROVAL Button] -->
                            <a asp-area="" asp-controller="Users" asp-action="Admin_Approval" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-user-tie sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Admin Approval</span>
                            </a>
                        </li>
                        <li class="mb-2"> <!-- [USER MANAGER Button] -->
                            <a asp-area="" asp-controller="Users" asp-action="Index" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-users-gear sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">User Manager</span>
                            </a>
                        </li>
                        <hr />
                        <li style="padding-bottom:6px"> <!-- [RETAIL MAMANGERMENT Header] -->
                            <span class="menu-text ms-3 text-white fw-semibold text-center" style="font-size:18px">RETAIL MANAGEMENT</span>
                        </li>
                        <li class="mb-2"> <!-- [PRODUCTS Button] -->
                            <a asp-area="" asp-controller="Products" asp-action="Index" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-cart-flatbed sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Products</span>
                            </a>
                        </li>
                        <li class="mb-2"> <!-- [CATEGORIES Button] -->
                            <a asp-area="" asp-controller="Categories" asp-action="Index" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-tag sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Categories</span>
                            </a>
                        </li>
                        <li class="mb-2"> <!-- [ENROLL RETAIL Button] -->
                            <a asp-area="" asp-controller="Retails" asp-action="Index" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-shop sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Enroll Retail</span>
                            </a>
                        </li>
                        <hr />
                        <li style="padding-bottom:6px"> <!-- [STATISTICS Header] -->
                            <span class="menu-text ms-3 text-white fw-semibold text-center" style="font-size:18px">STATISTICS</span>
                        </li>
                        <li class="mb-2"> <!-- [CURRENTLY NOT WORKING!] -->
                            <a asp-area="" asp-controller="" asp-action="" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-chart-line sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Sales Analysis</span>
                            </a>
                        </li>
                        <li class="mb-2"> <!-- [CURRENTLY NOT WORKING!] -->
                            <a asp-area="" asp-controller="" asp-action="" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-receipt sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Transaction Log</span>
                            </a>
                        </li>
                        <hr />
                        <li style="padding-bottom:6px"> <!-- [MISCELLANEOUS Header] -->
                            <span class="menu-text ms-3 text-white fw-semibold text-center" style="font-size:18px">MISCELLANEOUS</span>
                        </li>
                        <li class="mb-2"> <!-- [CURRENTLY NOT WORKING!] -->
                            <a asp-area="" asp-controller="" asp-action="" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-id-badge sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Enroll Customer</span>
                            </a>
                        </li>
                        <hr />
                        <li style="padding-bottom:6px"> <!-- [SETTINGS Header] -->
                            <span class="menu-text ms-3 text-white fw-semibold text-center" style="font-size:18px">SETTINGS</span>
                        </li>
                        <li class="mb-2"> <!-- [CURRENTLY NOT WORKING!] -->
                            <a asp-area="" asp-controller="" asp-action="" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-circle-user sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Account</span>
                            </a>
                        </li>

                    }
                    @if (User.IsInRole("Cashier"))
                    {
                        <li class="mb-2">
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link d-flex align-items-center p-2 rounded" style="color:white">
                                <i class="fa-solid fa-house sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Dashboard</span>
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-area="" asp-controller="Home" asp-action="Checkout" class="nav-link d-flex align-items-center p-2 rounded" style="color:white">
                                <i class="fa-solid fa-basket-shopping sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3 fs-6">Checkout</span>
                            </a>
                        </li>
                    }            
                </ul>
            </nav>
        }
        <div id="page-content-wrapper" class="flex-grow-1 d-flex flex-column">

            <header> 
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-0 mb-3" style="min-height: 60px; height:60px; background-color:@(User.Identity != null && User.Identity.IsAuthenticated ? "#1162a3" : "transparent");">
                    <div class="container-fluid">
                        @if (User.Identity == null || !User.Identity.IsAuthenticated)
                        {
                            <img src="~/images/SmartScanLogo.png" alt="Smart Scan Logo" wdith="75" height="75" />
                            <a class="navbar-brand fw-semibold me-auto" asp-area="" asp-controller="Home" asp-action="Index" style="font-size: 28px; font-family:'Microsoft Sans Serif'; text-decoration: none; color:#387bd6;">
                                <!--<i class="fa-solid fa-basket-shopping" style="color:#387bd6"></i>-->
                                SmartScan
                                <span class="fs-6" style="color:#387bd6">
                                    A Vision-Based Automated Checkout For Retail Counters
                                </span>
                            </a>
                        }
                        else
                        {
                            <p class="navbar-brand fw-semibold project-name text-truncate text-white mb-0" style="font-size: 22px; font-family:Tahoma;">
                                @(ViewData["HeaderTitle"] ?? ViewData["Title"] ?? "SmartScan")
                            </p>
                        }
                        <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between pb-3">
                            <ul class="navbar-nav flex-grow-1">
                            </ul>
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </nav>
            </header>

            <div class="content-scroll-container">
                <div class="container-fluid px-4">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script type="text/javascript">
            document.addEventListener("DOMContentLoaded", function () {
                const menuToggle = document.getElementById("menuToggle");
                const sidebar = document.getElementById("sidebar");

                menuToggle.addEventListener("click", function () {
                    sidebar.classList.toggle("collapsed");
                });
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
