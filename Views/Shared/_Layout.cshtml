<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartScan</title>
    <script type="importmap"></script>
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartScan.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/SmartScanLogo.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/images/SmartScanLogo.png" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="d-flex" id="wrapper">
    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
    {
            <nav id="sidebar" class="collapsed" style="background-color:#1665a0;">
                <div class="sidebar-header d-flex align-items-center p-3" style="min-height: 60px;">
                    <i class="fa-solid fa-bars menu-toggle-icon me-3" id="menuToggle" style="cursor: pointer; font-size: 1.3rem; color:white"></i>
                    <a class="navbar-brand fw-semibold project-name text-truncate" asp-area="" asp-controller="Users" asp-action="Index" style="font-size: 22px; color:white; font-family:Tahoma; text-decoration: none;">
                        SmartScan
                        @if (User.IsInRole("Admin"))
                        {
                            <span style="font-size:16px; width:40px; background-color:white; padding-left:4px; padding-right:4px; color:#1665a0"
                              class="rounded-1">Admin</span> <!--[Admin tag]-->
                        }
                    </a>
                </div>
                <ul class="list-unstyled components px-2">
                    @if (User.IsInRole("Admin"))
                    {
                        <li style="padding-bottom:6px"> <!-- [HOME Header] -->
                            <span class="menu-text ms-3 text-white fw-semibold text-center" style="font-size:18px">HOME</span>
                        </li>
                        <li class="mb-2"> <!-- [DASHBOARD BUTTON] -->
                            <a asp-area="" asp-controller="Users" asp-action="Index" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-border-all sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Dashboard</span>
                            </a>
                        </li>
                        <hr />
                        <li style="padding-bottom:6px"> <!-- [ACCOUNT MAMANGERMENT Header] -->
                            <span class="menu-text ms-3 text-white fw-semibold text-center" style="font-size:18px">ACCOUNT MANAGEMENT</span>
                        </li>
                        <li class="mb-2"> <!-- [ADMIN APPROVAL Button] -->
                            <a asp-area="" asp-controller="Users" asp-action="AdminApproval" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-user-tie sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Admin Approval</span>
                            </a>
                        </li>
                        <li class="mb-2"> <!-- [USER MANAGER Button] -->
                            <a asp-area="" asp-controller="Users" asp-action="UserManagement" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-users-gear sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">User Account Manager</span>
                            </a>
                        </li>
                        <hr />
                        <li style="padding-bottom:6px"> <!-- [RETAIL MAMANGERMENT Header] -->
                            <span class="menu-text ms-3 text-white fw-semibold text-center" style="font-size:18px">RETAIL MANAGEMENT</span>
                        </li>
                        <li class="mb-2"> <!-- [CATEGORIES Button] -->
                            <a asp-area="" asp-controller="Categories" asp-action="Index" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-tag sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Categories</span>
                            </a>
                        </li>
                        <li class="mb-2"> <!-- [PRODUCTS Button] -->
                            <a asp-area="" asp-controller="Products" asp-action="Index" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-cart-flatbed sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Products</span>
                            </a>
                        </li>
                        <li class="mb-2"> <!-- [RETAIL Button] -->
                            <a asp-area="" asp-controller="Retails" asp-action="Index" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-shop sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Retail</span>
                            </a>
                        </li>
                        <li class="mb-2"> <!-- [TRANSACTION LOGS Button] -->
                            <a asp-area="" asp-controller="Transactions" asp-action="Index" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-receipt sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Transaction</span>
                            </a>
                        </li>
                        <hr />
                        <li style="padding-bottom:6px"> <!-- [MISCELLANEOUS Header] -->
                            <span class="menu-text ms-3 text-white fw-semibold text-center" style="font-size:18px">MISCELLANEOUS</span>
                        </li>
                        <li class="mb-2"> <!-- [CUSTOMERS Button] -->
                            <a asp-area="" asp-controller="Customers" asp-action="Index" class="nav-link d-flex align-items-center p-2 rounded fw-medium" style="color:white">
                                <i class="fa-solid fa-id-badge sidebar-icon fs-5 text-center"></i>
                                <span class="menu-text ms-3">Customer</span>
                            </a>
                        </li>

                    }          
                </ul>
            </nav>
        }
        <div id="page-content-wrapper" class="flex-grow-1 d-flex flex-column">
            <header> 
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-0 mb-0" style="min-height: 60px; height:60px; background-color:@(User.Identity != null && User.Identity.IsAuthenticated ? "#1162a3" : "transparent");">
                    <div class="container-fluid">
                        @if (User.Identity == null || !User.Identity.IsAuthenticated)
                        {
                            <a class="navbar-brand d-inline-flex align-items-center gap-1 me-auto py-1 pt-4" 
                               asp-area="" asp-controller="Home" asp-action="Index" 
                               style="font-family: 'Microsoft Sans Serif', sans-serif; text-decoration: none; color: #387bd6;">
   
                                <!-- Scaled Logo Image -->
                                <img src="~/images/SmartScanLogo.png" 
                                     alt="Smart Scan Logo" 
                                     width="75" 
                                     height="75" 
                                     class="object-fit-contain flex-shrink-0"/>

                                <!-- Brand & Tagline Block -->
                                <div class="d-flex flex-column justify-content-center lh-1">
                                    <span class="fw-bold" style="font-size: 32px; line-height: 1.1;">SmartScan</span>
                                    <span class="fw-bold mt-1" style="font-size: 14px; letter-spacing: 0.3px;">
                                        A Vision-Based Automated Checkout For Retail Counters
                                    </span>
                                </div>
                            </a>
                        }
                        else if (User.IsInRole("Cashier"))
                        {
                            <span class="navbar-brand fw-semibold project-name text-truncate text-white mb-0" 
                                    style="font-size: 22px; font-family: Tahoma;">
                                SmartScan <span class="fw-normal">|</span> @(ViewData["HeaderTitle"] ?? ViewData["Title"] ?? "Cashier")
                            </span>
                        } else if (User.IsInRole("Admin"))
                        {
                            <span class="navbar-brand fw-semibold project-name text-truncate text-white mb-0" 
                                  style="font-size: 22px; font-family: Tahoma;">
                                @(ViewData["HeaderTitle"] ?? ViewData["Title"] ?? "Admin Portal")
                            </span>
                        }

                        <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between pb-3">
                            <ul class="navbar-nav flex-grow-1">
                            </ul>
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </nav>
            </header>

            <div class="content-scroll-container">
                <div class="container-fluid px-4">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- Hidden Form to Perform Clean POST Logout -->
        <form id="signalRForceLogoutForm" 
              asp-area="Identity" 
              asp-page="/Account/Logout" 
              asp-route-returnUrl="@Url.Page("/Account/Login", new { area = "Identity" })" 
              method="post" 
              style="display:none;">
            @Html.AntiForgeryToken()
        </form>

        <!-- SignalR & SweetAlert2 Libraries -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script type="text/javascript">
            document.addEventListener("DOMContentLoaded", function () {
                // Sidebar Toggle
                const menuToggle = document.getElementById("menuToggle");
                const sidebar = document.getElementById("sidebar");

                if (menuToggle && sidebar) {
                    menuToggle.addEventListener("click", function () {
                        sidebar.classList.toggle("collapsed");
                    });
                }

                // SignalR Session Kick-out Listener
                const sessionConnection = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/userSession")
                    .withAutomaticReconnect()
                    .build();

                sessionConnection.on("ForceLogout", function (message) {
                    Swal.fire({
                        title: "Session Terminated",
                        text: message,
                        icon: "warning",
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        confirmButtonColor: "#1162a3",
                        confirmButtonText: "Log In Again"
                    }).then(() => {
                        const logoutForm = document.getElementById("signalRForceLogoutForm");
                        if (logoutForm) {
                            logoutForm.submit();
                        } else {
                            window.location.href = "/Identity/Account/Login";
                        }
                    });
                });

                sessionConnection.start().catch(err => console.error("SignalR Session error:", err));
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
