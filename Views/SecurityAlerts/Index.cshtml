@model IEnumerable<SmartScan.Models.SecurityAlert>

@{
    ViewData["Title"] = "Security Alerts";
    if (ViewData["HeaderTitle"] == null)
    {
        ViewData["HeaderTitle"] = "Retail Management";
    }

    var readAlertIds = ViewBag.ReadAlertIds as HashSet<int> ?? new HashSet<int>();

    var unreadAlerts = Model.Where(a => !readAlertIds.Contains(a.AlertId)).ToList();
    var readAlerts = Model.Where(a => readAlertIds.Contains(a.AlertId)).ToList();
    bool isCashierOnly = User.IsInRole("Cashier") && !User.IsInRole("Admin");
}

@functions {
    // Dynamic Time Formatter
    public string GetRelativeTime(DateTime createdAt)
    {
        var span = DateTime.Now - createdAt;

        if (span.TotalMinutes < 1)
            return $"{(int)span.TotalSeconds} seconds ago";
        if (span.TotalHours < 1)
            return $"{(int)span.TotalMinutes} mins ago";
        if (span.TotalDays < 1)
            return $"{(int)span.TotalHours} hrs, {span.Minutes} mins ago";
        if (span.TotalDays < 30)
            return $"{(int)span.TotalDays} days ago";

        return createdAt.ToString("MMM dd, yyyy");
    }
}

<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white"
     style="height: calc(100dvh - 130px); min-height: 500px;">

    <!-- Top Card Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex justify-content-between align-items-center" style="background-color: #1162a3;">
        <h5 class="mb-0 fw-bold" style="letter-spacing: 0.5px;">
            <i class="fa-solid fa-clipboard-check me-2"></i>Security Logs
        </h5>

        @if (isCashierOnly)
        {
            <a asp-controller="Home" asp-action="Checkout"
               class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold text-primary shadow-sm"
               style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
                <i class="fa-solid fa-arrow-left me-1"></i>Return to Checkout
            </a>
        }
    </div>

    <!-- Scrollable Workspace -->
    <div class="flex-grow-1 overflow-auto position-relative d-flex flex-column rounded-bottom-4 bg-light">

        <div class="flex-grow-1 pb-3">
            <table class="table table-hover align-middle mb-0 w-100 bg-white"
                   style="min-width: 850px; border-collapse: separate; border-spacing: 0;">

                <thead class="sticky-top bg-white shadow-sm z-3" style="top: 0;">

                    <!-- Action Bar (Search & Toggles) -->
                    <tr class="bg-white">
                        <th colspan="5" class="p-0 border-0 border-bottom">
                            <div class="px-4 py-3 d-flex flex-wrap justify-content-between align-items-center gap-3">

                                <!-- Tab Toggles -->
                                <div class="btn-group shadow-sm" role="group">
                                    <input type="radio" class="btn-check" name="logTabs" id="tabUnread" autocomplete="off" checked onchange="switchTab('unread')">
                                    <label class="btn btn-outline-primary fw-medium px-4" for="tabUnread">
                                        <i class="fa-solid fa-envelope me-1"></i>Unread (<span id="unreadCountBtn">@unreadAlerts.Count</span>)
                                    </label>

                                    <input type="radio" class="btn-check" name="logTabs" id="tabRead" autocomplete="off" onchange="switchTab('read')">
                                    <label class="btn btn-outline-secondary fw-medium px-4" for="tabRead">
                                        <i class="fa-solid fa-envelope-open me-1"></i>Read (<span id="readCountBtn">@readAlerts.Count</span>)
                                    </label>
                                </div>

                                <!-- Live Client-Side Search Bar -->
                                <div class="d-flex gap-2" style="max-width: 320px; width: 100%;">
                                    <div class="input-group shadow-sm rounded-3 overflow-hidden border">
                                        <span class="input-group-text bg-white border-0">
                                            <i class="fa-solid fa-magnifying-glass text-muted"></i>
                                        </span>
                                        <input type="text"
                                               id="logSearchInput"
                                               onkeyup="filterLogs()"
                                               class="form-control border-0 bg-white shadow-none ps-0 fw-semibold"
                                               placeholder="Search logs..."
                                               aria-label="Search logs" />
                                    </div>

                                    <!-- Clear Search Button -->
                                    <button type="button"
                                            id="clearLogSearchBtn"
                                            class="btn btn-outline-secondary rounded-3"
                                            onclick="clearSearch()"
                                            title="Clear Search"
                                            style="display: none;">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            </div>
                        </th>
                    </tr>

                    <!-- Column Headers -->
                    <tr class="table-light border-bottom">
                        <th class="ps-4 py-3 text-secondary text-uppercase fw-bold" style="font-size: 13px; letter-spacing: 0.5px; width: 18%;">Timestamp</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 13px; letter-spacing: 0.5px; width: 15%;">Location</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 13px; letter-spacing: 0.5px; width: 22%;">Event Type</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 13px; letter-spacing: 0.5px; width: 35%;">Log Details</th>
                        <th class="pe-4 py-3 text-end text-secondary text-uppercase fw-bold text-nowrap" style="font-size: 13px; letter-spacing: 0.5px; width: 10%;"></th>
                    </tr>
                </thead>

                <!-- UNREAD ALERTS DIV/TBODY -->
                <tbody id="tbody-unread" class="searchable-tbody">
                    @if (!unreadAlerts.Any())
                    {
                        <tr id="emptyUnreadRow">
                            <td colspan="5" class="text-center py-5 bg-white">
                                <i class="fa-solid fa-envelope-circle-check fa-3x text-success opacity-50 mb-3"></i>
                                <h5 class="fw-bold text-secondary">All Caught Up!</h5>
                                <p class="text-muted small">You have no unread security logs.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var alert in unreadAlerts)
                        {
                            var typeName = alert.AlertType?.AlertTypeName ?? $"Type {alert.AlertTypeId}";
                            var storeName = alert.Retail?.RetailName ?? "System";
                            var safeDesc = alert.Description.Replace("'", "\\'");
                            var safeStore = storeName.Replace("'", "\\'");

                            <tr id="alert-row-@alert.AlertId" class="bg-white border-start border-4 position-relative log-row" style="transition: all 0.3s ease;">
                                <td class="ps-4" onclick="openAlertModal('@alert.AlertId', '@Html.Raw(typeName)', '@Html.Raw(safeStore)', '@Html.Raw(safeDesc)', '@(isCashierOnly ? "" : alert.ActionUrl)', false)" style="cursor: pointer;">
                                    <span class="d-block font-monospace fw-bold text-dark" style="font-size: 13px;">@GetRelativeTime(alert.CreatedAt)</span>
                                </td>
                                <td class="fw-semibold text-secondary" style="font-size: 14px; cursor: pointer;" onclick="openAlertModal('@alert.AlertId', '@Html.Raw(typeName)', '@Html.Raw(safeStore)', '@Html.Raw(safeDesc)', '@(isCashierOnly ? "" : alert.ActionUrl)', false)">
                                    @storeName
                                </td>
                                <td onclick="openAlertModal('@alert.AlertId', '@Html.Raw(typeName)', '@Html.Raw(safeStore)', '@Html.Raw(safeDesc)', '@(isCashierOnly ? "" : alert.ActionUrl)', false)" style="cursor: pointer;">
                                    <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 shadow-sm" style="font-size: 12px;">
                                        <i class="fa-solid fa-circle-exclamation me-1"></i>@typeName
                                    </span>
                                </td>
                                <td class="text-dark fw-medium text-truncate" style="max-width: 350px; font-size: 14px; cursor: pointer;" onclick="openAlertModal('@alert.AlertId', '@Html.Raw(typeName)', '@Html.Raw(safeStore)', '@Html.Raw(safeDesc)', '@(isCashierOnly ? "" : alert.ActionUrl)', false)">
                                    @alert.Description
                                </td>
                                <td class="pe-4 text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-success fw-bold rounded-pill px-3 shadow-sm"
                                            onclick="markLogAsRead(@alert.AlertId, event)"
                                            title="Mark as Read">
                                        <i class="fa-solid fa-check me-1"></i>Read
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

                <!-- READ ALERTS DIV/TBODY -->
                <tbody id="tbody-read" class="searchable-tbody d-none">
                    @if (!readAlerts.Any())
                    {
                        <tr id="emptyReadRow">
                            <td colspan="5" class="text-center py-5 bg-white">
                                <i class="fa-solid fa-box-open fa-3x text-secondary opacity-50 mb-3"></i>
                                <h5 class="fw-bold text-secondary">No Read Logs</h5>
                                <p class="text-muted small">Logs you mark as read will appear here for historical auditing.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var alert in readAlerts)
                        {
                            var typeName = alert.AlertType?.AlertTypeName ?? $"Type {alert.AlertTypeId}";
                            var storeName = alert.Retail?.RetailName ?? "System";
                            var safeDesc = alert.Description.Replace("'", "\\'");
                            var safeStore = storeName.Replace("'", "\\'");

                            <tr class="bg-light log-row" style="cursor: pointer;" onclick="openAlertModal('@alert.AlertId', '@Html.Raw(typeName)', '@Html.Raw(safeStore)', '@Html.Raw(safeDesc)', '@(isCashierOnly ? "" : alert.ActionUrl)', true)">
                                <td class="ps-4">
                                    <span class="d-block font-monospace fw-semibold text-secondary" style="font-size: 13px;">@GetRelativeTime(alert.CreatedAt)</span>
                                </td>
                                <td class="text-muted" style="font-size: 14px;">
                                    @storeName
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-3 py-2 shadow-sm" style="font-size: 12px;">
                                        @typeName
                                    </span>
                                </td>
                                <td colspan="2" class="text-muted text-truncate pe-4" style="max-width: 350px; font-size: 14px;">
                                    @alert.Description
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Security Log Modal -->
<div class="modal fade" id="alertLogModal" tabindex="-1" aria-labelledby="alertLogModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg overflow-hidden" style="border-radius: 20px;">

            <!-- Top Header -->
            <div class="modal-header text-white p-3 border-0 flex-shrink-0" style="background-color: #1162a3;">
                <h6 class="modal-title fw-bold mb-0 fs-5" id="alertLogModalLabel">
                    <i class="fa-solid fa-circle-info me-2"></i>Log Details
                </h6>
                <button type="button" data-bs-dismiss="modal" class="modal-custom-close rounded-2"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <div class="modal-body p-4">
                <!-- Readonly Location -->
                <div class="text-start mb-3">
                    <label class="custom-input-label text-secondary fw-bold small text-uppercase mb-1" style="letter-spacing: 0.5px; font-size: 11px;">Location</label>
                    <div class="form-control custom-input bg-light border-0 d-flex align-items-center" style="border-radius: 10px; padding: 10px 15px; height: auto;">
                        <span id="modalLogStore" class="fw-semibold text-dark"></span>
                    </div>
                </div>

                <!-- Readonly Alert Type -->
                <div class="text-start mb-3">
                    <label class="custom-input-label text-secondary fw-bold small text-uppercase mb-1" style="letter-spacing: 0.5px; font-size: 11px;">Alert Type</label>
                    <div class="form-control custom-input bg-light border-0 d-flex align-items-center" style="border-radius: 10px; padding: 10px 15px; height: auto;">
                        <span id="modalLogType" class="fw-bold text-primary"></span>
                    </div>
                </div>

                <!-- Readonly Description -->
                <div class="text-start mb-4">
                    <label class="custom-input-label text-secondary fw-bold small text-uppercase mb-1" style="letter-spacing: 0.5px; font-size: 11px;">Description</label>
                    <textarea class="form-control custom-input bg-light fw-medium text-dark border-0 lh-base" id="modalLogDesc" readonly rows="3" style="border-radius: 10px; padding: 12px 15px; resize: none;"></textarea>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex gap-3 mt-2">
                    <button type="button" id="btnReviewed" class="btn btn-outline-secondary rounded-pill fw-bold w-100 shadow-sm">
                        Mark as Read
                    </button>
                    <a href="#" id="modalLogActionBtn" class="btn btn-outline-primary rounded-pill fw-bold w-100 shadow-sm">
                        Take Action
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentModalAlertId = null;
        let indexAlertInterval = null;
        let isIndexUnloading = false;
        let activeIndexPollAbortController = null;

        function stopIndexAlertPolling() {
            isIndexUnloading = true;
            if (indexAlertInterval) {
                clearInterval(indexAlertInterval);
                indexAlertInterval = null;
            }
            if (activeIndexPollAbortController) {
                activeIndexPollAbortController.abort();
                activeIndexPollAbortController = null;
            }
        }

        function getIndexAntiForgeryHeaders() {
            const headers = {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            };
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenInput && tokenInput.value) {
                headers['RequestVerificationToken'] = tokenInput.value;
            }
            return headers;
        }

        document.addEventListener('DOMContentLoaded', function () {
            const logoutForm = document.getElementById('logoutForm');
            if (logoutForm) {
                logoutForm.addEventListener('submit', stopIndexAlertPolling);
            }
            indexAlertInterval = setInterval(fetchLiveIndexAlerts, 15000);
        });

        window.addEventListener('beforeunload', stopIndexAlertPolling);
        window.addEventListener('pagehide', stopIndexAlertPolling);

        // Tab Switcher
        function switchTab(tabName) {
            const tbodyUnread = document.getElementById('tbody-unread');
            const tbodyRead = document.getElementById('tbody-read');

            if (tabName === 'unread') {
                tbodyUnread.classList.remove('d-none');
                tbodyRead.classList.add('d-none');
            } else {
                tbodyUnread.classList.add('d-none');
                tbodyRead.classList.remove('d-none');
            }
            filterLogs(); // Re-apply search filter when switching tabs
        }

        // Live Client-Side Search
        function filterLogs() {
            const input = document.getElementById('logSearchInput').value.toLowerCase();
            const clearBtn = document.getElementById('clearLogSearchBtn');

            if (clearBtn) {
                clearBtn.style.display = input.trim().length > 0 ? 'block' : 'none';
            }

            const activeTbody = document.getElementById('tabUnread').checked ? document.getElementById('tbody-unread') : document.getElementById('tbody-read');
            const rows = activeTbody.getElementsByClassName('log-row');

            for (let i = 0; i < rows.length; i++) {
                const textContent = rows[i].textContent || rows[i].innerText;
                if (textContent.toLowerCase().indexOf(input) > -1) {
                    rows[i].style.display = '';
                } else {
                    rows[i].style.display = 'none';
                }
            }
        }

        function clearSearch() {
            document.getElementById('logSearchInput').value = '';
            filterLogs();
        }

        // Open Inspector Modal
        function openAlertModal(id, type, store, desc, url, isRead = false) {
            currentModalAlertId = id;

            const modalLogType = document.getElementById('modalLogType');
            if (isRead) {
                modalLogType.textContent = type;
            } else {
                modalLogType.innerHTML = `<i class="fa-solid fa-circle-exclamation me-1"></i> ${type}`;
            }

            document.getElementById('modalLogStore').innerHTML = `<i class="fa-solid fa-shop me-1 text-muted"></i> ${store}`;
            document.getElementById('modalLogDesc').value = desc;

            const actionBtn = document.getElementById('modalLogActionBtn');
            if (url && url.trim() !== "") {
                actionBtn.href = url;
                actionBtn.style.display = 'block';
            } else {
                actionBtn.style.display = 'none';
            }

            const btnReviewed = document.getElementById('btnReviewed');
            const clonedBtn = btnReviewed.cloneNode(true);
            btnReviewed.replaceWith(clonedBtn);

            clonedBtn.style.display = isRead ? 'none' : 'block';

            if (!isRead) {
                clonedBtn.addEventListener('click', function (e) {
                    markLogAsRead(currentModalAlertId, e);
                    var modalInstance = bootstrap.Modal.getInstance(document.getElementById('alertLogModal'));
                    if (modalInstance) modalInstance.hide();
                });
            }

            var modal = new bootstrap.Modal(document.getElementById('alertLogModal'));
            modal.show();
        }

        // AJAX: Mark as Read (From Index Table Button)
        async function markLogAsRead(alertId, e) {
            const evt = e || window.event;
            if (evt && evt.stopPropagation) evt.stopPropagation();

            if (isIndexUnloading) return;

            const row = document.getElementById('alert-row-' + alertId);
            if (!row) return;

            try {
                const response = await fetch(`/SecurityAlerts/MarkAsRead?alertId=${alertId}`, {
                    method: 'POST',
                    headers: getIndexAntiForgeryHeaders()
                });

                if (!response.ok || response.redirected) return;

                const contentType = response.headers.get("content-type");
                if (!contentType || !contentType.includes("application/json")) return;

                const data = await response.json();
                if (data.success) {
                    // Update Index Counters
                    let unreadCountBtn = document.getElementById('unreadCountBtn');
                    let readCountBtn = document.getElementById('readCountBtn');
                    if (unreadCountBtn && readCountBtn) {
                        unreadCountBtn.innerText = Math.max(0, parseInt(unreadCountBtn.innerText) - 1);
                        readCountBtn.innerText = parseInt(readCountBtn.innerText) + 1;
                    }

                    // Live Sync Navbar Dropdown
                    const dropdownItem = document.getElementById(`alert-item-${alertId}`);
                    if (dropdownItem) dropdownItem.remove();

                    const remaining = document.querySelectorAll('.alert-dropdown-item').length;
                    const badge = document.getElementById('alertBadge');
                    const countSpan = document.getElementById('alertCount');
                    const readAllBtn = document.getElementById('readAllBtn');

                    if (remaining === 0) {
                        if (badge) badge.remove();
                        if (readAllBtn) readAllBtn.style.display = 'none';
                        const scrollContainer = document.getElementById('alertListContainer');
                        if (scrollContainer) {
                            scrollContainer.innerHTML = `
                                <div class="dropdown-item py-4 text-muted text-center">
                                    <i class="fa-solid fa-bell-slash fa-2x mb-2 text-secondary opacity-50"></i><br />
                                    No unread alerts.
                                </div>`;
                        }
                    } else if (countSpan) {
                        countSpan.textContent = remaining > 9 ? "9+" : remaining;
                    }

                    if (typeof currentAlertCount !== 'undefined') currentAlertCount = remaining;

                    if (typeof broadcastAlertSync === "function") {
                        broadcastAlertSync(remaining, alertId, false);
                    }

                    // Animate and MOVE row from Unread to Read table
                    row.style.opacity = '0';
                    row.style.transform = 'translateX(20px)';

                    setTimeout(() => transitionRowToReadTable(row), 300);
                }
            } catch (err) {
                console.debug("Mark log as read skipped or failed:", err);
            }
        }

        // --- LIVE INDEX POLLING SYSTEM ---
        function getRelativeTimeJS(dateString) {
            const date = new Date(dateString);
            const now = new Date();
            const diffInSeconds = Math.floor((now - date) / 1000);

            if (diffInSeconds < 60) return `${diffInSeconds} seconds ago`;
            const diffInMinutes = Math.floor(diffInSeconds / 60);
            if (diffInMinutes < 60) return `${diffInMinutes} mins ago`;
            const diffInHours = Math.floor(diffInMinutes / 60);
            if (diffInHours < 24) return `${diffInHours} hrs, ${diffInMinutes % 60} mins ago`;
            const diffInDays = Math.floor(diffInHours / 24);
            if (diffInDays < 30) return `${diffInDays} days ago`;

            return date.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
        }

        async function fetchLiveIndexAlerts() {
            if (document.visibilityState !== "visible") return;
            if (isIndexUnloading) return;

            try {
                if (activeIndexPollAbortController) {
                    activeIndexPollAbortController.abort();
                }
                activeIndexPollAbortController = new AbortController();

                const response = await fetch('/SecurityAlerts/GetLiveAlerts', {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    signal: activeIndexPollAbortController.signal,
                    cache: 'no-store'
                });

                // Stop polling if unauthorized or redirected to login
                if (!response.ok || response.redirected) {
                    stopIndexAlertPolling();
                    return;
                }

                const contentType = response.headers.get("content-type");
                if (!contentType || !contentType.includes("application/json")) {
                    stopIndexAlertPolling();
                    return;
                }

                const data = await response.json();
                if (data && Array.isArray(data.alerts) && data.alerts.length > 0) {
                    const tbodyUnread = document.getElementById('tbody-unread');
                    const emptyRow = document.getElementById('emptyUnreadRow');
                    let newAlertsAdded = 0;

                    data.alerts.slice().reverse().forEach(alert => {
                        if (!document.getElementById('alert-row-' + alert.alertId)) {
                            if (emptyRow) emptyRow.remove();

                            const safeDesc = alert.description.replace(/'/g, "\\'");
                            const safeStore = alert.storeName.replace(/'/g, "\\'");
                            const typeName = alert.alertTypeName;
                            const safeUrl = (!alert.actionUrl || alert.actionUrl === '#') ? '' : alert.actionUrl;

                            const tr = document.createElement('tr');
                            tr.id = `alert-row-${alert.alertId}`;
                            tr.className = "bg-white border-start border-4 position-relative log-row";
                            tr.style.transition = "all 0.3s ease";

                            tr.innerHTML = `
                                <td class="ps-4" onclick="openAlertModal('${alert.alertId}', '${typeName}', '${safeStore}', '${safeDesc}', '${safeUrl}', false)" style="cursor: pointer;">
                                    <span class="d-block font-monospace fw-bold text-dark" style="font-size: 13px;">${getRelativeTimeJS(alert.timeString)}</span>
                                </td>
                                <td class="fw-semibold text-secondary" style="font-size: 14px; cursor: pointer;" onclick="openAlertModal('${alert.alertId}', '${typeName}', '${safeStore}', '${safeDesc}', '${safeUrl}', false)">
                                    ${alert.storeName}
                                </td>
                                <td onclick="openAlertModal('${alert.alertId}', '${typeName}', '${safeStore}', '${safeDesc}', '${safeUrl}', false)" style="cursor: pointer;">
                                    <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 shadow-sm" style="font-size: 12px;">
                                        <i class="fa-solid fa-circle-exclamation me-1"></i>${typeName}
                                    </span>
                                </td>
                                <td class="text-dark fw-medium text-truncate" style="max-width: 350px; font-size: 14px; cursor: pointer;" onclick="openAlertModal('${alert.alertId}', '${typeName}', '${safeStore}', '${safeDesc}', '${safeUrl}', false)">
                                    ${alert.description}
                                </td>
                                <td class="pe-4 text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-success fw-bold rounded-pill px-3 shadow-sm"
                                            onclick="markLogAsRead(${alert.alertId}, event)"
                                            title="Mark as Read">
                                        <i class="fa-solid fa-check me-1"></i>Read
                                    </button>
                                </td>
                            `;

                            tbodyUnread.prepend(tr);
                            newAlertsAdded++;
                        }
                    });

                    if (newAlertsAdded > 0) {
                        const unreadCountBtn = document.getElementById('unreadCountBtn');
                        let currentCount = parseInt(unreadCountBtn.innerText) || 0;
                        unreadCountBtn.innerText = currentCount + newAlertsAdded;

                        filterLogs();
                    }
                }
            } catch (err) {
                if (err.name !== 'AbortError') {
                    console.debug("Background index poll skipped:", err);
                }
            } finally {
                activeIndexPollAbortController = null;
            }
        }

        function transitionRowToReadTable(unreadRow) {
            const tbodyRead = document.getElementById('tbody-read');
            const tbodyUnread = document.getElementById('tbody-unread');
            const emptyReadRow = document.getElementById('emptyReadRow');

            if (emptyReadRow) emptyReadRow.remove();

            const cells = unreadRow.querySelectorAll('td');
            const timeText = cells[0].innerText.trim();
            const storeText = cells[1].innerText.trim();
            const typeText = cells[2].innerText.trim();
            const descText = cells[3].innerText.trim();

            const origOnClick = cells[0].getAttribute('onclick') || '';
            const readOnClick = origOnClick.replace(/,\s*false\s*\)$/, ', true)');

            const readTr = document.createElement('tr');
            readTr.className = 'bg-light log-row';
            readTr.style.cursor = 'pointer';
            readTr.setAttribute('onclick', readOnClick);

            readTr.innerHTML = `
                <td class="ps-4">
                    <span class="d-block font-monospace fw-semibold text-secondary" style="font-size: 13px;">${timeText}</span>
                </td>
                <td class="text-muted" style="font-size: 14px;">
                    ${storeText}
                </td>
                <td>
                    <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-3 py-2 shadow-sm" style="font-size: 12px;">
                        ${typeText}
                    </span>
                </td>
                <td colspan="2" class="text-muted text-truncate pe-4" style="max-width: 350px; font-size: 14px;">
                    ${descText}
                </td>
            `;

            unreadRow.remove();
            tbodyRead.prepend(readTr);

            if (tbodyUnread.querySelectorAll('.log-row').length === 0) {
                tbodyUnread.innerHTML = `
                    <tr id="emptyUnreadRow">
                        <td colspan="5" class="text-center py-5 bg-white">
                            <i class="fa-solid fa-envelope-circle-check fa-3x text-success opacity-50 mb-3"></i>
                            <h5 class="fw-bold text-secondary">All Caught Up!</h5>
                            <p class="text-muted small">You have no unread security logs.</p>
                        </td>
                    </tr>`;
            }

            filterLogs();
        }
    </script>
}