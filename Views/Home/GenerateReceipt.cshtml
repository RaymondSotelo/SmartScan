@{
    ViewData["Title"] = "Receipt";
    if (ViewData["HeaderTitle"] == null)
    {
        ViewData["HeaderTitle"] = "Receipt";
    }
}

@section Styles {
    <style>
        /* Mobile & Tablet Layout Adjustments (Desktop >= 768px stays untouched) */
        @@media (max-width: 767.98px) {
            .receipt-header-actions {
                width: 100%;
                justify-content: flex-start !important;
            }

            .receipt-zoom-bar {
                flex: 1 1 100%;
                justify-content: space-between;
            }

                .receipt-zoom-bar .custom-zoom-slider {
                    flex: 1 1 auto;
                    width: auto !important;
                    min-width: 70px;
                }

            .receipt-header-actions > button {
                flex: 1 1 auto;
                justify-content: center !important;
            }
        }

        @@media (max-width: 575.98px) {
            .receipt-paper {
                padding: 1rem !important;
            }
        }
    </style>
}

<!-- Viewport-Locked Outer Container -->
<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white mx-auto pos-viewport-card"
     style="height: calc(100dvh - 130px); min-height: 540px; max-width: 1200px;">

    <!-- Top Navigation Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex flex-wrap justify-content-between align-items-center gap-2"
         style="background-color: #1162a3;">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h5 class="mb-0 fw-bold">
                <i class="fa-solid fa-receipt me-2"></i>Transaction Receipt
            </h5>
            <!-- Dynamic Status Badge in Header -->
            <span id="headerStatusBadge" class="badge rounded-pill px-3 py-1 fw-bold shadow-sm" style="font-size: 11px;">
                <i class="fa-solid fa-circle-check me-1"></i>Completed
            </span>
        </div>

        <!-- Actions -->
        <div class="ms-md-auto d-flex flex-wrap align-items-center gap-2 receipt-header-actions">
            <!-- Horizontal Zoom Range Slider -->
            <div class="bg-white bg-opacity-25 rounded-pill d-flex align-items-center px-3 py-1 shadow-sm border border-light border-opacity-25 gap-2 receipt-zoom-bar" style="min-height: 38px;">
                <i class="fa-solid fa-magnifying-glass-minus text-white small opacity-75"></i>
                <input type="range"
                       id="zoomRangeSlider"
                       class="form-range custom-zoom-slider"
                       min="0.5"
                       max="2.0"
                       step="0.05"
                       value="1.25"
                       oninput="onZoomSliderChange(this.value)"
                       style="width: 100px; cursor: pointer;">
                <i class="fa-solid fa-magnifying-glass-plus text-white small opacity-75"></i>
                <span id="zoomLevelDisplay" class="text-white fw-bold font-monospace px-1 text-center" style="font-size: 0.85rem; min-width: 45px; cursor: default;">125%</span>
            </div>

            <!-- Customer QR Code Button (Scan to Phone without Login) -->
            <button type="button" class="btn btn-sm btn-warning rounded-pill px-3 fw-bold text-dark shadow-sm d-flex align-items-center text-nowrap"
                    style="min-height: 38px;"
                    onclick="openCustomerQrModal()"
                    title="Let customer scan QR to get receipt on their phone">
                <i class="fa-solid fa-qrcode me-2"></i>Customer QR Copy
            </button>

            <!-- Download Receipt as Image Button -->
            <button type="button" id="btnDownloadReceiptImg" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold shadow-sm d-flex align-items-center text-nowrap"
                    style="min-height: 38px;"
                    onclick="downloadReceiptAsImage()"
                    title="Save receipt as PNG image">
                <i class="fa-solid fa-download me-1"></i>Save PNG
            </button>

            <!-- New Transaction Button -->
            <button type="button" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold text-primary shadow-sm d-flex align-items-center text-nowrap"
                    style="background-color: #dbeafe; border-color: #cfe2f3 !important; min-height: 38px;"
                    onclick="startNewTransaction()">
                <i class="fa-solid fa-plus me-1"></i>New Transaction
            </button>
        </div>
    </div>

    <!-- Interior Workspace Split (Centered Column with Scrolling) -->
    <div class="card-body p-2 p-sm-3 p-lg-4 flex-grow-1 d-flex flex-column align-items-center bg-light bg-opacity-50 overflow-y-auto overflow-x-hidden no-scrollbar" style="min-height: 0;">

        <!-- Thermal POS Paper Card -->
        <div id="printableReceipt" class="receipt-paper w-100 p-4 border bg-white rounded-4 shadow-sm mx-auto mb-4"
             style="max-width: 460px; transition: transform 0.1s ease-out; transform-origin: top center; transform: scale(1.25);">

            <!-- Top Status Indicator -->
            <div class="text-end mb-2">
                <span id="receiptStatusBadge" class="badge rounded-pill px-3 py-1 fw-bold shadow-sm" style="font-size: 11px;">
                    <i class="fa-solid fa-circle-check me-1"></i>Completed
                </span>
            </div>

            <!-- Store Branding & Header -->
            <div class="text-center mb-3">
                <div class="d-inline-flex p-2 rounded-circle bg-primary bg-opacity-10 text-primary mb-1">
                    <img src="~/images/SmartScanLogo.png"
                         alt="Smart Scan Logo"
                         width="48"
                         height="48"
                         class="object-fit-contain"
                         onerror="this.style.display='none'" />
                </div>
                <h5 class="fw-bold text-uppercase mb-0 text-dark" style="letter-spacing: 0.5px; font-size: 1.15rem;">
                    SmartScan Retail
                </h5>
                <p class="text-muted small mb-1" style="font-size: 11px;">
                    Automated Vision Checkout System
                </p>
                <span class="badge rounded-pill bg-light text-secondary border fw-medium px-3 py-1" style="font-size: 10px;">
                    OFFICIAL TRANSACTION RECEIPT
                </span>
            </div>

            <div class="receipt-dashed-line"></div>

            <!-- Metadata -->
            <div class="small text-secondary mb-2" style="font-size: 12px;">
                <div class="d-flex justify-content-between gap-2 mb-1">
                    <span>Receipt #:</span>
                    <strong class="font-monospace text-dark text-end" id="receiptNumberDisplay">#REC-000000</strong>
                </div>
                <div class="d-flex justify-content-between gap-2 mb-1">
                    <span>Date &amp; Time:</span>
                    <span class="text-dark text-end" id="receiptDateDisplay">--</span>
                </div>
                <div class="d-flex justify-content-between gap-2 mb-1">
                    <span>Retail Store:</span>
                    <span class="text-dark fw-semibold text-end" id="receiptStoreDisplay">SmartScan Retail</span>
                </div>
                <div class="d-flex justify-content-between gap-2 mb-1">
                    <span>Cashier / POS:</span>
                    <span class="text-dark text-end" id="receiptCashierDisplay">@(User.Identity?.Name ?? "Main Station")</span>
                </div>
                <div class="d-flex justify-content-between gap-2 mb-1" id="receiptCustomerRow">
                    <span>Customer:</span>
                    <span class="text-dark fw-semibold text-end" id="receiptCustomerDisplay">Walk-in Guest</span>
                </div>
                <!-- Due Date Row (Strictly for Store Credits) -->
                <div class="justify-content-between gap-2" id="receiptDueDateRow" style="display: none !important;">
                    <span class="text-danger fw-bold">Due Date:</span>
                    <span class="text-danger fw-bold font-monospace text-end" id="receiptDueDateDisplay"></span>
                </div>
            </div>

            <div class="receipt-dashed-line"></div>

            <!-- Itemized Purchase List -->
            <div class="py-1">
                <div class="d-flex justify-content-between text-muted fw-bold text-uppercase mb-2" style="font-size: 11px;">
                    <span>Item Description</span>
                    <span class="text-end">Total</span>
                </div>
                <div id="receiptItemList" class="d-flex flex-column gap-2 mb-2 no-scrollbar" style="max-height: 220px; overflow-y: auto;">
                    <div class="text-center text-muted small py-3">Loading receipt items...</div>
                </div>
            </div>

            <div class="receipt-double-line"></div>

            <!-- Financial Summary -->
            <div class="small" style="font-size: 12px;">
                <div class="d-flex justify-content-between text-secondary mb-1">
                    <span>Total Quantity:</span>
                    <span class="fw-semibold text-dark" id="receiptTotalQty">0 units</span>
                </div>
                <div class="d-flex justify-content-between text-secondary mb-2">
                    <span>Subtotal:</span>
                    <span class="fw-semibold text-dark" id="receiptSubtotal">₱0.00</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2 pt-1 border-top">
                    <span class="fs-6 fw-bold text-dark">TOTAL PAID:</span>
                    <span class="fs-5 fw-bold text-success font-monospace" id="receiptGrandTotal">₱0.00</span>
                </div>

                <!-- Cash Tender Details -->
                <div id="cashDetailsSection" style="display: none;">
                    <div class="d-flex justify-content-between text-secondary mb-1">
                        <span>Amount Paid:</span>
                        <span class="fw-semibold text-dark" id="receiptAmountPaid">₱0.00</span>
                    </div>
                    <div class="d-flex justify-content-between text-secondary mb-2">
                        <span>Change:</span>
                        <span class="fw-bold text-success font-monospace" id="receiptChange">₱0.00</span>
                    </div>
                </div>

                <div class="d-flex justify-content-between text-secondary pt-1">
                    <span>Payment Tender:</span>
                    <span id="receiptPaymentMethodBadge">
                        <!-- Populated via getPaymentBadgeHtml -->
                    </span>
                </div>
            </div>

            <div class="receipt-dashed-line"></div>

            <!-- Embedded Scannable QR & Barcode Footer -->
            <div class="text-center pt-1">
                <div class="d-flex flex-column align-items-center my-2">
                    <div id="inlineReceiptQr" class="p-2 bg-white border rounded-3 shadow-sm d-inline-block"></div>
                    <span class="text-muted mt-1" style="font-size: 9.5px;">
                        <i class="fa-solid fa-camera me-1"></i>Scan with phone camera for digital copy
                    </span>
                </div>

                <div class="barcode-strip mb-2"></div>
                <span class="font-monospace small text-muted d-block mb-1" id="barcodeNumber" style="letter-spacing: 2px;">
                    *00000000*
                </span>
                <p class="small text-muted mb-0 fst-italic" style="font-size: 10px;">
                    Thank you for shopping with us!<br />
                    Verified by SmartScan Automated Vision System
                </p>
            </div>
        </div>

    </div>
</div>

<!-- VIEW C: Customer Digital Receipt QR Section (Inside Modal) -->
<div class="modal fade" id="customerQrModal" tabindex="-1" aria-labelledby="customerQrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg overflow-hidden" style="border-radius: 20px;">
            <div class="modal-header text-white p-3 border-0" style="background-color: #1162a3;">
                <h6 class="modal-title fw-bold mb-0 fs-5 pe-4" id="customerQrModalLabel">
                    <i class="fa-solid fa-qrcode me-2"></i>Customer Digital Receipt
                </h6>
                <button type="button" data-bs-dismiss="modal" class="modal-custom-close rounded-2">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body p-3 p-sm-4 bg-light text-center" id="txQrViewSection">
                <h5 class="fw-bold text-primary mb-1">Scan to Save Receipt on Phone</h5>
                <p class="fw-medium small mb-3 text-secondary">
                    Ask the customer to point their phone's camera or QR scanner at the code below.
                </p>

                <!-- Large Scannable QR Container -->
                <div class="bg-white p-3 rounded-4 shadow-sm border d-inline-flex flex-column align-items-center mb-3">
                    <div id="txModalQrContainer" class="p-1"></div>
                    <span class="font-monospace fw-bold text-dark small mt-2" id="txModalQrReceiptNum">#REC-000000</span>
                </div>

                <!-- Mode Switcher: Public Link vs Offline Text QR -->
                <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
                    <input type="radio" class="btn-check" name="txModalQrMode" id="txQrModeWeb" autocomplete="off" checked onchange="renderQrByMode('web')">
                    <label class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" for="txQrModeWeb" style="font-size: 11px;">
                        <i class="fa-solid fa-globe me-1"></i>Web e-Receipt Link
                    </label>

                    <input type="radio" class="btn-check" name="txModalQrMode" id="txQrModeText" autocomplete="off" onchange="renderQrByMode('text')">
                    <label class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold" for="txQrModeText" style="font-size: 11px;">
                        <i class="fa-solid fa-file-lines me-1"></i>Offline Text Summary
                    </label>
                </div>

                <!-- Copy Shareable Link -->
                <div class="input-group input-group-sm shadow-sm rounded-pill overflow-hidden border bg-white">
                    <input type="text" id="txModalPublicReceiptUrl" class="form-control border-0 bg-white ps-3 text-secondary small" readonly />
                    <button class="btn btn-primary px-3 fw-semibold" type="button" onclick="copyPublicReceiptLink()">
                        <i class="fa-regular fa-copy me-1"></i>Copy Link
                    </button>
                </div>
                <small id="txModalCopyToast" class="text-success fw-bold d-block mt-2" style="display: none !important; font-size: 11px;">
                    <i class="fa-solid fa-check me-1"></i>Link copied to clipboard!
                </small>

                <!-- Footer Actions -->
                <div class="bg-white rounded-4 shadow-sm border p-3 mt-3 mx-auto d-flex justify-content-center align-items-center">
                    <a id="txModalPreviewLinkBtn" href="#" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                        <i class="fa-solid fa-up-right-from-square me-1"></i>Preview Customer View
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        let currentReceiptPayload = null;
        let publicReceiptUrl = "";
        let plainTextReceiptSummary = "";

        function escapeHtml(value) {
            if (value === null || value === undefined) return "";
            const el = document.createElement("div");
            el.textContent = String(value);
            return el.innerHTML;
        }

        function getPaymentBadgeHtml(methodName) {
            const safeName = escapeHtml(methodName || 'Cash In Hand');
            const lower = safeName.toLowerCase();

            if (lower.includes("store")) {
                return `
                    <span class="badge rounded-pill fw-semibold px-2 py-1 shadow-sm"
                          style="font-size: 11px; background-color: #fff3cd; color: #856404; border: 1.5px solid #ffeeba;">
                        <i class="fa-solid fa-coins me-1"></i>${safeName}
                    </span>`;
            }
            if (lower.includes("gcash") || lower.includes("ewallet") || lower.includes("e-wallet")) {
                return `
                    <span class="badge rounded-pill fw-semibold px-2 py-1 shadow-sm text-success"
                          style="font-size: 11px; background-color: #dcfce7; border: 1.5px solid #bbf7d0;">
                        <i class="fa-solid fa-mobile-screen-button me-1"></i>${safeName}
                    </span>`;
            }
            if (lower.includes("credit")) {
                return `
                    <span class="badge rounded-pill fw-semibold px-2 py-1 shadow-sm"
                          style="font-size: 11px; background-color: #f3e8ff; color: #6b21a8; border: 1.5px solid #e9d5ff;">
                        <i class="fa-solid fa-credit-card me-1"></i>${safeName}
                    </span>`;
            }
            return `
                <span class="badge rounded-pill fw-semibold px-2 py-1 shadow-sm text-primary"
                      style="font-size: 11px; background-color: #e0f2fe; border: 1.5px solid #bae6fd;">
                    <i class="fa-solid fa-money-bill-wave me-1"></i>${safeName}
                </span>`;
        }

        function buildCustomerReceiptToken(tx, receiptNum, formattedDate, cashierName) {
            const compactData = {
                r: receiptNum,
                d: formattedDate,
                st: tx.retailName || tx.storeName || "SmartScan Retail",
                c: cashierName,
                u: tx.customerName && tx.customerName !== "Guest" ? tx.customerName : "Walk-in Guest",
                m: tx.paymentMethod || "Cash In Hand",
                s: parseInt(tx.statusId ?? (tx.status === "Pending" ? 4 : 3), 10),
                due: tx.dueDate || "",
                t: Number(tx.total || 0).toFixed(2),
                p: tx.amountPaid !== undefined ? Number(tx.amountPaid).toFixed(2) : "",
                ch: tx.change !== undefined ? Number(tx.change).toFixed(2) : "",
                i: (tx.items || []).map(item => [
                    item.name || "Product",
                    Number(item.qty) || 1,
                    Number(item.price || 0).toFixed(2)
                ])
            };
            const jsonStr = JSON.stringify(compactData);
            return btoa(encodeURIComponent(jsonStr));
        }

        function buildPlainTextSummary(tx, receiptNum, formattedDate) {
            const storeName = tx.retailName || tx.storeName || "SmartScan Retail";
            const lines = [
                storeName.toUpperCase(),
                `Receipt: ${receiptNum}`,
                `Date: ${formattedDate}`,
                "------------------------"
            ];
            if (Array.isArray(tx.items)) {
                tx.items.forEach(item => {
                    const q = Number(item.qty) || 1;
                    const p = Number(item.price) || 0;
                    lines.push(`${q}x ${item.name} - PHP ${(q * p).toFixed(2)}`);
                });
            }
            lines.push("------------------------");
            lines.push(`TOTAL: PHP ${Number(tx.total || 0).toFixed(2)}`);
            lines.push(`Tender: ${tx.paymentMethod || 'Cash'}`);
            if (tx.dueDate) lines.push(`Due Date: ${tx.dueDate}`);
            lines.push("Thank you for shopping!");
            return lines.join("\n");
        }

        document.addEventListener("DOMContentLoaded", function () {
            const initialZoom = window.innerWidth < 576 ? 0.85 : (window.innerWidth < 768 ? 0.95 : 1.25);
            const slider = document.getElementById("zoomRangeSlider");
            if (slider) slider.value = initialZoom;
            onZoomSliderChange(initialZoom);

            const urlParams = new URLSearchParams(window.location.search);
            const sharedToken = urlParams.get("d");
            let rawData = sessionStorage.getItem("smartScanLastTransaction");

            if (sharedToken && !rawData) {
                try {
                    const decoded = JSON.parse(decodeURIComponent(atob(sharedToken)));
                    rawData = JSON.stringify({
                        receiptNumber: decoded.r,
                        date: decoded.d,
                        retailName: decoded.st || "SmartScan Retail",
                        customerName: decoded.u,
                        paymentMethod: decoded.m,
                        statusId: decoded.s,
                        dueDate: decoded.due,
                        total: parseFloat(decoded.t),
                        amountPaid: decoded.p ? parseFloat(decoded.p) : undefined,
                        change: decoded.ch ? parseFloat(decoded.ch) : undefined,
                        items: (decoded.i || []).map(arr => ({ name: arr[0], qty: arr[1], price: parseFloat(arr[2]) }))
                    });
                } catch (e) {
                    console.error("Invalid digital receipt token:", e);
                }
            }

            if (!rawData) {
                alert("No recent transaction details were found.");
                window.location.href = "/Home/Checkout";
                return;
            }

            try {
                const tx = JSON.parse(rawData);
                currentReceiptPayload = tx;

                // Status Mapping (3 = Completed, 4 = Pending Settlement)
                const numericStatusId = parseInt(tx.statusId ?? (tx.status === "Pending" ? 4 : 3), 10);
                const headerBadge = document.getElementById("headerStatusBadge");
                const receiptBadge = document.getElementById("receiptStatusBadge");

                if (numericStatusId === 4) {
                    const pendingHtml = '<i class="fa-solid fa-clock me-1"></i>Pending Settlement';
                    const pendingStyle = "font-size: 11px; background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba;";

                    if (headerBadge) {
                        headerBadge.className = "badge rounded-pill px-3 py-1 fw-bold shadow-sm";
                        headerBadge.style = pendingStyle;
                        headerBadge.innerHTML = pendingHtml;
                    }
                    if (receiptBadge) {
                        receiptBadge.className = "badge rounded-pill px-3 py-1 fw-bold shadow-sm";
                        receiptBadge.style = pendingStyle;
                        receiptBadge.innerHTML = pendingHtml;
                    }
                } else {
                    const completedHtml = '<i class="fa-solid fa-circle-check me-1"></i>Completed';
                    const completedClass = "badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold shadow-sm";

                    if (headerBadge) {
                        headerBadge.className = completedClass;
                        headerBadge.style = "font-size: 11px;";
                        headerBadge.innerHTML = completedHtml;
                    }
                    if (receiptBadge) {
                        receiptBadge.className = completedClass;
                        receiptBadge.style = "font-size: 11px;";
                        receiptBadge.innerHTML = completedHtml;
                    }
                }

                // Receipt & Date Metadata
                const receiptNum = tx.receiptNumber || ("REC" + Date.now().toString().slice(-8));
                const receiptNumEl = document.getElementById("receiptNumberDisplay");
                if (receiptNumEl) receiptNumEl.textContent = receiptNum;

                const modalQrNumEl = document.getElementById("txModalQrReceiptNum");
                if (modalQrNumEl) modalQrNumEl.textContent = receiptNum;

                const barcodeEl = document.getElementById("barcodeNumber");
                if (barcodeEl) barcodeEl.textContent = `*${receiptNum.replace(/[^0-9A-Z]/gi, '')}*`;

                const parsedDate = tx.date ? new Date(tx.date) : new Date();
                const formattedDate = isNaN(parsedDate.getTime())
                    ? String(tx.date)
                    : parsedDate.toLocaleString("en-US", {
                        year: "numeric",
                        month: "short",
                        day: "2-digit",
                        hour: "numeric",
                        minute: "2-digit",
                        hour12: true
                    });
                const dateEl = document.getElementById("receiptDateDisplay");
                if (dateEl) dateEl.textContent = formattedDate;

                const storeDisplayEl = document.getElementById("receiptStoreDisplay");
                if (storeDisplayEl) {
                    storeDisplayEl.textContent = tx.retailName || tx.storeName || "SmartScan Retail";
                }

                // Customer Info
                const custName = tx.customerName && tx.customerName !== "Guest" ? tx.customerName : "Walk-in Guest";
                const custEl = document.getElementById("receiptCustomerDisplay");
                if (custEl) custEl.textContent = custName;

                // Due Date Handling (Only visible for Store Credits)
                const method = tx.paymentMethod || "Cash In Hand";
                const isStoreCredit = method.toLowerCase().includes("store");
                const rawDueDate = tx.dueDate;
                const dueDateRow = document.getElementById("receiptDueDateRow");
                const dueDateDisplay = document.getElementById("receiptDueDateDisplay");

                const hasValidDate = rawDueDate &&
                                     String(rawDueDate).trim() !== '' &&
                                     String(rawDueDate).trim() !== '--' &&
                                     String(rawDueDate).toLowerCase() !== 'null';

                if (isStoreCredit && hasValidDate) {
                    if (dueDateDisplay) dueDateDisplay.textContent = rawDueDate;
                    if (dueDateRow) dueDateRow.style.setProperty("display", "flex", "important");
                } else {
                    if (dueDateDisplay) dueDateDisplay.textContent = '';
                    if (dueDateRow) dueDateRow.style.setProperty("display", "none", "important");
                }

                // Render Itemized Rows
                const itemsContainer = document.getElementById("receiptItemList");
                itemsContainer.innerHTML = "";
                let totalUnits = 0;
                let calculatedSubtotal = 0;

                if (Array.isArray(tx.items) && tx.items.length > 0) {
                    tx.items.forEach(item => {
                        const qty = Number(item.qty) || 1;
                        const price = Number(item.price) || 0;
                        const rowTotal = qty * price;

                        totalUnits += qty;
                        calculatedSubtotal += rowTotal;

                        itemsContainer.innerHTML += `
                            <div class="d-flex justify-content-between align-items-center" style="font-size: 11px;">
                                <div class="text-truncate pe-2">
                                    <span class="fw-bold text-dark">${escapeHtml(item.name || 'Product')}</span>
                                    <small class="text-muted d-block">${qty} x ₱${price.toFixed(2)}</small>
                                </div>
                                <span class="font-monospace fw-semibold text-dark text-nowrap">₱${rowTotal.toFixed(2)}</span>
                            </div>
                        `;
                    });
                } else {
                    itemsContainer.innerHTML = `<div class="text-center text-muted small py-2">No individual items recorded.</div>`;
                }

                // Totals & Tender Details
                const grandTotal = Number(tx.total ?? calculatedSubtotal);
                document.getElementById("receiptTotalQty").textContent = `${totalUnits} units`;
                document.getElementById("receiptSubtotal").textContent = `₱${calculatedSubtotal.toFixed(2)}`;
                document.getElementById("receiptGrandTotal").textContent = `₱${grandTotal.toFixed(2)}`;

                const methodBadge = document.getElementById("receiptPaymentMethodBadge");
                if (methodBadge) {
                    methodBadge.innerHTML = getPaymentBadgeHtml(method);
                }

                // Cash specific Details
                const cashSection = document.getElementById("cashDetailsSection");
                if (method.toLowerCase().includes("cash") && tx.amountPaid !== undefined) {
                    cashSection.style.display = "block";
                    document.getElementById("receiptAmountPaid").textContent = `₱${Number(tx.amountPaid).toFixed(2)}`;
                    document.getElementById("receiptChange").textContent = `₱${Number(tx.change ?? 0).toFixed(2)}`;
                } else {
                    cashSection.style.display = "none";
                }

                // Build Customer Digital Receipt URL & Offline Text Summary
                const cashierName = document.getElementById("receiptCashierDisplay")?.textContent?.trim() || "Main Station";
                const token = buildCustomerReceiptToken(tx, receiptNum, formattedDate, cashierName);
                publicReceiptUrl = `${window.location.origin}/Home/DigitalReceipt?d=${encodeURIComponent(token)}`;
                plainTextReceiptSummary = buildPlainTextSummary(tx, receiptNum, formattedDate);

                const urlInput = document.getElementById("txModalPublicReceiptUrl");
                if (urlInput) urlInput.value = publicReceiptUrl;

                const previewBtn = document.getElementById("txModalPreviewLinkBtn");
                if (previewBtn) previewBtn.href = publicReceiptUrl;

                const isLocalhost = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
                const defaultQrContent = isLocalhost ? plainTextReceiptSummary : publicReceiptUrl;

                const qrModeTextRadio = document.getElementById("txQrModeText");
                if (isLocalhost && qrModeTextRadio) {
                    qrModeTextRadio.checked = true;
                }

                generateQrIntoElement("inlineReceiptQr", defaultQrContent, 96);
                generateQrIntoElement("txModalQrContainer", defaultQrContent, 200);

                // Broadcast receipt state to Customer Display screen if active
                localStorage.setItem("smartScanCustomerDisplay", JSON.stringify({
                    mode: "receipt",
                    receiptNumber: receiptNum,
                    total: grandTotal,
                    qrContent: defaultQrContent
                }));

            } catch (err) {
                console.error("Error loading receipt:", err);
            }
        });

        function generateQrIntoElement(elementId, textContent, sizePx) {
            const container = document.getElementById(elementId);
            if (!container || typeof QRCode === "undefined") return;
            container.innerHTML = "";
            new QRCode(container, {
                text: textContent,
                width: sizePx,
                height: sizePx,
                colorDark: "#0f172a",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.M
            });
        }

        function renderQrByMode(mode) {
            const targetContent = mode === 'text' ? plainTextReceiptSummary : publicReceiptUrl;
            generateQrIntoElement("txModalQrContainer", targetContent, 200);
            generateQrIntoElement("inlineReceiptQr", targetContent, 96);
        }

        function openCustomerQrModal() {
            const modalEl = document.getElementById("customerQrModal");
            if (!modalEl) return;
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

        function copyPublicReceiptLink() {
            const input = document.getElementById("txModalPublicReceiptUrl");
            const toast = document.getElementById("txModalCopyToast");
            if (!input) return;

            navigator.clipboard.writeText(input.value).then(() => {
                if (toast) {
                    toast.style.setProperty("display", "block", "important");
                    setTimeout(() => {
                        toast.style.setProperty("display", "none", "important");
                    }, 2500);
                }
            });
        }

        async function downloadReceiptAsImage() {
            const receiptEl = document.getElementById("printableReceipt");
            const btn = document.getElementById("btnDownloadReceiptImg");
            if (!receiptEl || typeof html2canvas === "undefined") return;

            const originalTransform = receiptEl.style.transform;
            const itemList = document.getElementById("receiptItemList");
            const originalMaxHeight = itemList ? itemList.style.maxHeight : "";

            try {
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Saving...';
                }

                receiptEl.style.transform = "scale(1)";
                if (itemList) itemList.style.maxHeight = "none";

                const canvas = await html2canvas(receiptEl, {
                    scale: 2,
                    useCORS: true,
                    backgroundColor: "#ffffff"
                });

                const receiptNum = document.getElementById("receiptNumberDisplay")?.textContent?.replace(/[^0-9A-Z-]/gi, '') || "Receipt";
                const link = document.createElement("a");
                link.download = `SmartScan-${receiptNum}.png`;
                link.href = canvas.toDataURL("image/png");
                link.click();
            } catch (err) {
                console.error("Error generating receipt image:", err);
            } finally {
                receiptEl.style.transform = originalTransform;
                if (itemList) itemList.style.maxHeight = originalMaxHeight;
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-download me-1"></i>Save PNG';
                }
            }
        }

        function startNewTransaction() {
            sessionStorage.removeItem("smartScanLastTransaction");
            sessionStorage.removeItem("smartScanCart");
            sessionStorage.removeItem("activeDebtTransactionIds");
            sessionStorage.removeItem("activeDebtPenalty");
            sessionStorage.removeItem("activeDebtDueDate");
            localStorage.removeItem("smartScanCustomerDisplay");
            window.location.href = "/Home/Checkout";
        }

        function onZoomSliderChange(val) {
            const scale = parseFloat(val);
            const receipt = document.getElementById("printableReceipt");
            const display = document.getElementById("zoomLevelDisplay");

            if (receipt) {
                receipt.style.transform = `scale(${scale})`;
            }
            if (display) {
                display.textContent = `${Math.round(scale * 100)}%`;
            }
        }
    </script>
}