@{
    ViewData["Title"] = "Receipt";
    if (ViewData["HeaderTitle"] == null)
    {
        ViewData["HeaderTitle"] = "Receipt";
    }
}

<!-- Viewport-Locked Outer Container -->
<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white mx-auto"
     style="height: calc(100dvh - 130px); min-height: 540px; max-width: 1200px;">

    <!-- Top Navigation Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex justify-content-between align-items-center"
         style="background-color: #1162a3;">
        <div class="d-flex align-items-center gap-2">
            <h5 class="mb-0 fw-bold">
                <i class="fa-solid fa-receipt me-2"></i>Transaction Receipt
            </h5>
            <!-- Dynamic Status Badge in Header -->
            <span id="headerStatusBadge" class="badge rounded-pill px-3 py-1 fw-bold ms-2 shadow-sm" style="font-size: 11px;">
                <i class="fa-solid fa-circle-check me-1"></i>Completed
            </span>
        </div>

        <!-- Actions -->
        <div class="ms-auto d-flex align-items-center gap-3">
            <!-- Horizontal Zoom Range Slider -->
            <div class="bg-white bg-opacity-25 rounded-pill d-flex align-items-center px-3 py-1 shadow-sm border border-light border-opacity-25 gap-2" style="height: 38px;">
                <i class="fa-solid fa-magnifying-glass-minus text-white small opacity-75"></i>
                <input type="range"
                       id="zoomRangeSlider"
                       class="form-range custom-zoom-slider"
                       min="0.5"
                       max="2.0"
                       step="0.05"
                       value="1.5"
                       oninput="onZoomSliderChange(this.value)"
                       style="width: 110px; cursor: pointer;">
                <i class="fa-solid fa-magnifying-glass-plus text-white small opacity-75"></i>
                <span id="zoomLevelDisplay" class="text-white fw-bold font-monospace px-1 text-center" style="font-size: 0.85rem; min-width: 45px; cursor: default;">150%</span>
            </div>

            <!-- New Transaction Button -->
            <button type="button" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold text-primary"
                    style="background-color: #dbeafe; border-color: #cfe2f3 !important; height: 38px;"
                    onclick="startNewTransaction()">
                <i class="fa-solid fa-plus me-1"></i>New Transaction
            </button>
        </div>
    </div>

    <!-- Interior Workspace Split (Centered Column with Scrolling) -->
    <div class="card-body p-3 p-lg-4 flex-grow-1 d-flex flex-column align-items-center bg-light bg-opacity-50 overflow-y-auto no-scrollbar" style="min-height: 0;">

        <!-- Thermal POS Paper Card -->
        <div id="printableReceipt" class="receipt-paper w-100 p-4 border bg-white rounded-4 shadow-sm mx-auto mb-4"
             style="max-width: 460px; transition: transform 0.1s ease-out; transform-origin: top center; transform: scale(1.5);">

            <!-- Top Status Indicator -->
            <div class="text-end mb-2">
                <span id="receiptStatusBadge" class="badge rounded-pill px-3 py-1 fw-bold shadow-sm" style="font-size: 11px;">
                    <i class="fa-solid fa-circle-check me-1"></i>Completed
                </span>
            </div>

            <!-- Store Branding & Header -->
            <div class="text-center mb-3">
                <div class="d-inline-flex p-2 rounded-circle bg-primary bg-opacity-10 text-primary mb-1">
                    <img src="~/images/SmartScanLogo.png"
                         alt="Smart Scan Logo"
                         width="48"
                         height="48"
                         class="object-fit-contain"
                         onerror="this.style.display='none'" />
                </div>
                <h5 class="fw-bold text-uppercase mb-0 text-dark" style="letter-spacing: 0.5px; font-size: 1.15rem;">
                    SmartScan Retail
                </h5>
                <p class="text-muted small mb-1" style="font-size: 11px;">
                    Automated Vision Checkout System
                </p>
                <span class="badge rounded-pill bg-light text-secondary border fw-medium px-3 py-1" style="font-size: 10px;">
                    OFFICIAL TRANSACTION RECEIPT
                </span>
            </div>

            <div class="receipt-dashed-line"></div>

            <!-- Metadata -->
            <div class="small text-secondary mb-2" style="font-size: 12px;">
                <div class="d-flex justify-content-between mb-1">
                    <span>Receipt #:</span>
                    <strong class="font-monospace text-dark" id="receiptNumberDisplay">#REC-000000</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span>Date & Time:</span>
                    <span class="text-dark" id="receiptDateDisplay">--</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span>Cashier / POS:</span>
                    <span class="text-dark">@(User.Identity?.Name ?? "Main Station")</span>
                </div>
                <div class="d-flex justify-content-between mb-1" id="receiptCustomerRow">
                    <span>Customer:</span>
                    <span class="text-dark fw-semibold" id="receiptCustomerDisplay">Walk-in Guest</span>
                </div>
                <!-- Due Date Row (Strictly for Store Credits) -->
                <div class="justify-content-between" id="receiptDueDateRow" style="display: none !important;">
                    <span class="text-danger fw-bold">Due Date:</span>
                    <span class="text-danger fw-bold font-monospace" id="receiptDueDateDisplay"></span>
                </div>
            </div>

            <div class="receipt-dashed-line"></div>

            <!-- Itemized Purchase List -->
            <div class="py-1">
                <div class="d-flex justify-content-between text-muted fw-bold text-uppercase mb-2" style="font-size: 11px;">
                    <span>Item Description</span>
                    <span class="text-end">Total</span>
                </div>
                <div id="receiptItemList" class="d-flex flex-column gap-2 mb-2 no-scrollbar" style="max-height: 220px; overflow-y: auto;">
                    <div class="text-center text-muted small py-3">Loading receipt items...</div>
                </div>
            </div>

            <div class="receipt-double-line"></div>

            <!-- Financial Summary -->
            <div class="small" style="font-size: 12px;">
                <div class="d-flex justify-content-between text-secondary mb-1">
                    <span>Total Quantity:</span>
                    <span class="fw-semibold text-dark" id="receiptTotalQty">0 units</span>
                </div>
                <div class="d-flex justify-content-between text-secondary mb-2">
                    <span>Subtotal:</span>
                    <span class="fw-semibold text-dark" id="receiptSubtotal">₱0.00</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2 pt-1 border-top">
                    <span class="fs-6 fw-bold text-dark">TOTAL PAID:</span>
                    <span class="fs-5 fw-bold text-success font-monospace" id="receiptGrandTotal">₱0.00</span>
                </div>

                <!-- Cash Tender Details -->
                <div id="cashDetailsSection" style="display: none;">
                    <div class="d-flex justify-content-between text-secondary mb-1">
                        <span>Amount Paid:</span>
                        <span class="fw-semibold text-dark" id="receiptAmountPaid">₱0.00</span>
                    </div>
                    <div class="d-flex justify-content-between text-secondary mb-2">
                        <span>Change:</span>
                        <span class="fw-bold text-success font-monospace" id="receiptChange">₱0.00</span>
                    </div>
                </div>

                <div class="d-flex justify-content-between text-secondary pt-1">
                    <span>Payment Tender:</span>
                    <span id="receiptPaymentMethodBadge">
                        <!-- Populated via getPaymentBadgeHtml -->
                    </span>
                </div>
            </div>

            <div class="receipt-dashed-line"></div>

            <!-- Footer & Barcode -->
            <div class="text-center pt-1">
                <div class="barcode-strip mb-2"></div>
                <span class="font-monospace small text-muted d-block mb-1" id="barcodeNumber" style="letter-spacing: 2px;">
                    *00000000*
                </span>
                <p class="small text-muted mb-0 fst-italic" style="font-size: 10px;">
                    Thank you for shopping with us!<br />
                    Verified by SmartScan Automated Vision System
                </p>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function escapeHtml(value) {
            if (value === null || value === undefined) return "";
            const el = document.createElement("div");
            el.textContent = String(value);
            return el.innerHTML;
        }

        function getPaymentBadgeHtml(methodName) {
            const safeName = escapeHtml(methodName || 'Cash In Hand');
            const lower = safeName.toLowerCase();

            if (lower.includes("store")) {
                return `
                    <span class="badge rounded-pill fw-semibold px-2 py-1 shadow-sm"
                          style="font-size: 11px; background-color: #fff3cd; color: #856404; border: 1.5px solid #ffeeba;">
                        <i class="fa-solid fa-coins me-1"></i>${safeName}
                    </span>
                `;
            }
            if (lower.includes("gcash") || lower.includes("ewallet") || lower.includes("e-wallet")) {
                return `
                    <span class="badge rounded-pill fw-semibold px-2 py-1 shadow-sm text-success"
                          style="font-size: 11px; background-color: #dcfce7; border: 1.5px solid #bbf7d0;">
                        <i class="fa-solid fa-mobile-screen-button me-1"></i>${safeName}
                    </span>
                `;
            }
            if (lower.includes("credit")) {
                return `
                    <span class="badge rounded-pill fw-semibold px-2 py-1 shadow-sm"
                          style="font-size: 11px; background-color: #f3e8ff; color: #6b21a8; border: 1.5px solid #e9d5ff;">
                        <i class="fa-solid fa-credit-card me-1"></i>${safeName}
                    </span>
                `;
            }
            return `
                <span class="badge rounded-pill fw-semibold px-2 py-1 shadow-sm text-primary"
                      style="font-size: 11px; background-color: #e0f2fe; border: 1.5px solid #bae6fd;">
                    <i class="fa-solid fa-money-bill-wave me-1"></i>${safeName}
                </span>
            `;
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Set default zoom to 150%
            onZoomSliderChange(1.5);

            const rawData = sessionStorage.getItem("smartScanLastTransaction");


            if (!rawData) {
                alert("No recent transaction details were found.");
                window.location.href = "/Home/Checkout";
                return;
            }

            try {
                const tx = JSON.parse(rawData);

                // Status Mapping (3 = Completed, 4 = Pending Settlement)
                const numericStatusId = parseInt(tx.statusId ?? (tx.status === "Pending" ? 4 : 3), 10);
                const headerBadge = document.getElementById("headerStatusBadge");
                const receiptBadge = document.getElementById("receiptStatusBadge");

                if (numericStatusId === 4) {
                    const pendingHtml = '<i class="fa-solid fa-clock me-1"></i>Pending Settlement';
                    const pendingStyle = "font-size: 11px; background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba;";

                    if (headerBadge) {
                        headerBadge.className = "badge rounded-pill px-3 py-1 fw-bold ms-2 shadow-sm";
                        headerBadge.style = pendingStyle;
                        headerBadge.innerHTML = pendingHtml;
                    }
                    if (receiptBadge) {
                        receiptBadge.className = "badge rounded-pill px-3 py-1 fw-bold shadow-sm";
                        receiptBadge.style = pendingStyle;
                        receiptBadge.innerHTML = pendingHtml;
                    }
                } else {
                    const completedHtml = '<i class="fa-solid fa-circle-check me-1"></i>Completed';
                    const completedClass = "badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold shadow-sm";

                    if (headerBadge) {
                        headerBadge.className = completedClass + " ms-2";
                        headerBadge.style = "font-size: 11px;";
                        headerBadge.innerHTML = completedHtml;
                    }
                    if (receiptBadge) {
                        receiptBadge.className = completedClass;
                        receiptBadge.style = "font-size: 11px;";
                        receiptBadge.innerHTML = completedHtml;
                    }
                }

                // Receipt & Date Metadata
                const receiptNum = tx.receiptNumber || ("REC" + Date.now().toString().slice(-8));
                document.getElementById("receiptNumberDisplay").textContent = receiptNum;
                document.getElementById("barcodeNumber").textContent = `*${receiptNum.replace(/[^0-9A-Z]/gi, '')}*`;

                const txDate = tx.date ? new Date(tx.date) : new Date();
                const formattedDate = txDate.toLocaleString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "2-digit",
                    hour: "numeric",
                    minute: "2-digit",
                    hour12: true
                });
                document.getElementById("receiptDateDisplay").textContent = formattedDate;

                // Customer Info
                const custName = tx.customerName && tx.customerName !== "Guest" ? tx.customerName : "Walk-in Guest";
                document.getElementById("receiptCustomerDisplay").textContent = custName;

                // Due Date Handling (Strict check: Only visible for Store Credits)
                const method = tx.paymentMethod || "Cash In Hand";
                const isStoreCredit = method.toLowerCase().includes("store");
                const rawDueDate = tx.dueDate;
                const dueDateRow = document.getElementById("receiptDueDateRow");
                const dueDateDisplay = document.getElementById("receiptDueDateDisplay");

                const hasValidDate = rawDueDate &&
                                     String(rawDueDate).trim() !== '' &&
                                     String(rawDueDate).trim() !== '--' &&
                                     String(rawDueDate).toLowerCase() !== 'null';

                if (isStoreCredit && hasValidDate) {
                    if (dueDateDisplay) dueDateDisplay.textContent = rawDueDate;
                    if (dueDateRow) dueDateRow.style.setProperty("display", "flex", "important");
                } else {
                    if (dueDateDisplay) dueDateDisplay.textContent = '';
                    if (dueDateRow) dueDateRow.style.setProperty("display", "none", "important");
                }

                // Render Itemized Rows
                const itemsContainer = document.getElementById("receiptItemList");
                itemsContainer.innerHTML = "";
                let totalUnits = 0;
                let calculatedSubtotal = 0;

                if (Array.isArray(tx.items) && tx.items.length > 0) {
                    tx.items.forEach(item => {
                        const qty = Number(item.qty) || 1;
                        const price = Number(item.price) || 0;
                        const rowTotal = qty * price;

                        totalUnits += qty;
                        calculatedSubtotal += rowTotal;

                        itemsContainer.innerHTML += `
                            <div class="d-flex justify-content-between align-items-center" style="font-size: 11px;">
                                <div class="text-truncate pe-2">
                                    <span class="fw-bold text-dark">${escapeHtml(item.name || 'Product')}</span>
                                    <small class="text-muted d-block">${qty} x ₱${price.toFixed(2)}</small>
                                </div>
                                <span class="font-monospace fw-semibold text-dark text-nowrap">₱${rowTotal.toFixed(2)}</span>
                            </div>
                        `;
                    });
                } else {
                    itemsContainer.innerHTML = `<div class="text-center text-muted small py-2">No individual items recorded.</div>`;
                }

                // Totals & Tender Details
                const grandTotal = Number(tx.total ?? calculatedSubtotal);
                document.getElementById("receiptTotalQty").textContent = `${totalUnits} units`;
                document.getElementById("receiptSubtotal").textContent = `₱${calculatedSubtotal.toFixed(2)}`;
                document.getElementById("receiptGrandTotal").textContent = `₱${grandTotal.toFixed(2)}`;

                // Tender Badge
                const methodBadge = document.getElementById("receiptPaymentMethodBadge");
                if (methodBadge) {
                    methodBadge.innerHTML = getPaymentBadgeHtml(method);
                }

                // Cash specific Details
                const cashSection = document.getElementById("cashDetailsSection");
                if (method.toLowerCase().includes("cash") && tx.amountPaid !== undefined) {
                    cashSection.style.display = "block";
                    document.getElementById("receiptAmountPaid").textContent = `₱${Number(tx.amountPaid).toFixed(2)}`;
                    document.getElementById("receiptChange").textContent = `₱${Number(tx.change ?? 0).toFixed(2)}`;
                } else {
                    cashSection.style.display = "none";
                }

            } catch (err) {
                console.error("Error loading receipt:", err);
            }
        });

        function startNewTransaction() {
            sessionStorage.removeItem("smartScanLastTransaction");
            sessionStorage.removeItem("smartScanCart");
            sessionStorage.removeItem("activeDebtTransactionIds");
            sessionStorage.removeItem("activeDebtPenalty");
            sessionStorage.removeItem("activeDebtDueDate");
            localStorage.removeItem("smartScanCustomerDisplay");
            window.location.href = "/Home/Checkout";
        }

        // ================= HORIZONTAL ZOOM CONTROLS =================
        function onZoomSliderChange(val) {
            const scale = parseFloat(val);
            const receipt = document.getElementById("printableReceipt");
            const display = document.getElementById("zoomLevelDisplay");

            if (receipt) {
                receipt.style.transform = `scale(${scale})`;
            }
            if (display) {
                display.textContent = `${Math.round(scale * 100)}%`;
            }
        }
    </script>
}