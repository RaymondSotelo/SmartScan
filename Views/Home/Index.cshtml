@{
    ViewData["Title"] = "Home Page";
    if (ViewData["HeaderTitle"] == null)
    {
        ViewData["HeaderTitle"] = "Dashboard";
    }
}

<div class="card shadow border-0 rounded-4 d-flex flex-column mt-2 mt-md-3 bg-white p-4"
     style="height: calc(100dvh - 130px); min-height: 540px;">
    <div class="d-flex align-items-center gap-2 mb-3">
        <i class="fa-solid fa-home fs-4 text-primary"></i>
        <h4 class="mb-0 fw-bold text-primary">Dashboard</h4>
    </div>
    <div class="alert alert-light border rounded-3 p-3">
        <p class="mb-0 text-secondary">Welcome to SmartScan. Select a module from the navigation to begin.</p>
    </div>
</div>