@section Scripts {
    <script>
        let overviewPlayedOnce = false;

        document.addEventListener("DOMContentLoaded", function () {
            const wrapper = document.getElementById("homeScrollWrapper");
            if (wrapper && wrapper.parentElement) {
                wrapper.parentElement.style.overflow = "hidden";
                wrapper.parentElement.style.minHeight = "0";
            }

            // Scroll-reveal observer scoped to #homeScrollWrapper (plays once per section)
            const observerOptions = {
                root: wrapper,
                threshold: 0.15
            };

            const sectionObserver = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (!entry.isIntersecting) return;

                    const target = entry.target;

                    // 1. System Overview (Plays ONCE on initial page access; switching tabs won't replay)
                    if (target.id === "showcaseCashierSection" && !overviewPlayedOnce) {
                        overviewPlayedOnce = true;
                        target.querySelectorAll(".overview-anim-item").forEach(card => {
                            const animClass = card.dataset.anim;
                            const delay = parseInt(card.dataset.delay || "0", 10);
                            setTimeout(() => {
                                card.classList.remove("anim-hidden");
                                card.classList.add(animClass);
                            }, delay);
                        });
                        // Immediately reveal Admin tab items without animation so switching tabs is instant
                        document.querySelectorAll("#showcaseAdminSection .overview-anim-item").forEach(card => {
                            card.classList.remove("anim-hidden");
                        });
                    }

                    // 2. Core System Capabilities (Inverse Pop: 1 -> 2&4 -> 3&5 -> 6 at halfway shrink)
                    if (target.id === "coreCapabilitiesGrid") {
                        target.querySelectorAll(".core-pop-card").forEach(card => {
                            const delay = parseInt(card.dataset.delay || "0", 10);
                            setTimeout(() => {
                                card.classList.remove("anim-hidden");
                                card.classList.add("anim-inverse-pop");
                            }, delay);
                        });
                    }

                    // 3. AI Pipeline (Fade Slide Right: Step 1 -> 2 -> 3 -> 4)
                    if (target.id === "aiPipelineGrid") {
                        target.querySelectorAll(".ai-step-card").forEach(card => {
                            const delay = parseInt(card.dataset.delay || "0", 10);
                            setTimeout(() => {
                                card.classList.remove("anim-hidden");
                                card.classList.add("anim-fade-right");
                            }, delay);
                        });
                    }

                    // 4. Capstone Team (Fade Slide Down: Project Manager -> Tester)
                    if (target.id === "teamGrid") {
                        target.querySelectorAll(".team-down-card").forEach(card => {
                            const delay = parseInt(card.dataset.delay || "0", 10);
                            setTimeout(() => {
                                card.classList.remove("anim-hidden");
                                card.classList.add("anim-fade-down");
                            }, delay);
                        });
                    }

                    observer.unobserve(target);
                });
            }, observerOptions);

            ["showcaseCashierSection", "coreCapabilitiesGrid", "aiPipelineGrid", "teamGrid"].forEach(id => {
                const el = document.getElementById(id);
                if (el) sectionObserver.observe(el);
            });
        });

        // Tab Section Switcher 
        function switchOverviewRole(role) {
            const pill = document.getElementById("overviewTogglePill");
            const btnCashier = document.getElementById("btnToggleCashier");
            const btnAdmin = document.getElementById("btnToggleAdmin");
            const cashierSection = document.getElementById("showcaseCashierSection");
            const adminSection = document.getElementById("showcaseAdminSection");

            if (!pill || !btnCashier || !btnAdmin || !cashierSection || !adminSection) return;

            if (role === "admin") {
                pill.style.transform = "translateX(100%)";
                btnCashier.style.color = "#1162a3";
                btnAdmin.style.color = "#ffffff";

                cashierSection.classList.remove("d-flex");
                cashierSection.classList.add("d-none");

                adminSection.classList.remove("d-none");
                adminSection.classList.add("d-flex");
            } else {
                pill.style.transform = "translateX(0%)";
                btnCashier.style.color = "#ffffff";
                btnAdmin.style.color = "#1162a3";

                adminSection.classList.remove("d-flex");
                adminSection.classList.add("d-none");

                cashierSection.classList.remove("d-none");
                cashierSection.classList.add("d-flex");
            }
        }
    </script>
