        async function finalizeTransaction(method, amountPaid, changeAmount) {
            const resolvedCustomerId = liveCustomerId > 0 ? liveCustomerId : 0;
            const activeDebtIds = sessionStorage.getItem("activeDebtTransactionIds");
            const debtPenalty = parseFloat(sessionStorage.getItem("activeDebtPenalty") || "0");

            // Build items list
            const finalItems = cart.map(i => ({
                name: i.name,
                qty: parseInt(i.qty),
                price: parseFloat(i.price)
            }));

            // If there's an overdue penalty on debt settlement, append as a receipt line item
            if (debtPenalty > 0) {
                finalItems.push({
                    name: "Overdue Late Fee (5%)",
                    qty: 1,
                    price: debtPenalty
                });
            }

            const payload = {
                items: finalItems,
                total: parseFloat(total),
                paymentMethod: method,
                customerName: verifiedCustomerName || "Guest",
                customerId: resolvedCustomerId,
                debtTransactionIds: activeDebtIds ? JSON.parse(activeDebtIds) : null
            };

            const activeModal = document.querySelector('.modal.show');
            const btn = activeModal ? activeModal.querySelector('.btn-proceed') : null;
            if (btn) {
                btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Processing...';
                btn.disabled = true;
            }

            try {
                const response = await fetch('/Home/SaveTransaction', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();

                if (result.success) {
                    sessionStorage.setItem("smartScanLastTransaction", JSON.stringify(payload));

                    // Broadcast to ALL open/duplicated tabs to wipe smartScanCart & activeDebtTransactionIds
                    window.SmartScanTabGuard.broadcastTransactionCompleted();
                    window.location.href = "/Home/GenerateReceipt";

                    payload.date = new Date().toISOString();
                    payload.status = "Completed";
                    payload.receiptNumber = result.receiptNumber;
                    payload.amountPaid = amountPaid;
                    payload.change = changeAmount;
                    payload.dueDate = result.dueDate || null;

                    // Reset In-Memory Variables
                    liveCustomerId = 0;
                    liveStoreCreditLimit = 0;
                    liveAvailableBalance = 0;

                    // Clear Hidden Input
                    const hiddenCustInput = document.getElementById("savedCustomerId");
                    if (hiddenCustInput) hiddenCustInput.value = "";

                    // Clear Storage Keys
                    sessionStorage.removeItem("smartScanCart");
                    sessionStorage.removeItem("activeDebtTransactionIds");
                    sessionStorage.removeItem("activeDebtPenalty");
                    sessionStorage.removeItem("activeDebtDueDate");
                    sessionStorage.removeItem("verifiedCustomerId");
                    sessionStorage.removeItem("verifiedCustomerName");
                    sessionStorage.removeItem("verificationRedirect");
                    sessionStorage.removeItem("verificationReason");
                    sessionStorage.removeItem("customerAgeVerified");

                    // Force Reset Customer Facing Display to Empty State
                    localStorage.setItem("smartScanCustomerDisplay", JSON.stringify({
                        customerName: "",
                        items: [],
                        total: 0
                    }));
                    localStorage.removeItem("smartScanCustomerDisplay");

                    // Check if we were settling a debt
                    if (activeDebtIds) {
                        const customerDisplayName = verifiedCustomerName && verifiedCustomerName.trim() !== ""
                            ? `${verifiedCustomerName}'s`
                            : "the customer's";

                        Swal.fire({
                            icon: 'success',
                            title: 'Debt Settled',
                            text: `Debt has been successfully payed and ${customerDisplayName} current debt has been reset.`,
                            confirmButtonColor: '#1162a3',
                            allowOutsideClick: false
                        }).then(() => {
                            // Redirect using replace to prevent back-navigation to the paid session
                            window.location.replace("/Home/Checkout");
                        });
                    } else {
                        sessionStorage.setItem("smartScanLastTransaction", JSON.stringify(payload));
                        window.location.href = "/Home/GenerateReceipt";
                    }
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Transaction Failed',
                        text: result.message || 'Could not complete transaction.',
                        confirmButtonColor: '#1162a3'
                    });
                    if (btn) { btn.innerHTML = "Proceed"; btn.disabled = false; }
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Network Error',
                    text: 'Could not connect to the database.',
                    confirmButtonColor: '#1162a3'
                });
                if (btn) { btn.innerHTML = "Proceed"; btn.disabled = false; }
            }
        }

        function cancelAndReturn() {
            sessionStorage.removeItem("verifiedCustomerId");
            sessionStorage.removeItem("verifiedCustomerName");
            sessionStorage.removeItem("verificationRedirect");
            sessionStorage.removeItem("verificationReason");
            sessionStorage.removeItem("activeDebtTransactionIds");
            sessionStorage.removeItem("activeDebtPenalty");
            sessionStorage.removeItem("activeDebtDueDate");
            sessionStorage.removeItem("customerAgeVerified");
            window.location.href = "/Home/Checkout";
        }

        function calculateChange() {
            const amountInput = document.getElementById('cashAmountReceived');
            // Strip '-', '+', or any non-digit/decimal characters if pasted
            if (amountInput && /[^0-9.]/.test(amountInput.value)) {
                amountInput.value = amountInput.value.replace(/[^0-9.]/g, '');
            }

            const rawDue = document.getElementById('cashTotalDue').value.replace(/[^0-9.-]+/g, "");
            const totalDue = parseFloat(rawDue) || Math.round(total);
            const amountReceived = parseFloat(amountInput.value) || 0;
            const change = amountReceived - totalDue;
            const displayChange = change > 0 ? change : 0;
            document.getElementById('cashChange').value = "₱ " + displayChange.toFixed(2);
        }

        // if a cashier switches back to an older duplicated tab after completing payment in another tab,
        // it immediately detects the cleared cart and redirects to /Home/Checkout
        document.addEventListener("visibilitychange", function () {
            if (document.visibilityState === "visible" && window.SmartScanTabGuard.isPrimary()) {
                const currentCart = JSON.parse(sessionStorage.getItem("smartScanCart") || "[]");
                if (!Array.isArray(currentCart) || currentCart.length === 0) {
                    window.location.replace("/Home/Checkout");
                }
            }
        });
    </script>
}