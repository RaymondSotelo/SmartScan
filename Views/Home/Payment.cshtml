@{
    ViewData["Title"] = "Payment Page";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(0deg, #95CCDD 0%);
            background-repeat: no-repeat;
            background-size: cover;
            height: 100vh;
        }

        .pay-btn {
            height: 80px;
            font-weight: bold;
            color: white;
            border-radius: 10px;
            border: none;
            font-size: 1rem;
            transition: transform 0.1s ease-in-out;
        }

            .pay-btn:active {
                transform: scale(0.95);
            }

        .btn-cash {
            background-color: #3498db;
        }

        .btn-credit {
            background-color: #9b59b6;
        }

        .btn-ewallet {
            background-color: #2ecc71;
        }

        .btn-store {
            background-color: #f1c40f;
            color: #333;
        }
    </style>
}

<div class="container mt-5">
    <div class="row g-4 justify-content-center" style="height: 70vh;">

        <!-- Left Panel: Transaction Summary -->
        <div class="col-md-5 d-flex flex-column">
            <div class="card shadow-sm border-0 flex-grow-1">
                <div class="card-header text-white fw-bold p-3" style="background-color: #1b6ec2;">
                    <i class="fa-solid fa-receipt me-2"></i> Transaction Summary
                </div>
                <div class="card-body d-flex flex-column bg-white">
                    <div class="table-responsive flex-grow-1" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-striped table-sm align-middle" style="font-size: 0.9rem;">
                            <thead class="table-light text-muted">
                                <tr>
                                    <th>Product Name</th>
                                    <th>Qty</th>
                                    <th>Unit Price</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody id="summaryList">
                                <!-- JavaScript will load the items here -->
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-end">
                        <h5 class="mb-0 text-muted fw-bold">Grand Total Due:</h5>
                        <h3 class="mb-0 fw-bold text-dark" id="grandTotalDisplay">PHP 0.00</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Panel: Payment Method -->
        <div class="col-md-5 d-flex flex-column">
            <div class="card shadow-sm border-0 flex-grow-1">
                <div class="card-header text-white fw-bold p-3" style="background-color: #1b6ec2;">
                    <i class="fa-solid fa-money-bill-wave me-2"></i> Payment Method
                </div>
                <div class="card-body d-flex flex-column bg-white">
                    <h6 class="fw-bold mb-4 text-center">Select Payment Method</h6>

                    <div class="row g-3 mb-4 flex-grow-1 align-content-start">
                        <div class="col-6">
                            <button class="w-100 pay-btn btn-cash shadow-sm" onclick="selectPayment('Cash')">CASH IN HAND</button>
                        </div>
                        <div class="col-6">
                            <button class="w-100 pay-btn btn-credit shadow-sm" onclick="selectPayment('Credit Card')">CREDIT CARD</button>
                        </div>
                        <div class="col-6">
                            <button class="w-100 pay-btn btn-ewallet shadow-sm" onclick="selectPayment('E-Wallet')">E-WALLET</button>
                        </div>
                        <div class="col-6">
                            <button class="w-100 pay-btn btn-store shadow-sm" onclick="selectPayment('Store Credits')">STORE CREDITS</button>
                        </div>
                    </div>

                    <!-- Logic Step 2: Cancel redirects back -->
                    <button class="btn btn-danger w-100 py-3 fw-bold mt-auto shadow-sm" style="border-radius: 10px; font-size: 1.1rem;" onclick="cancelAndReturn()">
                        CANCEL & RETURN
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const summaryList = document.getElementById("summaryList");
            const grandTotalDisplay = document.getElementById("grandTotalDisplay");

            // Retrieve the saved cart data from the previous page
            const cartData = sessionStorage.getItem("smartScanCart");
            let currentTotal = 0;

            if (cartData) {
                const cart = JSON.parse(cartData);
                let htmlOutput = "";

                cart.forEach(item => {
                    const subtotal = item.price * item.qty;
                    currentTotal += subtotal;

                    htmlOutput += `
                        <tr>
                            <td class="fw-semibold">${item.name}</td>
                            <td>${item.qty}</td>
                            <td>PHP ${item.price.toFixed(2)}</td>
                            <td class="fw-bold text-success">PHP ${subtotal.toFixed(2)}</td>
                        </tr>
                    `;
                });

                summaryList.innerHTML = htmlOutput;
            } else {
                summaryList.innerHTML = "<tr><td colspan='4' class='text-center text-danger py-4 fw-bold'>Error: Cart data lost. Please return to checkout.</td></tr>";
            }

            // Display Final Total
            grandTotalDisplay.innerText = `PHP ${currentTotal.toFixed(2)}`;
        });

        // Logic Steps 1.1, 1.2, 1.3
        function selectPayment(method) {
            alert(`Redirecting to ${method} process... (Screen 7 / 8)`);
            // Future logic: window.location.href = `/Home/ProcessPayment?method=${method}`;
        }

        // Logic Step 2
        function cancelAndReturn() {
            // Send cashier back to the scanning screen
            window.location.href = "/Home/Checkout";
        }
    </script>
}