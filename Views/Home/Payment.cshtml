@{
    ViewData["Title"] = "Payment";
    if (ViewData["HeaderTitle"] == null)
    {
        ViewData["HeaderTitle"] = "Checkout";
    }
}

<!-- Viewport-Locked Outer Container -->
<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white mx-auto"
     style="height: calc(100dvh - 130px); min-height: 540px; max-width: 1200px;">

    <!-- Top Navigation Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex justify-content-between align-items-center"
         style="background-color: #1162a3;">
        <div class="d-flex align-items-center gap-2">
            <h5 class="mb-0 fw-bold">
                <i class="fa-solid fa-money-check-dollar me-2"></i>Payment Processing
            </h5>
            @if (ViewData["CustomerName"] != null)
            {
                <span class="badge bg-light text-primary border rounded-pill px-3 ms-2">
                    <i class="fa-solid fa-user me-1"></i> @ViewData["CustomerName"]
                </span>
            }
        </div>

        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold text-primary"
                style="background-color: #dbeafe; border-color: #cfe2f3 !important;"
                onclick="cancelAndReturn()">
            <i class="fa-solid fa-arrow-left me-1"></i>Cancel & Return
        </button>
    </div>

    <!-- Interior Workspace Split -->
    <div class="card-body p-3 px-lg-4 pb-lg-4 pt-3 flex-grow-1 d-flex flex-column bg-light bg-opacity-50 overflow-hidden" style="min-height: 0;">
        <div class="row gx-4 gy-3 flex-grow-1 h-100">

            <!-- ================= LEFT COLUMN | Transaction Summary ================= -->
            <div class="col-12 col-lg-6 d-flex flex-column h-100 p-0 pe-lg-2 pb-3">
                <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden flex-grow-1 d-flex flex-column h-100">

                    <!-- Header -->
                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center flex-shrink-0">
                        <h4 class="fw-bold mb-0" style="color: #1162a3;">
                            <i class="fa-solid fa-receipt me-2"></i>Order Summary
                        </h4>
                    </div>

                    <!-- Table Container -->
                    <div class="card-body p-0 flex-grow-1 overflow-y-auto no-scrollbar">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light sticky-top shadow-sm">
                                <tr>
                                    <th class="ps-4 py-3 text-secondary text-uppercase fw-bold" style="font-size: 12px;">Product</th>
                                    <th class="py-3 text-center text-secondary text-uppercase fw-bold" style="font-size: 12px; width: 80px;">Qty</th>
                                    <th class="py-3 text-end text-secondary text-uppercase fw-bold" style="font-size: 12px; width: 120px;">Price</th>
                                    <th class="pe-4 py-3 text-end text-secondary text-uppercase fw-bold" style="font-size: 12px; width: 140px;">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody id="summaryList">
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">Loading items...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Grand Total Footer -->
                    <div class="card-footer bg-white border-top p-4 flex-shrink-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-uppercase text-secondary fw-bold d-block" style="font-size: 13px; letter-spacing: 1px;">Amount Due</span>
                            </div>
                            <div class="text-end">
                                <span id="grandTotalDisplay" class="fw-bold font-monospace" style="font-size: 2.0rem; color: #1162a3; line-height: 1;">
                                    ₱0.00
                                </span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ================= RIGHT COLUMN | Payment Methods ================= -->
            <div class="col-12 col-lg-6 d-flex flex-column h-100 p-0 ps-lg-2 pb-3">
                <div class="card border-0 shadow-sm rounded-4 bg-white flex-grow-1 d-flex flex-column p-4 h-100">

                    <h5 class="fw-bold text-dark mb-4 text-center">How would you like to pay?</h5>

                    <div class="pay-btn-grid mb-auto">
                        <!-- Cash -->
                        <button class="pay-btn-modern btn-cash" onclick="openModal('cashModal')">
                            <i class="fa-solid fa-money-bill-wave"></i>
                            <span>Cash in Hand</span>
                        </button>

                        <!-- Credit Card -->
                        <button class="pay-btn-modern btn-credit" onclick="openModal('creditModal')">
                            <i class="fa-solid fa-credit-card"></i>
                            <span>Credit Card</span>
                        </button>

                        <!-- E-Wallet -->
                        <button class="pay-btn-modern btn-ewallet" onclick="openModal('ewalletModal')">
                            <i class="fa-solid fa-mobile-screen-button"></i>
                            <span>E-Wallet</span>
                        </button>

                        <!-- Store Credits -->
                        <button class="pay-btn-modern btn-store" onclick="openModal('storeCreditModal')">
                            <i class="fa-solid fa-coins"></i>
                            <span>Store Credits</span>
                        </button>
                    </div>

                    <div class="alert alert-light border small text-muted mt-4 mb-0 py-3 text-center rounded-3">
                        <i class="fa-solid fa-shield-check text-success me-1"></i> All transactions are secure and encrypted.
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- ================= MODALS ================= -->
<!-- Cash In Hand Modal -->
<div class="modal fade" id="cashModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content position-relative p-2">
            <button type="button" data-bs-dismiss="modal" class="modal-custom-close rounded-2"><i class="fa-solid fa-xmark"></i></button>
            <div class="modal-body text-center p-4">
                <h3 class="modal-title-custom">Cash Payment</h3>
                <p class="modal-subtitle fw-medium mb-4">Enter the amount received from the customer.</p>

                <!-- Total Due (Disabled) -->
                <div class="text-start mb-3">
                    <label class="custom-input-label text-secondary">Total Due</label>
                    <input type="text" class="form-control custom-input fs-5 text-primary text-end font-monospace" id="cashTotalDue" readonly>
                </div>

                <!-- Amount Received -->
                <div class="text-start mb-4">
                    <label class="custom-input-label">Amount Received</label>
                    <div class="input-group shadow-sm rounded-3 overflow-hidden border bg-white cash-focus-group">
                        <span class="input-group-text bg-white border-0 fw-bold text-secondary ps-3 py-2 fs-5">₱</span>
                        <input id="cashAmountReceived"
                               class="form-control border-0 bg-white shadow-none fs-5 text-end font-monospace pe-3 ps-0 fw-semibold py-2"
                               type="number"
                               step="0.01"
                               min="0.01"
                               onwheel="this.blur()"
                               placeholder="0.00">
                    </div>
                </div>

                <button type="button" class="btn w-100 btn-proceed shadow-sm" onclick="proceedCashPayment()">Complete Transaction</button>
            </div>
        </div>
    </div>
</div>

<!-- Credit Card Modal -->
<div class="modal fade" id="creditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 450px;">
        <div class="modal-content position-relative p-2">
            <button type="button" data-bs-dismiss="modal" class="modal-custom-close rounded-2"><i class="fa-solid fa-xmark"></i></button>
            <div class="modal-body text-center p-4">
                <h3 class="modal-title-custom">Credit Card</h3>
                <p class="modal-subtitle mb-4 fw-medium">Swipe, insert, or enter card details.</p>

                <!-- Card Number -->
                <div class="text-start mb-3">
                    <label class="custom-input-label">Card Number</label>
                    <div class="input-group shadow-sm rounded-3 overflow-hidden border bg-white custom-focus-group">
                        <span class="input-group-text bg-white border-0 text-muted ps-3 py-2">
                            <i class="fa-regular fa-credit-card"></i>
                        </span>
                        <input type="text"
                               class="form-control border-0 bg-white shadow-none font-monospace ps-2 py-2"
                               id="ccNumber"
                               inputmode="numeric"
                               maxlength="19"
                               placeholder="0000 0000 0000 0000">
                    </div>
                </div>

                <!-- Cardholder Name -->
                <div class="text-start mb-3">
                    <label class="custom-input-label">Cardholder Name</label>
                    <input type="text"
                           class="form-control custom-input text-uppercase"
                           id="ccName"
                           maxlength="50"
                           placeholder="Full Name on Card" />
                </div>

                <div class="row mb-4 g-3">
                    <!-- Expiry Date -->
                    <div class="col-6 text-start">
                        <label class="custom-input-label">Expiry Date</label>
                        <input type="text"
                               class="form-control custom-input font-monospace"
                               id="ccExpiry"
                               inputmode="numeric"
                               maxlength="5"
                               placeholder="MM/YY">
                    </div>

                    <!-- CVV / CVC -->
                    <div class="col-6 text-start">
                        <label class="custom-input-label">CVV / CVC</label>
                        <input type="password"
                               class="form-control custom-input font-monospace"
                               id="ccCvv"
                               inputmode="numeric"
                               placeholder="***"
                               maxlength="4">
                    </div>
                </div>

                <button type="button" class="btn w-100 btn-proceed shadow-sm" onclick="proceedCreditCard()">Process Card</button>
            </div>
        </div>
    </div>
</div>

<!-- Store Credits Modal -->
<div class="modal fade" id="storeCreditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content position-relative p-2">
            <button type="button" data-bs-dismiss="modal" class="modal-custom-close rounded-2"><i class="fa-solid fa-xmark"></i></button>
            <div class="modal-body text-center p-4">
                <h3 class="modal-title-custom">Store Credits</h3>
                <p class="modal-subtitle mb-4 fw-medium">Pay using accumulated customer loyalty points.</p>

                <!-- Store Balance -->
                <div class="text-start mb-3 p-3 bg-light rounded-3 border">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted fw-bold small text-uppercase">Available Balance</span>
                        <span class="badge bg-danger">Max ₱300.00</span>
                    </div>
                    <h4 class="mb-0 fw-bold text-dark font-monospace" id="storeBalance">₱109.00</h4>
                </div>

                <!-- Total Due -->
                <div class="text-start mb-4">
                    <label class="custom-input-label text-secondary">Total Due</label>
                    <input type="text" class="form-control custom-input fs-5 text-primary text-end font-monospace" id="storeTotalDue" readonly>
                </div>

                <!-- Error Display -->
                <div id="storeCreditError" class="alert alert-danger py-2 px-3 text-start mb-4 shadow-sm" style="display: none; font-size: 0.85rem; font-weight: bold; border-left: 4px solid #dc3545;">
                    <i class="fa-solid fa-circle-exclamation me-1"></i> <span id="storeCreditErrorText"></span>
                </div>

                <button type="button" class="btn w-100 btn-proceed shadow-sm" onclick="proceedStoreCredit()">Apply Credits</button>
            </div>
        </div>
    </div>
</div>

<!-- E-Wallet Selection Modal -->
<div class="modal fade" id="ewalletModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 380px;">
        <div class="modal-content position-relative p-2">
            <button type="button" data-bs-dismiss="modal" class="modal-custom-close rounded-2"><i class="fa-solid fa-xmark"></i></button>
            <div class="modal-body text-center p-4">
                <h3 class="modal-title-custom">E-Wallet</h3>
                <p class="modal-subtitle mb-4 fw-medium">Select an e-wallet provider to generate a QR.</p>

                <button class="w-100 ewallet-option-btn d-flex align-items-center shadow-sm" onclick="openGCashQR()">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/5/52/GCash_logo.svg" alt="GCash" height="24" class="me-3">
                    <span class="fs-5">GCash App</span>
                    <i class="fa-solid fa-chevron-right ms-auto text-muted"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- GCash QR Modal -->
<div class="modal fade" id="gcashQRModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 380px;">
        <div class="modal-content gcash-modal-content position-relative border-0 shadow-lg">
            <button type="button" data-bs-dismiss="modal" class="modal-custom-close rounded-2" style="border: none;"><i class="fa-solid fa-xmark"></i></button>
            <div class="modal-body text-center p-2 mt-2">
                <img src="https://upload.wikimedia.org/wikipedia/commons/5/52/GCash_logo.svg" alt="GCash" height="30" class="mb-3" style="filter: brightness(0) invert(1);">
                <p class="mb-4 text-white text-opacity-75 fw-medium" style="font-size: 0.95rem;">Ask customer to scan the QR code using their GCash App to pay.</p>

                <div class="bg-white p-4 d-inline-block rounded-4 shadow mb-4 cursor-pointer transition-all hover-scale" onclick="simulateGCashSuccess()" title="Click to simulate successful scan">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/d/d0/QR_code_for_mobile_English_Wikipedia.svg" width="180" height="180" alt="QR Code" />
                </div>

                <h2 class="fw-bold text-white mb-0 font-monospace" id="gcashTotalAmount">₱0.00</h2>
                <small class="text-white text-opacity-50">Amount to send</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
            document.addEventListener("DOMContentLoaded", function () {
            const ccNumberInput = document.getElementById('ccNumber');
            const ccNameInput = document.getElementById('ccName');
            const ccExpiryInput = document.getElementById('ccExpiry');
            const ccCvvInput = document.getElementById('ccCvv');

            // Card Number: Digits only, max 16 digits formatted into 4-4-4-4 blocks (19 chars total)
            ccNumberInput.addEventListener('input', function (e) {
                let val = e.target.value.replace(/\D/g, ''); // strip non-numeric
                if (val.length > 16) val = val.substring(0, 16);

                // Group into blocks of 4 digits
                const parts = val.match(/.{1,4}/g);
                e.target.value = parts ? parts.join(' ') : '';
            });

            // Cardholder Name: Letters, spaces, periods, and hyphens only
            ccNameInput.addEventListener('input', function (e) {
                e.target.value = e.target.value.replace(/[^a-zA-Z\s\.\-]/g, '').toUpperCase();
            });

            // Expiry Date: Digits only, auto-formats to MM/YY with valid month bounds (01-12)
            ccExpiryInput.addEventListener('input', function (e) {
                let val = e.target.value.replace(/\D/g, '');
                if (val.length > 4) val = val.substring(0, 4);

                if (val.length >= 1) {
                    // First digit can only be 0 or 1
                    if (val[0] > '1') val = '0' + val;
                }
                if (val.length >= 2) {
                    let month = parseInt(val.substring(0, 2), 10);
                    if (month === 0) val = '01' + val.substring(2);
                    else if (month > 12) val = '12' + val.substring(2);
                }

                if (val.length > 2) {
                    e.target.value = val.substring(0, 2) + '/' + val.substring(2);
                } else {
                    e.target.value = val;
                }
            });

            // Prevent deletion glitch when backspacing past the slash '/'
            ccExpiryInput.addEventListener('keydown', function (e) {
                if (e.key === 'Backspace' && this.value.length === 3) {
                    this.value = this.value.substring(0, 2);
                }
            });

            // CVV / CVC: Exactly digits only, max 4
            ccCvvInput.addEventListener('input', function (e) {
                let val = e.target.value.replace(/\D/g, '');
                if (val.length > 4) val = val.substring(0, 4);
                e.target.value = val;
            });
        });

        // ================= CART GUARD =================
        // Instantly check if the cart has items. If empty, kick them back to Checkout.
        (function checkCartStatus() {
            const savedCart = sessionStorage.getItem("smartScanCart");
            let isEmpty = true;

            if (savedCart) {
                try {
                    const cartData = JSON.parse(savedCart);
                    if (Array.isArray(cartData) && cartData.length > 0) {
                        isEmpty = false;
                    }
                } catch (e) { }
            }

            if (isEmpty) {
                alert("Cannot proceed to payment: The shopping cart is empty.");
                window.location.replace('/Home/Checkout');
            }
        })();

        // ================= PAYMENT LOGIC =================
        let cart = [];
        let total = 0;
        let cashModalInstance, creditModalInstance, storeCreditModalInstance, ewalletModalInstance, gcashQRModalInstance;

        // Parse search params to catch Customer ID from Verification Page
        const urlParams = new URLSearchParams(window.location.search);
        const verifiedCustomerName = urlParams.get('search');

        document.addEventListener("DOMContentLoaded", function () {
            cashModalInstance = new bootstrap.Modal(document.getElementById('cashModal'));
            creditModalInstance = new bootstrap.Modal(document.getElementById('creditModal'));
            storeCreditModalInstance = new bootstrap.Modal(document.getElementById('storeCreditModal'));
            ewalletModalInstance = new bootstrap.Modal(document.getElementById('ewalletModal'));
            gcashQRModalInstance = new bootstrap.Modal(document.getElementById('gcashQRModal'));

            const summaryList = document.getElementById("summaryList");
            const cartData = sessionStorage.getItem("smartScanCart");

            if (!cartData) return;

            try {
                cart = JSON.parse(cartData);
                let html = "";

                cart.forEach(item => {
                    const price = Number(item.price);
                    const qty = Number(item.qty);
                    if (!Number.isFinite(price) || !Number.isFinite(qty) || price < 0 || qty <= 0) return;

                    const subtotal = price * qty;
                    total += subtotal;

                    html += `
                        <tr>
                            <td class="ps-4 py-3"><span class="fw-bold text-dark">${escapeHtml(item.name)}</span></td>
                            <td class="text-center py-3"><span class="badge bg-light text-dark border px-2 py-1">${qty}</span></td>
                            <td class="text-end text-secondary py-3">₱${price.toFixed(2)}</td>
                            <td class="pe-4 text-end fw-bold text-dark py-3">₱${subtotal.toFixed(2)}</td>
                        </tr>`;
                });

                if (html) {
                    summaryList.innerHTML = html;
                }

                const formattedTotal = `₱${total.toFixed(2)}`;
                document.getElementById("grandTotalDisplay").textContent = formattedTotal;

                // Pre-fill fields
                document.getElementById("cashTotalDue").value = formattedTotal;
                document.getElementById("storeTotalDue").value = formattedTotal;
                document.getElementById("gcashTotalAmount").textContent = formattedTotal;

            } catch (error) {
                console.error("Cart error", error);
            }
        });

        function escapeHtml(value) {
            const element = document.createElement("div");
            element.textContent = value ?? "";
            return element.innerHTML;
        }

        function openModal(modalId) {
            if (cart.length === 0 || total <= 0) {
                alert("Your cart is empty. Please return to Checkout.");
                return;
            }
            if (modalId === 'cashModal') cashModalInstance.show();
            else if (modalId === 'creditModal') creditModalInstance.show();
            else if (modalId === 'storeCreditModal') storeCreditModalInstance.show();
            else if (modalId === 'ewalletModal') ewalletModalInstance.show();
        }

        function proceedCashPayment() {
            const amountInput = document.getElementById("cashAmountReceived").value;

            if (!amountInput || amountInput.trim() === "") {
                alert("Error: Please enter the amount received from the customer.");
                return;
            }

            const amountReceived = parseFloat(amountInput);
            if (isNaN(amountReceived) || amountReceived < total) {
                alert(`Insufficient amount. The total due is ₱${total.toFixed(2)}.`);
                return;
            }

            const changeAmount = amountReceived - total;
            finalizeTransaction("Cash In Hand", amountReceived, changeAmount);
        }

        function proceedCreditCard() {
            const ccNum = document.getElementById("ccNumber").value;
            const ccName = document.getElementById("ccName").value;
            const ccExp = document.getElementById("ccExpiry").value;
            const ccCvv = document.getElementById("ccCvv").value;

            if (!ccNum || !ccName || !ccExp || !ccCvv) {
                alert("Error: Please fill in all Credit Card fields before proceeding.");
                return;
            }

            finalizeTransaction("Credit Card", total, 0);
        }

        function proceedStoreCredit() {
            const storeCreditLimit = 300.00;
            const errorBox = document.getElementById("storeCreditError");
            const errorText = document.getElementById("storeCreditErrorText");

            if (total > storeCreditLimit) {
                errorText.textContent = `Total Due (₱${total.toFixed(2)}) exceeds the ₱${storeCreditLimit.toFixed(2)} limit.`;
                errorBox.style.display = "block";
                return;
            }

            errorBox.style.display = "none";
            finalizeTransaction("Store Credits", total, 0);
        }

        function openGCashQR() {
            ewalletModalInstance.hide();
            gcashQRModalInstance.show();
        }

        function simulateGCashSuccess() {
            gcashQRModalInstance.hide();
            finalizeTransaction("GCash API", total, 0);
        }

        async function finalizeTransaction(method, amountPaid, changeAmount) {

            // Create payload, attaching customer name if verified
            const payload = {
                items: cart.map(i => ({
                    name: i.name,
                    qty: parseInt(i.qty),
                    price: parseFloat(i.price)
                })),
                total: parseFloat(total),
                paymentMethod: method,
                customerName: verifiedCustomerName || "Guest" // Forward name to backend if needed
            };

            // Basic button loading state
            const activeModal = document.querySelector('.modal.show');
            const btn = activeModal ? activeModal.querySelector('.btn-proceed') : null;
            if(btn) {
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Processing...';
                btn.disabled = true;
            }

            try {
                const response = await fetch('/Home/SaveTransaction', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();

                if (result.success) {
                    payload.date = new Date().toISOString();
                    payload.status = "Completed";
                    payload.receiptNumber = result.receiptNumber;
                    payload.amountPaid = amountPaid;
                    payload.change = changeAmount;

                    sessionStorage.setItem("smartScanLastTransaction", JSON.stringify(payload));
                    sessionStorage.removeItem("smartScanCart");

                    // Clear Customer Display Monitor
                    localStorage.removeItem("smartScanCustomerDisplay");

                    window.location.href = "/Home/GenerateReceipt";
                } else {
                    alert("Transaction Failed: " + result.message);
                    if(btn) { btn.innerHTML = originalText; btn.disabled = false; }
                }
            } catch (error) {
                alert("Network Error: Could not connect to the database.");
                if(btn) { btn.innerHTML = "Proceed"; btn.disabled = false; }
            }
        }

        function cancelAndReturn() {
            window.location.href = "/Home/Checkout";
        }
    </script>
}