@{
    ViewData["Title"] = "Payment";
    if (ViewData["HeaderTitle"] == null)
    {
        ViewData["HeaderTitle"] = "Checkout";
    }
}

@section Styles {
    <style>
        /* Mobile & Tablet Stacking Adjustments (Desktop >= 992px stays untouched) */
        @@media (max-width: 991.98px) {
            .payment-workspace-body,
            .payment-workspace-row,
            .payment-col,
            .payment-panel-card {
                height: auto !important;
                overflow: visible !important;
            }

            .payment-summary-scroll {
                max-height: 280px;
            }
        }

        @@media (max-width: 575.98px) {
            #grandTotalDisplay {
                font-size: 1.65rem !important;
            }

            .pay-btn-grid {
                grid-template-columns: repeat(2, 1fr) !important;
                gap: 0.75rem !important;
            }

            .pay-btn-modern {
                padding: 1rem 0.75rem !important;
                min-height: 108px;
                font-size: 0.9rem !important;
            }

            .pay-btn-modern i {
                font-size: 1.5rem !important;
            }
        }
    </style>
}

<!-- Viewport-Locked Outer Container -->
<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white mx-auto pos-viewport-card"
     style="height: calc(100dvh - 130px); min-height: 540px; max-width: 1200px;">

    <!-- Top Navigation Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex flex-wrap justify-content-between align-items-center gap-2"
         style="background-color: #1162a3;">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h5 class="mb-0 fw-bold">
                <i class="fa-solid fa-money-check-dollar me-2"></i>Payment Processing
            </h5>
            @if (ViewData["CustomerName"] != null)
            {
                <span class="badge bg-light text-primary border rounded-pill px-3">
                    <i class="fa-solid fa-user me-1"></i> @ViewData["CustomerName"]
                </span>
            }
        </div>

        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold text-primary text-nowrap"
                style="background-color: #dbeafe; border-color: #cfe2f3 !important;"
                onclick="cancelAndReturn()">
            <i class="fa-solid fa-arrow-left me-1"></i>Cancel &amp; Return
        </button>
    </div>

    <!-- Interior Workspace Split -->
    <div class="card-body p-3 px-lg-4 pb-lg-4 pt-3 flex-grow-1 d-flex flex-column bg-light bg-opacity-50 overflow-hidden payment-workspace-body" style="min-height: 0;">
        <div class="row gx-0 gx-lg-4 gy-3 flex-grow-1 h-100 payment-workspace-row">

            <!-- Hidden field tracking currently bound customer -->
            <input type="hidden" id="savedCustomerId" name="savedCustomerId" value="" />

            <!-- ================= LEFT COLUMN | Transaction Summary ================= -->
            <div class="col-12 col-lg-6 d-flex flex-column h-100 p-0 pe-lg-2 pb-2 pb-lg-3 payment-col">
                <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden flex-grow-1 d-flex flex-column h-100 payment-panel-card">

                    <!-- Header -->
                    <div class="card-header bg-transparent border-0 pt-3 pt-md-4 px-3 px-md-4 pb-2 d-flex justify-content-between align-items-center flex-shrink-0">
                        <h4 class="fw-bold mb-0" style="color: #1162a3;">
                            <i class="fa-solid fa-receipt me-2"></i>Order Summary
                        </h4>
                    </div>

                    <!-- Table Container -->
                    <div class="card-body p-0 flex-grow-1 overflow-y-auto no-scrollbar payment-summary-scroll">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" style="min-width: 380px;">
                                <thead class="table-light sticky-top shadow-sm">
                                    <tr>
                                        <th class="ps-3 ps-md-4 py-3 text-secondary text-uppercase fw-bold" style="font-size: 12px;">Product</th>
                                        <th class="py-3 text-center text-secondary text-uppercase fw-bold text-nowrap" style="font-size: 12px; width: 70px;">Qty</th>
                                        <th class="py-3 text-end text-secondary text-uppercase fw-bold text-nowrap" style="font-size: 12px; width: 100px;">Price</th>
                                        <th class="pe-3 pe-md-4 py-3 text-end text-secondary text-uppercase fw-bold text-nowrap" style="font-size: 12px; width: 115px;">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody id="summaryList">
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-5">Loading items...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Grand Total Footer -->
                    <div class="card-footer bg-white border-top p-3 p-md-4 flex-shrink-0">

                        <!-- Penalty Indicator -->
                        <div id="penaltyNoticeRow" class="alert alert-warning py-2 px-3 mb-3 rounded-3 small d-flex flex-wrap justify-content-between align-items-center gap-2" style="display: none !important;">
                            <div>
                                <i class="fa-solid fa-clock-rotate-left me-1 text-danger"></i>
                                <span class="fw-bold">Includes 5% Overdue Penalty:</span>
                                <span id="penaltyDueDateInfo" class="text-muted ms-1"></span>
                            </div>
                            <span id="penaltyAmountDisplay" class="fw-bold font-monospace text-danger text-nowrap">+₱0.00</span>
                        </div>

                        <!-- Total Amount -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <span class="text-uppercase text-secondary fw-bold d-block" style="font-size: 13px; letter-spacing: 1px;">Amount Due</span>
                            </div>
                            <div class="text-end">
                                <span id="grandTotalDisplay" class="fw-bold font-monospace" style="font-size: 2.0rem; color: #1162a3; line-height: 1;">
                                    ₱0.00
                                </span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ================= RIGHT COLUMN | Payment Methods ================= -->
            <div class="col-12 col-lg-6 d-flex flex-column h-100 p-0 ps-lg-2 pb-2 pb-lg-3 payment-col">
                <div class="card border-0 shadow-sm rounded-4 bg-white flex-grow-1 d-flex flex-column p-3 p-md-4 h-100 payment-panel-card">

                    <h5 class="fw-bold text-dark mb-3 mb-md-4 text-center">How would you like to pay?</h5>

                    <div class="pay-btn-grid mb-auto">
                        <!-- Cash In Hand -->
                        <button type="button" class="pay-btn-modern btn-cash" onclick="openModal('cashModal')">
                            <i class="fa-solid fa-money-bill-wave"></i>
                            <span>Cash in Hand</span>
                        </button>

                        <!-- Credit Card -->
                        <button type="button" class="pay-btn-modern btn-credit" onclick="openModal('creditModal')">
                            <i class="fa-solid fa-credit-card"></i>
                            <span>Credit Card</span>
                        </button>

                        <!-- E-Wallet -->
                        <button type="button" class="pay-btn-modern btn-ewallet" onclick="openModal('ewalletModal')">
                            <i class="fa-solid fa-mobile-screen-button"></i>
                            <span>E-Wallet</span>
                        </button>

                        <!-- Store Credits -->
                        <button type="button" class="pay-btn-modern btn-store" onclick="openModal('storeCreditModal')">
                            <i class="fa-solid fa-coins"></i>
                            <span>Store Credits</span>
                        </button>
                    </div>

                    <div class="alert alert-light border small text-muted mt-3 mt-md-4 mb-0 py-3 text-center rounded-3">
                        <i class="fa-solid fa-shield-check text-success me-1"></i> All transactions are secure and encrypted.
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODALS ================= -->
<!-- Cash In Hand Modal -->
<div class="modal fade" id="cashModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 420px;">
        <div class="modal-content position-relative p-2">
            <button type="button" data-bs-dismiss="modal" class="modal-custom-close rounded-2"><i class="fa-solid fa-xmark"></i></button>
            <div class="modal-body text-center p-3 p-sm-4">
                <h3 class="modal-title-custom">Cash Payment</h3>
                <p class="modal-subtitle fw-medium mb-4">Enter the amount received from the customer.</p>

                <div class="text-start mb-3">
                    <label class="custom-input-label text-secondary">Total Due</label>
                    <input type="text" class="form-control custom-input fs-5 text-primary fw-bold text-end font-monospace" id="cashTotalDue" readonly>
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-12 col-sm-6 text-start">
                        <label class="custom-input-label">Amount Received</label>
                        <div class="input-group shadow-sm rounded-3 overflow-hidden border bg-white cash-focus-group">
                            <span class="input-group-text bg-white border-0 fw-bold text-secondary ps-3 py-2 fs-6">₱</span>
                            <input id="cashAmountReceived"
                                   class="form-control border-0 bg-white shadow-none fs-5 text-end font-monospace pe-3 ps-0 fw-semibold py-2"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   inputmode="decimal"
                                   onwheel="this.blur()"
                                   onkeydown="if(['-', '+', 'e', 'E'].includes(event.key)) event.preventDefault();"
                                   placeholder="0.00"
                                   oninput="calculateChange()">
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 text-start">
                        <label class="custom-input-label text-secondary">Exact Change</label>
                        <input type="text"
                               class="form-control custom-input fs-5 text-success fw-bold text-end font-monospace py-2"
                               id="cashChange"
                               placeholder="₱ 0.00"
                               readonly>
                    </div>
                </div>

                <button type="button" class="btn w-100 btn-proceed shadow-sm" onclick="proceedCashPayment()">Complete Transaction</button>
            </div>
        </div>
    </div>
</div>

<!-- Online Credit Card Modal -->
<div class="modal fade" id="creditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 400px;">
        <div class="modal-content position-relative p-2">
            <button type="button" data-bs-dismiss="modal" class="modal-custom-close rounded-2"><i class="fa-solid fa-xmark"></i></button>
            <div class="modal-body text-center p-3 p-sm-4">
                <h3 class="modal-title-custom">Credit/Debit Card</h3>
                <p class="modal-subtitle mb-4 fw-medium">Generate a secure payment link for Visa, Mastercard, or JCB.</p>
                <div class="alert alert-light border small text-muted text-start mb-4">
                    <i class="fa-solid fa-lock text-success me-1"></i> Card details are securely collected and processed by Xendit.
                </div>
                <button id="btnCreditTrigger" type="button" class="btn w-100 btn-proceed shadow-sm d-flex justify-content-center align-items-center" onclick="proceedCreditCard()">
                    Open Secure Checkout
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Store Credits Modal -->
<div class="modal fade" id="storeCreditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 420px;">
        <div class="modal-content position-relative p-2">
            <button type="button" data-bs-dismiss="modal" class="modal-custom-close rounded-2"><i class="fa-solid fa-xmark"></i></button>
            <div class="modal-body text-center p-3 p-sm-4">
                <h3 class="modal-title-custom">Store Credits</h3>
                <p class="modal-subtitle mb-4 fw-medium">Charge to authenticated customer account credit.</p>

                <!-- Store Balance -->
                <div class="text-start mb-3 p-3 bg-light rounded-3 border">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                        <span class="text-muted fw-bold small text-uppercase">Available Balance</span>
                        <span class="badge bg-danger text-nowrap" id="storeCreditBadge">Loading...</span>
                    </div>
                    <h4 class="mb-0 fw-bold text-dark font-monospace" id="storeBalance">₱0.00</h4>

                    <!-- Due Date & Overdue Indicator -->
                    <div class="mt-2 pt-2 border-top text-muted small fw-medium d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <i class="fa-regular fa-calendar me-1"></i> Next Due:
                            <span id="storeDueDate" class="fw-bold text-dark">N/A</span>
                        </div>
                        <span id="storeOverdueBadge" class="badge bg-danger rounded-pill px-2 py-1 text-nowrap" style="display: none;">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i>OVERDUE
                        </span>
                    </div>
                </div>

                <div class="text-start mb-4">
                    <label class="custom-input-label text-secondary">Total Due</label>
                    <input type="text" class="form-control custom-input fs-5 text-primary text-end font-monospace" id="storeTotalDue" readonly>
                </div>

                <div id="storeCreditError" class="alert alert-danger py-2 px-3 text-start mb-4 shadow-sm" style="display: none; font-size: 0.85rem; font-weight: bold; border-left: 4px solid #dc3545;">
                    <i class="fa-solid fa-circle-exclamation me-1"></i> <span id="storeCreditErrorText"></span>
                    <div class="mt-3 text-end">
                        <button type="button" id="btnExtendCredit" class="btn btn-sm btn-outline-danger fw-bold rounded-pill" style="display: none;" onclick="extendCustomerCredit()">
                            <i class="fa-solid fa-plus me-1"></i> Add ₱300 Limit
                        </button>
                    </div>
                </div>

                <button type="button" class="btn w-100 btn-proceed shadow-sm" onclick="proceedStoreCredit()">Apply Credits</button>
            </div>
        </div>
    </div>
</div>

<!-- E-Wallet Selection Modal -->
<div class="modal fade" id="ewalletModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 380px;">
        <div class="modal-content position-relative p-2">
            <button type="button" data-bs-dismiss="modal" class="modal-custom-close rounded-2"><i class="fa-solid fa-xmark"></i></button>
            <div class="modal-body text-center p-3 p-sm-4">
                <h3 class="modal-title-custom">E-Wallet</h3>
                <p class="modal-subtitle mb-4 fw-medium">Select an e-wallet provider to generate a checkout link.</p>

                <button type="button" id="btnGCashTrigger" class="w-100 ewallet-option-btn d-flex align-items-center shadow-sm" onclick="openGCashQR()">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/5/52/GCash_logo.svg" alt="GCash" height="24" class="me-3">
                    <span class="fs-5">GCash App</span>
                    <i class="fa-solid fa-chevron-right ms-auto text-muted"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Payment Waiting Modal (Auto-Polling + Mobile Fallback Link) -->
<div class="modal fade" id="paymentWaitingModal" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 p-3 p-sm-4 text-center">
            <h4 class="fw-bold text-primary mb-3">Awaiting Payment</h4>

            <!-- Loading Spinner -->
            <div class="spinner-border text-primary mx-auto mb-3" style="width: 3rem; height: 3rem;" role="status"></div>

            <p class="text-muted fw-medium mb-3" id="paymentStatusMessage">
                A new tab has opened for Xendit.<br>
                Please complete your payment there. This page will automatically update when the payment is successful.
            </p>

            <!-- Mobile Popup-Blocker Fallback Button -->
            <div class="d-flex flex-column align-items-center gap-2">
                <a id="manualXenditLink"
                   href="#"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-primary rounded-pill fw-semibold px-4 shadow-sm"
                   style="background-color: #1162a3; border-color: #1162a3; display: none;">
                    <i class="fa-solid fa-up-right-from-square me-1"></i>Open Payment Page
                </a>

                <button type="button" class="btn btn-outline-danger rounded-pill fw-semibold px-4" onclick="cancelPolling()">
                    Cancel Transaction
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pos-tab-guard.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let liveStoreCreditLimit = 0;
        let liveAvailableBalance = 0;
        let liveCustomerId = 0;
        let paymentPollingTimer = null;
        let xenditTab = null;
        let activeXenditInvoiceId = null;
        let activeXenditMethod = null;
        let isCheckingXendit = false;

        function closeXenditTab() {
            if (xenditTab && !xenditTab.closed) {
                try { xenditTab.close(); } catch (e) { }
            }
            xenditTab = null;
        }

        // Open tab synchronously inside the click gesture so mobile browsers do not block it
        function openPendingXenditTab() {
            closeXenditTab();
            const tab = window.open('', '_blank');
            if (tab) {
                try {
                    tab.document.title = 'Redirecting to Xendit...';
                    tab.document.body.innerHTML =
                        '<div style="font-family:system-ui,-apple-system,sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;margin:0;color:#1162a3;text-align:center;padding:24px;">' +
                        '<h3 style="margin:0 0 8px;">Connecting to Xendit...</h3>' +
                        '<p style="margin:0;color:#64748b;font-size:14px;">Please wait while we open your secure checkout page.</p>' +
                        '</div>';
                } catch (e) { }
            }
            xenditTab = tab;
            return tab;
        }

        (function checkCartStatus() {
            const savedCart = sessionStorage.getItem("smartScanCart");
            let isEmpty = true;

            if (savedCart) {
                try {
                    const cartData = JSON.parse(savedCart);
                    if (Array.isArray(cartData) && cartData.length > 0) {
                        isEmpty = false;
                    }
                } catch (e) { }
            }

            if (isEmpty) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Empty Cart',
                    text: 'Cannot proceed to payment: The shopping cart is empty.',
                    confirmButtonColor: '#1162a3'
                }).then(() => {
                    window.location.replace('/Home/Checkout');
                });
            }
        })();

        let cart = [];
        let total = 0;
        let cashModalInstance, creditModalInstance, storeCreditModalInstance, ewalletModalInstance, paymentWaitingModalInstance;

        const urlParams = new URLSearchParams(window.location.search);
        const verifiedCustomerName = urlParams.get('search') || sessionStorage.getItem("verifiedCustomerName") || "";
        const sessionCustomerId = parseInt(sessionStorage.getItem("verifiedCustomerId") || "0");
        const currentStoreName = @Html.Raw(Json.Serialize(ViewData["HeaderTitle"]?.ToString() ?? "SmartScan Retail"));

        document.addEventListener("DOMContentLoaded", function () {
            cashModalInstance = new bootstrap.Modal(document.getElementById('cashModal'));
            creditModalInstance = new bootstrap.Modal(document.getElementById('creditModal'));
            storeCreditModalInstance = new bootstrap.Modal(document.getElementById('storeCreditModal'));
            ewalletModalInstance = new bootstrap.Modal(document.getElementById('ewalletModal'));
            paymentWaitingModalInstance = new bootstrap.Modal(document.getElementById('paymentWaitingModal'));

            const canPay = window.SmartScanTabGuard.claimRegister();
            if (!canPay) return;

            // DISABLE STORE CREDIT IF SETTLING DEBT
            const activeDebtIds = sessionStorage.getItem("activeDebtTransactionIds");
            if (activeDebtIds) {
                const storeBtn = document.querySelector('.btn-store');
                if (storeBtn) {
                    storeBtn.disabled = true;
                    storeBtn.style.opacity = "0.5";
                    storeBtn.innerHTML = '<i class="fa-solid fa-ban"></i><span class="mt-1">Debt Settlement</span>';
                    storeBtn.onclick = null;
                }
            }

            const summaryList = document.getElementById("summaryList");
            const cartData = sessionStorage.getItem("smartScanCart");

            if (!cartData) return;

            try {
                cart = JSON.parse(cartData);
                let html = "";
                total = 0;

                // Calculate and render cart products
                cart.forEach(item => {
                    const price = Number(item.price);
                    const qty = Number(item.qty);
                    if (!Number.isFinite(price) || !Number.isFinite(qty) || price < 0 || qty <= 0) return;

                    const subtotal = price * qty;
                    total += subtotal;

                    html += `
                        <tr>
                            <td class="ps-3 ps-md-4 py-3"><span class="fw-bold text-dark">${escapeHtml(item.name)}</span></td>
                            <td class="text-center py-3 text-nowrap"><span class="badge bg-light text-dark border px-2 py-1">${qty}</span></td>
                            <td class="text-end text-secondary py-3 text-nowrap">₱${price.toFixed(2)}</td>
                            <td class="pe-3 pe-md-4 text-end fw-bold text-dark py-3 text-nowrap">₱${subtotal.toFixed(2)}</td>
                        </tr>`;
                });

                // Add Late Fee / Penalty if present
                const debtPenalty = parseFloat(sessionStorage.getItem("activeDebtPenalty") || "0");
                const debtDueDate = sessionStorage.getItem("activeDebtDueDate");

                if (debtPenalty > 0) {
                    total += debtPenalty;
                    const penaltyBox = document.getElementById("penaltyNoticeRow");
                    const penaltyAmt = document.getElementById("penaltyAmountDisplay");
                    const dateInfo = document.getElementById("penaltyDueDateInfo");

                    if (penaltyBox) penaltyBox.style.setProperty("display", "flex", "important");
                    if (penaltyAmt) penaltyAmt.textContent = `+₱${debtPenalty.toFixed(2)}`;
                    if (dateInfo && debtDueDate) dateInfo.textContent = `(Overdue from ${debtDueDate})`;
                }

                if (html) {
                    summaryList.innerHTML = html;
                }

                // Update all grand total displays once cleanly
                const formattedTotal = `₱${total.toFixed(2)}`;
                document.getElementById("grandTotalDisplay").textContent = formattedTotal;
                document.getElementById("cashTotalDue").value = formattedTotal;
                document.getElementById("storeTotalDue").value = formattedTotal;

            } catch (error) {
                console.error("Cart error", error);
            }

            // Bind hidden Customer ID input if available
            const hiddenCustInput = document.getElementById("savedCustomerId");
            if (sessionCustomerId > 0) {
                liveCustomerId = sessionCustomerId;
                if (hiddenCustInput) hiddenCustInput.value = sessionCustomerId;
            }

            // ======== FETCH LIVE CREDIT DATA WITH OVERDUE CHECK ========
            if (verifiedCustomerName) {
                fetch(`/Home/GetCustomerCredit?customerName=${encodeURIComponent(verifiedCustomerName)}`)
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            liveStoreCreditLimit = data.creditLimit;
                            liveAvailableBalance = data.availableBalance;
                            liveCustomerId = data.customerId;
                            if (hiddenCustInput) hiddenCustInput.value = data.customerId;

                            document.getElementById("storeCreditBadge").innerText = `Max ₱${liveStoreCreditLimit.toFixed(2)}`;
                            document.getElementById("storeBalance").innerText = `₱${liveAvailableBalance.toFixed(2)}`;

                            const dueDateEl = document.getElementById("storeDueDate");
                            const overdueBadge = document.getElementById("storeOverdueBadge");

                            if (dueDateEl) {
                                dueDateEl.innerText = data.nextDueDate;

                                if (data.nextDueDate && data.nextDueDate !== "No pending dues" && data.nextDueDate !== "N/A") {
                                    const parsedDate = new Date(data.nextDueDate);
                                    const today = new Date();
                                    today.setHours(0, 0, 0, 0);

                                    if (parsedDate < today) {
                                        dueDateEl.classList.remove("text-dark");
                                        dueDateEl.classList.add("text-danger");
                                        if (overdueBadge) overdueBadge.style.display = "inline-block";
                                    } else {
                                        dueDateEl.classList.remove("text-danger");
                                        dueDateEl.classList.add("text-dark");
                                        if (overdueBadge) overdueBadge.style.display = "none";
                                    }
                                } else {
                                    dueDateEl.classList.remove("text-danger");
                                    dueDateEl.classList.add("text-dark");
                                    if (overdueBadge) overdueBadge.style.display = "none";
                                }
                            }
                        } else {
                            document.getElementById("storeCreditBadge").innerText = "Unregistered";
                            document.getElementById("storeBalance").innerText = "₱0.00";
                            document.getElementById("storeDueDate").innerText = "N/A";
                        }
                    })
                    .catch(err => console.error("Could not load credit balance."));
            }

            if (urlParams.get('openStoreCredit') === 'true' && liveCustomerId > 0) {
                openModal('storeCreditModal');
            }
        });

        function escapeHtml(value) {
            const element = document.createElement("div");
            element.textContent = value ?? "";
            return element.innerHTML;
        }

        function openModal(modalId) {
            if (cart.length === 0 || total <= 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Empty Cart',
                    text: 'Your cart is empty. Please return to Checkout.',
                    confirmButtonColor: '#1162a3'
                });
                return;
            }

            if (modalId === 'storeCreditModal') {
                if (!verifiedCustomerName || verifiedCustomerName.trim() === '' || liveCustomerId <= 0) {
                    Swal.fire({
                        title: 'Customer Verification Required',
                        text: 'Store Credits require customer identity and facial verification before charging.',
                        icon: 'info',
                        showCancelButton: true,
                        confirmButtonColor: '#1162a3',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: '<i class="fa-solid fa-id-card me-1"></i>Verify Identity',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            sessionStorage.setItem("verificationRedirect", "StoreCredit");
                            window.location.href = "/Home/CustomerVerification";
                        }
                    });
                    return;
                }
            }

            if (modalId === 'cashModal') {
                const cashDue = Math.round(total);
                document.getElementById("cashTotalDue").value = `₱${cashDue.toFixed(2)}`;
                cashModalInstance.show();
            }
            else if (modalId === 'creditModal') creditModalInstance.show();
            else if (modalId === 'storeCreditModal') storeCreditModalInstance.show();
            else if (modalId === 'ewalletModal') ewalletModalInstance.show();
        }

        function proceedCashPayment() {
            const rawDue = document.getElementById("cashTotalDue").value.replace(/[^0-9.-]+/g, "");
            const cashTotalDue = parseFloat(rawDue) || Math.round(total);
            const amountInput = document.getElementById("cashAmountReceived").value;

            if (!amountInput || amountInput.trim() === "") {
                Swal.fire({
                    icon: 'warning',
                    title: 'Missing Amount',
                    text: 'Please enter the amount received from the customer.',
                    confirmButtonColor: '#1162a3'
                });
                return;
            }

            const amountReceived = parseFloat(amountInput);
            if (isNaN(amountReceived) || amountReceived < cashTotalDue) {
                Swal.fire({
                    icon: 'error',
                    title: 'Insufficient Amount',
                    text: `The total due is ₱${cashTotalDue.toFixed(2)}. Customer provided ₱${amountReceived.toFixed(2)}.`,
                    confirmButtonColor: '#1162a3'
                });
                return;
            }

            const changeAmount = amountReceived - cashTotalDue;
            total = cashTotalDue;
            finalizeTransaction("Cash In Hand", amountReceived, changeAmount);
        }

        function proceedStoreCredit() {
            const errorBox = document.getElementById("storeCreditError");
            const errorText = document.getElementById("storeCreditErrorText");
            const extendBtn = document.getElementById("btnExtendCredit");

            if (liveCustomerId === 0) {
                errorText.textContent = "Error: Customer profile not found. Please register customer.";
                errorBox.style.display = "block";
                extendBtn.style.display = "none";
                return;
            }

            if (total > liveAvailableBalance) {
                errorText.textContent = `Insufficient balance. Total Due (₱${total.toFixed(2)}) exceeds your available credit of ₱${liveAvailableBalance.toFixed(2)}.`;
                errorBox.style.display = "block";
                extendBtn.style.display = "inline-block";
                return;
            }

            errorBox.style.display = "none";
            extendBtn.style.display = "none";
            finalizeTransaction("Store Credits", total, 0);
        }

        async function extendCustomerCredit() {
            const confirmResult = await Swal.fire({
                title: 'Increase Credit Limit?',
                text: "Increase this customer's credit limit by ₱300.00 and extend their due date by 3 days?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#1162a3',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Increase'
            });

            if (!confirmResult.isConfirmed) return;

            const btn = document.getElementById("btnExtendCredit");
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Processing...';
            btn.disabled = true;

            try {
                const response = await fetch('/Home/IncreaseCreditLimit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ CustomerId: liveCustomerId })
                });
                const result = await response.json();

                if (result.success) {
                    liveStoreCreditLimit += 300;
                    liveAvailableBalance += 300;

                    document.getElementById("storeCreditBadge").innerText = `Max ₱${liveStoreCreditLimit.toFixed(2)}`;
                    document.getElementById("storeBalance").innerText = `₱${liveAvailableBalance.toFixed(2)}`;

                    btn.innerHTML = originalText;
                    btn.disabled = false;

                    proceedStoreCredit();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Failed',
                        text: result.message || 'Failed to increase limit.',
                        confirmButtonColor: '#1162a3'
                    });
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } catch (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'Network Error',
                    text: 'Network error while trying to increase limit.',
                    confirmButtonColor: '#1162a3'
                });
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

