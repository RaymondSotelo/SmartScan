        function startXenditPayment(xenditInvoiceId, xenditCheckoutUrl, paymentMethod) {
            if (paymentPollingTimer) {
                clearInterval(paymentPollingTimer);
                paymentPollingTimer = null;
            }

            activeXenditInvoiceId = xenditInvoiceId;
            activeXenditMethod = paymentMethod;
            isCheckingXendit = false;

            // Navigate the already-opened tab (or fall back to manual button if blocked)
            const statusMsg = document.getElementById("paymentStatusMessage");
            const manualLink = document.getElementById("manualXenditLink");
            let popupOpened = false;

            if (xenditTab && !xenditTab.closed) {
                try {
                    xenditTab.location.href = xenditCheckoutUrl;
                    popupOpened = true;
                } catch (e) {
                    popupOpened = false;
                }
            }

            if (manualLink) {
                manualLink.href = xenditCheckoutUrl;
                manualLink.style.display = "inline-block";
            }

            if (statusMsg) {
                statusMsg.innerHTML = popupOpened
                    ? 'A new tab has opened for Xendit.<br>Please complete your payment there. If it did not open, tap <strong>Open Payment Page</strong> below.'
                    : 'Your browser blocked the automatic popup.<br>Tap <strong>Open Payment Page</strong> below to complete your Xendit payment.';
            }

            paymentWaitingModalInstance.show();

            // Poll backend every 3 seconds to check if Xendit says it is paid
            paymentPollingTimer = setInterval(() => checkXenditStatus(xenditInvoiceId, paymentMethod), 3000);

            // Reset buttons if they were loading
            const creditBtn = document.getElementById("btnCreditTrigger");
            if (creditBtn) {
                creditBtn.innerHTML = 'Open Secure Checkout';
                creditBtn.disabled = false;
            }
            const gcashBtn = document.getElementById("btnGCashTrigger");
            if (gcashBtn) {
                gcashBtn.innerHTML = '<img src="https://upload.wikimedia.org/wikipedia/commons/5/52/GCash_logo.svg" alt="GCash" height="24" class="me-3"><span class="fs-5">GCash App</span><i class="fa-solid fa-chevron-right ms-auto text-muted"></i>';
                gcashBtn.disabled = false;
            }
        }

        async function checkXenditStatus(invoiceId, paymentMethod) {
            if (isCheckingXendit || !activeXenditInvoiceId || activeXenditInvoiceId !== invoiceId) return;
            isCheckingXendit = true;

            try {
                const response = await fetch(`/Home/VerifyXenditPayment?invoiceId=${encodeURIComponent(invoiceId)}`, {
                    cache: 'no-store'
                });
                const result = await response.json();

                if (result.status === "PAID" || result.status === "SETTLED") {
                    activeXenditInvoiceId = null;
                    activeXenditMethod = null;
                    if (paymentPollingTimer) {
                        clearInterval(paymentPollingTimer);
                        paymentPollingTimer = null;
                    }

                    closeXenditTab();
                    paymentWaitingModalInstance.hide();

                    Swal.fire({
                        icon: 'success',
                        title: 'Payment Received!',
                        text: 'The transaction was successful.',
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        finalizeTransaction(paymentMethod, total, 0);
                    });
                }
            } catch (error) {
                console.error("Polling error:", error);
            } finally {
                isCheckingXendit = false;
            }
        }

        function cancelPolling() {
            activeXenditInvoiceId = null;
            activeXenditMethod = null;
            isCheckingXendit = false;
            if (paymentPollingTimer) {
                clearInterval(paymentPollingTimer);
                paymentPollingTimer = null;
            }
            const manualLink = document.getElementById("manualXenditLink");
            if (manualLink) {
                manualLink.href = "#";
                manualLink.style.display = "none";
            }
            closeXenditTab();
            paymentWaitingModalInstance.hide();
        }

