        // ================= PHILSYS NATIONAL ID / QR SCANNER =================
        let html5QrScanner = null;
        let isProcessingScan = false;

        function startRightQrScanner() {
            showPlaceholder();
            placeholder.style.display = "none";
            regVideoContainer.style.display = "none";
            verifyVideoContainer.style.display = "none";
            qrContainer.style.display = "block";

            startBtn.classList.add("d-none");
            stopBtn.classList.remove("d-none");
            if (cameraDropdownWrapper) cameraDropdownWrapper.style.backgroundColor = "#dc3545";

            const selectedDeviceId = cameraSelect.value;
            const cameraConfig = selectedDeviceId ? { deviceId: { exact: selectedDeviceId } } : { facingMode: "environment" };

            html5QrScanner = new Html5Qrcode("qrReader");
            html5QrScanner.start(
                cameraConfig,
                { fps: 15, qrbox: { width: 260, height: 260 } },
                async (decodedText) => { await processPhilSysLiveScan(decodedText); },
                () => { }
            ).then(() => {
                updateOverlayStatus("fa-camera", "Hold PhilSys QR in view", "text-success");
            }).catch(err => {
                updateOverlayStatus("fa-triangle-exclamation", "Camera Error: " + err, "text-danger");
                showPlaceholder();
            });
        }

        async function stopRightQrScanner() {
            isProcessingScan = false;
            if (html5QrScanner) {
                try {
                    await html5QrScanner.stop();
                    html5QrScanner.clear();
                } catch (e) { }
                html5QrScanner = null;
            }
        }

        async function processPhilSysLiveScan(decodedText) {
            if (isProcessingScan) return;
            isProcessingScan = true;

            let jsonString = decodedText;

            try {
                if (decodedText.split('.').length === 3 && !decodedText.startsWith("{")) {
                    const base64Url = decodedText.split('.')[1];
                    const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                    jsonString = decodeURIComponent(atob(base64).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join(''));
                }

                const qrData = JSON.parse(jsonString);
                const subject = qrData.subject || qrData;

                const rawPcn = subject.pcn || subject.PCN || "";
                const rawDob = subject.bd || subject.DOB || subject.dob || subject.DateOfBirth || subject.birthDate || "";

                const normalizedPcn = rawPcn.replace(/[^0-9]/g, '');
                let normalizedDob = rawDob;
                if (rawDob) {
                    const dateObj = new Date(rawDob);
                    if (!isNaN(dateObj)) normalizedDob = dateObj.toISOString().split('T')[0];
                }

                document.getElementById('digitalIdInput').value = normalizedPcn;
                document.getElementById('manualDobInput').value = normalizedDob;

                await stopRightQrScanner();
                await verifyGovernmentId();

            } catch (error) {
                console.error("Failed to parse QR:", error);
                updateOverlayStatus("fa-qrcode", "Invalid PhilSys QR payload", "text-warning");
                isProcessingScan = false;
            }
        }

        const qrImageUpload = document.getElementById("qrImageUpload");
        if (qrImageUpload) {
            qrImageUpload.addEventListener("change", async (e) => {
                if (e.target.files.length === 0) return;
                updateOverlayStatus("fa-image", "Parsing uploaded image...", "text-info");

                const file = e.target.files[0];
                const tempScanner = new Html5Qrcode("qrReader");
                try {
                    const decodedText = await tempScanner.scanFile(file, true);
                    await processPhilSysLiveScan(decodedText);
                } catch (err) {
                    Swal.fire({ icon: 'error', title: 'Scan Error', text: 'Could not detect a clear PhilSys QR code in this image.', confirmButtonColor: '#1162a3' });
                    updateOverlayStatus("fa-image", "No QR found in image", "text-danger");
                }
                e.target.value = '';
            });
        }

        async function verifyGovernmentId() {
            const pcnValue = document.getElementById('digitalIdInput').value.trim();
            const dobValue = document.getElementById('manualDobInput').value;

            if (!pcnValue || !dobValue) {
                Swal.fire({ icon: 'warning', title: 'Incomplete Details', text: 'Please ensure both the 16-digit PCN and Date of Birth are provided.', confirmButtonColor: '#1162a3' });
                isProcessingScan = false;
                return;
            }

            updateOverlayStatus("fa-spinner fa-spin", "Validating record...", "text-light");
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const response = await fetch('/Home/NationalIDVerification', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ rawPayload: pcnValue, manualDob: dobValue })
                });

                const res = await response.json();

                const iconBox = document.getElementById('idResultIcon');
                const displayTitle = document.getElementById('idDisplayPayload');
                const displaySub = document.getElementById('idDisplaySub');
                const ageContainer = document.getElementById('ageResultContainer');
                const ageBadge = document.getElementById('ageClassificationBadge');
                const dobText = document.getElementById('dobDisplayText');

                if (res.isValid) {
                    if (res.isUnderage) {
                        iconBox.className = 'rounded-circle bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center';
                        iconBox.innerHTML = '<i class="fa-solid fa-ban fa-lg"></i>';

                        displayTitle.textContent = 'Sale Prohibited: Minor';
                        displaySub.textContent = `Calculated Age: ${res.age} yrs. Restricted items cannot be sold.`;

                        ageContainer.style.display = 'block';
                        ageBadge.className = 'badge rounded-pill bg-danger text-white px-3 py-1';
                        ageBadge.innerText = 'Underage (<18)';
                        dobText.textContent = `Age: ${res.age} yrs`;

                        updateOverlayStatus("fa-ban", "Age check failed: Customer is a minor", "text-danger");

                        Swal.fire({ icon: 'error', title: 'Age Verification Failed', text: 'Customer is under 18 years old. Restricted merchandise cannot be purchased.', confirmButtonColor: '#dc3545' });
                        isProcessingScan = false;
                        return;
                    }

                    iconBox.className = 'rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center';
                    iconBox.innerHTML = '<i class="fa-solid fa-shield-halved fa-lg"></i>';

                    const maskedPcn = res.idNumber.length === 16 ? `****-****-****-${res.idNumber.slice(-4)}` : res.idNumber;
                    displayTitle.textContent = `PhilSys PCN: ${maskedPcn}`;
                    displaySub.textContent = "Legal age confirmed. Proceeding to payment...";

                    ageContainer.style.display = 'block';
                    dobText.textContent = `Age: ${res.age} yrs old`;
                    ageBadge.className = 'badge rounded-pill bg-success text-white px-3 py-1';
                    ageBadge.innerText = 'Adult (18+)';

                    updateOverlayStatus("fa-check", `Adult Confirmed (${res.age} yrs)`, "text-success");

                    sessionStorage.removeItem("verificationReason");
                    sessionStorage.setItem("customerAgeVerified", "true");

                    stopActiveCamera();
                    await stopRightQrScanner();

                    Swal.fire({
                        icon: 'success',
                        title: 'Age Verified',
                        text: `Customer is ${res.age} years old. Redirecting to payment...`,
                        timer: 1200,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.replace('/Home/Payment');
                    });
                } else {
                    displayTitle.textContent = 'Verification Failed';
                    displaySub.textContent = res.message;
                    updateOverlayStatus("fa-xmark", "Invalid PhilSys credentials", "text-danger");

                    Swal.fire({ icon: 'error', title: 'Verification Failed', text: res.message || 'Invalid PhilSys record details.', confirmButtonColor: '#1162a3' });
                    isProcessingScan = false;
                }
            } catch (err) {
                console.error("Age check error:", err);
                updateOverlayStatus("fa-server", "API Error", "text-danger");
                isProcessingScan = false;
            }
        }

        window.addEventListener('beforeunload', () => {
            stopActiveCamera();
            stopRightQrScanner();
        });

        // ================= PHONE FORMATTER (09XX XXX XXXX) =================
        function formatPhpPhone(input) {
            // Strip everything except digits
            let digits = input.value.replace(/\D/g, '');

            // Enforce starting with "09"
            if (!digits.startsWith('09')) {
                digits = '09' + digits.replace(/^0+/, '');
            }

            // Truncate to maximum 11 digits
            digits = digits.slice(0, 11);

            // Format into 4 - 3 - 4 pattern (09XX XXX XXXX)
            let formatted = '';
            if (digits.length <= 4) {
                formatted = digits;
            } else if (digits.length <= 7) {
                formatted = digits.slice(0, 4) + ' ' + digits.slice(4);
            } else {
                formatted = digits.slice(0, 4) + ' ' + digits.slice(4, 7) + ' ' + digits.slice(7, 11);
            }

            input.value = formatted;
        }

        // Prevent backspace from removing the "09" prefix
        function handlePhoneBackspace(input, event) {
            if (event.key === 'Backspace' && input.value.replace(/\D/g, '').length <= 2) {
                event.preventDefault();
                input.value = '09';
            }
        }
    </script>
}