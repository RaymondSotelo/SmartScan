@{
    ViewData["Title"] = "Customer Verification";
    if (ViewData["HeaderTitle"] == null)
    {
        ViewData["HeaderTitle"] = "Customer Verification";
    }
}

@Html.AntiForgeryToken()

<!-- Viewport-Locked Outer Container -->
<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white"
     style="height: calc(100dvh - 130px); min-height: 540px;">

    <!-- Top Navigation Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex justify-content-between align-items-center"
         style="background-color: #1162a3;">
        <div class="d-flex align-items-center gap-2">
            <h5 class="mb-0 fw-bold">
                <i class="fa-solid fa-user-shield me-2"></i>Customer Verification
            </h5>
        </div>
        <a asp-action="Checkout" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold text-primary"
           style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
            <i class="fa-solid fa-arrow-left me-1"></i>Return to Checkout
        </a>
    </div>

    <!-- Interior Workspace Split -->
    <div class="card-body p-3 p-lg-4 flex-grow-1 d-flex flex-column" style="min-height: 0;">
        <div class="row g-3 flex-grow-1 m-0" style="min-height: 0;">

            <!-- ================= LEFT COLUMN | Controls & Forms ================= -->
            <div class="col-12 col-lg-6 d-flex flex-column h-100 p-0 pe-lg-3 pb-3" style="min-height: 0;">               

                <!-- Verification Tabs -->
                <ul class="nav nav-pills mb-3 flex-shrink-0 gap-2" id="verificationTabs" role="tablist">
					
                    <p class="fw-medium text-secondary text-center" style="font-size: 16.5px;">
                        <i class="fa-solid fa-info-circle me-2"></i>Select a Verification Method in order to proceed to the payment process.
					</p>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill fw-semibold border shadow-sm px-4"
                                style="width: 280px;"
                                id="facial-tab" data-bs-toggle="pill" data-bs-target="#facial-pane" type="button" role="tab">
                            <i class="fa-solid fa-camera-viewfinder me-2"></i>Face ID
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill fw-semibold border shadow-sm px-4"
                                style="width: 280px;"
                                id="nationalid-tab" data-bs-toggle="pill" data-bs-target="#nationalid-pane" type="button" role="tab">
                            <i class="fa-solid fa-address-card me-2"></i>National ID
                        </button>
                    </li>
                </ul>

                <!-- Tab Content Area -->
                <div class="tab-content flex-grow-1 overflow-y-auto no-scrollbar pe-2">

                    <!-- PANE 1: FACE VERIFICATION -->
                    <div class="tab-pane fade show active h-100 flex-column" id="facial-pane" role="tabpanel">
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3"
                                     style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
                                    <i class="fa-solid fa-user-check fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0 text-primary fs-5">Live Face Verification</h6>
                                    <small class="text-muted fw-medium">Auto-scans continuously for registered customers.</small>
                                </div>
                            </div>
                            <p class="text-muted small mb-0">
                                <i class="fa-solid fa-shield-halved text-success me-1"></i>
                                <strong>Privacy Secured:</strong> Facial features are converted to a mathematical vector; raw video frames are never saved.
                            </p>
                        </div>
                    </div>

                    <!-- PANE 2: NATIONAL ID VERIFICATION -->
                    <div class="tab-pane fade h-100 flex-column" id="nationalid-pane" role="tabpanel">
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3"
                                     style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
                                    <i class="fa-solid fa-id-card fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0 text-primary fs-5">PhilSys Age Verification</h6>
                                    <small class="text-muted fw-medium">Scan QR in the viewer or enter PCN manually.</small>
                                </div>
                            </div>

                            <!-- Manual Inputs -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold small text-secondary mb-1">16-Digit PCN</label>
                                <div class="input-group shadow-sm rounded-3 overflow-hidden border bg-white">
                                    <span class="input-group-text bg-white border-0 text-muted"><i class="fa-solid fa-hashtag"></i></span>
                                    <input type="text" id="digitalIdInput" class="form-control border-0 shadow-none fw-semibold font-monospace" placeholder="e.g. 1234567891234567" />
                                </div>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-semibold small text-secondary mb-1">Date of Birth</label>
                                <div class="input-group shadow-sm rounded-3 overflow-hidden border bg-white">
                                    <span class="input-group-text bg-white border-0 text-muted"><i class="fa-regular fa-calendar"></i></span>
                                    <input type="date" id="manualDobInput" class="form-control border-0 shadow-none fw-semibold" />
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex flex-column gap-2">
                                <button type="button" class="btn btn-primary rounded-pill fw-bold py-2 shadow-sm" style="background-color: #1162a3; border-color: #1162a3;" onclick="verifyGovernmentId()">
                                    <i class="fa-solid fa-shield-check me-2"></i>Verify Age
                                </button>
                                <label class="btn btn-outline-secondary rounded-pill fw-semibold shadow-sm mb-0 cursor-pointer">
                                    <i class="fa-solid fa-image me-1"></i>Upload QR Image File
                                    <input type="file" id="qrImageUpload" class="d-none" accept="image/*">
                                </label>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ================= RIGHT COLUMN | Camera Viewport ================= -->
            <div class="col-12 col-lg-6 d-flex flex-column h-100 p-0 ps-lg-2 pb-3" style="min-height: 0;">

                <div class="card border-0 bg-dark text-white rounded-4 flex-grow-1 position-relative d-flex align-items-center justify-content-center overflow-hidden shadow-sm"
                     style="background: radial-gradient(circle at center, #1b2838 0%, #0d131a 100%); isolation: isolate;">

                    <!-- Camera Off Placeholder -->
                    <div id="cameraPlaceholder" class="text-center p-4 z-2">
                        <div class="border-2 rounded-circle bg-black bg-opacity-25 p-4 d-inline-flex mb-3 border border-secondary border-opacity-25">
                            <i class="fa-solid fa-spinner fa-spin fa-3x text-secondary"></i>
                        </div>
                        <h5 class="fw-bold text-secondary mb-1">Scanner Idle</h5>
                        <p class="text-muted small mb-0">Press start to activate the lens.</p>
                    </div>

                    <!-- Face Video Stream Container -->
                    <div id="faceVideoContainer" class="position-absolute top-0 start-0 w-100 h-100" style="display: none; z-index: 1;">
                        <video id="videoFeed" autoplay playsinline muted class="w-100 h-100 object-fit-cover"></video>
                        <canvas id="faceCanvas" class="position-absolute top-0 start-0 pointer-events-none"></canvas>
                        <div id="scanGuide" class="position-absolute top-50 start-50 translate-middle border border-2 border-primary rounded-circle"
                             style="width: 220px; height: 280px; opacity: 0.5; transition: border-color 0.3s; box-shadow: 0 0 0 9999px rgba(0,0,0,0.4);">
                        </div>
                    </div>

                    <!-- QR Scanner Container (Html5-Qrcode) -->
                    <div id="qrVideoContainer" class="position-absolute top-0 start-0 w-100 h-100 bg-white" style="display: none; z-index: 1;">
                        <div id="qrReader" class="w-100 h-100 border-0"></div>
                    </div>

                    <!-- OVERLAY: Transparent Status Display (Bottom Left) -->
                    <div class="position-absolute bottom-0 start-0 p-3 z-3 w-100 d-flex flex-column gap-1 bg-transparent"
                         style="pointer-events: none; text-shadow: 1px 1px 4px rgba(0,0,0,0.9), -1px -1px 4px rgba(0,0,0,0.9);">

                        <!-- Face Status -->
                        <div class="d-flex align-items-center gap-2" style="font-size: 0.95rem;">
                            <i id="faceStatusIcon" class="fa-solid fa-user text-light" style="width: 20px; text-align: center;"></i>
                            <span id="faceStatusText" class="fw-bold text-light">Face: Idle</span>
                        </div>

                        <!-- Age Status -->
                        <div class="d-flex align-items-center gap-2" style="font-size: 0.95rem;">
                            <i id="ageStatusIcon" class="fa-solid fa-id-card text-light" style="width: 20px; text-align: center;"></i>
                            <span id="ageStatusText" class="fw-bold text-light">Age: Unverified</span>
                        </div>
                    </div>

                    <!-- OVERLAY: Camera Activation Buttons (Bottom Center) -->
                    <div class="position-absolute bottom-0 start-50 translate-middle-x pb-3 z-3">

                        <!-- Face Cam Button -->
                        <button type="button" id="btnToggleFaceCam" class="btn btn-primary rounded-pill fw-bold px-4 shadow-lg"
                                style="background-color: #1162a3; border-color: #1162a3; font-size: 0.9rem;">
                            <i class="fa-solid fa-video me-2"></i>Start Face Scanner
                        </button>

                        <!-- QR Cam Button (Hidden by default) -->
                        <button type="button" id="btnToggleQrCam" class="btn btn-primary rounded-pill fw-bold px-4 shadow-lg"
                                style="display: none; background-color: #1162a3; border-color: #1162a3; font-size: 0.9rem;"
                                onclick="toggleQrScanner()">
                            <i class="fa-solid fa-qrcode me-2"></i>Scan QR
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@vladmandic/face-api/dist/face-api.js"></script>
    <script src="https://unpkg.com/html5-qrcode"></script>

    <script>
        // ================= GLOBAL UI CONTROLS =================
        const placeholder = document.getElementById('cameraPlaceholder');
        const faceContainer = document.getElementById('faceVideoContainer');
        const qrContainer = document.getElementById('qrVideoContainer');

        const btnToggleFaceCam = document.getElementById('btnToggleFaceCam');
        const btnToggleQrCam = document.getElementById('btnToggleQrCam');

        function updateFaceStatus(theme, iconClass, text) {
            const icon = document.getElementById('faceStatusIcon');
            const span = document.getElementById('faceStatusText');
            icon.className = `fa-solid ${iconClass} text-${theme}`;
            span.className = `fw-bold text-${theme}`;
            span.textContent = text;
        }

        function updateAgeStatus(theme, iconClass, text) {
            const icon = document.getElementById('ageStatusIcon');
            const span = document.getElementById('ageStatusText');
            icon.className = `fa-solid ${iconClass} text-${theme}`;
            span.className = `fw-bold text-${theme}`;
            span.textContent = text;
        }

        function showPlaceholder() {
            placeholder.style.display = 'block';
            faceContainer.style.display = 'none';
            qrContainer.style.display = 'none';
        }

        // Handle Tab Switching (Stop Active Cameras and Swap Buttons)
        document.querySelectorAll('button[data-bs-toggle="pill"]').forEach(tab => {
            tab.addEventListener('shown.bs.tab', event => {
                stopFaceCamera();
                stopQrScanner();

                // Reset Indicators
                updateFaceStatus('light', 'fa-user', 'Face: Idle');
                updateAgeStatus('light', 'fa-id-card', 'Age: Unverified');
                showPlaceholder();

                // Swap bottom buttons based on active tab
                if (event.target.id === 'facial-tab') {
                    btnToggleFaceCam.style.display = 'block';
                    btnToggleQrCam.style.display = 'none';
                } else {
                    btnToggleFaceCam.style.display = 'none';
                    btnToggleQrCam.style.display = 'block';
                }
            });
        });

        // ================= RESTRICT ACCESS =================
        // Instantly check if the cart has items. If empty, kick them back to Checkout.
        (function checkCartStatus() {
            const savedCart = localStorage.getItem("smartScanCustomerDisplay");
            let isEmpty = true;

            if (savedCart) {
                try {
                    const cartData = JSON.parse(savedCart);
                    if (cartData.items && cartData.items.length > 0) {
                        isEmpty = false;
                    }
                } catch (e) { }
            }

            if (isEmpty) {
                alert("Cannot proceed: The shopping cart is empty. Please scan items first.");
                window.location.replace('/Home/Checkout'); // Redirect immediately
            }
        })();

        // ================= FACE API LOGIC =================
        const video = document.getElementById('videoFeed');
        const canvas = document.getElementById('faceCanvas');
        const scanGuide = document.getElementById('scanGuide');

        let faceStream = null;
        let isModelReady = false;
        let isFaceScanning = false;
        let isAuthenticating = false;
        let scanSessionTimeout = null;

        const MODEL_URL = 'https://cdn.jsdelivr.net/npm/@@vladmandic/face-api/model/';
        const AUTO_STOP_MS = 15000;

        async function loadModels() {
            updateFaceStatus('info', 'fa-spinner fa-spin', 'Face: Loading Models...');
            try {
                await Promise.all([
                    faceapi.nets.ssdMobilenetv1.loadFromUri(MODEL_URL),
                    faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL),
                    faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
                ]);
                isModelReady = true;
                updateFaceStatus('light', 'fa-user-check', 'Face: Ready');
            } catch (err) {
                updateFaceStatus('danger', 'fa-triangle-exclamation', 'Face: Engine Error');
            }
        }
        loadModels();

        function stopFaceCamera() {
            isFaceScanning = false;
            isAuthenticating = false;
            if (scanSessionTimeout) clearTimeout(scanSessionTimeout);

            if (faceStream) {
                faceStream.getTracks().forEach(track => track.stop());
                faceStream = null;
            }
            video.srcObject = null;

            if(canvas.width > 0) {
                canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height);
            }

            btnToggleFaceCam.className = 'btn btn-primary rounded-pill fw-bold px-4 shadow-lg';
            btnToggleFaceCam.innerHTML = '<i class="fa-solid fa-video me-2"></i>Start Face Scanner';
            btnToggleFaceCam.style.backgroundColor = '#1162a3';
            btnToggleFaceCam.style.borderColor = '#1162a3';
            scanGuide.className = 'position-absolute top-50 start-50 translate-middle border border-2 border-primary rounded-circle';
        }

        btnToggleFaceCam.addEventListener('click', async () => {
            if (faceStream) {
                stopFaceCamera();
                showPlaceholder();
                updateFaceStatus('light', 'fa-video-slash', 'Face: Idle');
                return;
            }
            if (!isModelReady) return;

            try {
                faceStream = await navigator.mediaDevices.getUserMedia({ video: { width: { ideal: 640 }, height: { ideal: 480 } } });
                video.srcObject = faceStream;

                placeholder.style.display = 'none';
                faceContainer.style.display = 'block';

                btnToggleFaceCam.className = 'btn btn-danger rounded-pill fw-bold px-4 shadow-lg';
                btnToggleFaceCam.innerHTML = '<i class="fa-solid fa-video-slash me-2"></i>Stop Scanner';
                btnToggleFaceCam.style.backgroundColor = '';
                btnToggleFaceCam.style.borderColor = '';

                isFaceScanning = true;
                isAuthenticating = false;

                video.onplay = () => {
                    updateFaceStatus('info', 'fa-eye fa-fade', 'Face: Scanning...');

                    scanSessionTimeout = setTimeout(() => {
                        if (isFaceScanning) {
                            stopFaceCamera();
                            showPlaceholder();
                            updateFaceStatus('warning', 'fa-clock', 'Face: Timeout');
                        }
                    }, AUTO_STOP_MS);

                    runDetectionLoop();
                };
            } catch (err) {
                updateFaceStatus('danger', 'fa-camera', 'Face: Hardware Denied');
            }
        });

        async function runDetectionLoop() {
            while (isFaceScanning) {
                if (video.readyState >= 3 && !isAuthenticating) {
                    try {
                        const detection = await faceapi.detectSingleFace(video).withFaceLandmarks().withFaceDescriptor();

                        const displaySize = { width: video.offsetWidth, height: video.offsetHeight };
                        faceapi.matchDimensions(canvas, displaySize);

                        const ctx = canvas.getContext('2d');
                        ctx.clearRect(0, 0, canvas.width, canvas.height);

                        if (detection) {
                            await verifyFaceWithServer(detection.descriptor);
                        }
                    } catch (err) {}
                }
                await new Promise(r => setTimeout(r, 100));
            }
        }

        async function verifyFaceWithServer(descriptorArray) {
            isAuthenticating = true;
            updateFaceStatus('info', 'fa-microchip fa-spin', 'Face: Verifying...');

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const capturedVectorJson = JSON.stringify(Array.from(descriptorArray));

            try {
                const response = await fetch('/Home/AuthenticateFace', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ capturedEmbeddingJson: capturedVectorJson })
                });

                const result = await response.json();

                if (result.success) {
                    isFaceScanning = false;
                    clearTimeout(scanSessionTimeout);
                    scanGuide.className = 'position-absolute top-50 start-50 translate-middle border border-3 border-success rounded-circle';

                    updateFaceStatus('success', 'fa-user-check', `User: ${result.customerName}`);

                    if(result.hasAge){
                        const ageMsg = result.isUnderage ? `Age: ${result.age} (Underage)` : `Age: ${result.age} (Adult)`;
                        const ageTheme = result.isUnderage ? 'warning' : 'success';
                        const ageIcon = result.isUnderage ? 'fa-triangle-exclamation' : 'fa-id-card-clip';

                        updateAgeStatus(ageTheme, ageIcon, ageMsg);
                    } else {
                        updateAgeStatus('secondary', 'fa-circle-question', 'Age: Unknown in DB');
                    }

                    setTimeout(() => { window.location.href = result.redirectUrl; }, 1500);
                } else {
                    scanGuide.className = 'position-absolute top-50 start-50 translate-middle border border-2 border-danger rounded-circle';
                    updateFaceStatus('danger', 'fa-user-xmark', 'Face: Unregistered');
                    setTimeout(() => {
                        isAuthenticating = false;
                        updateFaceStatus('info', 'fa-eye fa-fade', 'Face: Scanning...');
                        scanGuide.className = 'position-absolute top-50 start-50 translate-middle border border-2 border-primary rounded-circle';
                    }, 1200);
                }
            } catch (err) {
                setTimeout(() => { isAuthenticating = false; }, 1000);
            }
        }


        // ================= NATIONAL ID / QR SCANNER LOGIC =================
        let html5QrScanner = null;

        async function toggleQrScanner() {
            if (html5QrScanner) {
                await stopQrScanner();
                showPlaceholder();
                updateAgeStatus('light', 'fa-qrcode', 'Age: Unverified');
                return;
            }

            placeholder.style.display = 'none';
            faceContainer.style.display = 'none';
            qrContainer.style.display = 'block';

            btnToggleQrCam.className = 'btn btn-danger rounded-pill fw-bold px-4 shadow-lg';
            btnToggleQrCam.innerHTML = '<i class="fa-solid fa-camera-slash me-2"></i>Stop Camera';

            updateAgeStatus('info', 'fa-qrcode fa-fade', 'Age: Scanning QR...');

            html5QrScanner = new Html5Qrcode("qrReader");
            html5QrScanner.start(
                { facingMode: "environment" },
                { fps: 10, qrbox: { width: 250, height: 250 } },
                async (decodedText) => { await processScannedQrData(decodedText); },
                (err) => { /* ignore */ }
            ).catch(err => {
                showPlaceholder();
                updateAgeStatus('danger', 'fa-triangle-exclamation', 'Age: Camera Error');
            });
        }

        async function stopQrScanner() {
            if (html5QrScanner) {
                await html5QrScanner.stop();
                html5QrScanner.clear();
                html5QrScanner = null;
            }
            btnToggleQrCam.className = 'btn btn-primary rounded-pill fw-bold px-4 shadow-lg';
            btnToggleQrCam.innerHTML = '<i class="fa-solid fa-qrcode me-2"></i>Scan QR';
            btnToggleQrCam.style.backgroundColor = '#1162a3';
            btnToggleQrCam.style.borderColor = '#1162a3';
        }

        async function processScannedQrData(decodedText) {
            try {
                let jsonString = decodedText;
                if (decodedText.split('.').length === 3 && !decodedText.startsWith("{")) {
                    const base64Url = decodedText.split('.')[1];
                    const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                    jsonString = decodeURIComponent(atob(base64).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join(''));
                }

                const qrData = JSON.parse(jsonString);
                const subject = qrData.subject || qrData;

                const rawPcn = subject.pcn || subject.PCN || "";
                const rawDob = subject.bd || subject.DOB || subject.dob || subject.DateOfBirth || subject.birthDate || "";

                document.getElementById('digitalIdInput').value = rawPcn.replace(/[^0-9]/g, '');

                if (rawDob) {
                    const dateObj = new Date(rawDob);
                    if (!isNaN(dateObj)) document.getElementById('manualDobInput').value = dateObj.toISOString().split('T')[0];
                }

                if (html5QrScanner) await toggleQrScanner();
                await verifyGovernmentId();

            } catch (error) {
                updateAgeStatus('danger', 'fa-qrcode', 'Age: Invalid QR');
                if (html5QrScanner) await toggleQrScanner();
                showPlaceholder();
            }
        }

        // Image Upload fallback
        document.getElementById('qrImageUpload').addEventListener('change', async function(e) {
            if (e.target.files.length === 0) return;
            const file = e.target.files[0];
            const tempQrCode = new Html5Qrcode("qrReader"); // Uses div invisibly
            try {
                updateAgeStatus('info', 'fa-image', 'Age: Parsing Image...');
                const decodedText = await tempQrCode.scanFile(file, true);
                await processScannedQrData(decodedText);
            } catch (err) {
                updateAgeStatus('danger', 'fa-image', 'Age: No QR Found');
            }
            e.target.value = '';
        });

        // PhilSys Verification Backend Call
        async function verifyGovernmentId() {
            const pcnValue = document.getElementById('digitalIdInput').value.trim();
            const dobValue = document.getElementById('manualDobInput').value;

            if (!pcnValue || !dobValue) {
                updateAgeStatus('warning', 'fa-circle-exclamation', 'Age: Missing Info');
                return;
            }

            updateAgeStatus('info', 'fa-spinner fa-spin', 'Age: Verifying...');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            try {
                const response = await fetch('/Home/NationalIDVerification', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ rawPayload: pcnValue, manualDob: dobValue })
                });

                const res = await response.json();

                if (res.isValid) {
                    const statusMsg = res.isUnderage ? `Age: ${res.age} (Underage)` : `Age: ${res.age} (Adult)`;
                    const theme = res.isUnderage ? 'warning' : 'success';
                    const icon = res.isUnderage ? 'fa-triangle-exclamation' : 'fa-id-card-clip';

                    updateAgeStatus(theme, icon, statusMsg);
                } else {
                    updateAgeStatus('danger', 'fa-circle-xmark', 'Age: Failed');
                }
            } catch (err) {
                updateAgeStatus('danger', 'fa-server', 'Age: API Error');
            }
        }

        window.addEventListener('beforeunload', () => {
            stopFaceCamera();
            if(html5QrScanner) html5QrScanner.stop();
        });
    </script>
}