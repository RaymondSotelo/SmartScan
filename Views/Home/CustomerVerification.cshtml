@{
    ViewData["Title"] = "Customer Verification";
    if (ViewData["HeaderTitle"] == null)
    {
        ViewData["HeaderTitle"] = "Customer Verification";
    }
}

@Html.AntiForgeryToken()

<!-- Viewport-Locked Outer Container -->
<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white"
     style="height: calc(100dvh - 130px); min-height: 540px;">

    <!-- Top Navigation Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex justify-content-between align-items-center"
         style="background-color: #1162a3;">
        <div class="d-flex align-items-center gap-2">
            <h5 class="mb-0 fw-bold" id="pageHeaderTitle">
                <i class="fa-solid fa-user-shield me-2"></i>Customer Verification
            </h5>
        </div>
        <!-- Dynamic Return Button -->
        <button type="button" id="btnCancelVerification" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold text-primary"
                style="background-color: #dbeafe; border-color: #cfe2f3 !important;"
                onclick="cancelVerification()">
            <i class="fa-solid fa-arrow-left me-1"></i><span id="btnCancelText">Return to Checkout</span>
        </button>
    </div>

    <!-- Interior Workspace Split -->
    <div class="card-body p-3 p-lg-4 flex-grow-1 d-flex flex-column overflow-hidden" style="min-height: 0;">
        <div class="row g-3 flex-grow-1 m-0 overflow-hidden" style="min-height: 0;">

            <!-- ================= LEFT COLUMN: WORKSPACE PANES ================= -->
            <div class="col-12 col-lg-6 d-flex flex-column h-100 p-0 pe-lg-3 pb-3 overflow-hidden" style="min-height: 0;">

                <!-- TOP SWITCHER: Toggle between Verification / Pay Debt & Register Customer -->
                <div id="verificationSwitcherGroup" class="mb-3 flex-shrink-0" style="display: none;">
                    <div class="p-1 bg-light rounded-pill border d-flex gap-1 shadow-sm">
                        <button type="button"
                                id="btnSwitchPayDebt"
                                class="btn btn-sm rounded-pill flex-fill fw-semibold py-2 transition-all"
                                onclick="switchToPayDebtPane()">
                            <i class="fa-solid fa-user-check me-1" id="iconSwitchPayDebt"></i>
                            <span id="labelSwitchPayDebt">Pay Debt</span>
                        </button>
                        <button type="button"
                                id="btnSwitchRegister"
                                class="btn btn-sm rounded-pill flex-fill fw-semibold py-2 transition-all"
                                onclick="switchToRegistrationPane()">
                            <i class="fa-solid fa-user-plus me-1"></i>Register Customer
                        </button>
                    </div>
                </div>

                <!-- PANE 1: FACIAL RECOGNITION (VERIFICATION / PAY DEBT) -->
                <div id="facial-recognition-pane" class="h-100 flex-column justify-content-between overflow-hidden" style="display: none;">
                    <div class="overflow-y-auto no-scrollbar pe-1">

                        <!-- Header Info -->
                        <div class="px-2 pt-2 pb-3 flex-shrink-0">
                            <h4 class="mb-1 fw-bold" style="color: #1162a3;" id="faceRecognitionHeaderTitle">Live Face Recognition</h4>
                            <p class="fw-medium text-secondary mb-0" id="faceRecognitionHeaderSub">Authenticate customer identity against the biometric registry.</p>
                        </div>

                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-light mb-3">

                            <!-- Mobile Contact Number (Manual Lookup) -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="control-label fw-semibold mb-1" style="color: #1162a3;">
                                        Mobile Contact Number
                                    </label>
                                    <span class="text-muted" style="font-size: 11px;">Manual Lookup</span>
                                </div>
                                <div class="input-group shadow-sm rounded-3 overflow-hidden border bg-white">
                                    <input type="tel"
                                           id="manualLookupContact"
                                           class="form-control border-0 bg-white shadow-none ps-3 font-monospace fw-medium"
                                           maxlength="13"
                                           inputmode="numeric"
                                           value="09"
                                           oninput="formatPhpPhone(this)"
                                           onkeydown="handlePhoneBackspace(this, event); if(event.key === 'Enter') lookupCustomerByPhone();"
                                           placeholder="09XX XXX XXXX" />
                                    <button type="button"
                                            class="btn btn-primary fw-semibold px-3 z-3 border-0"
                                            style="background-color: #1162a3;"
                                            onclick="lookupCustomerByPhone()">
                                        <i class="fa-solid fa-magnifying-glass me-1"></i>Search
                                    </button>
                                </div>
                                <div class="form-text small" style="font-size: 11px;">11-digit mobile number required to verify without facial scanning.</div>
                            </div>
                        </div>



                        <!-- Recognition Status & Result Display Card -->
                        <div class="card border rounded-4 p-3 bg-white shadow-sm mb-3">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div id="recognitionIconBox" class="rounded-circle bg-light text-secondary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="fa-solid fa-user-clock fa-lg"></i>
                                    </div>
                                    <div class="text-start">
                                        <span class="fw-bold text-dark d-block" id="recognitionCustomerDisplay" style="font-size: 14px;">Awaiting Verification...</span>
                                        <small class="text-muted d-block" id="recognitionSubDisplay">Enable scanner or lookup by contact number.</small>
                                    </div>
                                </div>
                                <div class="text-end" id="recognitionBadgeContainer" style="display: none;">
                                    <span class="badge rounded-pill bg-success text-white px-3 py-1 fw-bold" id="recognitionStatusBadge">Matched</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-light border small text-muted mb-0 py-2 text-center rounded-3 mt-auto">
                        <i class="fa-solid fa-info-circle me-1 text-primary"></i> Click <strong>Enable Scanner</strong> below or enter mobile number.
                    </div>
                </div>

                <!-- PANE 2: CUSTOMER REGISTRATION -->
                <div id="register-left-pane" class="h-100 flex-column justify-content-between overflow-hidden" style="display: none;">
                    <div class="overflow-y-auto no-scrollbar pe-1">

                        <!-- Header Info -->
                        <div class="px-2 pt-2 pb-1 flex-shrink-0">
                            <h4 class="mb-1 fw-bold" style="color: #1162a3;" id="faceRecognitionHeaderTitle">Register Customer</h4>
                            <p class="fw-medium text-secondary mb-0" id="faceRecognitionHeaderSub">Enroll customer profile for store credit verification.</p>
                        </div>

                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-light mb-3">

                            <!-- Full Name -->
                            <div class="form-group mb-3">
                                <label class="control-label fw-semibold mb-1" style="color: #1162a3;">Full Name</label>
                                <input type="text" id="regFullName" class="form-control rounded-3" placeholder="e.g., Juan Dela Cruz" autocomplete="off" />
                            </div>

                            <!-- Mobile Contact -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="control-label fw-semibold mb-1" style="color: #1162a3;">Mobile Contact Number</label>
                                </div>
                                <div class="input-group shadow-sm rounded-3 overflow-hidden border bg-white">
                                    <input type="tel"
                                           id="regContactNumber"
                                           class="form-control rounded-3 border-0 font-monospace"
                                           maxlength="13"
                                           inputmode="numeric"
                                           required
                                           value="09"
                                           oninput="formatPhpPhone(this)"
                                           onkeydown="handlePhoneBackspace(this, event);"
                                           placeholder="09XX XXX XXXX" />
                                </div>
                                <div class="form-text small" style="font-size: 11px;">11-digit mobile number for Store Credit SMS updates.</div>
                            </div>

                            <!-- Biometric Status Indicator -->
                            <div class="card border rounded-3 p-3 bg-white shadow-sm mb-3">
                                <span class="text-uppercase text-secondary fw-bold d-block mb-1" style="font-size: 11px;">Biometric Profile</span>
                                <span id="regFaceStatusBadge" class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1">
                                    <i class="fa-solid fa-user-xmark me-1"></i>Face Not Captured
                                </span>
                            </div>

                            <input type="hidden" id="regFaceEmbeddingJson" />

                            <button type="button" class="btn w-100 btn-primary fw-bold rounded-pill py-2 shadow-sm"
                                    style="background-color: #1162a3; border-color: #1162a3;"
                                    onclick="submitCustomerRegistration()">
                                <i class="fa-solid fa-check-circle me-1"></i>Register & Proceed to Store Credit
                            </button>
                        </div>
                    </div>

                    <div class="alert alert-light border small text-muted mb-0 py-2 text-center rounded-3 mt-auto">
                        <i class="fa-solid fa-circle-info text-primary me-1"></i>
                        Store credit limit is initialized to <strong>PHP 300.00</strong>.
                    </div>
                </div>

                <!-- PANE 3: PHILSYS NATIONAL ID (AGE RESTRICTION) -->
                <div id="nationalid-left-pane" class="h-100 flex-column justify-content-between overflow-hidden" style="display: none;">
                    <div class="overflow-hidden d-flex flex-column h-100">

                        <!-- Header Info -->
                        <div class="px-2 pt-2 flex-shrink-0">
                            <h4 class="mb-1 fw-bold" style="color: #1162a3;" id="faceRecognitionHeaderTitle">PhilSys Age Verification</h4>
                            <p class="fw-medium text-secondary mb-0" id="faceRecognitionHeaderSub">Required for purchase of 18+ restricted merchandise.</p>
                        </div>

                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-light mb-3 flex-shrink-0">

                            <!-- Manual PCN & DOB Inputs -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="control-label fw-semibold mb-1" style="color: #1162a3;">16-Digit PCN</label>
                                </div>
                                <div class="input-group shadow-sm rounded-3 overflow-hidden border bg-white">
                                    <input type="text"
                                           id="digitalIdInput"
                                           class="form-control rounded-3 border-0 shadow-none ps-3 font-monospace fw-semibold"
                                           placeholder="e.g. 1234567891234567" />
                                </div>
                            </div>

                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="control-label fw-semibold mb-1" style="color: #1162a3;">Date of Birth</label>
                                </div>
                                <div class="input-group shadow-sm rounded-3 overflow-hidden border bg-white">
                                    <input type="date"
                                           id="manualDobInput"
                                           class="form-control rounded-3 border-0 shadow-none ps-3 fw-semibold" />
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex flex-column gap-2">
                                <button type="button" class="btn btn-primary rounded-pill fw-bold py-2 shadow-sm"
                                        style="background-color: #1162a3; border-color: #1162a3;"
                                        onclick="verifyGovernmentId()">
                                    <i class="fa-solid fa-shield-check me-2"></i>Verify Age
                                </button>
                                <label class="btn btn-outline-secondary rounded-pill fw-semibold shadow-sm mb-0 cursor-pointer">
                                    <i class="fa-solid fa-image me-1"></i>Upload QR Image File
                                    <input type="file" id="qrImageUpload" class="d-none" accept="image/*">
                                </label>
                            </div>
                        </div>

                        <!-- Result Card -->
                        <div class="card border rounded-3 p-3 bg-white shadow-sm flex-shrink-0" id="idVerificationCard">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div id="idResultIcon" class="rounded-circle bg-light text-secondary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="fa-solid fa-id-card fa-lg"></i>
                                    </div>
                                    <div class="text-start">
                                        <span class="fw-bold text-dark d-block" id="idDisplayPayload" style="font-size: 14px;">Pending Verification</span>
                                        <small class="text-muted d-block" id="idDisplaySub">Scan QR or enter PCN and DOB manually.</small>
                                    </div>
                                </div>
                                <div class="text-end" id="ageResultContainer" style="display: none;">
                                    <span class="badge rounded-pill px-3 py-1 fw-bold" id="ageClassificationBadge" style="font-size: 12px;">--</span>
                                    <small class="text-muted d-block mt-1" id="dobDisplayText" style="font-size: 11px;"></small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-light border small text-muted mb-0 py-2 text-center rounded-3 mt-auto">
                        <i class="fa-solid fa-id-card me-1 text-primary"></i> Present the PhilSys QR code directly in front of the scanner.
                    </div>
                </div>
            </div>

            <!-- ================= RIGHT COLUMN: DEDICATED SEPARATE VIEWPORTS ================= -->
            <div class="col-12 col-lg-6 d-flex flex-column h-100 p-0 ps-lg-2 pb-3 overflow-hidden" style="min-height: 0;">
                <div class="card border-0 bg-dark text-white rounded-4 flex-grow-1 position-relative d-flex align-items-center justify-content-center overflow-hidden shadow-sm"
                     style="background: radial-gradient(circle at center, #1b2838 0%, #0d131a 100%); isolation: isolate; height: 100%;">

                    <!-- Idle / Placeholder (Default State on load) -->
                    <div id="cameraPlaceholder" class="text-center p-4 z-2">
                        <div class="border-2 rounded-circle bg-black bg-opacity-25 p-4 d-inline-flex mb-3 border border-secondary border-opacity-25">
                            <i class="fa-solid fa-video-slash fa-3x text-secondary"></i>
                        </div>
                        <h5 class="fw-bold text-secondary mb-1">Webcam Disabled</h5>
                        <p class="text-muted small mb-0" style="max-width: 320px;">
                            Select your video source and enable the camera to authenticate customer verification.
                        </p>
                    </div>

                    <!-- Dedicated Face Registration Stream Container -->
                    <div id="regVideoContainer" class="position-absolute top-0 start-0 w-100 h-100" style="display: none; z-index: 1;">
                        <video id="regVideoFeed" autoplay playsinline muted class="w-100 h-100 object-fit-cover"></video>
                        <canvas id="regFaceCanvas" class="position-absolute top-0 start-0 pointer-events-none"></canvas>
                        <div class="position-absolute top-50 start-50 translate-middle border border-2 border-primary rounded-circle"
                             style="width: 220px; height: 280px; opacity: 0.5; box-shadow: 0 0 0 9999px rgba(0,0,0,0.4);">
                        </div>
                    </div>

                    <!-- Dedicated Face Verification Stream Container -->
                    <div id="verifyVideoContainer" class="position-absolute top-0 start-0 w-100 h-100" style="display: none; z-index: 1;">
                        <video id="verifyVideoFeed" autoplay playsinline muted class="w-100 h-100 object-fit-cover"></video>
                        <canvas id="verifyFaceCanvas" class="position-absolute top-0 start-0 pointer-events-none"></canvas>
                        <div id="scanGuide" class="position-absolute top-50 start-50 translate-middle border border-2 border-primary rounded-circle"
                             style="width: 220px; height: 280px; opacity: 0.5; transition: border-color 0.3s; box-shadow: 0 0 0 9999px rgba(0,0,0,0.4);">
                        </div>
                    </div>

                    <!-- Dedicated QR Scanner Container -->
                    <div id="qrVideoContainer" class="position-absolute top-0 start-0 w-100 h-100 bg-white" style="display: none; z-index: 1;">
                        <div id="qrReader" class="w-100 h-100 border-0"></div>
                    </div>

                    <!-- OVERLAY: Top-Left Floating Status Pill Badge -->
                    <div class="position-absolute top-0 start-0 m-3 z-3" style="pointer-events: none;">
                        <span class="badge bg-black bg-opacity-60 text-white border border-white border-opacity-25 rounded-pill px-3 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2"
                              style="backdrop-filter: blur(4px); font-size: 0.82rem; letter-spacing: 0.3px;">
                            <i id="overlayStatusIcon" class="fa-solid fa-video-slash text-light" style="width: 16px; text-align: center;"></i>
                            <span id="overlayStatusText">Webcam Disabled</span>
                        </span>
                    </div>

                    <!-- ================= ENABLE/DISABLE BUTTON & CAMERA SELECTOR (CHECKOUT DESIGN) ================= -->
                    <div class="position-absolute start-50 translate-middle-x z-3 shadow-lg" style="bottom: 24px;">
                        <div class="btn-group rounded-pill overflow-hidden border border-white border-opacity-25 shadow" role="group">
                            <button id="startCamBtn"
                                    type="button"
                                    class="btn btn-sm text-white fw-semibold px-3 py-2 d-flex align-items-center gap-2 border-0"
                                    style="background-color: #1162a3;">
                                <i class="fa-solid fa-play small"></i>
                                <span>Enable Scanner</span>
                            </button>

                            <button id="stopCamBtn"
                                    type="button"
                                    class="btn btn-sm btn-danger fw-semibold px-3 py-2 d-none d-flex align-items-center gap-2 border-0">
                                <i class="fa-solid fa-stop small"></i>
                                <span>Stop Feed</span>
                            </button>

                            <div class="position-relative d-flex align-items-center border-start border-white border-opacity-25"
                                 id="cameraDropdownWrapper"
                                 style="background-color: #1162a3; transition: background-color 0.2s ease;">
                                <button type="button"
                                        tabindex="-1"
                                        class="btn btn-sm text-white px-2 py-2 border-0 h-100 d-flex align-items-center justify-content-center"
                                        style="pointer-events: none; width: 34px;">
                                    <i class="fa-solid fa-chevron-down small"></i>
                                </button>
                                <select id="cameraSelect"
                                        class="position-absolute top-0 start-0 w-100 h-100 opacity-0"
                                        style="cursor: pointer;"
                                        title="Choose camera device">
                                    <option value="">Detecting cameras...</option>
                                </select>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@vladmandic/face-api/dist/face-api.js"></script>
    <script src="https://unpkg.com/html5-qrcode"></script>

    <script type="text/javascript">
        // ================= GLOBAL STATE & ROUTING =================
        const placeholder = document.getElementById('cameraPlaceholder');
        const regVideoContainer = document.getElementById('regVideoContainer');
        const verifyVideoContainer = document.getElementById('verifyVideoContainer');
        const qrContainer = document.getElementById('qrVideoContainer');
        const scanGuide = document.getElementById('scanGuide');
        const switchRegisterContainer = document.getElementById('switchRegisterContainer');

        const switcherGroup = document.getElementById('verificationSwitcherGroup');
        const btnSwitchPayDebt = document.getElementById('btnSwitchPayDebt');
        const btnSwitchRegister = document.getElementById('btnSwitchRegister');

        const startBtn = document.getElementById("startCamBtn");
        const stopBtn = document.getElementById("stopCamBtn");
        const cameraSelect = document.getElementById("cameraSelect");
        const cameraDropdownWrapper = document.getElementById("cameraDropdownWrapper");

        let verificationReason = sessionStorage.getItem("verificationReason"); // "AgeGated" | "PayDebt" | null
        let verificationRedirect = sessionStorage.getItem("verificationRedirect"); // "StoreCredit" | null
        let isPayDebt = verificationReason === "PayDebt";

        let activeStream = null;
        let isModelReady = false;
        let isAuthenticating = false;
        let isDetectionActive = false;
        let scanSessionTimeout = null;

        const MODEL_URL = 'https://cdn.jsdelivr.net/npm/@@vladmandic/face-api/model/';
        const AUTO_STOP_MS = 25000;

        function updateOverlayStatus(iconClass, text, colorClass = "text-light") {
            const icon = document.getElementById("overlayStatusIcon");
            const span = document.getElementById("overlayStatusText");
            if (icon) icon.className = `fa-solid ${iconClass} ${colorClass}`;
            if (span) span.innerText = text;
        }

        function showPlaceholder() {
            placeholder.style.display = 'block';
            regVideoContainer.style.display = 'none';
            verifyVideoContainer.style.display = 'none';
            qrContainer.style.display = 'none';

            stopBtn.classList.add("d-none");
            startBtn.classList.remove("d-none");
            if (cameraDropdownWrapper) cameraDropdownWrapper.style.backgroundColor = "#1162a3";
        }

        function updateSwitcherButtons(activeSection) {
            if (activeSection === 'PayDebt') {
                btnSwitchPayDebt.className = "btn btn-sm rounded-pill flex-fill fw-semibold py-2 shadow-sm text-white";
                btnSwitchPayDebt.style.backgroundColor = "#1162a3";
                btnSwitchPayDebt.style.borderColor = "#1162a3";

                btnSwitchRegister.className = "btn btn-sm rounded-pill flex-fill fw-semibold py-2 text-secondary border-0 bg-transparent";
                btnSwitchRegister.style.backgroundColor = "";
                btnSwitchRegister.style.borderColor = "";
            } else {
                btnSwitchRegister.className = "btn btn-sm rounded-pill flex-fill fw-semibold py-2 shadow-sm text-white";
                btnSwitchRegister.style.backgroundColor = "#1162a3";
                btnSwitchRegister.style.borderColor = "#1162a3";

                btnSwitchPayDebt.className = "btn btn-sm rounded-pill flex-fill fw-semibold py-2 text-secondary border-0 bg-transparent";
                btnSwitchPayDebt.style.backgroundColor = "";
                btnSwitchPayDebt.style.borderColor = "";
            }
        }

        // ================= LOAD CAMERAS =================
        async function loadCameras() {
            try {
                const tempStream = await navigator.mediaDevices.getUserMedia({ video: true });
                tempStream.getTracks().forEach(t => t.stop());

                const devices = await navigator.mediaDevices.enumerateDevices();
                const videoDevices = devices.filter(d => d.kind === "videoinput");

                cameraSelect.innerHTML = "";
                videoDevices.forEach((device, index) => {
                    const option = document.createElement("option");
                    option.value = device.deviceId;
                    option.text = device.label || `Camera ${index + 1}`;
                    const lowerLabel = (device.label || "").toLowerCase();
                    if (lowerLabel.includes("user") || lowerLabel.includes("front") || lowerLabel.includes("integrated")) {
                        option.selected = true;
                    }
                    cameraSelect.appendChild(option);
                });

                if (videoDevices.length === 0) {
                    cameraSelect.innerHTML = "<option value=''>Default Camera</option>";
                }
            } catch (err) {
                cameraSelect.innerHTML = "<option value=''>Default Camera</option>";
            }
        }

        // ================= PAGE INITIALIZATION =================
        document.addEventListener("DOMContentLoaded", function () {
            loadCameras();

            const isFromPayment = verificationRedirect === "StoreCredit";
            const isFromCheckout = document.referrer.toLowerCase().includes("checkout")
                                  || verificationReason === "AgeGated"
                                  || isPayDebt;

            // Contextual Toggle Button Labels & Visibility
            const labelSwitchPayDebt = document.getElementById("labelSwitchPayDebt");
            const iconSwitchPayDebt = document.getElementById("iconSwitchPayDebt");

            if (isFromCheckout) {
                if (switcherGroup) switcherGroup.style.display = "none";
            } else {
                if (switcherGroup) switcherGroup.style.display = "block";
            }

            if (labelSwitchPayDebt && iconSwitchPayDebt) {
                if (isFromPayment) {
                    labelSwitchPayDebt.innerText = "Verify Customer";
                    iconSwitchPayDebt.className = "fa-solid fa-user-check me-1";
                } else {
                    labelSwitchPayDebt.innerText = "Pay Debt";
                    iconSwitchPayDebt.className = "fa-solid fa-hand-holding-dollar me-1";
                }
            }

            // Route Viewport Panes
            if (verificationReason === "AgeGated") {
                if (switcherGroup) switcherGroup.style.display = "none";

                document.getElementById("nationalid-left-pane").style.display = "flex";
                document.getElementById("register-left-pane").style.display = "none";
                document.getElementById("facial-recognition-pane").style.display = "none";
                document.getElementById("pageHeaderTitle").innerHTML = '<i class="fa-solid fa-user-shield me-2"></i>Customer Verification';

                updateOverlayStatus("fa-qrcode", "PhilSys QR Scanner Ready");
            } else if (isPayDebt) {
                if (switcherGroup) switcherGroup.style.display = "none";

                document.getElementById("facial-recognition-pane").style.display = "flex";
                document.getElementById("register-left-pane").style.display = "none";
                document.getElementById("nationalid-left-pane").style.display = "none";
                document.getElementById("pageHeaderTitle").innerHTML = '<i class="fa-solid fa-user-shield me-2"></i>Customer Verification';

                const faceTitle = document.getElementById("faceRecognitionHeaderTitle");
                const faceSub = document.getElementById("faceRecognitionHeaderSub");
                if (faceTitle) faceTitle.innerText = "Pay Debt Face Authentication";
                if (faceSub) faceSub.innerText = "Scan customer face to automatically fetch pending credit debt.";

                if (switchRegisterContainer) switchRegisterContainer.style.display = "none";
                loadFaceApiModels();
            } else if (isFromPayment) {
                if (switcherGroup) switcherGroup.style.display = "block";
                updateSwitcherButtons('PayDebt');

                document.getElementById("facial-recognition-pane").style.display = "flex";
                document.getElementById("register-left-pane").style.display = "none";
