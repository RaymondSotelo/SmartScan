        function stopActiveCamera() {
            isDetectionActive = false;
            isAuthenticating = false;
            if (scanSessionTimeout) {
                clearTimeout(scanSessionTimeout);
                scanSessionTimeout = null;
            }

            if (activeStream) {
                activeStream.getTracks().forEach(t => t.stop());
                activeStream = null;
            }

            const regVid = document.getElementById('regVideoFeed');
            const verifyVid = document.getElementById('verifyVideoFeed');
            if (regVid) regVid.srcObject = null;
            if (verifyVid) verifyVid.srcObject = null;

            const regCv = document.getElementById('regFaceCanvas');
            const verifyCv = document.getElementById('verifyFaceCanvas');
            if (regCv && regCv.width > 0) regCv.getContext('2d').clearRect(0, 0, regCv.width, regCv.height);
            if (verifyCv && verifyCv.width > 0) verifyCv.getContext('2d').clearRect(0, 0, verifyCv.width, verifyCv.height);

            if (scanGuide) {
                scanGuide.className = 'position-absolute top-50 start-50 translate-middle border border-2 border-primary rounded-circle';
            }

            stopBtn.classList.add("d-none");
            startBtn.classList.remove("d-none");
            if (cameraDropdownWrapper) cameraDropdownWrapper.style.backgroundColor = "#1162a3";
        }

        // ================= RECOGNITION / VERIFICATION PIPELINE =================
        async function startVerificationCamera() {
            if (!isModelReady) {
                Swal.fire({ icon: 'info', title: 'Loading Models', text: 'Facial models are still initializing. Please wait a moment.' });
                return;
            }
            stopActiveCamera();
            await stopRightQrScanner();

            placeholder.style.display = 'none';
            regVideoContainer.style.display = 'none';
            if (qrContainer) qrContainer.style.display = 'none';
            verifyVideoContainer.style.display = 'block';

            const video = document.getElementById('verifyVideoFeed');
            const canvas = document.getElementById('verifyFaceCanvas');
            const selectedDeviceId = cameraSelect.value;

            try {
                const constraints = {
                    video: {
                        deviceId: selectedDeviceId ? { exact: selectedDeviceId } : undefined,
                        facingMode: selectedDeviceId ? undefined : "user",
                        width: { ideal: 640 },
                        height: { ideal: 480 }
                    }
                };

                activeStream = await navigator.mediaDevices.getUserMedia(constraints);
                video.srcObject = activeStream;

                isDetectionActive = true;
                isAuthenticating = false;

                startBtn.classList.add("d-none");
                stopBtn.classList.remove("d-none");
                if (cameraDropdownWrapper) cameraDropdownWrapper.style.backgroundColor = "#dc3545";

                video.onplay = () => {
                    updateOverlayStatus('fa-eye fa-fade', 'Face: Scanning...', 'text-info');

                    if (scanSessionTimeout) clearTimeout(scanSessionTimeout);
                    scanSessionTimeout = setTimeout(() => {
                        if (isDetectionActive && !isAuthenticating) {
                            stopActiveCamera();
                            showPlaceholder();
                            updateOverlayStatus('fa-clock', 'Face: Timeout', 'text-warning');
                        }
                    }, AUTO_STOP_MS);

                    runFastVerificationLoop(video, canvas);
                };
            } catch (err) {
                console.error("Camera access error:", err);
                updateOverlayStatus('fa-camera', 'Face: Hardware Denied', 'text-danger');
                showPlaceholder();
            }
        }

        async function runFastVerificationLoop(videoEl, canvasEl) {
            while (isDetectionActive) {
                if (videoEl.readyState >= 3 && !isAuthenticating) {
                    try {
                        const detection = await faceapi.detectSingleFace(videoEl)
                            .withFaceLandmarks()
                            .withFaceDescriptor();

                        if (videoEl.offsetWidth > 0 && videoEl.offsetHeight > 0) {
                            const displaySize = { width: videoEl.offsetWidth, height: videoEl.offsetHeight };
                            faceapi.matchDimensions(canvasEl, displaySize);
                            canvasEl.getContext('2d').clearRect(0, 0, canvasEl.width, canvasEl.height);
                        }

                        if (detection) {
                            await verifyFaceWithServer(detection.descriptor);
                        }
                    } catch (err) { }
                }
                await new Promise(r => setTimeout(r, 90));
            }
        }

        async function verifyFaceWithServer(descriptorArray) {
            isAuthenticating = true;
            updateOverlayStatus('fa-microchip fa-spin', 'Face: Verifying...', 'text-primary');

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const capturedVectorJson = JSON.stringify(Array.from(descriptorArray));

            try {
                const response = await fetch('/Home/AuthenticateFace', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ capturedEmbeddingJson: capturedVectorJson })
                });

                const result = await response.json();

                if (result.success && result.customerId) {
                    await handleSuccessfulVerification(result.customerId, result.customerName, result.redirectUrl);
                } else {
                    if (scanGuide) scanGuide.className = 'position-absolute top-50 start-50 translate-middle border border-2 border-danger rounded-circle';
                    updateOverlayStatus('fa-user-xmark', 'Face: Unregistered', 'text-danger');

                    setTimeout(() => {
                        isAuthenticating = false;
                        updateOverlayStatus('fa-eye fa-fade', 'Face: Scanning...', 'text-info');
                        if (scanGuide) scanGuide.className = 'position-absolute top-50 start-50 translate-middle border border-2 border-primary rounded-circle';
                    }, 1200);
                }
            } catch (err) {
                console.error("Auth server error:", err);
                setTimeout(() => { isAuthenticating = false; }, 1000);
            }
        }

        // ================= MANUAL PHONE NUMBER LOOKUP =================
        async function lookupCustomerByPhone() {
            const phoneInput = document.getElementById("manualLookupContact");
            // Strip spaces before sending to backend
            const phone = phoneInput ? phoneInput.value.replace(/\D/g, '') : "";

            if (!phone || phone.length !== 11 || !phone.startsWith("09")) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Invalid Contact Number',
                    text: 'Please input a complete 11-digit mobile number (e.g., 0912 345 6789).',
                    confirmButtonColor: '#1162a3'
                });
                return;
            }

            updateOverlayStatus("fa-spinner fa-spin", "Searching customer database...", "text-light");

            try {
                const response = await fetch(`/Home/GetCustomerByContact?contactNumber=${encodeURIComponent(phone)}`);
                const result = await response.json();

                if (result.success && result.customerId) {
                    const customerDisplay = document.getElementById("recognitionCustomerDisplay");
                    const subDisplay = document.getElementById("recognitionSubDisplay");
                    const iconBox = document.getElementById("recognitionIconBox");
                    const badgeContainer = document.getElementById("recognitionBadgeContainer");

                    if (customerDisplay) customerDisplay.textContent = result.customerName;
                    if (subDisplay) subDisplay.textContent = `Mobile: ${result.contactNumber} | Debt: ₱${parseFloat(result.currentDebt || 0).toFixed(2)}`;
                    if (iconBox) {
                        iconBox.className = "rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center";
                        iconBox.innerHTML = '<i class="fa-solid fa-user-check fa-lg"></i>';
                    }
                    if (badgeContainer) badgeContainer.style.display = "block";

                    await handleSuccessfulVerification(result.customerId, result.customerName, result.redirectUrl);
                } else {
                    updateOverlayStatus("fa-circle-xmark", "Customer Not Found", "text-danger");
                    Swal.fire({
                        icon: 'error',
                        title: 'Customer Not Found',
                        text: result.message || 'No registered account found with that mobile number.',
                        confirmButtonColor: '#1162a3'
                    });
                }
            } catch (err) {
                console.error("Lookup error:", err);
                updateOverlayStatus("fa-triangle-exclamation", "Lookup Error", "text-danger");
                Swal.fire({
                    icon: 'error',
                    title: 'Lookup Error',
                    text: 'Unable to reach the server to verify customer records.',
                    confirmButtonColor: '#1162a3'
                });
            }
        }

        // Shared handler for successful match (Face or Phone)
        async function handleSuccessfulVerification(customerId, customerName, defaultRedirect) {
            isDetectionActive = false;
            if (scanSessionTimeout) clearTimeout(scanSessionTimeout);
            if (scanGuide) scanGuide.className = 'position-absolute top-50 start-50 translate-middle border border-3 border-success rounded-circle';
            updateOverlayStatus('fa-user-check', `User: ${customerName}`, 'text-success');

            stopActiveCamera();
            await stopRightQrScanner();

            const redirectMode = sessionStorage.getItem("verificationRedirect");
            const reasonMode = sessionStorage.getItem("verificationReason");

            // STORE CREDIT FLOW (From Payment Page)
            if (redirectMode === "StoreCredit") {
                sessionStorage.setItem("verifiedCustomerId", customerId);
                sessionStorage.setItem("verifiedCustomerName", customerName);
                sessionStorage.removeItem("verificationRedirect");

                Swal.fire({
                    icon: 'success',
                    title: 'Customer Verified',
                    text: `Verified ${customerName}. Returning to payment...`,
                    timer: 1200,
                    showConfirmButton: false
                }).then(() => {
                    window.location.replace(`/Home/Payment?search=${encodeURIComponent(customerName)}&openStoreCredit=true`);
                });
                return;
            }

            // PAY DEBT FLOW (From Checkout Page)
            if (reasonMode === "PayDebt") {
                const debtRes = await fetch(`/Home/GetCustomerDebtTransaction?customerId=${customerId}`);
                const debtData = await debtRes.json();

                if (debtData.success) {
                    sessionStorage.removeItem("verificationReason");
                    sessionStorage.setItem("verifiedCustomerId", customerId);
                    sessionStorage.setItem("verifiedCustomerName", customerName);
                    sessionStorage.setItem("smartScanCart", JSON.stringify(debtData.items));
                    sessionStorage.setItem("activeDebtTransactionIds", JSON.stringify(debtData.transactionIds));
                    sessionStorage.setItem("activeDebtPenalty", debtData.penaltyAmount || 0);
                    sessionStorage.setItem("activeDebtDueDate", debtData.dueDate || "");

                    Swal.fire({
                        icon: 'success',
                        title: 'Customer Verified',
                        text: `Loaded unpaid debt for ${customerName}. Proceeding to settlement...`,
                        timer: 1200,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.replace(`/Home/Payment?search=${encodeURIComponent(customerName)}`);
                    });
                } else {
                    sessionStorage.removeItem("verifiedCustomerId");
                    sessionStorage.removeItem("verifiedCustomerName");
                    sessionStorage.removeItem("activeDebtTransactionIds");
                    sessionStorage.removeItem("activeDebtTransactionId");
                    sessionStorage.removeItem("activeDebtPenalty");
                    sessionStorage.removeItem("activeDebtDueDate");

                    Swal.fire({
                        icon: 'info',
                        title: 'No Pending Debt',
                        html: `<strong>${customerName}</strong> has no active unpaid credit transactions on record.`,
                        showCancelButton: true,
                        confirmButtonColor: '#1162a3',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: '<i class="fa-solid fa-arrow-left me-1"></i>Return to Checkout',
                        cancelButtonText: '<i class="fa-solid fa-rotate-right me-1"></i>Search Another Customer',
                        allowOutsideClick: false
                    }).then((swalResult) => {
                        if (swalResult.isConfirmed) {
                            sessionStorage.removeItem("verificationReason");
                            sessionStorage.removeItem("verificationRedirect");
                            window.location.href = "/Home/Checkout";
                        } else {
                            showPlaceholder();
                        }
                    });
                }
                return;
            }

            // DEFAULT FALLBACK REDIRECT
            sessionStorage.setItem("verifiedCustomerId", customerId);
            sessionStorage.setItem("verifiedCustomerName", customerName);

            setTimeout(() => {
                const targetUrl = defaultRedirect || `/Home/Payment?search=${encodeURIComponent(customerName)}`;
                window.location.replace(targetUrl);
            }, 1000);
        }

