        // ================= LOAD MODELS =================
        async function loadFaceApiModels() {
            updateOverlayStatus('fa-spinner fa-spin', 'Face: Loading Models...', 'text-light');
            try {
                await Promise.all([
                    faceapi.nets.ssdMobilenetv1.loadFromUri(MODEL_URL),
                    faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL),
                    faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
                ]);
                isModelReady = true;
                updateOverlayStatus('fa-check-circle', 'Engine Ready (Camera Standby)', 'text-success');
            } catch (err) {
