                            <i class="fa-solid fa-check me-1"></i>Digital receipt link copied!
                        </small>

                        <div class="mt-1">
                            <a id="txModalPreviewLinkBtn" href="#" target="_blank" class="btn btn-sm btn-link text-decoration-none fw-semibold" style="font-size: 12px; color: #1162a3;">
                                <i class="fa-solid fa-up-right-from-square me-1"></i>Open Digital Receipt Page in New Tab
                            </a>
                        </div>
                    </div>

                    <!-- Return to Receipt Details Button -->
                    <div class="text-center mt-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-4 fw-semibold shadow-sm" onclick="backToReceiptDetailsFromQr()">
                            <i class="fa-solid fa-arrow-left me-1"></i>Back to Receipt Details
                        </button>
