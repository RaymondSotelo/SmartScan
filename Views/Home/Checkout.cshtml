@section Scripts {
    <script src="~/js/pos-tab-guard.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@vladmandic/face-api/dist/face-api.js"></script>
    <script src="https://unpkg.com/html5-qrcode"></script>
    <script src="https://unpkg.com/@@zxing/library@latest"></script>
    <!-- QRCode.js for generating customer digital receipt QR codes -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <script type="text/javascript">
        // Helper to prevent XSS and prevent ReferenceError crashes
        function escapeHtml(value) {
            if (value === null || value === undefined) return "";
            const element = document.createElement("div");
            element.textContent = String(value);
            return element.innerHTML;
        }

        document.addEventListener("DOMContentLoaded", function () {
            const canOperate = window.SmartScanTabGuard.claimRegister(() => {
                // If another tab takes over, immediately release webcam hardware
                if (typeof pauseYoloScanner === "function") {
                    pauseYoloScanner();
                }
            });

            // Do NOT wipe CustomerDisplay or initialize camera if this is a blocked duplicate tab
            if (!canOperate) return;

            // Purge stale customer & debt session data if starting a fresh checkout session
            if (!sessionStorage.getItem("verificationReason")) {
                sessionStorage.removeItem("verifiedCustomerId");
                sessionStorage.removeItem("verifiedCustomerName");
                sessionStorage.removeItem("activeDebtTransactionIds");
                sessionStorage.removeItem("activeDebtPenalty");
                sessionStorage.removeItem("activeDebtDueDate");
                sessionStorage.removeItem("customerAgeVerified");
            }

            // Initialize secondary customer display cleanly
            localStorage.setItem("smartScanCustomerDisplay", JSON.stringify({ items: [], total: 0 }));

            // Bind UI & Video stream elements
            const video = document.getElementById("webcamFeed");
            const videoContainer = document.getElementById("videoContainer");
            const captureCanvas = document.getElementById("captureCanvas");
            const captureCtx = captureCanvas ? captureCanvas.getContext("2d") : null;
            const overlay = document.getElementById("overlayCanvas");
            const overlayCtx = overlay ? overlay.getContext("2d") : null;

            const placeholder = document.getElementById("cameraPlaceholder");
            const startBtn = document.getElementById("startCamBtn");
            const stopBtn = document.getElementById("stopCamBtn");
            const cameraSelect = document.getElementById("cameraSelect");
            const list = document.getElementById("identifiedItemsList");
            const totalDueDisplay = document.getElementById("totalDueDisplay");

            let isScanningActive = false;
            let isProcessingFrame = false;
            let mediaStream = null;
            const recentDetections = [];
            const detectionHoldMs = 300;

            const priceCache = {};
            let manualItems = [];
            let shouldResumeYoloAfterBarcode = false;

            // ================= LIVE AUTO-ADD/REMOVE LOGIC (SYNC) =================
            async function processLiveAutoAdd(yoloCounts) {
                for (const [itemName, quantityInFrame] of Object.entries(yoloCounts)) {
                    if (!priceCache[itemName]) {
                        try {
                            const response = await fetch(`/Home/GetProductDetails?productName=${encodeURIComponent(itemName)}`);
                            if (response.ok) {
                                const data = await response.json();
                                if (data.success && data.price !== undefined) {
                                    priceCache[itemName] = data;
                                } else {
                                    priceCache[itemName] = { notFound: true };
                                }
                            } else {
                                priceCache[itemName] = { notFound: true };
                            }
                        } catch (e) { priceCache[itemName] = { notFound: true }; }
                    }

                    const prod = priceCache[itemName];
                    if (prod && !prod.notFound) {
                        const cartItem = manualItems.find(i => i.name === prod.name);

                        if (cartItem) {
                            if (!cartItem.isLocked) {
                                const targetQty = Math.min(quantityInFrame, prod.stock);
                                if (cartItem.qty !== targetQty) {
                                    if (targetQty > cartItem.qty) playBeepSound();
                                    cartItem.qty = targetQty;
                                }
                            }
                        } else {
                            const targetQty = Math.min(quantityInFrame, prod.stock);
                            if (targetQty > 0) {
                                playBeepSound();
                                manualItems.push({
                                    name: prod.name,
                                    price: prod.price,
                                    qty: targetQty,
                                    stock: prod.stock,
                                    isAgeRestricted: prod.isAgeRestricted === true || prod.isAgeRestricted === 1,
                                    isLocked: false
                                });
                            }
                        }
                    }
                }

                for (let i = manualItems.length - 1; i >= 0; i--) {
                    const item = manualItems[i];
                    if (!item.isLocked) {
                        let isSeenByYolo = false;
                        for (const [yoloName, yoloQty] of Object.entries(yoloCounts)) {
                            if (priceCache[yoloName] && priceCache[yoloName].name === item.name) {
                                isSeenByYolo = true;
                                break;
                            }
                        }

                        if (!isSeenByYolo) {
                            manualItems.splice(i, 1);
                        }
                    }
                }
            }

            // ================= BARCODE PREPROCESSING =================
            const barcodeCanvas = document.createElement("canvas");
            const barcodeCtx = barcodeCanvas.getContext("2d", { willReadFrequently: true });
            let isZxingBusy = false;

            let barcodeDetector = null;
            if ('BarcodeDetector' in window) {
                barcodeDetector = new BarcodeDetector({
                    formats: ['ean_13', 'ean_8', 'upc_a', 'upc_e', 'code_128', 'code_39', 'qr_code']
                });
            }

            let zxingReader = null;
            if (!barcodeDetector && typeof ZXing !== 'undefined') {
                zxingReader = new ZXing.BrowserMultiFormatReader();
            }

            const scannedBarcodeCooldown = new Map();
            const BARCODE_COOLDOWN_MS = 2500;

            function preprocessBarcodeFrame(sourceVideo) {
                const sw = sourceVideo.videoWidth;
                const sh = sourceVideo.videoHeight;
                if (!sw || !sh) return null;

                const cropWidth = Math.round(sw * 0.55);
                const cropHeight = Math.round(sh * 0.55);
                const cropX = Math.round((sw - cropWidth) / 2);
                const cropY = Math.round((sh - cropHeight) / 2);

                barcodeCanvas.width = cropWidth;
                barcodeCanvas.height = cropHeight;

                barcodeCtx.drawImage(
                    sourceVideo,
                    cropX, cropY, cropWidth, cropHeight,
                    0, 0, cropWidth, cropHeight
                );

                const imgData = barcodeCtx.getImageData(0, 0, cropWidth, cropHeight);
                const d = imgData.data;

                for (let i = 0; i < d.length; i += 4) {
                    const gray = 0.299 * d[i] + 0.587 * d[i + 1] + 0.114 * d[i + 2];
                    d[i] = gray > 115 ? 255 : 0;
                    d[i + 1] = gray > 115 ? 255 : 0;
                    d[i + 2] = gray > 115 ? 255 : 0;
                }

                barcodeCtx.putImageData(imgData, 0, 0);
                return barcodeCanvas;
            }

            async function handleWebcamBarcodeDetected(rawCode) {
                const code = String(rawCode || '').trim();
                if (!code) return;

                const now = Date.now();
                const lastSeen = scannedBarcodeCooldown.get(code) || 0;
                if (now - lastSeen < BARCODE_COOLDOWN_MS) return;
                scannedBarcodeCooldown.set(code, now);

                try {
                    const dbResponse = await fetch(`/Home/GetProductDetails?productName=${encodeURIComponent(code)}`);
                    if (!dbResponse.ok) return;

                    const product = await dbResponse.json();
                    if (!product.success || product.price === undefined) return;

                    const alreadyInCart = manualItems.some(i => i.name.toLowerCase() === product.name.toLowerCase());
                    if (alreadyInCart) return;

                    if (product.stock <= 0) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Out of Stock',
                            text: `There are no ${product.name} left in inventory.`,
                            confirmButtonColor: '#1162a3'
                        });
                        return;
                    }

                    manualItems.push({
                        name: product.name,
                        price: product.price,
                        qty: 1,
                        stock: product.stock,
                        isAgeRestricted: product.isAgeRestricted === true || product.isAgeRestricted === 1,
                        isLocked: true
                    });

                    playBeepSound();
                    await buildCartAndRender();

                } catch (err) {
                    console.error("Webcam barcode lookup error:", err);
                }
            }

            let html5QrScanner = null;
            let isScannerActive = false;
            let isProcessingScan = false;

            const scannerModalEl = document.getElementById("barcodeScannerModal");
            const scannerStatus = document.getElementById("scannerStatus");

            function pauseYoloScanner() {
                isScanningActive = false;
                isProcessingFrame = false;

                if (mediaStream) {
                    mediaStream.getTracks().forEach(track => track.stop());
                    mediaStream = null;
                }
                if (video) video.srcObject = null;
                if (overlayCtx && overlay) overlayCtx.clearRect(0, 0, overlay.width, overlay.height);
                recentDetections.length = 0;

                if (!shouldResumeYoloAfterBarcode) {
                    manualItems = manualItems.filter(item => item.isLocked);
                    buildCartAndRender();
                }
            }

            async function resumeYoloScanner() {
                try {
                    await startSelectedCamera();
                    isScanningActive = true;
                    startDetectionLoop();
                } catch (err) {
                    console.error("Failed to resume YOLO scanner:", err);
                }
            }

            if (scannerModalEl) {
                scannerModalEl.addEventListener("show.bs.modal", function () {
                    if (isScanningActive) {
                        shouldResumeYoloAfterBarcode = true;
                        pauseYoloScanner();
                    } else {
                        shouldResumeYoloAfterBarcode = false;
                    }
                });

                scannerModalEl.addEventListener("shown.bs.modal", function () {
                    setTimeout(() => {
                        startBarcodeModalScanner();
                    }, 300);
                });

                scannerModalEl.addEventListener("hidden.bs.modal", async function () {
                    await stopBarcodeModalScanner();
                    if (shouldResumeYoloAfterBarcode) {
                        shouldResumeYoloAfterBarcode = false;
                        setTimeout(() => {
                            resumeYoloScanner();
                        }, 300);
                    }
                });
            }

            async function startBarcodeModalScanner() {
                if (isScannerActive) return;
                isScannerActive = true;
                isProcessingScan = false;

                if (scannerStatus) {
                    scannerStatus.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Initializing camera...';
                    scannerStatus.className = "alert alert-info py-2 small fw-semibold text-center mb-0";
                }

                try {
                    html5QrScanner = new Html5Qrcode("qrReader");
                    const qrBoxWidth = Math.min(280, Math.max(180, Math.floor(window.innerWidth * 0.65)));
                    const qrBoxHeight = Math.round(qrBoxWidth * 0.5);

                    await html5QrScanner.start(
                        { facingMode: "environment" },
                        { fps: 15, qrbox: { width: qrBoxWidth, height: qrBoxHeight } },
                        (decodedText) => { processLiveScan(decodedText); },
                        () => { }
                    );

                    if (scannerStatus) {
                        scannerStatus.innerHTML = '<i class="fa-solid fa-camera me-1"></i>Live scanner active. Hold barcode in view.';
                        scannerStatus.className = "alert alert-success py-2 small fw-semibold text-center mb-0";
                    }
                } catch (err) {
                    if (scannerStatus) {
                        scannerStatus.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-1"></i>Camera failed to initialize.';
                        scannerStatus.className = "alert alert-danger py-2 small fw-semibold text-center mb-0";
                    }
                    isScannerActive = false;
                }
            }

            async function stopBarcodeModalScanner() {
                if (html5QrScanner) {
                    try {
                        await html5QrScanner.stop();
                        html5QrScanner.clear();
                    } catch (e) { }
                    html5QrScanner = null;
                }
                isScannerActive = false;
                isProcessingScan = false;
            }

            function playBeepSound() {
                try {
                    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.frequency.value = 1750;
                    gain.gain.value = 0.1;
                    osc.start();
                    setTimeout(() => osc.stop(), 80);
                } catch (e) { }
            }

            async function processLiveScan(decodedText) {
                if (isProcessingScan) return;
                isProcessingScan = true;

                let retrievedNumber = String(decodedText || '');

                try {
                    const parsedData = JSON.parse(decodedText);
                    if (parsedData && typeof parsedData === "object") {
                        retrievedNumber = parsedData.barcode || parsedData.Barcode || parsedData.number || parsedData.id || Object.values(parsedData)[0] || decodedText;
                    }
                } catch (error) { }

                const normalizedBarcode = String(retrievedNumber).replace(/\s+/g, '').trim();
                if (!normalizedBarcode) {
                    isProcessingScan = false;
                    return;
                }

                try {
                    const dbResponse = await fetch(`/Home/GetProductDetails?productName=${encodeURIComponent(normalizedBarcode)}`);
                    if (dbResponse.ok) {
                        const product = await dbResponse.json();

                        if (product.success && product.price !== undefined) {
                            const alreadyInCart = manualItems.some(i => i.name.toLowerCase() === product.name.toLowerCase());
                            if (alreadyInCart) {
                                closeScannerModal();
                                return;
                            }

                            if (product.stock <= 0) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Out of Stock',
                                    text: `There are no ${product.name} left in inventory.`,
                                    confirmButtonColor: '#1162a3'
                                });
                                closeScannerModal();
                                return;
                            }

                            manualItems.push({
                                name: product.name,
                                price: product.price,
                                qty: 1,
                                stock: product.stock,
                                isAgeRestricted: product.isAgeRestricted === true || product.isAgeRestricted === 1,
                                isLocked: true
                            });

                            playBeepSound();
                            await buildCartAndRender();
                            closeScannerModal();
                            return;
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Not Found',
                                text: `No product registered for barcode "${normalizedBarcode}".`,
                                confirmButtonColor: '#1162a3'
                            });
                        }
                    }
                } catch (err) {
                    console.error("Barcode lookup error:", err);
                } finally {
                    isProcessingScan = false;
                }
            }

            function closeScannerModal() {
                if (!scannerModalEl) return;
                const modal = bootstrap.Modal.getInstance(scannerModalEl);
                if (modal) modal.hide();
            }

            // ================= SEARCH & MANUAL INPUT =================
            const productSearchInput = document.getElementById("manualProductInput");
            const productSearchResults = document.getElementById("productSearchResults");
            const btnAddProduct = document.getElementById("btnAddProduct");
            let recentSearches = JSON.parse(localStorage.getItem("smartScanRecentSearches") || "[]");

            function showRecentSearches() {
                if (!productSearchResults) return;
                productSearchResults.innerHTML = "";
                if (recentSearches.length === 0) {
                    productSearchResults.style.display = "none";
                    return;
                }

                productSearchResults.innerHTML = "<div class='px-3 py-1 fw-bold text-muted small border-bottom'>Recent Searches</div>";
                recentSearches.slice(0, 3).forEach(search => {
                    const item = document.createElement("div");
                    item.className = "px-3 py-2 small rounded hover-bg cursor-pointer d-flex align-items-center";
                    item.style.cursor = "pointer";
                    item.innerHTML = `<i class="fa-solid fa-clock me-2 text-muted"></i>${escapeHtml(search)}`;
                    item.addEventListener("click", () => {
                        productSearchInput.value = search;
                        productSearchResults.style.display = "none";
                    });
                    productSearchResults.appendChild(item);
                });
                productSearchResults.style.display = "block";
            }

            function saveRecentSearch(search) {
                search = (search || '').trim();
                if (!search) return;
                recentSearches = recentSearches.filter(item => item.toLowerCase() !== search.toLowerCase());
                recentSearches.unshift(search);
                recentSearches = recentSearches.slice(0, 3);
                localStorage.setItem("smartScanRecentSearches", JSON.stringify(recentSearches));
            }

            if (productSearchInput) {
                productSearchInput.addEventListener("focus", () => {
                    if (productSearchInput.value.trim() === "") showRecentSearches();
                });

                productSearchInput.addEventListener("keydown", (e) => {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        if (btnAddProduct) btnAddProduct.click();
                    }
                });

                let searchTimeout = null;
                productSearchInput.addEventListener("input", () => {
                    const query = productSearchInput.value.trim();

                    if (query !== "") {
                        clearTimeout(searchTimeout);
                        searchTimeout = setTimeout(async () => {
                            try {
                                const response = await fetch(`/Home/SearchProducts?term=${encodeURIComponent(query)}`, {
                                    cache: 'no-store'
                                });
                                if (response.ok) {
                                    const results = await response.json();
                                    renderSearchResults(results);
                                }
                            } catch (error) {
                                console.error("Autocomplete search failed:", error);
                            }
                        }, 250);
                    } else {
                        showRecentSearches();
                    }
                });
            }

            function renderSearchResults(results) {
                if (!productSearchResults) return;
                productSearchResults.innerHTML = "";

                if (!results || results.length === 0) {
                    productSearchResults.innerHTML = "<div class='px-3 py-2 small text-muted'>No matches found...</div>";
                    productSearchResults.style.display = "block";
                    return;
                }

                productSearchResults.innerHTML = "<div class='px-3 py-1 fw-bold text-muted small border-bottom'>Matching Products</div>";

                results.forEach(item => {
                    const row = document.createElement("div");
                    row.className = "px-3 py-2 small rounded hover-bg cursor-pointer d-flex flex-wrap justify-content-between align-items-center gap-1 text-dark";
                    row.style.cursor = "pointer";

                    const barcodeSnippet = item.barcode
                        ? `<span class="badge bg-light text-secondary border font-monospace ms-1"><i class="fa-solid fa-barcode"></i> ${escapeHtml(item.barcode)}</span>`
                        : "";

                    const stockSnippet = typeof item.stock === "number"
                        ? `<span class="badge ${item.stock > 0 ? 'bg-success-subtle text-success border-success-subtle' : 'bg-danger-subtle text-danger border-danger-subtle'} border ms-1">Stock: ${item.stock}</span>`
                        : "";

                    row.innerHTML = `
                        <span><i class="fa-solid fa-box me-2 text-muted"></i>${escapeHtml(item.name)}</span>
                        <div class="d-flex align-items-center flex-wrap gap-1">${barcodeSnippet}${stockSnippet}</div>
                    `;

                    row.addEventListener("mouseenter", () => row.classList.add("bg-light"));
                    row.addEventListener("mouseleave", () => row.classList.remove("bg-light"));

                    row.addEventListener("click", () => {
                        productSearchInput.value = item.name;
                        productSearchResults.style.display = "none";
                        if (btnAddProduct) btnAddProduct.click();
                    });

                    productSearchResults.appendChild(row);
                });

                productSearchResults.style.display = "block";
            }

            document.addEventListener("click", event => {
                if (productSearchInput && productSearchResults && !productSearchInput.contains(event.target) && !productSearchResults.contains(event.target)) {
                    productSearchResults.style.display = "none";
                }
            });

            // ================= MANUAL ADD BUTTON =================
            if (btnAddProduct) {
                btnAddProduct.addEventListener("click", async () => {
                    const query = productSearchInput ? productSearchInput.value.trim() : "";
                    if (!query) return;

                    try {
                        const dbResponse = await fetch(`/Home/GetProductDetails?productName=${encodeURIComponent(query)}`, {
                            cache: 'no-store'
                        });

                        if (dbResponse.ok) {
                            const product = await dbResponse.json();

                            if (product.success === false || product.price === undefined) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Not Found',
                                    text: `No product found matching "${query}".`,
                                    confirmButtonColor: '#1162a3'
                                });
                                return;
                            }

                            if (product.stock <= 0) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Out of Stock',
                                    text: `There are no ${product.name} left in inventory.`,
                                    confirmButtonColor: '#1162a3'
                                });
                                return;
                            }

                            saveRecentSearch(product.name);

                            const existing = manualItems.find(i => i.name.toLowerCase() === product.name.toLowerCase());
                            const currentQty = existing ? existing.qty : 0;

                            // Always sync the latest stock & price from the database response
                            if (existing) {
                                existing.stock = product.stock;
                                existing.price = product.price;
                            }

                            if (currentQty + 1 > product.stock) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Stock Limit Reached',
                                    text: `Cannot add more ${product.name}. Store inventory limit is ${product.stock}.`,
                                    confirmButtonColor: '#1162a3'
                                });
                            } else {
                                if (existing) {
                                    existing.qty++;
                                    existing.isLocked = true;
                                } else {
                                    manualItems.push({
                                        name: product.name,
                                        price: product.price,
                                        qty: 1,
                                        stock: product.stock,
                                        isAgeRestricted: product.isAgeRestricted === true || product.isAgeRestricted === 1,
                                        isLocked: true
                                    });
                                }
                            }

                            productSearchInput.value = "";
                            productSearchResults.style.display = "none";
                            await buildCartAndRender();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Failed to retrieve product details.',
                                confirmButtonColor: '#1162a3'
                            });
                        }
                    } catch (err) {
                        console.error("Lookup error:", err);
                    }
                });
            }

            // ================= COUNTER CAMERA SETUP =================
            function isCameraApiAvailable() {
                return !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia && navigator.mediaDevices.enumerateDevices);
            }

            async function loadCameras(requestPermission = false) {
                if (!cameraSelect) return;

                if (!isCameraApiAvailable()) {
                    cameraSelect.innerHTML = "<option value=''>Camera Blocked (HTTP)</option>";
                    return;
                }

                try {
                    if (requestPermission) {
                        const tempStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                        tempStream.getTracks().forEach(t => t.stop());
                    }
                } catch (permErr) {
                    console.warn("Initial camera permission deferred:", permErr);
                }

                try {
                    const devices = await navigator.mediaDevices.enumerateDevices();
                    const videoDevices = devices.filter(d => d.kind === "videoinput");

                    const previousValue = cameraSelect.value;
                    cameraSelect.innerHTML = "";

                    if (videoDevices.length === 0) {
                        cameraSelect.innerHTML = "<option value=''>No camera detected</option>";
                        return;
                    }

                    let hasSelectedPreferred = false;
                    videoDevices.forEach((device, index) => {
                        const option = document.createElement("option");
                        option.value = device.deviceId;
                        option.text = device.label || `Camera ${index + 1}`;

                        if (previousValue && device.deviceId === previousValue) {
                            option.selected = true;
                            hasSelectedPreferred = true;
                        } else if (!hasSelectedPreferred) {
                            const lowerLabel = (device.label || "").toLowerCase();
                            if (lowerLabel.includes("back") || lowerLabel.includes("rear") || lowerLabel.includes("environment") || lowerLabel.includes("usb") || lowerLabel.includes("droidcam") || lowerLabel.includes("a4tech")) {
                                option.selected = true;
                                hasSelectedPreferred = true;
                            }
                        }
                        cameraSelect.appendChild(option);
                    });
                } catch (err) {
                    console.error("Failed to enumerate cameras:", err);
                    cameraSelect.innerHTML = "<option value=''>Default Camera</option>";
                }
            }
            loadCameras(false);

            if (navigator.mediaDevices && typeof navigator.mediaDevices.addEventListener === "function") {
                navigator.mediaDevices.addEventListener("devicechange", () => loadCameras(false));
            }

            async function startSelectedCamera() {
                if (!isCameraApiAvailable()) {
                    throw new Error("Browser blocked camera access on insecure HTTP. Launch Edge with the SmartScanPOS flag or use HTTPS.");
                }

                if (mediaStream) {
                    mediaStream.getTracks().forEach(track => track.stop());
                }

                const selectedDeviceId = cameraSelect ? cameraSelect.value : "";
                const videoConstraints = {
                    width: { ideal: 1280 },
                    height: { ideal: 720 },
                    frameRate: { ideal: 30 }
                };

                if (selectedDeviceId) {
                    videoConstraints.deviceId = { exact: selectedDeviceId };
                } else {
                    videoConstraints.facingMode = { ideal: "environment" };
                }

                try {
                    mediaStream = await navigator.mediaDevices.getUserMedia({ video: videoConstraints, audio: false });
                } catch (primaryErr) {
                    try {
                        mediaStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: "environment" } }, audio: false });
                    } catch (fallbackErr) {
                        mediaStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                    }
                }

                if (video) video.srcObject = mediaStream;

                const track = mediaStream.getVideoTracks()[0];
                if (track) {
                    track.onended = () => {
                        if (isScanningActive && stopBtn) {
                            stopBtn.click();
                        }
                    };
                }
                const activeDeviceId = track && track.getSettings ? track.getSettings().deviceId : "";

                // Refresh dropdown labels after camera permission is granted
                await loadCameras(false);
                if (cameraSelect && activeDeviceId) {
                    cameraSelect.value = activeDeviceId;
                }

                const capabilities = track && track.getCapabilities ? track.getCapabilities() : {};
                if (capabilities.focusMode && capabilities.focusMode.includes("continuous")) {
                    try {
                        await track.applyConstraints({ advanced: [{ focusMode: "continuous" }] });
                    } catch (e) { }
                }
            }

            if (startBtn) {
                startBtn.addEventListener("click", async function () {
                    try {
                        await startSelectedCamera();
                        if (placeholder) placeholder.style.display = "none";
                        if (videoContainer) videoContainer.style.display = "block";
                        startBtn.classList.add("d-none");
                        if (stopBtn) stopBtn.classList.remove("d-none");
                        const wrapper = document.getElementById("cameraDropdownWrapper");
                        if (wrapper) wrapper.style.backgroundColor = "#dc3545";

                        isScanningActive = true;
                        startDetectionLoop();
                    } catch (err) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Camera Error',
                            text: 'Failed to access camera: ' + err.message,
                            confirmButtonColor: '#1162a3'
                        });
                    }
                });
            }

            if (cameraSelect) {
                cameraSelect.addEventListener("change", async function () {
                    if (mediaStream) {
                        try { await startSelectedCamera(); } catch (err) { console.error(err); }
                    }
                });
            }

            if (stopBtn) {
                stopBtn.addEventListener("click", function () {
                    isScanningActive = false;
                    isProcessingFrame = false;

                    if (mediaStream) {
                        mediaStream.getTracks().forEach(track => track.stop());
                        mediaStream = null;
                    }
                    if (video) video.srcObject = null;

                    const detectedCountDisplay = document.getElementById("detectedCountDisplay");
                    if (detectedCountDisplay) detectedCountDisplay.textContent = "0";

                    if (overlayCtx && overlay) overlayCtx.clearRect(0, 0, overlay.width, overlay.height);
                    recentDetections.length = 0;

                    manualItems = manualItems.filter(item => item.isLocked);

                    if (videoContainer) videoContainer.style.display = "none";
                    if (placeholder) placeholder.style.display = "block";
                    stopBtn.classList.add("d-none");
                    if (startBtn) startBtn.classList.remove("d-none");
                    const wrapper = document.getElementById("cameraDropdownWrapper");
                    if (wrapper) wrapper.style.backgroundColor = "#1162a3";

                    buildCartAndRender();
                });
            }

            async function startDetectionLoop() {
                while (isScanningActive) {
                    if (!isProcessingFrame && video && video.readyState === video.HAVE_ENOUGH_DATA) {
                        isProcessingFrame = true;
                        await captureAndDetect();
                        isProcessingFrame = false;
                    }
                    await new Promise(resolve => setTimeout(resolve, 100));
                }
            }

            async function captureAndDetect() {
                if (!isScanningActive || !video || video.videoWidth === 0 || video.videoHeight === 0) return;

                if (captureCanvas && (captureCanvas.width !== video.videoWidth || captureCanvas.height !== video.videoHeight)) {
                    captureCanvas.width = video.videoWidth;
                    captureCanvas.height = video.videoHeight;
                }

                if (overlay && (overlay.width !== video.videoWidth || overlay.height !== video.videoHeight)) {
                    overlay.width = video.videoWidth;
                    overlay.height = video.videoHeight;
                }

                if (captureCtx && captureCanvas) {
                    captureCtx.drawImage(video, 0, 0, captureCanvas.width, captureCanvas.height);
                }

                const enhancedCanvas = preprocessBarcodeFrame(video);
                if (enhancedCanvas) {
                    if (barcodeDetector) {
                        barcodeDetector.detect(enhancedCanvas).then(barcodes => {
                            if (barcodes && barcodes.length > 0) {
                                for (const b of barcodes) {
                                    if (b.rawValue) handleWebcamBarcodeDetected(b.rawValue);
                                }
                            }
                        }).catch(() => { });
                    } else if (zxingReader && !isZxingBusy) {
                        isZxingBusy = true;
                        try {
                            if (typeof zxingReader.decodeFromCanvas === 'function') {
                                zxingReader.decodeFromCanvas(enhancedCanvas).then(result => {
                                    if (result && result.getText()) handleWebcamBarcodeDetected(result.getText());
                                }).catch(() => { }).finally(() => {
                                    isZxingBusy = false;
                                });
                            } else {
                                isZxingBusy = false;
                            }
                        } catch (err) {
                            console.warn("Barcode scanner skipped.", err);
                            isZxingBusy = false;
                        }
                    }
                }

                try {
                    const frameBase64 = captureCanvas.toDataURL("image/jpeg", 0.5);
                    const response = await fetch("/api/Scan/detect", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ image: frameBase64 })
                    });

                    if (!isScanningActive) return;

                    const data = await response.json();
                    if (!isScanningActive) return;

                    const detections = data.detections || [];
                    const now = Date.now();
                    const currentDetections = detections.filter(d => d.box);

                    const validDetections = [];
                    for (const detected of currentDetections) {
                        if (!priceCache[detected.name]) {
                            priceCache[detected.name] = { pending: true };
                            fetch(`/Home/GetProductDetails?productName=${encodeURIComponent(detected.name)}`)
                                .then(res => res.json())
                                .then(prod => {
                                    if (prod.success === false || prod.price === undefined) {
                                        priceCache[detected.name] = { notFound: true };
                                    } else {
                                        priceCache[detected.name] = prod;
                                    }
                                }).catch(() => { priceCache[detected.name] = { notFound: true }; });
                        }

                        if (priceCache[detected.name] && priceCache[detected.name].notFound) {
                            continue;
                        }
                        validDetections.push(detected);
                    }

                    const detectedCountDisplay = document.getElementById("detectedCountDisplay");
                    if (detectedCountDisplay) {
                        detectedCountDisplay.textContent = validDetections.length;
                    }

                    for (const detected of validDetections) {
                        const [x1, y1, x2, y2] = detected.box;
                        let previous = recentDetections.find(item =>
                            item.name === detected.name &&
                            Math.abs(item.box[0] - x1) < video.videoWidth * 0.12 &&
                            Math.abs(item.box[1] - y1) < video.videoHeight * 0.12
                        );

                        if (!previous) {
                            previous = { name: detected.name, box: detected.box, confidence: detected.confidence };
                            recentDetections.push(previous);
                        }

                        if (previous.lastSeen) {
                            previous.box = detected.box.map((coordinate, index) =>
                                Math.round(previous.box[index] * 0.65 + coordinate * 0.35)
                            );
                            previous.confidence = Math.round(
                                (previous.confidence * 0.65 + detected.confidence * 0.35) / 5
                            ) * 5;
                        } else {
                            previous.box = detected.box;
                            previous.confidence = detected.confidence;
                        }
                        previous.lastSeen = now;
                    }

                    for (let i = recentDetections.length - 1; i >= 0; i--) {
                        if (now - (recentDetections[i].lastSeen || 0) > detectionHoldMs) {
                            recentDetections.splice(i, 1);
                        }
                    }

                    if (overlayCtx && overlay) {
                        overlayCtx.clearRect(0, 0, overlay.width, overlay.height);

                        for (const detected of recentDetections) {
                            const [x1, y1, x2, y2] = detected.box;
                            const boxColor = detected.confidence >= 80 ? "#00FF00" : "#FFA500";
                            overlayCtx.lineWidth = 3;
                            overlayCtx.strokeStyle = boxColor;
                            overlayCtx.strokeRect(x1, y1, x2 - x1, y2 - y1);
                            overlayCtx.fillStyle = boxColor;
                            overlayCtx.font = "bold 15px Arial";
                            overlayCtx.fillText(`${detected.name} (${detected.confidence}%)`, x1, Math.max(18, y1 - 8));
                        }
                    }

                    const yoloCounts = {};
                    const lowConfidenceItems = {};

                    for (const detected of recentDetections) {
                        if (detected.confidence >= 80) {
                            yoloCounts[detected.name] = (yoloCounts[detected.name] || 0) + 1;
                        } else {
                            lowConfidenceItems[detected.name] = Math.max(lowConfidenceItems[detected.name] || 0, Math.round(detected.confidence));
                        }
                    }

                    if (!isScanningActive) return;

                    await processLiveAutoAdd(yoloCounts);
                    if (!isScanningActive) return;

                    await buildCartAndRender(lowConfidenceItems);

                } catch (error) {
                    if (!isScanningActive) return;
                    console.error("Cannot connect to Python Server:", error);
                    if (list) list.innerHTML = "<tr><td colspan='5' class='text-danger text-center py-3'>Lost connection to AI Scanner!</td></tr>";
                }
            }

            // ================= CART RENDERER =================
            window.buildCartAndRender = async function (lowConfidenceItems = {}) {
                let htmlOutput = "";
                let currentTotal = 0;

                manualItems.forEach((item, index) => {
                    const subtotal = item.price * item.qty;
                    currentTotal += subtotal;

                    const ageBadgeHtml = (item.isAgeRestricted === true || item.isAgeRestricted === 1)
                        ? `<span class="badge bg-danger text-white rounded-pill ms-1" style="font-size: 9px;">18+</span>`
                        : ``;

                    const sourceBadgeHtml = item.isLocked
                        ? `<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill ms-1" style="font-size: 9px;"><i class="fa-solid fa-lock"></i> Locked</span>`
                        : `<span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill ms-1" style="font-size: 9px;"><i class="fa-solid fa-video"></i> Auto-Syncing</span>`;

                    const lockIcon = item.isLocked ? "fa-lock" : "fa-lock-open";
                    const lockBtnClass = item.isLocked ? "btn-success bg-success-subtle border-success" : "btn-outline-secondary";
                    const lockTitle = item.isLocked ? "Unlock Auto-Sync" : "Lock Product";

                    htmlOutput += `
                        <tr>
                            <td class="fw-medium text-truncate" style="max-width: 140px;">
                                ${escapeHtml(item.name)}
                                ${sourceBadgeHtml}
                                ${ageBadgeHtml}
                            </td>
                            <td class="text-center fw-bold">${item.qty}</td>
                            <td class="text-end text-muted small text-nowrap">₱${item.price.toFixed(2)}</td>
                            <td class="text-end text-primary fw-bold small text-nowrap">₱${subtotal.toFixed(2)}</td>
                            <td class="text-center text-nowrap">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <button class="btn btn-sm ${lockBtnClass} rounded-circle p-1" style="width: 22px; height: 22px; display: inline-grid; place-items: center;" onclick="toggleLockItem(${index})" title="${lockTitle}">
                                        <i class="fa-solid ${lockIcon}" style="font-size: 9px;"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary rounded-circle p-1" style="width: 22px; height: 22px; display: inline-grid; place-items: center;" onclick="editManualItem(${index})" title="Edit Qty">
                                        <i class="fa-solid fa-pen" style="font-size: 9px;"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger rounded-circle p-1" style="width: 22px; height: 22px; display: inline-grid; place-items: center;" onclick="removeManualItem(${index})" title="Delete">
                                        <i class="fa-solid fa-xmark" style="font-size: 9px;"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>`;
                });

                for (const [itemName, conf] of Object.entries(lowConfidenceItems)) {
                    const isAlreadyInCart = manualItems.some(i => i.name === itemName);
                    if (!isAlreadyInCart) {
                        htmlOutput += `
                            <tr class="table-warning">
                                <td class="fw-medium text-truncate text-muted" style="max-width: 140px;">
                                    ${escapeHtml(itemName)}
                                    <br><span class="badge bg-warning text-dark border border-warning rounded-pill mt-1" style="font-size: 9px;"><i class="fa-solid fa-spinner fa-spin"></i> Low Conf (${conf}%)</span>
                                </td>
                                <td class="text-center fw-bold text-muted">-</td>
                                <td class="text-end text-muted small fw-medium">Pending</td>
                                <td class="text-end text-muted fw-bold small fw-medium">Pending</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-secondary" style="font-size: 10px;" disabled>Processing</button>
                                </td>
                            </tr>`;
                    }
                }

                if (htmlOutput === "" && manualItems.length === 0) {
                    htmlOutput = "<tr><td colspan='5' class='text-muted text-center py-4'>No products detected on checkout tray...</td></tr>";
                }

                if (list) list.innerHTML = htmlOutput;
                if (totalDueDisplay) totalDueDisplay.innerText = `₱ ${currentTotal.toFixed(2)}`;

                const btnLockAll = document.getElementById("btnLockAllItems");
                if (btnLockAll) {
                    const hasUnlocked = manualItems.some(item => !item.isLocked);
                    btnLockAll.disabled = !hasUnlocked;

                    if (manualItems.length > 0 && !hasUnlocked) {
                        btnLockAll.style.backgroundColor = "#dcfce7";
                        btnLockAll.style.color = "#166534";
                        btnLockAll.style.borderColor = "#bbf7d0";
                        btnLockAll.innerHTML = '<i class="fa-solid fa-circle-check"></i><span>All Locked</span>';
                    } else {
                        btnLockAll.style.backgroundColor = "#dbeafe";
                        btnLockAll.style.color = "#1162a3";
                        btnLockAll.style.borderColor = "#cfe2f3";
                        btnLockAll.innerHTML = '<i class="fa-solid fa-lock"></i><span>Lock All</span>';
                    }
                }

                const broadcastItems = [];
                let customerTotal = 0;
                manualItems.forEach(item => {
                    broadcastItems.push({ name: item.name, qty: item.qty, price: item.price });
                    customerTotal += (item.price * item.qty);
                });
                localStorage.setItem("smartScanCustomerDisplay", JSON.stringify({ items: broadcastItems, total: customerTotal }));
            };

            // ================= CART CONTROLS =================
            window.lockAllItems = function () {
                let lockedAny = false;
                manualItems.forEach(item => {
                    if (!item.isLocked) {
                        item.isLocked = true;
                        lockedAny = true;
                    }
                });
                if (lockedAny) {
                    playBeepSound();
                    buildCartAndRender();
                }
            };

            window.toggleLockItem = function (index) {
                if (manualItems[index]) {
                    manualItems[index].isLocked = !manualItems[index].isLocked;
                    buildCartAndRender();
                }
            };

            const btnVoid = document.getElementById("btnVoidCart");
            if (btnVoid) {
                btnVoid.addEventListener("click", () => {
                    if (manualItems.length === 0) return;

                    Swal.fire({
                        title: 'Void Entire Cart?',
                        text: 'Are you sure you want to remove all saved items from the cart?',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: '<i class="fa-solid fa-trash-can me-1"></i>Yes, void cart',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            manualItems = [];
                            buildCartAndRender();

                            if (stopBtn && !stopBtn.classList.contains("d-none")) {
                                stopBtn.click();
                            }

                            Swal.fire({
                                icon: 'success',
                                title: 'Cart Cleared',
                                text: 'All items have been removed.',
                                timer: 1200,
                                showConfirmButton: false
                            });
                        }
                    });
                });
            }

            window.editManualItem = function (index) {
                const item = manualItems[index];
                if (!item) return;

                document.getElementById("editItemIndex").value = index;
                document.getElementById("editProductName").value = item.name;
                document.getElementById("editProductPrice").value = `PHP ${item.price.toFixed(2)}`;

                const qtyInput = document.getElementById("editProductQuantity");
                qtyInput.value = item.qty;
                qtyInput.classList.remove("is-invalid");

                const adjustModal = new bootstrap.Modal(document.getElementById("adjustQuantityModal"));
                adjustModal.show();
            };

            const btnConfirmAdjust = document.getElementById("btnConfirmAdjust");
            if (btnConfirmAdjust) {
                btnConfirmAdjust.addEventListener("click", function () {
                    const index = document.getElementById("editItemIndex").value;
                    const qtyInput = document.getElementById("editProductQuantity");
                    const newQty = parseInt(qtyInput.value);
                    const maxStock = (manualItems[index] && manualItems[index].stock) ? manualItems[index].stock : 999;

                    if (isNaN(newQty) || newQty <= 0) {
                        qtyInput.classList.add("is-invalid");
                        return;
                    }

                    if (newQty > maxStock) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Stock Limit Reached',
                            text: `You cannot enter a quantity higher than the available stock (${maxStock}).`,
                            confirmButtonColor: '#1162a3'
                        });
                        qtyInput.value = maxStock;
                        return;
                    }

                    qtyInput.classList.remove("is-invalid");
                    manualItems[index].qty = newQty;
                    manualItems[index].isLocked = true;

                    const adjustModal = bootstrap.Modal.getInstance(document.getElementById("adjustQuantityModal"));
                    if (adjustModal) adjustModal.hide();

                    buildCartAndRender();
                });
            }

            window.removeManualItem = function (index) {
                manualItems.splice(index, 1);
                buildCartAndRender();
            };

            // ================= PROCEED TO PAYMENT (WITH AGE CHECK ROUTING) =================
            const btnProceed = document.getElementById("btnProceedToPayment");
            if (btnProceed) {
                btnProceed.addEventListener("click", () => {
                    if (manualItems.length === 0) {
                        Swal.fire({
                            icon: 'info',
                            title: 'Cart is Empty',
                            text: 'Please scan or add items to the cart before proceeding to payment.',
                            confirmButtonColor: '#1162a3'
                        });
                        return;
                    }

                    sessionStorage.setItem("smartScanCart", JSON.stringify(manualItems));
                    const has18PlusItem = manualItems.some(item => item.isAgeRestricted === true || item.isAgeRestricted === 1);

                    if (has18PlusItem) {
                        sessionStorage.setItem("verificationReason", "AgeGated");
                        window.location.href = "/Home/CustomerVerification";
                    } else {
                        sessionStorage.removeItem("verificationReason");
                        sessionStorage.removeItem("verifiedCustomerName");
                        sessionStorage.removeItem("verifiedCustomerId");
                        window.location.href = "/Home/Payment";
                    }
                });
            }

            @if (TempData["ErrorMessage"] != null)
            {
                    <text>
                    Swal.fire({
                        icon: 'warning',
                        title: 'Notice',
                        text: @Html.Raw(Json.Serialize(TempData["ErrorMessage"])),
                        confirmButtonColor: '#1162a3'
                    });
                    </text>
            }
        });

        window.addEventListener('load', () => {
            setTimeout(() => {
                const MODEL_URL = 'https://cdn.jsdelivr.net/npm/@@vladmandic/face-api/model/';
                Promise.all([
                    faceapi.nets.ssdMobilenetv1.loadFromUri(MODEL_URL),
                    faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL),
                    faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
                ]).catch(err => console.warn("Background model fetch delayed.", err));
            }, 3000);
        });

        // ================= RECENT TRANSACTIONS STATE & INTERACTIVE RECEIPT =================
        let allTodayTransactions = [];
        let activeModalTransaction = null;
        let activeModalPublicUrl = "";
        let activeModalPlainText = "";

        function getPaymentBadgeHtml(methodId, methodName) {
            const safeName = escapeHtml(methodName || 'Cash');
            if (methodId === 4) {
                return `<span class="badge rounded-pill fw-semibold px-2 py-1 shadow-sm" style="font-size: 11px; background-color: #fff3cd; color: #856404; border: 1.5px solid #ffeeba;"><i class="fa-solid fa-coins me-1"></i>${safeName}</span>`;
            }
            if (methodId === 2) {
                return `<span class="badge rounded-pill fw-semibold px-2 py-1 shadow-sm text-success" style="font-size: 11px; background-color: #dcfce7; border: 1.5px solid #bbf7d0;"><i class="fa-solid fa-mobile-screen-button me-1"></i>${safeName}</span>`;
            }
            if (methodId === 3) {
                return `<span class="badge rounded-pill fw-semibold px-2 py-1 shadow-sm" style="font-size: 11px; background-color: #f3e8ff; color: #6b21a8; border: 1.5px solid #e9d5ff;"><i class="fa-solid fa-credit-card me-1"></i>${safeName}</span>`;
            }
            return `<span class="badge rounded-pill fw-semibold px-2 py-1 shadow-sm text-primary" style="font-size: 11px; background-color: #e0f2fe; border: 1.5px solid #bae6fd;"><i class="fa-solid fa-money-bill-wave me-1"></i>${safeName}</span>`;
        }

        window.openOldTransactions = async function () {
            const modalEl = document.getElementById('oldTransactionsModal');
            if (!modalEl) return;
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            closeReceiptPreview();
            const searchInput = document.getElementById('txSearchInput');
            if (searchInput) searchInput.value = "";

            const container = document.getElementById('oldTransactionsList');
            if (container) {
                container.innerHTML = `<div class="text-center py-4 text-muted small"><i class="fa-solid fa-spinner fa-spin text-primary me-2"></i>Loading transactions...</div>`;
            }

            try {
                const response = await fetch('/Home/GetOldTransactions');
                const data = await response.json();
                if (data.success && Array.isArray(data.transactions) && data.transactions.length > 0) {
                    allTodayTransactions = data.transactions;
                    renderTransactionCards(allTodayTransactions);
                } else {
                    if (container) container.innerHTML = '<div class="text-center py-4 text-muted small">No transactions found for today.</div>';
                }
            } catch (err) {
                console.error("Transaction fetch error:", err);
                if (container) container.innerHTML = '<div class="text-center py-4 text-danger small">Failed to load transaction history.</div>';
            }
        };

        function renderTransactionCards(transactions) {
            const container = document.getElementById('oldTransactionsList');
            if (!container) return;

            if (!transactions || transactions.length === 0) {
                container.innerHTML = '<div class="text-center py-4 text-muted small">No matching transactions found.</div>';
                return;
            }

            let html = '';
            transactions.forEach(tx => {
                const totalNum = typeof tx.total === 'number' ? tx.total : parseFloat(tx.total || 0);
                const customerSnippet = tx.customerName ? `<span class="badge bg-light text-dark border me-1">${escapeHtml(tx.customerName)}</span>` : '';
                const safeReceiptNum = escapeHtml(tx.receiptNumber || '');
                const paymentBadgeHtml = getPaymentBadgeHtml(tx.paymentMethodId, tx.paymentMethod);

                html += `
                    <div class="card border rounded-3 p-3 bg-white shadow-sm cursor-pointer transition-all hover-shadow"
                         style="cursor: pointer; user-select: none;"
                         onclick="showReceiptByReceiptNumber('${safeReceiptNum}')">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width: 38px; height: 38px;">
                                    <i class="fa-solid fa-receipt fs-6"></i>
                                </div>
                                <div class="text-start">
                                    <span class="fw-bold font-monospace text-dark d-block" style="font-size: 0.9rem;">
                                        ${safeReceiptNum}
                                    </span>
                                    <div class="text-muted d-flex flex-wrap align-items-center gap-1" style="font-size: 11px;">
                                        ${customerSnippet}
                                        <span><i class="fa-regular fa-clock me-1"></i>${escapeHtml(tx.date || '')}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="text-end ms-auto">
                                <div class="mb-1">
                                    ${paymentBadgeHtml}
                                </div>
                                <div class="fw-bold text-dark font-monospace lh-1" style="font-size: 1rem;">
                                    ₱${totalNum.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        function filterTransactionsList() {
            const input = document.getElementById('txSearchInput');
            const rawQuery = input ? input.value.trim().toLowerCase() : '';
            const cleanQuery = rawQuery.replace(/[₱,\s]/g, '');

            if (!rawQuery) {
                renderTransactionCards(allTodayTransactions);
                return;
            }

            const filtered = allTodayTransactions.filter(tx => {
                const rNum = String(tx.receiptNumber || '').toLowerCase();
                const cName = String(tx.customerName || '').toLowerCase();
                const pMethod = String(tx.paymentMethod || '').toLowerCase();
                const totalNum = typeof tx.total === 'number' ? tx.total : parseFloat(tx.total || 0);
                const totalFormatted = totalNum.toFixed(2);
                const totalRaw = String(totalNum);

                const matchesText = rNum.includes(rawQuery) || cName.includes(rawQuery) || pMethod.includes(rawQuery);
                const matchesAmount = cleanQuery !== '' && (totalFormatted.includes(cleanQuery) || totalRaw.includes(cleanQuery));

                return matchesText || matchesAmount;
            });

            renderTransactionCards(filtered);
        }

        function showReceiptByReceiptNumber(receiptNum) {
            const tx = allTodayTransactions.find(t => String(t.receiptNumber) === String(receiptNum));
            if (!tx) return;

            activeModalTransaction = tx;

            const listSection = document.getElementById('txListViewSection');
            const receiptSection = document.getElementById('txReceiptViewSection');
            const qrSection = document.getElementById('txQrViewSection');
            const headerTitle = document.getElementById('txModalHeaderTitle');

            if (!listSection || !receiptSection) return;

            listSection.style.display = 'none';
            if (qrSection) qrSection.style.display = 'none';
            receiptSection.style.display = 'block';
            if (headerTitle) headerTitle.innerHTML = '<i class="fa-solid fa-receipt me-2"></i>Receipt Details';

            const statusBadge = document.getElementById('modalReceiptStatusBadge');
            const numericStatusId = parseInt(tx.statusId, 10);
            if (statusBadge) {
                if (numericStatusId === 4) {
                    statusBadge.className = "badge rounded-pill px-3 py-1 fw-bold shadow-sm";
                    statusBadge.style.backgroundColor = "#fff3cd";
                    statusBadge.style.color = "#856404";
                    statusBadge.style.border = "1px solid #ffeeba";
                    statusBadge.innerHTML = '<i class="fa-solid fa-clock me-1"></i>Pending Settlement';
                } else {
                    statusBadge.className = "badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold";
                    statusBadge.style.backgroundColor = "";
                    statusBadge.style.color = "";
                    statusBadge.style.border = "";
                    statusBadge.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i>Completed';
                }
            }

            document.getElementById('modalReceiptNumber').textContent = tx.receiptNumber || '#REC-000000';
            document.getElementById('modalReceiptDate').textContent = tx.date || '';

            const rStoreEl = document.getElementById('modalReceiptStore');
            if (rStoreEl && (tx.retailName || tx.storeName)) {
                rStoreEl.textContent = tx.retailName || tx.storeName;
            }

            document.getElementById('modalBarcodeNumber').textContent = `*${(tx.receiptNumber || '000000').replace(/[^0-9A-Z]/gi, '')}*`;

            const custRow = document.getElementById('modalCustomerRow');
            if (tx.customerName && String(tx.customerName).trim() !== '') {
                document.getElementById('modalReceiptCustomer').textContent = tx.customerName;
                custRow.style.display = 'flex';
            } else {
                custRow.style.display = 'none';
            }

            const numericMethodId = parseInt(tx.paymentMethodId ?? tx.PaymentMethodId, 10);
            const rawDueDate = tx.dueDate ?? tx.DueDate;

            const dueDateRow = document.getElementById('modalDueDateRow');
            const dueDateEl = document.getElementById('modalReceiptDueDate');

            if (dueDateRow) {
                const hasValidDate = rawDueDate && String(rawDueDate).trim() !== '' && String(rawDueDate).trim() !== '--' && String(rawDueDate).toLowerCase() !== 'null';
                if (numericMethodId === 4 && hasValidDate) {
                    if (dueDateEl) dueDateEl.textContent = rawDueDate;
                    dueDateRow.style.setProperty("display", "flex", "important");
                } else {
                    if (dueDateEl) dueDateEl.textContent = '';
                    dueDateRow.style.setProperty("display", "none", "important");
                }
            }

            const itemsListContainer = document.getElementById('modalReceiptItemList');
            if (itemsListContainer) {
                itemsListContainer.innerHTML = '';
                let totalQuantity = 0;

                if (tx.items && Array.isArray(tx.items) && tx.items.length > 0) {
                    tx.items.forEach(item => {
                        const qty = parseInt(item.qty || 1, 10);
                        totalQuantity += qty;
                        const subtotal = parseFloat(item.subtotal || (item.price * qty) || 0);

                        itemsListContainer.innerHTML += `
                            <div class="d-flex justify-content-between align-items-center" style="font-size: 11px;">
                                <div class="text-truncate pe-2">
                                    <span class="fw-bold text-dark">${escapeHtml(item.name || 'Product')}</span>
                                    <small class="text-muted d-block">${qty} x ₱${parseFloat(item.price || 0).toFixed(2)}</small>
                                </div>
                                <span class="font-monospace fw-semibold text-dark text-nowrap">₱${subtotal.toFixed(2)}</span>
                            </div>
                        `;
                    });
                } else {
                    itemsListContainer.innerHTML = '<div class="text-muted small text-center py-2">No individual items recorded.</div>';
                }

                const totalQtyEl = document.getElementById('modalReceiptTotalQty');
                if (totalQtyEl) totalQtyEl.textContent = `${totalQuantity} units`;
            }

            const totalNum = typeof tx.total === 'number' ? tx.total : parseFloat(tx.total || 0);
            document.getElementById('modalReceiptSubtotal').textContent = `₱${totalNum.toFixed(2)}`;
            document.getElementById('modalReceiptGrandTotal').textContent = `₱${totalNum.toFixed(2)}`;

            const tenderBadge = document.getElementById('modalReceiptMethodBadge');
            if (tenderBadge) {
                tenderBadge.outerHTML = `<span id="modalReceiptMethodBadge">${getPaymentBadgeHtml(numericMethodId, tx.paymentMethod)}</span>`;
            }
        }

        // ================= CUSTOMER QR VIEW INSIDE RECENT TRANSACTIONS MODAL =================
        function buildModalReceiptToken(tx) {
            const cashierName = document.getElementById('modalReceiptCashier')?.textContent?.trim() || "Main Station";
            const totalNum = typeof tx.total === 'number' ? tx.total : parseFloat(tx.total || 0);
            const numericMethodId = parseInt(tx.paymentMethodId ?? tx.PaymentMethodId, 10);
            const rawDueDate = tx.dueDate ?? tx.DueDate;

            const compactData = {
                r: tx.receiptNumber || "#REC-000000",
                d: tx.date || "--",
                st: tx.retailName || tx.storeName || "SmartScan Retail",
                c: cashierName,
                u: (tx.customerName && String(tx.customerName).trim() !== "") ? tx.customerName : "Walk-in Guest",
                m: tx.paymentMethod || "Cash In Hand",
                s: parseInt(tx.statusId ?? 3, 10),
                due: (numericMethodId === 4 && rawDueDate && String(rawDueDate).toLowerCase() !== 'null') ? rawDueDate : "",
                t: totalNum.toFixed(2),
                p: tx.amountPaid !== undefined ? Number(tx.amountPaid).toFixed(2) : "",
                ch: tx.change !== undefined ? Number(tx.change).toFixed(2) : "",
                i: (tx.items || []).map(item => [
                    item.name || "Product",
                    parseInt(item.qty || 1, 10),
                    parseFloat(item.price || 0).toFixed(2)
                ])
            };
            return btoa(encodeURIComponent(JSON.stringify(compactData)));
        }

        function buildModalPlainTextSummary(tx) {
            const storeName = (tx.retailName || tx.storeName || "SmartScan Retail").toUpperCase();
            const totalNum = typeof tx.total === 'number' ? tx.total : parseFloat(tx.total || 0);
            const lines = [
                storeName,
                `Receipt: ${tx.receiptNumber || '#REC-000000'}`,
                `Date: ${tx.date || '--'}`,
                "------------------------"
            ];
            if (Array.isArray(tx.items)) {
                tx.items.forEach(item => {
                    const q = parseInt(item.qty || 1, 10);
                    const p = parseFloat(item.price || 0);
                    lines.push(`${q}x ${item.name} - PHP ${(q * p).toFixed(2)}`);
                });
            }
            lines.push("------------------------");
            lines.push(`TOTAL: PHP ${totalNum.toFixed(2)}`);
            lines.push(`Tender: ${tx.paymentMethod || 'Cash'}`);
            if (tx.dueDate && String(tx.dueDate).toLowerCase() !== 'null') {
                lines.push(`Due Date: ${tx.dueDate}`);
            }
            lines.push("Thank you for shopping!");
            return lines.join("\n");
        }

        window.openModalReceiptQrView = function () {
            if (!activeModalTransaction) return;

            const receiptSection = document.getElementById('txReceiptViewSection');
            const qrSection = document.getElementById('txQrViewSection');
            const headerTitle = document.getElementById('txModalHeaderTitle');

            if (receiptSection) receiptSection.style.display = 'none';
            if (qrSection) qrSection.style.display = 'block';
            if (headerTitle) {
                headerTitle.innerHTML = '<i class="fa-solid fa-mobile-screen-button me-2"></i>Customer Digital Receipt';
            }

            const token = buildModalReceiptToken(activeModalTransaction);
            activeModalPublicUrl = `${window.location.origin}/Home/DigitalReceipt?d=${encodeURIComponent(token)}`;
            activeModalPlainText = buildModalPlainTextSummary(activeModalTransaction);

            const recNumEl = document.getElementById('txModalQrReceiptNum');
            if (recNumEl) recNumEl.textContent = activeModalTransaction.receiptNumber || '#REC-000000';

            const urlInput = document.getElementById('txModalPublicReceiptUrl');
            if (urlInput) urlInput.value = activeModalPublicUrl;

            const previewBtn = document.getElementById('txModalPreviewLinkBtn');
            if (previewBtn) previewBtn.href = activeModalPublicUrl;

            const isTextMode = document.getElementById('txQrModeText')?.checked;
            renderTxModalQrByMode(isTextMode ? 'text' : 'web');
        }

        window.renderTxModalQrByMode = function (mode) {
            const container = document.getElementById('txModalQrContainer');
            if (!container || typeof QRCode === 'undefined') return;

            const qrContent = mode === 'text' ? activeModalPlainText : activeModalPublicUrl;
            container.innerHTML = '';
            new QRCode(container, {
                text: qrContent,
                width: 190,
                height: 190,
                colorDark: "#0f172a",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.M
            });

            if (activeModalTransaction) {
                const totalNum = typeof activeModalTransaction.total === 'number'
                    ? activeModalTransaction.total
                    : parseFloat(activeModalTransaction.total || 0);
                localStorage.setItem("smartScanCustomerDisplay", JSON.stringify({
                    mode: "receipt",
                    receiptNumber: activeModalTransaction.receiptNumber || "#REC-000000",
                    total: totalNum,
                    qrContent: qrContent
                }));
            }
        };

        window.copyTxModalReceiptLink = function () {
            const input = document.getElementById('txModalPublicReceiptUrl');
            const toast = document.getElementById('txModalCopyToast');
            if (!input) return;

            navigator.clipboard.writeText(input.value).then(() => {
                if (toast) {
                    toast.style.setProperty("display", "block", "important");
                    setTimeout(() => {
                        toast.style.setProperty("display", "none", "important");
                    }, 2200);
                }
            });
        };

        window.backToReceiptDetailsFromQr = function () {
            const receiptSection = document.getElementById('txReceiptViewSection');
            const qrSection = document.getElementById('txQrViewSection');
            const headerTitle = document.getElementById('txModalHeaderTitle');

            if (qrSection) qrSection.style.display = 'none';
            if (receiptSection) receiptSection.style.display = 'block';
            if (headerTitle) headerTitle.innerHTML = '<i class="fa-solid fa-receipt me-2"></i>Receipt Details';
        };

        window.closeReceiptPreview = function () {
            const listSection = document.getElementById('txListViewSection');
            const receiptSection = document.getElementById('txReceiptViewSection');
            const qrSection = document.getElementById('txQrViewSection');
            const headerTitle = document.getElementById('txModalHeaderTitle');

            if (receiptSection) receiptSection.style.display = 'none';
            if (qrSection) qrSection.style.display = 'none';
            if (listSection) listSection.style.display = 'block';
            if (headerTitle) headerTitle.innerHTML = '<i class="fa-solid fa-clock-rotate-left me-2"></i>Today\'s Completed Transactions';
        };

        // ================= PAY DEBT BUTTON TRIGGER =================
        window.initiateDebtPayment = function () {
            sessionStorage.setItem("verificationReason", "PayDebt");
            sessionStorage.setItem("verificationRedirect", "DebtSettlement");
            window.location.href = "/Home/CustomerVerification";
        };
    </script>
}