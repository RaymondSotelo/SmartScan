@{
    ViewData["Title"] = "Checkout";
    if (ViewData["HeaderTitle"] == null)
    {
        ViewData["HeaderTitle"] = "Checkout";
    }
}

<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white"
     style="height: calc(100dvh - 130px); min-height: 540px;">

    <!-- Top Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex justify-content-between align-items-center"
         style="background-color: #1162a3;">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-cash-register fs-5"></i>
            <h5 class="mb-0 fw-bold">Automated Checkout Counter</h5>
        </div>
        <button type="button"
                class="btn btn-sm btn-light fw-bold rounded-pill px-3 shadow-sm text-primary d-flex align-items-center gap-2"
                onclick="window.open('/Home/CustomerDisplay', 'CustomerDisplay', 'width=1000,height=700')">
            <i class="fa-solid fa-display"></i>
            <span>Customer Display</span>
        </button>
    </div>

    <!-- Interior Workspace Split -->
    <div class="card-body p-3 p-lg-4 flex-grow-1 d-flex flex-column" style="min-height: 0;">
        <div class="row g-3 flex-grow-1 m-0" style="min-height: 0;">

            <!-- LEFT COLUMN | Camera View -->
            <div class="col-12 col-lg-6 d-flex flex-column h-100 p-0 pe-lg-2 pb-3" style="min-height: 0;">

                <!-- Camera Card -->
                <div class="card border-0 bg-dark text-white rounded-4 flex-grow-1 position-relative d-flex align-items-center justify-content-center overflow-hidden shadow-sm"
                     style="background: radial-gradient(circle at center, #1b2838 0%, #0d131a 100%); isolation: isolate;">

                    <!-- Live Video Stream Container -->
                    <div id="videoContainer" class="position-relative w-100 h-100 rounded-4 overflow-hidden" style="display: none;">
                        <video id="webcamFeed" autoplay playsinline class="w-100 h-100 rounded-4" style="object-fit: cover;"></video>

                        <!-- Canvas overlay for bounding boxes & labels -->
                        <canvas id="overlayCanvas" class="position-absolute top-0 start-0 w-100 h-100 rounded-4" style="pointer-events: none;"></canvas>
                    </div>

                    <!-- Hidden canvas for sending frames -->
                    <canvas id="captureCanvas" style="display: none;"></canvas>

                    <!-- Idle / Disabled State Placeholder -->
                    <div id="cameraPlaceholder" class="text-center p-4">
                        <div class="border-2 rounded-circle bg-black bg-opacity-25 p-4 d-inline-flex mb-3 border border-secondary border-opacity-25">
                            <i class="fa-solid fa-video-slash fa-3x text-secondary"></i>
                        </div>
                        <h5 class="fw-bold text-secondary mb-1">Webcam Disabled</h5>
                        <p class="text-muted small mb-0" style="max-width: 320px;">
                            Select your video source and enable the camera to start scanning products on the counter.
                        </p>
                    </div>

                    <!-- Enable/Disable Webcam Button -->
                    <div class="position-absolute start-50 translate-middle-x z-3 shadow-lg" style="bottom: 24px;">
                        <div class="btn-group rounded-pill overflow-hidden border border-white border-opacity-25 shadow" role="group">

                            <!-- Start Button -->
                            <button id="startCamBtn"
                                    type="button"
                                    class="btn btn-sm text-white fw-semibold px-3 py-2 d-flex align-items-center gap-2 border-0"
                                    style="background-color: #1162a3;">
                                <i class="fa-solid fa-play small"></i>
                                <span>Enable Scanner</span>
                            </button>

                            <!-- Stop Button -->
                            <button id="stopCamBtn"
                                    type="button"
                                    class="btn btn-sm btn-danger fw-semibold px-3 py-2 d-none d-flex align-items-center gap-2 border-0">
                                <i class="fa-solid fa-stop small"></i>
                                <span>Stop Feed</span>
                            </button>

                            <!-- Divider & Caret Combobox Trigger -->
                            <div class="position-relative d-flex align-items-center border-start border-white border-opacity-25"
                                 id="cameraDropdownWrapper"
                                 style="background-color: #1162a3; transition: background-color 0.2s ease;">

                                <!-- Visible Down Chevron (v) -->
                                <button type="button"
                                        tabindex="-1"
                                        class="btn btn-sm text-white px-2 py-2 border-0 h-100 d-flex align-items-center justify-content-center"
                                        style="pointer-events: none; width: 34px;">
                                    <i class="fa-solid fa-chevron-down small"></i>
                                </button>

                                <!-- Invisible Overlay Select -->
                                <select id="cameraSelect"
                                        class="position-absolute top-0 start-0 w-100 h-100 opacity-0"
                                        style="cursor: pointer;"
                                        title="Choose camera device">
                                    <option value="">Detecting cameras...</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN | Transaction Queue -->
            <div class="col-12 col-lg-6 d-flex flex-column h-100 p-0 ps-lg-2 pb-3 pos-queue-pane" style="min-height: 0;">
                <div class="card border-0 rounded-4 bg-white d-flex flex-column h-100 shadow-sm overflow-hidden">

                    <!-- Queue Header -->
                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom flex-shrink-0"
                         style="background-color: #f8fafc;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-receipt text-primary"></i>
                            <span class="fw-bold text-primary small text-uppercase">Receipt Queue</span>
                        </div>
                        <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle fw-semibold px-2 py-1" style="font-size: 11px;">
                            Live Cart
                        </span>
                    </div>

                    <!-- Scrollable Receipt Item Table -->
                    <div class="flex-grow-1 overflow-y-auto no-scrollbar p-2 p-md-3 pos-queue-table-container">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.82rem;">
                            <thead class="table-light text-muted position-sticky top-0 z-2">
                                <tr>
                                    <th class="border-0 pb-2">Item</th>
                                    <th class="border-0 pb-2 text-center" style="width: 45px;">Qty</th>
                                    <th class="border-0 pb-2 text-end">Price</th>
                                    <th class="border-0 pb-2 text-end">Subtotal</th>
                                    <th class="border-0 pb-2 text-center" style="width: 45px;"></th>
                                </tr>
                            </thead>
                            <tbody id="identifiedItemsList">
                                <tr>
                                    <td colspan="5" class="text-muted text-center py-4">Waiting for optical scanner...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Manual Product Search Input -->
                    <div class="px-2 px-md-3 pt-2 pb-2 border-top bg-light flex-shrink-0 position-relative">
                        <div class="input-group input-group-sm shadow-sm rounded-pill overflow-hidden border bg-white">
                            <span class="input-group-text bg-white border-0 text-muted ps-3 pe-1">
                                <i class="fa-solid fa-barcode"></i>
                            </span>
                            <input type="text"
                                   class="form-control border-0 bg-white shadow-none ps-2 fw-medium"
                                   placeholder="Manual entry (product name)..."
                                   id="manualProductInput"
                                   autocomplete="off" />
                            <button class="btn btn-primary fw-semibold px-3"
                                    type="button"
                                    id="btnAddProduct"
                                    style="background-color: #1162a3; border-color: #1162a3;">
                                <i class="fa-solid fa-plus me-1"></i> Add
                            </button>
                        </div>

                        <!-- Autocomplete Suggestions -->
                        <div id="productSearchResults"
                             class="position-absolute bg-white border rounded-3 shadow-lg w-100 start-0 px-1 py-1"
                             style="display: none; z-index: 1050; max-height: 180px; overflow-y: auto; bottom: 100%; margin-bottom: 4px;">
                        </div>
                    </div>

                    <!-- Bottom Settlement Bar -->
                    <div class="p-2 p-md-1 border-0 flex-shrink-0 bg-white rounded-bottom-4">
                        <div class="d-flex justify-content-between align-items-center p-2 px-3 border rounded-4 shadow-sm bg-white">

                            <!-- Total Due -->
                            <div class="text-start">
                                <span class="text-muted fw-bold text-uppercase d-block mb-1" style="font-size: 0.70rem; letter-spacing: 0.5px;">Total Amount</span>
                                <span class="fw-bold text-dark lh-1" id="totalDueDisplay" style="font-size: 1.5rem;">₱ 0.00</span>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex gap-2">

                                <!-- Stacked Secondary Buttons -->
                                <div class="d-flex flex-column gap-2 justify-content-center">

                                    <!-- Receipt History Button -->
                                    <button class="btn btn-warning border-secondary border-opacity-25 fw-bold rounded-3 d-flex align-items-center px-3 shadow-sm"
                                            style="font-size: 0.85rem; height: 38px;"
                                            onclick="openOldTransactions()">
                                        <i class="fa-solid fa-clock-rotate-left me-2"></i>Recent Transaction
                                    </button>

                                    <!-- Void Cart Button -->
                                    <button class="btn btn-danger border-danger border-opacity-25 fw-bold rounded-3 d-flex align-items-center px-3 shadow-sm position-relative"
                                            id="btnVoidCart"
                                            style="font-size: 0.85rem; height: 38px;">
                                        <i class="fa-solid fa-trash-can"></i>
                                        <span class="flex-grow-1 text-center">Void Cart</span>
                                    </button>
                                </div>

                                <!-- Big Primary Button -->
                                <button class="btn btn-primary d-flex flex-column align-items-center justify-content-center fw-bold px-3 px-sm-4 rounded-3 shadow-sm"
                                        id="btnProceedToPayment"
                                        style="background-color: #1162a3; border-color: #1162a3;">
                                    <i class="fa-solid fa-credit-card mb-1" style="font-size: 1.4rem;"></i>
                                    <span class="text-center" style="font-size: 0.85rem; letter-spacing: 0.3px; line-height: 1.2;">PROCEED TO<br>PAYMENT</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Recent Transactions -->
<div class="modal fade" id="oldTransactionsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">

            <!-- Top Header -->
            <div class="modal-header text-white p-3 border-0 flex-shrink-0" style="background-color: #1162a3;">
                <h6 class="modal-title fw-bold mb-0 fs-5">
                    <i class="fa-solid fa-clock-rotate-left me-2"></i>Recent Transactions
                </h6>
                <button type="button" data-bs-dismiss="modal" class="modal-custom-close rounded-2"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <!-- Table -->
            <div class="modal-body p-2">
                <div class="table-responsive" style="max-height: 380px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                        <thead class="table-light text-muted sticky-top">
                            <tr>
                                <th class="ps-3 py-2">Receipt #</th>
                                <th class="py-2">Date</th>
                                <th class="text-end pe-3 py-2">Total</th>
                            </tr>
                        </thead>
                        <tbody id="oldTransactionsList">
                            <!-- Injected via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Adjust Product Quantity -->
<div class="modal fade" id="adjustQuantityModal" tabindex="-1" aria-labelledby="adjustQuantityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content border-0 shadow-lg overflow-hidden" style="border-radius: 20px;">

            <!-- Top Header -->
            <div class="modal-header text-white p-3 border-0 flex-shrink-0" style="background-color: #1162a3;">
                <h6 class="modal-title fw-bold mb-0 fs-5" id="adjustQuantityModalLabel">
                    <i class="fa-solid fa-pen-to-square me-2"></i>Adjust Quantity
                </h6>
                <button type="button" data-bs-dismiss="modal" class="modal-custom-close rounded-2"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <div class="modal-body p-4">
                <input type="hidden" id="editItemIndex" />

                <!-- Readonly Product Name -->
                <div class="text-start mb-3">
                    <label class="custom-input-label text-secondary">Product</label>
                    <input type="text" class="form-control custom-input fw-bold text-primary" id="editProductName" readonly />
                </div>

                <!-- Readonly Unit Price -->
                <div class="text-start mb-3">
                    <label class="custom-input-label text-secondary">Unit Price</label>
                    <input type="text" class="form-control custom-input fw-bold text-primary font-monospace" id="editProductPrice" readonly />
                </div>

                <!-- Editable Quantity with Glow Focus -->
                <div class="text-start mb-4">
                    <label class="custom-input-label">Quantity</label>
                    <div class="input-group shadow-sm rounded-3 overflow-hidden border bg-white cash-focus-group">
                        <span class="input-group-text bg-white border-0 fw-bold text-secondary ps-3 py-2">
                            <i class="fa-solid fa-box"></i>
                        </span>
                        <input id="editProductQuantity"
                               class="form-control border-0 bg-white shadow-none fs-5 font-monospace px-3 fw-semibold py-2 text-center"
                               type="number"
                               min="1"
                               inputmode="numeric"
                               onwheel="this.blur()">
                    </div>
                    <div class="invalid-feedback fw-bold mt-2">Enter a valid quantity (1 or more).</div>
                </div>

                <!-- Proceed Button -->
                <button type="button" class="btn w-100 btn-proceed shadow-sm" id="btnConfirmAdjust">
                    Update Quantity
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@vladmandic/face-api/dist/face-api.js"></script>

    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {
            localStorage.setItem("smartScanCustomerDisplay", JSON.stringify({ items: [], total: 0 }));

            const video = document.getElementById("webcamFeed");
            const videoContainer = document.getElementById("videoContainer");
            const captureCanvas = document.getElementById("captureCanvas");
            const captureCtx = captureCanvas.getContext("2d");
            const overlay = document.getElementById("overlayCanvas");
            const overlayCtx = overlay.getContext("2d");

            const placeholder = document.getElementById("cameraPlaceholder");
            const startBtn = document.getElementById("startCamBtn");
            const stopBtn = document.getElementById("stopCamBtn");
            const cameraSelect = document.getElementById("cameraSelect");
            const list = document.getElementById("identifiedItemsList");
            const totalDueDisplay = document.getElementById("totalDueDisplay");

            let isScanningActive = false;
            let isProcessingFrame = false;
            let mediaStream = null;
            const recentDetections = [];
            const detectionHoldMs = 300;

            const priceCache = {};
            let manualItems = [];

            // SEARCH HISTORY
            const productSearchInput = document.getElementById("manualProductInput");
            const productSearchResults = document.getElementById("productSearchResults");
            let recentSearches = JSON.parse(localStorage.getItem("smartScanRecentSearches") || "[]");

            function showRecentSearches() {
                productSearchResults.innerHTML = "";
                if (recentSearches.length === 0) {
                    productSearchResults.style.display = "none";
                    return;
                }

                productSearchResults.innerHTML = "<div class='px-3 py-1 fw-bold text-muted small border-bottom'>Recent Searches</div>";
                recentSearches.slice(0, 3).forEach(search => {
                    const item = document.createElement("div");
                    item.className = "px-3 py-2 small rounded hover-bg cursor-pointer d-flex align-items-center";
                    item.style.cursor = "pointer";
                    item.innerHTML = `<i class="fa-solid fa-clock me-2 text-muted"></i>${search}`;
                    item.addEventListener("click", () => {
                        productSearchInput.value = search;
                        productSearchResults.style.display = "none";
                    });
                    productSearchResults.appendChild(item);
                });
                productSearchResults.style.display = "block";
            }

            function saveRecentSearch(search) {
                search = search.trim();
                if (!search) return;
                recentSearches = recentSearches.filter(item => item.toLowerCase() !== search.toLowerCase());
                recentSearches.unshift(search);
                recentSearches = recentSearches.slice(0, 3);
                localStorage.setItem("smartScanRecentSearches", JSON.stringify(recentSearches));
            }

            productSearchInput.addEventListener("focus", () => {
                if (productSearchInput.value.trim() === "") showRecentSearches();
            });

            productSearchInput.addEventListener("input", () => {
                if (productSearchInput.value.trim() !== "") {
                    productSearchResults.style.display = "none";
                } else {
                    showRecentSearches();
                }
            });

            document.addEventListener("click", event => {
                if (!productSearchInput.contains(event.target) && !productSearchResults.contains(event.target)) {
                    productSearchResults.style.display = "none";
                }
            });

            // POPULATE CONNECTED WEBCAMS
            async function loadCameras() {
                try {
                    const tempStream = await navigator.mediaDevices.getUserMedia({ video: true });
                    tempStream.getTracks().forEach(t => t.stop());

                    const devices = await navigator.mediaDevices.enumerateDevices();
                    const videoDevices = devices.filter(d => d.kind === "videoinput");

                    cameraSelect.innerHTML = "";
                    videoDevices.forEach((device, index) => {
                        const option = document.createElement("option");
                        option.value = device.deviceId;
                        option.text = device.label || `Camera ${index + 1}`;
                        const lowerLabel = (device.label || "").toLowerCase();
                        if (lowerLabel.includes("back") || lowerLabel.includes("rear") || lowerLabel.includes("environment")) {
                            option.selected = true;
                        } else if (lowerLabel.includes("usb") || lowerLabel.includes("external") || lowerLabel.includes("webcam")) {
                            option.selected = true;
                        }
                        cameraSelect.appendChild(option);
                    });

                    if (videoDevices.length === 0) {
                        cameraSelect.innerHTML = "<option value=''>Default Camera</option>";
                    }
                } catch (err) {
                    console.warn("Could not enumerate camera labels:", err);
                    cameraSelect.innerHTML = "<option value=''>Default Camera</option>";
                }
            }
            loadCameras();

            async function startSelectedCamera() {
                if (mediaStream) {
                    mediaStream.getTracks().forEach(track => track.stop());
                }

                const selectedDeviceId = cameraSelect.value;
                const constraints = {
                    video: {
                        deviceId: selectedDeviceId ? { exact: selectedDeviceId } : undefined,
                        facingMode: selectedDeviceId ? undefined : { ideal: "environment" },
                        width: { ideal: 1280, min: 640 },
                        height: { ideal: 720, min: 480 },
                        frameRate: { ideal: 30, max: 30 }
                    }
                };

                mediaStream = await navigator.mediaDevices.getUserMedia(constraints);
                video.srcObject = mediaStream;
            }

            startBtn.addEventListener("click", async function () {
                try {
                    await startSelectedCamera();

                    placeholder.style.display = "none";
                    videoContainer.style.display = "block";
                    startBtn.classList.add("d-none");
                    stopBtn.classList.remove("d-none");

                    document.getElementById("cameraDropdownWrapper").style.backgroundColor = "#dc3545";

                    isScanningActive = true;
                    startDetectionLoop();
                } catch (err) {
                    console.error("Camera access error:", err);
                    alert("Failed to access camera: " + err.message);
                }
            });

            cameraSelect.addEventListener("change", async function () {
                if (mediaStream) {
                    try {
                        await startSelectedCamera();
                    } catch (err) {
                        console.error("Failed to switch camera:", err);
                    }
                }
            });

            stopBtn.addEventListener("click", function () {
                isScanningActive = false;
                isProcessingFrame = false;

                if (mediaStream) {
                    mediaStream.getTracks().forEach(track => track.stop());
                    mediaStream = null;
                }
                video.srcObject = null;

                overlayCtx.clearRect(0, 0, overlay.width, overlay.height);
                recentDetections.length = 0;

                videoContainer.style.display = "none";
                placeholder.style.display = "block";
                stopBtn.classList.add("d-none");
                startBtn.classList.remove("d-none");

                document.getElementById("cameraDropdownWrapper").style.backgroundColor = "#1162a3";

                buildCartAndRender({}, false);
            });

            async function startDetectionLoop() {
                while (isScanningActive) {
                    if (!isProcessingFrame && video.readyState === video.HAVE_ENOUGH_DATA) {
                        isProcessingFrame = true;
                        await captureAndDetect();
                        isProcessingFrame = false;
                    }
                    await new Promise(resolve => setTimeout(resolve, 100));
                }
            }

            async function captureAndDetect() {
                if (video.videoWidth === 0 || video.videoHeight === 0) return;

                captureCanvas.width = video.videoWidth;
                captureCanvas.height = video.videoHeight;

                if (overlay.width !== video.videoWidth || overlay.height !== video.videoHeight) {
                    overlay.width = video.videoWidth;
                    overlay.height = video.videoHeight;
                }

                captureCtx.drawImage(video, 0, 0, captureCanvas.width, captureCanvas.height);
                const frameBase64 = captureCanvas.toDataURL("image/jpeg", 0.5);

                try {
                    const response = await fetch("/api/Scan/detect", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ image: frameBase64 })
                    });

                    const data = await response.json();
                    const detections = data.detections || [];
                    const now = Date.now();
                    const currentDetections = detections.filter(d => d.box);

                    for (const detected of currentDetections) {
                        const [x1, y1, x2, y2] = detected.box;
                        let previous = recentDetections.find(item =>
                            item.name === detected.name &&
                            Math.abs(item.box[0] - x1) < video.videoWidth * 0.12 &&
                            Math.abs(item.box[1] - y1) < video.videoHeight * 0.12
                        );

                        if (!previous) {
                            previous = { name: detected.name, box: detected.box, confidence: detected.confidence };
                            recentDetections.push(previous);
                        }

                        if (previous.lastSeen) {
                            previous.box = detected.box.map((coordinate, index) =>
                                Math.round(previous.box[index] * 0.65 + coordinate * 0.35)
                            );
                            previous.confidence = Math.round(
                                (previous.confidence * 0.65 + detected.confidence * 0.35) / 5
                            ) * 5;
                        } else {
                            previous.box = detected.box;
                            previous.confidence = detected.confidence;
                        }
                        previous.lastSeen = now;
                    }

                    for (let i = recentDetections.length - 1; i >= 0; i--) {
                        if (now - (recentDetections[i].lastSeen || 0) > detectionHoldMs) {
                            recentDetections.splice(i, 1);
                        }
                    }

                    overlayCtx.clearRect(0, 0, overlay.width, overlay.height);

                    for (const detected of recentDetections) {
                        const [x1, y1, x2, y2] = detected.box;
                        const boxColor = detected.confidence >= 80 ? "#00FF00" : "#FFA500";
                        overlayCtx.lineWidth = 3;
                        overlayCtx.strokeStyle = boxColor;
                        overlayCtx.strokeRect(x1, y1, x2 - x1, y2 - y1);
                        overlayCtx.fillStyle = boxColor;
                        overlayCtx.font = "bold 15px Arial";
                        overlayCtx.fillText(`${detected.name} (${detected.confidence}%)`, x1, Math.max(18, y1 - 8));
                    }

                    const yoloCounts = {};
                    let hasLowConfidence = false;

                    for (const detected of detections) {
                        if (detected.confidence < 80) {
                            hasLowConfidence = true;
                        } else {
                            yoloCounts[detected.name] = (yoloCounts[detected.name] || 0) + 1;
                        }
                    }

                    await buildCartAndRender(yoloCounts, hasLowConfidence);

                } catch (error) {
                    console.error("Cannot connect to Python Server:", error);
                    list.innerHTML = "<tr><td colspan='5' class='text-danger text-center py-3'>Lost connection to AI Scanner!</td></tr>";
                }
            }

            // ==========================================
            // 🔴 UPDATED: INVENTORY STOCK GATEKEEPER
            // ==========================================
            window.buildCartAndRender = async function(yoloCounts, hasLowConfidence) {
                let htmlOutput = "";
                let currentTotal = 0;

                for (const [itemName, qty] of Object.entries(yoloCounts)) {
                    if (!priceCache[itemName]) {
                        try {
                            const dbResponse = await fetch(`/Home/GetProductDetails?productName=${encodeURIComponent(itemName)}`);
                            if (dbResponse.ok) {
                                const productData = await dbResponse.json();
                                if (productData.success === false || productData.price === undefined) {
                                    priceCache[itemName] = { name: itemName, notFound: true };
                                } else {
                                    priceCache[itemName] = productData; // Now includes productData.stock!
                                }
                            } else {
                                priceCache[itemName] = { name: itemName, notFound: true };
                            }
                        } catch (err) {
                            priceCache[itemName] = { name: itemName, notFound: true };
                        }
                    }

                    const product = priceCache[itemName];
                    if (!product.notFound) {

                        const savedItem = manualItems.find(i => i.name === product.name);
                        const savedQty = savedItem ? savedItem.qty : 0;
                        const availableStock = (product.stock || 0) - savedQty;
                        let newQtyToLock = qty - savedQty;

                        if (newQtyToLock > 0) {
                            // Enforce Stock Limit: Cap the auto-scanner so it can't add more than available
                            if (newQtyToLock > availableStock) {
                                newQtyToLock = availableStock;
                            }

                            if (newQtyToLock > 0) {
                                const subtotal = product.price * newQtyToLock;
                                currentTotal += subtotal;

                                const safeName = itemName.replace(/'/g, "\\'");
                                const safeDbName = product.name.replace(/'/g, "\\'");

                                let stockBadge = "";
                                if (product.stock <= 5 && product.stock > 0) {
                                    stockBadge = `<br><span class="text-warning" style="font-size: 10px;"><i class="fa-solid fa-triangle-exclamation"></i> Low Stock: ${product.stock} total</span>`;
                                }

                                htmlOutput += `
                                    <tr>
                                        <td class="fw-medium text-truncate" style="max-width: 140px;">${product.name} <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill ms-1" style="font-size: 9px;">Auto</span>${stockBadge}</td>
                                        <td class="text-center fw-bold">${newQtyToLock}</td>
                                        <td class="text-end text-muted small fw-medium">₱${product.price.toFixed(2)}</td>
                                        <td class="text-end text-dark fw-bold small fw-medium">₱${subtotal.toFixed(2)}</td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-success rounded-circle p-1" style="width: 24px; height: 24px; display: inline-grid; place-items: center;" onclick="lockYoloItem('${safeName}', '${safeDbName}', ${product.price}, ${newQtyToLock}, ${product.stock})" title="Lock Item in Cart">
                                                <i class="fa-solid fa-check" style="font-size: 14px;"></i>
                                            </button>
                                        </td>
                                    </tr>`;
                            } else {
                                // Scanned more items, but stock is completely maxed out!
                                htmlOutput += `
                                    <tr class="table-danger border-danger">
                                        <td class="fw-medium text-truncate text-danger" style="max-width: 140px;">${product.name} <span class="badge bg-danger text-white rounded-pill ms-1" style="font-size: 9px;">Limit Reached</span></td>
                                        <td class="text-center fw-bold text-danger">Max</td>
                                        <td class="text-end text-muted small fw-medium">₱${product.price.toFixed(2)}</td>
                                        <td class="text-end text-danger fw-bold small fw-medium">Stock: ${product.stock}</td>
                                        <td class="text-center"></td>
                                    </tr>`;
                            }
                        }
                    } else {
                        htmlOutput += `
                            <tr>
                                <td class="text-warning fw-bold text-truncate" style="max-width: 140px;"><i class="fa-solid fa-triangle-exclamation me-1"></i>${itemName}</td>
                                <td class="text-center">${qty}</td>
                                <td class="text-end">-</td>
                                <td class="text-end text-danger small">Unknown</td>
                                <td></td>
                            </tr>`;
                    }
                }

                // Process Saved Items
                manualItems.forEach((item, index) => {
                    const subtotal = item.price * item.qty;
                    currentTotal += subtotal;

                    htmlOutput += `
                        <tr>
                            <td class="fw-medium text-truncate" style="max-width: 140px;">${item.name} <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill ms-1" style="font-size: 9px;">Cart</span></td>
                            <td class="text-center fw-bold">${item.qty}</td>
                            <td class="text-end text-muted small">₱${item.price.toFixed(2)}</td>
                            <td class="text-end text-primary fw-bold small">₱${subtotal.toFixed(2)}</td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-1">
                                    <button class="btn btn-sm btn-outline-primary rounded-circle p-1" style="width: 22px; height: 22px; display: inline-grid; place-items: center;" onclick="editManualItem(${index})" title="Edit Qty">
                                        <i class="fa-solid fa-pen" style="font-size: 9px;"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger rounded-circle p-1" style="width: 22px; height: 22px; display: inline-grid; place-items: center;" onclick="removeManualItem(${index})" title="Delete">
                                        <i class="fa-solid fa-xmark" style="font-size: 9px;"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>`;
                });

                if (hasLowConfidence) {
                    htmlOutput += `
                        <tr class="table-warning">
                            <td colspan="5" class="text-danger fw-semibold text-center small py-1" style="font-size: 11px;"><i class="fa-solid fa-triangle-exclamation me-1"></i>Hold item steady over tray.</td>
                        </tr>`;
                }

                if (htmlOutput === "" && manualItems.length === 0) {
                    htmlOutput = "<tr><td colspan='5' class='text-muted text-center py-4'>No products detected on checkout tray...</td></tr>";
                }

                list.innerHTML = htmlOutput;
                totalDueDisplay.innerText = `₱ ${currentTotal.toFixed(2)}`;

                // Broadcast Customer Display
                const broadcastItems = [];
                let customerTotal = 0;
                manualItems.forEach(item => {
                    broadcastItems.push({ name: item.name, qty: item.qty, price: item.price });
                    customerTotal += (item.price * item.qty);
                });
                localStorage.setItem("smartScanCustomerDisplay", JSON.stringify({ items: broadcastItems, total: customerTotal }));
            }

            // MANUAL ADD BUTTON LOGIC
            document.getElementById("btnAddProduct").addEventListener("click", async () => {
                const input = document.getElementById("manualProductInput");
                const name = input.value.trim();
                if (!name) return;

                try {
                    const dbResponse = await fetch(`/Home/GetProductDetails?productName=${encodeURIComponent(name)}`);

                    if (dbResponse.ok) {
                        const product = await dbResponse.json();

                        if (product.success === false || product.price === undefined) {
                            alert("Product not found in database.");
                            return;
                        }

                        // Prevent adding if literally out of stock
                        if (product.stock <= 0) {
                            alert(`Out of Stock! There are no ${product.name} left in inventory.`);
                            return;
                        }

                        saveRecentSearch(product.name);

                        const existing = manualItems.find(i => i.name === product.name);
                        const currentQty = existing ? existing.qty : 0;

                        // Prevent adding beyond available stock limit
                        if (currentQty + 1 > product.stock) {
                            alert(`Inventory Limit: Cannot add more ${product.name}. The store only has ${product.stock} left.`);
                        } else {
                            if (existing) {
                                existing.qty++;
                            } else {
                                manualItems.push({
                                    name: product.name,
                                    price: product.price,
                                    qty: 1,
                                    stock: product.stock // Track max stock inside cart
                                });
                            }
                        }

                        input.value = "";
                        productSearchResults.style.display = "none";
                        if (!isScanningActive) buildCartAndRender({}, false);
                    } else {
                        alert("Product not found in database.");
                    }
                } catch (err) {
                    alert("Database connection error.");
                }
            });

            document.getElementById("btnVoidCart").addEventListener("click", () => {
                if (confirm("Are you sure you want to void all saved items?")) {
                    manualItems = [];
                    if (!isScanningActive) buildCartAndRender({}, false);
                }
            });

            window.openOldTransactions = async function() {
                const modal = new bootstrap.Modal(document.getElementById('oldTransactionsModal'));
                modal.show();

                const tbody = document.getElementById('oldTransactionsList');
                tbody.innerHTML = '<tr><td colspan="3" class="text-center py-3 text-muted">Loading transactions...</td></tr>';

                try {
                    const response = await fetch('/Home/GetOldTransactions');
                    const data = await response.json();

                    if (data.success && data.transactions.length > 0) {
                        let html = '';
                        data.transactions.forEach(tx => {
                            html += `
                                <tr>
                                    <td class="fw-semibold ps-3">${tx.receiptNumber}</td>
                                    <td><small class="text-muted">${tx.date}</small></td>
                                    <td class="text-end pe-3 fw-bold text-dark">PHP ${tx.total.toFixed(2)}</td>
                                </tr>
                            `;
                        });
                        tbody.innerHTML = html;
                    } else {
                        tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted py-3">No recent transactions found.</td></tr>';
                    }
                } catch (error) {
                    tbody.innerHTML = '<tr><td colspan="3" class="text-center text-danger py-3">Error loading transactions.</td></tr>';
                }
            };

            // Locks a scanned Auto item into the permanent Saved cart
            window.lockYoloItem = function (formattedName, displayName, price, qty, maxStock) {
                const existing = manualItems.find(i => i.name === displayName);
                const currentQty = existing ? existing.qty : 0;

                if (currentQty + qty > maxStock) {
                    alert(`Inventory Limit: The store only has ${maxStock} ${displayName} left.`);
                    const allowedQty = maxStock - currentQty;
                    if (allowedQty > 0) {
                        if (existing) existing.qty += allowedQty;
                        else manualItems.push({ name: displayName, price: price, qty: allowedQty, stock: maxStock });
                    }
                } else {
                    if (existing) {
                        existing.qty += qty;
                    } else {
                        manualItems.push({ name: displayName, price: price, qty: qty, stock: maxStock });
                    }
                }
                if (!isScanningActive) buildCartAndRender({}, false);
            };

            // EDIT MODAL LOGIC
            window.editManualItem = function (index) {
                const item = manualItems[index];
                document.getElementById("editItemIndex").value = index;
                document.getElementById("editProductName").value = item.name;
                document.getElementById("editProductPrice").value = `PHP ${item.price.toFixed(2)}`;

                const qtyInput = document.getElementById("editProductQuantity");
                qtyInput.value = item.qty;
                qtyInput.classList.remove("is-invalid");

                const adjustModal = new bootstrap.Modal(document.getElementById("adjustQuantityModal"));
                adjustModal.show();
            };

            // CONFIRM ADJUSTMENT BUTTON
            document.getElementById("btnConfirmAdjust").addEventListener("click", function() {
                const index = document.getElementById("editItemIndex").value;
                const qtyInput = document.getElementById("editProductQuantity");
                const newQty = parseInt(qtyInput.value);
                const maxStock = manualItems[index].stock || 999;

                if (isNaN(newQty) || newQty <= 0) {
                    qtyInput.classList.add("is-invalid");
                    return;
                }

                if (newQty > maxStock) {
                    alert(`Stock Limit Reached: You cannot enter a quantity higher than the available stock (${maxStock}).`);
                    qtyInput.value = maxStock;
                    return;
                }

                qtyInput.classList.remove("is-invalid");
                manualItems[index].qty = newQty;

                const adjustModalEl = document.getElementById("adjustQuantityModal");
                const adjustModal = bootstrap.Modal.getInstance(adjustModalEl);
                adjustModal.hide();

                if (!isScanningActive) buildCartAndRender({}, false);
            });

            window.removeManualItem = function (index) {
                manualItems.splice(index, 1);
                if (!isScanningActive) buildCartAndRender({}, false);
            };

            document.getElementById("btnProceedToPayment").addEventListener("click", () => {
                if (manualItems.length === 0) {
                    alert("The cart is empty! Please add or lock items before proceeding.");
                    return;
                }

                sessionStorage.setItem("smartScanCart", JSON.stringify(manualItems));
                window.location.href = "/Home/CustomerVerification";
            });

            buildCartAndRender({}, false);
        });

        // BACKGROUND PRE-FETCHER: Download AI models into browser cache while scanning items
        window.addEventListener('load', () => {
            const MODEL_URL = 'https://cdn.jsdelivr.net/npm/@@vladmandic/face-api/model/';

            console.log("Pre-fetching Biometric Models in background...");
            Promise.all([
                faceapi.nets.ssdMobilenetv1.loadFromUri(MODEL_URL),
                faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL),
                faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
            ]).then(() => {
                console.log("Biometric Models cached! Verification page will now load instantly.");
            }).catch(err => console.warn("Background model fetch delayed.", err));
        });
    </script>
}