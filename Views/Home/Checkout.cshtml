@{
    ViewData["Title"] = "Checkout";
    if (ViewData["HeaderTitle"] == null)
    {
        ViewData["HeaderTitle"] = "Checkout";
    }
}

@section Styles {
    <style>
        /* Mobile & Tablet Layout Adjustments (Desktop >= 992px stays untouched) */
        @@media (max-width: 991.98px) {
            .checkout-camera-card {
                min-height: 270px !important;
                height: 300px !important;
            }

            .pos-queue-table-container {
                min-height: 180px;
                max-height: 320px;
            }
        }

        @@media (max-width: 575.98px) {
            /* Keep Detected badge at top-right on narrow phones so it never overlaps Enable Scanner */
            .checkout-detected-badge {
                top: 0 !important;
                bottom: auto !important;
                left: auto !important;
                right: 0 !important;
                margin: 0.75rem !important;
            }
            /* Stack Total Amount on top and put the 4 action buttons in a clean 2x2 touch grid */
            .checkout-settlement-bar {
                flex-direction: column !important;
                align-items: stretch !important;
                gap: 0.75rem !important;
                padding: 0.75rem !important;
            }

            .checkout-total-row {
                display: flex !important;
                justify-content: space-between;
                align-items: center;
                padding-bottom: 0.5rem;
                border-bottom: 1px solid #e9ecef;
            }

            .checkout-settlement-actions {
                display: grid !important;
                grid-template-columns: repeat(2, 1fr);
                gap: 0.5rem !important;
                width: 100%;
            }

            .checkout-secondary-btns {
                display: contents !important;
            }

            .checkout-settlement-actions button {
                width: 100%;
                justify-content: center !important;
                height: auto !important;
                min-height: 46px;
                padding: 0.5rem 0.6rem !important;
                font-size: 0.8rem !important;
            }

            .checkout-settlement-actions #btnPayDebt,
            .checkout-settlement-actions #btnProceedToPayment {
                flex-direction: row !important;
                gap: 0.45rem;
                padding-top: 0.65rem !important;
                padding-bottom: 0.65rem !important;
            }

                .checkout-settlement-actions #btnPayDebt i,
                .checkout-settlement-actions #btnProceedToPayment i {
                    margin-bottom: 0 !important;
                    font-size: 1.05rem !important;
                }

                .checkout-settlement-actions #btnPayDebt br,
                .checkout-settlement-actions #btnProceedToPayment br {
                    display: none;
                }
        }
    </style>
}

<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white pos-viewport-card"
     style="height: calc(100dvh - 130px); min-height: 540px;">

    <!-- Top Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex flex-wrap justify-content-between align-items-center gap-2"
         style="background-color: #1162a3;">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-cash-register fs-5"></i>
            <h5 class="mb-0 fw-bold">Automated Checkout Counter</h5>
        </div>
        <button type="button"
                class="btn btn-sm btn-light fw-bold rounded-pill px-3 shadow-sm text-primary d-flex align-items-center gap-2"
                onclick="window.open('/Home/CustomerDisplay', 'CustomerDisplay', 'width=1000,height=700')">
            <i class="fa-solid fa-display"></i>
            <span>Customer Display</span>
        </button>
    </div>

    <!-- Interior Workspace Split -->
    <div class="card-body p-2 p-sm-3 p-lg-4 flex-grow-1 d-flex flex-column" style="min-height: 0;">
        <div class="row g-3 flex-grow-1 m-0" style="min-height: 0;">

            <!-- LEFT COLUMN | Camera View -->
            <div class="col-12 col-lg-6 d-flex flex-column h-100 p-0 pe-lg-2 pb-2 pb-lg-3" style="min-height: 0;">
                <div class="card border-0 bg-dark text-white rounded-4 flex-grow-1 position-relative d-flex align-items-center justify-content-center overflow-hidden shadow-sm checkout-camera-card"
                     style="background: radial-gradient(circle at center, #1b2838 0%, #0d131a 100%); isolation: isolate;">

                    <!-- Live Video Stream Container -->
                    <div id="videoContainer" class="position-relative w-100 h-100 rounded-4 overflow-hidden" style="display: none;">
                        <video id="webcamFeed" autoplay playsinline muted class="w-100 h-100 rounded-4" style="object-fit: cover;"></video>
                        <canvas id="overlayCanvas" class="position-absolute top-0 start-0 w-100 h-100 rounded-4" style="pointer-events: none;"></canvas>

                        <!-- Top Left: YOLO Engine Badge -->
                        <div class="position-absolute top-0 start-0 m-3 z-3" style="pointer-events: none;">
                            <span class="badge bg-black bg-opacity-50 text-white border border-white border-opacity-25 rounded-pill px-3 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2"
                                  style="backdrop-filter: blur(4px); font-size: 0.8rem; letter-spacing: 0.5px;">
                                <span class="spinner-grow spinner-grow-sm text-success" style="width: 8px; height: 8px;" role="status"></span>
                                YOLO
                            </span>
                        </div>

                        <!-- Bottom Left (Top Right on narrow phones): Total Products Detected Badge -->
                        <div class="position-absolute bottom-0 start-0 m-3 z-3 checkout-detected-badge" style="pointer-events: none; margin-bottom: 20px !important;">
                            <span class="badge bg-black bg-opacity-50 text-white border border-white border-opacity-25 rounded-3 px-3 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2"
                                  style="backdrop-filter: blur(4px); font-size: 0.82rem;">
                                <i class="fa-solid fa-boxes-stacked text-white"></i>
                                <span>Detected: <strong id="detectedCountDisplay" class="text-white">0</strong></span>
                            </span>
                        </div>
                    </div>

                    <canvas id="captureCanvas" style="display: none;"></canvas>

                    <!-- Idle / Disabled State Placeholder -->
                    <div id="cameraPlaceholder" class="text-center p-4 pb-5">
                        <div class="border-2 rounded-circle bg-black bg-opacity-25 p-3 p-sm-4 d-inline-flex mb-2 mb-sm-3 border border-secondary border-opacity-25">
                            <i class="fa-solid fa-video-slash fa-2x fa-sm-3x text-secondary"></i>
                        </div>
                        <h5 class="fw-bold text-secondary mb-1">Webcam Disabled</h5>
                    </div>

                    <!-- Enable/Disable Webcam Button -->
                    <div class="position-absolute start-50 translate-middle-x z-3 shadow-lg" style="bottom: 18px;">
                        <div class="btn-group rounded-pill overflow-hidden border border-white border-opacity-25 shadow" role="group">
                            <button id="startCamBtn"
                                    type="button"
                                    class="btn btn-sm text-white fw-semibold px-3 py-2 d-flex align-items-center gap-2 border-0 text-nowrap"
                                    style="background-color: #1162a3;">
                                <i class="fa-solid fa-play small"></i>
                                <span>Enable Scanner</span>
                            </button>

                            <button id="stopCamBtn"
                                    type="button"
                                    class="btn btn-sm btn-danger fw-semibold px-3 py-2 d-none d-flex align-items-center gap-2 border-0 text-nowrap">
                                <i class="fa-solid fa-stop small"></i>
                                <span>Stop Feed</span>
                            </button>

                            <div class="position-relative d-flex align-items-center border-start border-white border-opacity-25"
                                 id="cameraDropdownWrapper"
                                 style="background-color: #1162a3; transition: background-color 0.2s ease;">
                                <button type="button"
                                        tabindex="-1"
                                        class="btn btn-sm text-white px-2 py-2 border-0 h-100 d-flex align-items-center justify-content-center"
                                        style="pointer-events: none; width: 34px;">
                                    <i class="fa-solid fa-chevron-down small"></i>
                                </button>
                                <select id="cameraSelect"
                                        class="position-absolute top-0 start-0 w-100 h-100 opacity-0"
                                        style="cursor: pointer;"
                                        title="Choose camera device">
                                    <option value="">Detecting cameras...</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN | Transaction Queue -->
            <div class="col-12 col-lg-6 d-flex flex-column h-100 p-0 ps-lg-2 pb-2 pb-lg-3 pos-queue-pane" style="min-height: 0;">
                <div class="card border-0 rounded-4 bg-white d-flex flex-column h-100 shadow-sm overflow-hidden">

                    <!-- Queue Header -->
                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom flex-shrink-0"
                         style="background-color: #f8fafc;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-basket-shopping text-primary"></i>
                            <span class="fw-bold text-primary small text-uppercase">Digital Cart</span>
                        </div>

                        <button type="button"
                                id="btnLockAllItems"
                                class="btn btn-sm fw-bold rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1 text-nowrap"
                                style="background-color: #dbeafe; color: #1162a3; border: 1px solid #cfe2f3; font-size: 0.75rem; transition: all 0.2s ease;"
                                onclick="lockAllItems()"
                                title="Lock all items to scan next batch">
                            <i class="fa-solid fa-lock"></i>
                            <span>Lock All</span>
                        </button>
                    </div>

                    <!-- Scrollable Receipt Item Table -->
                    <div class="flex-grow-1 overflow-y-auto no-scrollbar p-2 p-md-3 pos-queue-table-container">
                        <div class="table-responsive">
                            <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.82rem;">
                                <thead class="table-light text-muted position-sticky top-0 z-2">
                                    <tr>
                                        <th class="border-0 pb-2">Item</th>
                                        <th class="border-0 pb-2 text-center" style="width: 45px;">Qty</th>
                                        <th class="border-0 pb-2 text-end text-nowrap">Price</th>
                                        <th class="border-0 pb-2 text-end text-nowrap">Subtotal</th>
                                        <th class="border-0 pb-2 text-center" style="width: 85px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="identifiedItemsList">
                                    <tr>
                                        <td colspan="5" class="text-muted text-center py-4">Waiting for item scan or manual entry...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Manual Product & Barcode Search Input -->
                    <div class="px-2 px-md-3 pt-2 pb-2 border-top bg-light flex-shrink-0 position-relative">
                        <div class="input-group input-group-sm shadow-sm rounded-pill overflow-hidden border bg-white">
                            <span class="input-group-text bg-white border-0 text-muted ps-3 pe-1">
                                <i class="fa-solid fa-barcode"></i>
                            </span>
                            <input type="text"
                                   class="form-control border-0 bg-white shadow-none ps-2 fw-medium"
                                   placeholder="Scan barcode or enter product name..."
                                   id="manualProductInput"
                                   autocomplete="off" />

                            <button class="btn btn-outline-secondary border-0 px-2 px-sm-3 d-flex align-items-center"
                                    type="button"
                                    id="btnToggleScanner"
                                    data-bs-toggle="modal"
                                    data-bs-target="#barcodeScannerModal"
                                    title="Scan Barcode via Camera">
                                <i class="fa-solid fa-camera text-primary"></i>
                            </button>

                            <button class="btn btn-primary fw-semibold px-3 text-nowrap"
                                    type="button"
                                    id="btnAddProduct"
                                    style="background-color: #1162a3; border-color: #1162a3;">
                                <i class="fa-solid fa-plus me-1"></i> Add
                            </button>
                        </div>

                        <!-- Autocomplete Suggestions -->
                        <div id="productSearchResults"
                             class="position-absolute bg-white border rounded-3 shadow-lg w-100 start-0 px-1 py-1"
                             style="display: none; z-index: 1050; max-height: 180px; overflow-y: auto; bottom: 100%; margin-bottom: 4px;">
                        </div>
                    </div>

                    <!-- Bottom Settlement Bar with Pay Debt & Proceed Buttons -->
                    <div class="p-2 p-md-1 border-0 flex-shrink-0 bg-white rounded-bottom-4">
                        <div class="d-flex justify-content-between align-items-center p-2 px-3 border rounded-4 shadow-sm bg-white checkout-settlement-bar">
                            <div class="text-start checkout-total-row">
                                <span class="text-muted fw-bold text-uppercase d-block mb-1 mb-sm-1" style="font-size: 0.70rem; letter-spacing: 0.5px;">Total Amount</span>
                                <span class="fw-bold text-dark lh-1" id="totalDueDisplay" style="font-size: 1.5rem;">₱ 0.00</span>
                            </div>

                            <div class="d-flex gap-2 checkout-settlement-actions">
                                <div class="d-flex flex-column gap-2 justify-content-center checkout-secondary-btns">
                                    <button class="btn btn-warning border-secondary border-opacity-25 fw-bold rounded-3 d-flex align-items-center px-3 shadow-sm text-nowrap"
                                            style="font-size: 0.85rem; height: 38px;"
                                            onclick="openOldTransactions()">
                                        <i class="fa-solid fa-clock-rotate-left me-2"></i>Recent Transaction
                                    </button>

                                    <button class="btn btn-danger border-danger border-opacity-25 fw-bold rounded-3 d-flex align-items-center px-3 shadow-sm position-relative text-nowrap"
                                            id="btnVoidCart"
                                            style="font-size: 0.85rem; height: 38px;">
                                        <i class="fa-solid fa-trash-can me-2"></i>Void Cart
                                    </button>
                                </div>

                                <!-- GREEN Pay Debt Button -->
                                <button class="btn btn-success d-flex flex-column align-items-center justify-content-center fw-bold px-3 px-sm-4 rounded-3 shadow-sm"
                                        id="btnPayDebt"
                                        style="background-color: #198754; border-color: #198754;"
                                        onclick="initiateDebtPayment()">
                                    <i class="fa-solid fa-hand-holding-dollar mb-1" style="font-size: 1.4rem;"></i>
                                    <span class="text-center" style="font-size: 0.85rem; letter-spacing: 0.3px; line-height: 1.2;">PAY <br>DEBT</span>
                                </button>

                                <button class="btn btn-primary d-flex flex-column align-items-center justify-content-center fw-bold px-3 px-sm-4 rounded-3 shadow-sm"
                                        id="btnProceedToPayment"
                                        style="background-color: #1162a3; border-color: #1162a3;">
                                    <i class="fa-solid fa-credit-card mb-1" style="font-size: 1.4rem;"></i>
                                    <span class="text-center" style="font-size: 0.85rem; letter-spacing: 0.3px; line-height: 1.2;">PROCEED TO <br>PAYMENT</span>
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Recent Transaction UI Model -->
<div class="modal fade" id="oldTransactionsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 540px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

            <!-- Modal Header -->
            <div class="modal-header text-white p-3 border-0 flex-shrink-0" style="background-color: #1162a3;">
                <h6 class="modal-title fw-bold mb-0 fs-5 pe-4" id="txModalHeaderTitle">
                    <i class="fa-solid fa-clock-rotate-left me-2"></i>Today's Completed Transactions
                </h6>
                <button type="button" data-bs-dismiss="modal" class="modal-custom-close rounded-2"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-3 p-md-4 bg-light">

                <!-- VIEW A: Transactions List Section -->
                <div id="txListViewSection">
                    <!-- Search Bar -->
                    <div class="input-group input-group-sm mb-3 shadow-sm rounded-pill overflow-hidden border bg-white">
                        <span class="input-group-text bg-white border-0 text-muted ps-3">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" id="txSearchInput" class="form-control border-0 bg-white shadow-none ps-2"
                               placeholder="Search receipt #, customer, method..." oninput="filterTransactionsList()" />
                    </div>

                    <!-- Scrollable List Container -->
                    <div class="overflow-y-auto pe-1 no-scrollbar" style="max-height: 460px;" id="oldTransactionsContainer">
                        <div id="oldTransactionsList" class="d-flex flex-column gap-2">
                            <div class="text-center py-4 text-muted small">
                                <i class="fa-solid fa-spinner fa-spin text-primary me-2"></i>Loading transactions...
                            </div>
                        </div>
                    </div>
                </div>

                <!-- VIEW B: Thermal Mini-Receipt Section -->
                <div id="txReceiptViewSection" style="display: none;">

                    <!-- Thermal POS Paper Card (Utilizing Site CSS) -->
                    <div class="receipt-paper w-100 p-3 p-sm-4 border bg-white rounded-4 shadow-sm mx-auto mb-3" style="max-width: 460px;">

                        <!-- Top Status Indicator -->
                        <div class="text-end mb-2">
                            <span id="modalReceiptStatusBadge" class="badge rounded-pill px-3 py-1 fw-bold" style="font-size: 11px;">
                                Completed
                            </span>
                        </div>

                        <!-- Store Branding -->
                        <div class="text-center mb-3">
                            <div class="d-inline-flex p-2 rounded-circle bg-primary bg-opacity-10 text-primary mb-1">
                                <img src="/images/SmartScanLogo.png"
                                     alt="Smart Scan Logo"
                                     width="48"
                                     height="48"
                                     class="object-fit-contain"
                                     onerror="this.style.display='none'" />
                            </div>
                            <h5 class="fw-bold text-uppercase mb-0 text-dark" style="letter-spacing: 0.5px; font-size: 1.15rem;">
                                SmartScan Retail
                            </h5>
                            <p class="text-muted small mb-1" style="font-size: 11px;">
                                Automated Vision Checkout System
                            </p>
                            <span class="badge rounded-pill bg-light text-secondary border fw-medium px-3 py-1" style="font-size: 10px;">
                                OFFICIAL TRANSACTION RECEIPT
                            </span>
                        </div>

                        <div class="receipt-dashed-line"></div>

                        <!-- Meta Data -->
                        <div class="small text-secondary mb-2" style="font-size: 12px;">
                            <div class="d-flex justify-content-between gap-2 mb-1">
                                <span>Receipt #:</span>
                                <strong class="font-monospace text-dark text-end" id="modalReceiptNumber">#REC-000000</strong>
                            </div>
                            <div class="d-flex justify-content-between gap-2 mb-1">
                                <span>Date &amp; Time:</span>
                                <span class="text-dark text-end" id="modalReceiptDate">YYYY-MM-DD 00:00 AM</span>
                            </div>
                            <div class="d-flex justify-content-between gap-2 mb-1">
                                <span>Retail Store:</span>
                                <span class="text-dark fw-semibold text-end" id="modalReceiptStore">@(ViewBag.RetailName ?? "SmartScan Retail")</span>
                            </div>
                            <div class="d-flex justify-content-between gap-2 mb-1">
                                <span>Cashier / POS:</span>
                                <span class="text-dark text-end" id="modalReceiptCashier">@(User.Identity?.Name ?? "Main Station")</span>
                            </div>
                            <div class="d-flex justify-content-between gap-2 mb-1" id="modalCustomerRow" style="display: none;">
                                <span>Customer:</span>
                                <span class="text-dark fw-semibold text-end" id="modalReceiptCustomer">Walk-in Guest</span>
                            </div>
                            <div class="justify-content-between gap-2" id="modalDueDateRow" style="display: none !important;">
                                <span class="text-danger fw-bold">Due Date:</span>
                                <span class="text-danger fw-bold font-monospace text-end" id="modalReceiptDueDate"></span>
                            </div>
                        </div>

                        <div class="receipt-dashed-line"></div>

                        <!-- Itemized Purchase List -->
                        <div class="py-1">
                            <div class="d-flex justify-content-between text-muted fw-bold text-uppercase mb-2" style="font-size: 11px;">
                                <span>Item Description</span>
                                <span class="text-end">Total</span>
                            </div>
                            <div id="modalReceiptItemList" class="d-flex flex-column gap-2 mb-2 no-scrollbar" style="max-height: 200px; overflow-y: auto;">
                                <!-- Injected via JavaScript -->
                            </div>
                        </div>

                        <div class="receipt-double-line"></div>

                        <!-- Financial Summary -->
                        <div class="small" style="font-size: 12px;">
                            <div class="d-flex justify-content-between text-secondary mb-1">
                                <span>Total Quantity:</span>
                                <span class="fw-semibold text-dark" id="modalReceiptTotalQty">0 units</span>
                            </div>
                            <div class="d-flex justify-content-between text-secondary mb-2">
                                <span>Subtotal:</span>
                                <span class="fw-semibold text-dark" id="modalReceiptSubtotal">₱0.00</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2 pt-1 border-top">
                                <span class="fs-6 fw-bold text-dark">TOTAL PAID:</span>
                                <span class="fs-5 fw-bold text-success font-monospace" id="modalReceiptGrandTotal">₱0.00</span>
                            </div>
                            <div class="d-flex justify-content-between text-secondary pt-1">
                                <span>Payment Tender:</span>
                                <span id="modalReceiptMethodBadge" class="badge rounded-pill fw-semibold px-2 py-1 shadow-sm" style="font-size: 11px;">
                                    Cash
                                </span>
                            </div>
                        </div>

                        <div class="receipt-dashed-line"></div>

                        <!-- CSS Barcode Strip & Footer -->
                        <div class="text-center pt-1">
                            <div class="barcode-strip mb-2"></div>
                            <span class="font-monospace small text-muted d-block mb-1" id="modalBarcodeNumber" style="letter-spacing: 2px;">
                                *00000000*
                            </span>
                            <p class="small text-muted mb-0 fst-italic" style="font-size: 10px;">
                                Thank you for shopping with us!<br />
                                Verified by SmartScan Automated Vision System
                            </p>
                        </div>
                    </div>

                    <!-- Bottom Action Buttons (Return + Customer QR Copy) -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2 w-100 mx-auto" style="max-width: 460px;">
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold shadow-sm" onclick="closeReceiptPreview()">
                            <i class="fa-solid fa-arrow-left me-1"></i>Return to Transactions List
                        </button>

                        <button type="button" class="btn btn-sm btn-warning rounded-pill px-3 fw-bold text-dark shadow-sm" onclick="openModalReceiptQrView()">
                            <i class="fa-solid fa-qrcode me-1"></i>Customer QR Copy
                        </button>
                    </div>

                </div>

                <!-- VIEW C: Customer Digital Receipt QR Section (Inside Modal) -->
                <div id="txQrViewSection" style="display: none;">
                    <div class="card border bg-white rounded-4 shadow-sm p-3 p-sm-4 text-center mx-auto mb-3" style="max-width: 460px;">
                        <h4 class="fw-bold text-primary mb-1 fs-5">Scan to Save Receipt on Phone</h4>
                        <p class="fw-medium small mb-3 text-secondary" style="font-size: 14px;">
                            Ask the customer to point their phone's camera or QR scanner at the code below.
                        </p>

                        <!-- QR Code Box -->
                        <div class="bg-light p-3 rounded-4 border d-inline-flex flex-column align-items-center mx-auto mb-3 shadow-sm">
                            <div id="txModalQrContainer" class="p-2 bg-white rounded-3 border"></div>
                            <span class="font-monospace fw-bold text-dark small mt-2" id="txModalQrReceiptNum">#REC-000000</span>
                        </div>

                        <!-- Mode Switcher: Web e-Receipt Link vs Offline Text Summary -->
                        <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
                            <input type="radio" class="btn-check" name="txModalQrMode" id="txQrModeWeb" autocomplete="off" checked onchange="renderTxModalQrByMode('web')">
                            <label class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" for="txQrModeWeb" style="font-size: 11px;">
                                <i class="fa-solid fa-globe me-1"></i>Digital Receipt Page
                            </label>

                            <input type="radio" class="btn-check" name="txModalQrMode" id="txQrModeText" autocomplete="off" onchange="renderTxModalQrByMode('text')">
                            <label class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold" for="txQrModeText" style="font-size: 11px;">
