@{
    ViewData["Title"] = "Checkout Page";
    ViewData["HeaderTitle"] = "Checkout";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(0deg, #95CCDD 0%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="container-fluid mt-3">
    <div class="row g-4" style="height: calc(100vh - 130px);">

        <div class="col-md-7 d-flex flex-column h-100">
            <div class="card shadow-lg border-0 bg-dark text-white flex-grow-1 position-relative d-flex align-items-center justify-content-center overflow-hidden rounded-3">

                <img id="webcamFeed" class="w-100 h-100" style="object-fit: cover; display: none;" alt="Live AI Scanner" />

                <div id="cameraPlaceholder" class="text-center p-4">
                    <i class="fa-solid fa-video-slash fa-4x text-secondary mb-3"></i>
                    <h4 class="text-secondary fw-semibold">Webcam Disabled</h4>
                    <p class="text-muted small">Click the action button below to connect to the YOLO scanner.</p>
                </div>

                <div class="position-absolute bottom-0 start-50 translate-middle-x mb-3 z-3">
                    <button id="startCamBtn" class="btn fw-semibold shadow px-4 py-2" style="background-color:#1ca9e1">
                        <i class="fa-solid fa-camera me-2"></i> Enable Webcam
                    </button>
                    <button id="stopCamBtn" class="btn btn-danger fw-semibold shadow px-4 py-2 d-none">
                        <i class="fa-solid fa-video-slash me-2"></i> Stop Feed
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-5 d-flex flex-column h-100">
            <div class="card shadow-lg border-0 h-100 rounded-3">
                <div class="card-header text-white p-3 d-flex align-items-center justify-content-between" style="background-color:#1162a3">
                    <h5 class="mb-0"><i class="fa-solid fa-list-check text-white me-2"></i> Identified Items</h5>
                </div>

                <div class="card-body overflow-y-auto flex-grow-1 p-0" style="max-height: 100%;">
                    <div class="list-group list-group-flush p-3" id="logListItems">
                        <ul id="identifiedItemsList" class="list-unstyled m-0">
                            <li class="text-muted text-center py-3">Waiting for scanner to start...</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {
            const videoImg = document.getElementById("webcamFeed");
            const placeholder = document.getElementById("cameraPlaceholder");
            const startBtn = document.getElementById("startCamBtn");
            const stopBtn = document.getElementById("stopCamBtn");

            // Variable to hold our scanning timer
            let scannerInterval = null;

            // 1. START WEBCAM ACTION HANDLER
            startBtn.addEventListener("click", function () {
                // Point the image source to your Python server stream
               videoImg.src = "http://localhost:5050/video_feed";

                // Toggle visibility states cleanly
                placeholder.style.display = "none";
                videoImg.style.display = "block";
                startBtn.classList.add("d-none");
                stopBtn.classList.remove("d-none");

                // Start asking Python for the item list every 1 second
                scannerInterval = setInterval(fetchScannedItems, 1000);
            });

            // 2. STOP WEBCAM ACTION HANDLER
            stopBtn.addEventListener("click", function () {
                // Disconnect from the Python server
                videoImg.src = "";

                // Stop asking for items
                clearInterval(scannerInterval);

                // Reset layouts back to placeholder states
                videoImg.style.display = "none";
                placeholder.style.display = "block";
                stopBtn.classList.add("d-none");
                startBtn.classList.remove("d-none");

                // Clear the list
                document.getElementById("identifiedItemsList").innerHTML = "<li class='text-muted text-center py-3'>Scanner stopped.</li>";
            });

            // 3. FETCH DATA FROM PYTHON
            async function fetchScannedItems() {
                try {
                    // Call the Python API
                    const response = await fetch("http://localhost:5050/get_detections");
                    const items = await response.json();

                    const list = document.getElementById("identifiedItemsList");
                    list.innerHTML = ""; // Clear the old list

                    if (items.length === 0) {
                        list.innerHTML = "<li class='text-muted text-center py-3'>No items detected on tray...</li>";
                    } else {
                        // Create a clean list item for every product YOLO sees
                        items.forEach(item => {
                            list.innerHTML += `
                                <li class="p-2 border-bottom">
                                    <h6 class="mb-0 fw-bold"><i class="fa-solid fa-box text-success me-2"></i>${item}</h6>
                                </li>`;
                        });
                    }
                } catch (error) {
                    console.error("Cannot connect to Python Server: ", error);
                    document.getElementById("identifiedItemsList").innerHTML =
                        "<li class='text-danger text-center py-3'>Lost connection to AI Scanner!</li>";
                }
            }
        });
    </script>
}