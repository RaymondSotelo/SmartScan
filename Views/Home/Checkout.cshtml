@{
    ViewData["Title"] = "Checkout Page";
    ViewData["HeaderTitle"] = "Checkout";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(180deg, #95CCDD 0%, #eef6f9 100%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="container-fluid mt-3">
    <div class="row g-4" style="height: calc(100vh - 130px);">

        <!-- Left Column: Camera View -->
        <div class="col-md-7 d-flex flex-column h-100">
            <div class="card shadow-lg border-0 bg-dark text-white flex-grow-1 position-relative d-flex align-items-center justify-content-center overflow-hidden rounded-3">

                <!-- Container to hold camera feed and overlay bounding boxes -->
                <div id="videoContainer" class="position-relative w-100 h-100" style="display: none;">
                    <video id="webcamFeed" autoplay playsinline class="w-100 h-100" style="object-fit: cover;"></video>

                    <!-- Transparent canvas overlay for drawing boxes & labels -->
                    <canvas id="overlayCanvas" class="position-absolute top-0 start-0 w-100 h-100" style="pointer-events: none;"></canvas>
                </div>

                <!-- Hidden canvas for sending frames to Python -->
                <canvas id="captureCanvas" style="display: none;"></canvas>

                <div id="cameraPlaceholder" class="text-center p-4">
                    <i class="fa-solid fa-video-slash fa-4x text-secondary mb-3"></i>
                    <h4 class="text-secondary fw-semibold">Webcam Disabled</h4>
                    <p class="text-muted small">Select your webcam and click the button below to connect to the scanner.</p>
                </div>

                <!-- Action Controls: Camera Dropdown + Enable/Stop Buttons -->
                <div class="position-absolute bottom-0 start-50 translate-middle-x mb-3 z-3 d-flex gap-2 align-items-center">
                    <select id="cameraSelect" class="form-select form-select-sm shadow-sm" style="max-width: 220px;">
                        <option value="">Detecting cameras...</option>
                    </select>

                    <button id="startCamBtn" class="btn fw-semibold shadow px-4 py-2 text-white" style="background-color:#1ca9e1">
                        <i class="fa-solid fa-camera me-2"></i> Enable Webcam
                    </button>
                    <button id="stopCamBtn" class="btn btn-danger fw-semibold shadow px-4 py-2 d-none">
                        <i class="fa-solid fa-video-slash me-2"></i> Stop Feed
                    </button>
                </div>
            </div>
        </div>

        <!-- Right Column: Transaction Queue -->
        <div class="col-md-5 d-flex flex-column h-100">
            <div class="card shadow-sm border-0 h-100" style="background-color: #e9ecef;">
                <!-- Blue Header -->
                <div class="card-header text-white text-start fw-bold p-3" style="background-color: #1b6ec2;">
                    <i class="fa-solid fa-list-ul me-2"></i> Transaction Queue
                </div>

                <div class="card-body bg-white m-2 rounded d-flex flex-column">
                    <h6 class="fw-bold mb-3 text-start">Digital Receipt</h6>

                    <!-- Receipt Table -->
                    <div class="table-responsive flex-grow-1" style="max-height: 100%; overflow-y: auto;">
                        <table class="table table-striped table-hover table-sm align-middle" style="font-size: 0.85rem;">
                            <thead class="table-light text-muted">
                                <tr>
                                    <th>Product Name</th>
                                    <th>Qty</th>
                                    <th>Unit Price</th>
                                    <th>Subtotal</th>
                                    <th></th> <!-- For Buttons -->
                                </tr>
                            </thead>
                            <tbody id="identifiedItemsList">
                                <tr>
                                    <td colspan="5" class="text-muted text-center py-3">Waiting for scanner to start...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Manual Add Input -->
                    <div class="input-group input-group-sm mt-3 mb-3">
                        <input type="text" class="form-control" placeholder="Enter product name" id="manualProductInput">
                        <button class="btn btn-success fw-bold px-3" type="button" id="btnAddProduct" style="border-radius: 20px;">Add</button>
                    </div>

                    <!-- Total and Actions Row -->
                    <div class="d-flex justify-content-between align-items-center p-2 border rounded shadow-sm bg-white mt-auto">
                        <!-- Total Due -->
                        <div class="text-start">
                            <span class="text-dark fw-bold d-block" style="font-size: 0.75rem;">TOTAL DUE:</span>
                            <span class="fw-bold text-dark" id="totalDueDisplay" style="font-size: 1.3rem;">PHP 0.00</span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2">
                            <!-- Stacked Buttons -->
                            <div class="d-flex flex-column gap-1">
                                <button class="btn btn-warning btn-sm fw-bold text-dark py-1 px-2" style="font-size: 0.65rem;">OLD<br>TRANSACTION</button>
                                <button class="btn btn-danger btn-sm fw-bold py-1 px-2" id="btnVoidCart" style="font-size: 0.65rem;">VOID CART</button>
                            </div>
                            <!-- Big Blue Button (ID ADDED HERE) -->
                            <button class="btn btn-primary d-flex flex-column align-items-center justify-content-center fw-bold px-2" id="btnProceedToPayment" style="font-size: 0.75rem; background-color: #1b6ec2;">
                                <i class="fa-solid fa-credit-card mb-1 fs-5"></i>
                                PROCEED TO<br>PAYMENT
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Adjust Product Quantity Modal -->
<div class="modal fade" id="adjustQuantityModal" tabindex="-1" aria-labelledby="adjustQuantityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content shadow-lg border-0 rounded-3">
            <div class="modal-header border-bottom-0 pb-0">
                <h6 class="modal-title fw-bold" id="adjustQuantityModalLabel">
                    <i class="fa-solid fa-pen-to-square me-2"></i>Adjusting product quantity
                </h6>
                <button type="button" class="btn-close text-danger fw-bold" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Hidden field to track which item we are editing -->
                <input type="hidden" id="editItemIndex">

                <div class="mb-3">
                    <label class="form-label fw-bold small text-muted mb-1">Product Name</label>
                    <input type="text" class="form-control bg-light" id="editProductName" readonly>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small text-muted mb-1">Price</label>
                    <input type="text" class="form-control bg-light" id="editProductPrice" readonly>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold small text-muted mb-1">Quantity</label>
                    <input type="number" class="form-control" id="editProductQuantity" min="1">
                    <div class="invalid-feedback">Please enter a valid quantity greater than 0.</div>
                </div>

                <button type="button" class="btn w-100 fw-bold text-white shadow-sm" id="btnConfirmAdjust" style="background-color: #1ca9e1; border-radius: 8px;">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {
            const video = document.getElementById("webcamFeed");
            const videoContainer = document.getElementById("videoContainer");
            const captureCanvas = document.getElementById("captureCanvas");
            const captureCtx = captureCanvas.getContext("2d");
            const overlay = document.getElementById("overlayCanvas");
            const overlayCtx = overlay.getContext("2d");

            const placeholder = document.getElementById("cameraPlaceholder");
            const startBtn = document.getElementById("startCamBtn");
            const stopBtn = document.getElementById("stopCamBtn");
            const cameraSelect = document.getElementById("cameraSelect");
            const list = document.getElementById("identifiedItemsList");
            const totalDueDisplay = document.getElementById("totalDueDisplay");

            let isScanningActive = false;
            let isProcessingFrame = false;
            let mediaStream = null;
            const recentDetections = [];
            const detectionHoldMs = 300;

            // CART & CACHE STATE
            const priceCache = {};
            let manualItems = [];

            // 1. POPULATE CONNECTED WEBCAMS
            async function loadCameras() {
                try {
                    const tempStream = await navigator.mediaDevices.getUserMedia({ video: true });
                    tempStream.getTracks().forEach(t => t.stop());

                    const devices = await navigator.mediaDevices.enumerateDevices();
                    const videoDevices = devices.filter(d => d.kind === "videoinput");

                    cameraSelect.innerHTML = "";
                    videoDevices.forEach((device, index) => {
                        const option = document.createElement("option");
                        option.value = device.deviceId;
                        option.text = device.label || `Camera ${index + 1}`;

                        const lowerLabel = (device.label || "").toLowerCase();
                        if (lowerLabel.includes("usb") || lowerLabel.includes("external") || lowerLabel.includes("webcam")) {
                            option.selected = true;
                        }

                        cameraSelect.appendChild(option);
                    });

                    if (videoDevices.length === 0) {
                        cameraSelect.innerHTML = "<option value=''>Default Camera</option>";
                    }
                } catch (err) {
                    console.warn("Could not enumerate camera labels:", err);
                    cameraSelect.innerHTML = "<option value=''>Default Camera</option>";
                }
            }
            loadCameras();

            // 2. START SELECTED CAMERA
            async function startSelectedCamera() {
                if (mediaStream) {
                    mediaStream.getTracks().forEach(track => track.stop());
                }

                const selectedDeviceId = cameraSelect.value;
                const constraints = {
                    video: {
                        deviceId: selectedDeviceId ? { exact: selectedDeviceId } : undefined,
                        width: { ideal: 1280, min: 640 },
                        height: { ideal: 720, min: 480 },
                        frameRate: { ideal: 30, max: 30 },
                        focusMode: { ideal: "continuous" }
                    }
                };

                mediaStream = await navigator.mediaDevices.getUserMedia(constraints);
                video.srcObject = mediaStream;

                const track = mediaStream.getVideoTracks()[0];
                const capabilities = track.getCapabilities ? track.getCapabilities() : {};
                if (capabilities.focusMode && capabilities.focusMode.includes("continuous")) {
                    try {
                        await track.applyConstraints({ advanced: [{ focusMode: "continuous" }] });
                    } catch (e) {
                        console.warn("Autofocus constraint not applied:", e);
                    }
                }
            }

            // 3. START WEBCAM BUTTON
            startBtn.addEventListener("click", async function () {
                try {
                    await startSelectedCamera();

                    placeholder.style.display = "none";
                    videoContainer.style.display = "block";
                    startBtn.classList.add("d-none");
                    stopBtn.classList.remove("d-none");

                    isScanningActive = true;
                    startDetectionLoop();
                } catch (err) {
                    console.error("Camera access error:", err);
                    alert("Failed to access camera: " + err.message);
                }
            });

            // 4. SWITCH WEBCAM ON THE FLY
            cameraSelect.addEventListener("change", async function () {
                if (mediaStream) {
                    try {
                        await startSelectedCamera();
                    } catch (err) {
                        console.error("Failed to switch camera:", err);
                    }
                }
            });

            // 5. STOP WEBCAM
            stopBtn.addEventListener("click", function () {
                isScanningActive = false;
                isProcessingFrame = false;

                if (mediaStream) {
                    mediaStream.getTracks().forEach(track => track.stop());
                    mediaStream = null;
                }
                video.srcObject = null;

                overlayCtx.clearRect(0, 0, overlay.width, overlay.height);
                recentDetections.length = 0;

                videoContainer.style.display = "none";
                placeholder.style.display = "block";
                stopBtn.classList.add("d-none");
                startBtn.classList.remove("d-none");

                buildCartAndRender({}, false);
            });

            // 6. DETECTION LOOP (Adjusted to 100ms for stable performance)
            async function startDetectionLoop() {
                while (isScanningActive) {
                    if (!isProcessingFrame && video.readyState === video.HAVE_ENOUGH_DATA) {
                        isProcessingFrame = true;
                        await captureAndDetect();
                        isProcessingFrame = false;
                    }
                    await new Promise(resolve => setTimeout(resolve, 100));
                }
            }

                    // 7. CAPTURE, DETECT, & UPDATE UI
        async function captureAndDetect() {
            captureCanvas.width = video.videoWidth;
            captureCanvas.height = video.videoHeight;
            // Resizing a canvas clears it, so only update its backing size when
            // the camera's actual resolution changes.
            if (overlay.width !== video.videoWidth || overlay.height !== video.videoHeight) {
                overlay.width = video.videoWidth;
                overlay.height = video.videoHeight;
            }

            captureCtx.drawImage(
                video,
                0,
                0,
                captureCanvas.width,
                captureCanvas.height
            );

            const frameBase64 = captureCanvas.toDataURL("image/jpeg", 0.5);

            try {
                const response = await fetch("http://localhost:5000/detect_frame", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        image: frameBase64
                    })
                });

                const data = await response.json();
                const detections = data.detections || [];
                const now = Date.now();
                const currentDetections = detections.filter(d => d.box);

                // Keep a detection briefly through a single missed inference,
                // while redrawing from a clean canvas to avoid label trails.
                for (const detected of currentDetections) {
                    const [x1, y1, x2, y2] = detected.box;
                    let previous = recentDetections.find(item =>
                        item.name === detected.name &&
                        Math.abs(item.box[0] - x1) < video.videoWidth * 0.12 &&
                        Math.abs(item.box[1] - y1) < video.videoHeight * 0.12
                    );

                    if (!previous) {
                        previous = { name: detected.name, box: detected.box, confidence: detected.confidence };
                        recentDetections.push(previous);
                    }

                    if (previous.lastSeen) {
                        previous.box = detected.box.map((coordinate, index) =>
                            Math.round(previous.box[index] * 0.65 + coordinate * 0.35)
                        );
                        previous.confidence = Math.round(
                            (previous.confidence * 0.65 + detected.confidence * 0.35) / 5
                        ) * 5;
                    } else {
                        previous.box = detected.box;
                        previous.confidence = detected.confidence;
                    }
                    previous.lastSeen = now;
                }

                for (let i = recentDetections.length - 1; i >= 0; i--) {
                    if (now - (recentDetections[i].lastSeen || 0) > detectionHoldMs) {
                        recentDetections.splice(i, 1);
                    }
                }

                overlayCtx.clearRect(0, 0, overlay.width, overlay.height);

                for (const detected of recentDetections) {
                    const [x1, y1, x2, y2] = detected.box;
                    const boxColor = detected.confidence >= 80 ? "#00FF00" : "#FFA500";
                    overlayCtx.lineWidth = 3;
                    overlayCtx.strokeStyle = boxColor;
                    overlayCtx.strokeRect(x1, y1, x2 - x1, y2 - y1);
                    overlayCtx.fillStyle = boxColor;
                    overlayCtx.font = "bold 15px Arial";
                    overlayCtx.fillText(`${detected.name} (${detected.confidence}%)`, x1, Math.max(18, y1 - 8));
                }

                const yoloCounts = {};
                let hasLowConfidence = false;

                for (const detected of detections) {

                    if (detected.confidence < 80) {
                        hasLowConfidence = true;
                    } else {
                        yoloCounts[detected.name] =
                            (yoloCounts[detected.name] || 0) + 1;
                    }
                }

                await buildCartAndRender(
                    yoloCounts,
                    hasLowConfidence
                );

            } catch (error) {

                console.error(
                    "Cannot connect to Python Server:",
                    error
                );

                list.innerHTML =
                    "<tr><td colspan='5' class='text-danger text-center py-3'>Lost connection to AI Scanner!</td></tr>";
            }
        }

            // Helper to fetch DB data safely and render the final table
            window.buildCartAndRender = async function(yoloCounts, hasLowConfidence) {
                let htmlOutput = "";
                let currentTotal = 0;

                // 1. Process YOLO Auto Items
                for (const [itemName, qty] of Object.entries(yoloCounts)) {
                    const formattedItemName = itemName.toLowerCase().replaceAll(" ", "_");

                    if (!priceCache[formattedItemName]) {
                        try {
                            const dbResponse = await fetch(`/Home/GetProductDetails?productName=${formattedItemName}`);
                            if (dbResponse.ok) {
                                priceCache[formattedItemName] = await dbResponse.json();
                            } else {
                                priceCache[formattedItemName] = { name: itemName, notFound: true };
                            }
                        } catch (err) {
                            priceCache[formattedItemName] = { name: itemName, notFound: true };
                        }
                    }

                    const product = priceCache[formattedItemName];
                    if (!product.notFound) {
                        const subtotal = product.price * qty;
                        currentTotal += subtotal;

                        htmlOutput += `
                            <tr>
                                <td>${product.name} <span class="badge bg-success ms-1">Auto</span></td>
                                <td>${qty}</td>
                                <td>PHP ${product.price.toFixed(2)}</td>
                                <td class="text-success fw-bold">PHP ${subtotal.toFixed(2)}</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-success py-0 px-1" onclick="lockYoloItem('${formattedItemName}', '${product.name}', ${product.price}, ${qty})" title="Lock Item in Cart">
                                        <i class="fa-solid fa-check"></i>
                                    </button>
                                </td>
                            </tr>`;
                    } else {
                        htmlOutput += `
                            <tr>
                                <td class="text-warning fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>${itemName}</td>
                                <td>${qty}</td>
                                <td>-</td>
                                <td class="text-danger">Not in DB</td>
                                <td></td>
                            </tr>`;
                    }
                }

                // 2. Process Manual/Saved Items
                manualItems.forEach((item, index) => {
                    const subtotal = item.price * item.qty;
                    currentTotal += subtotal;

                    htmlOutput += `
                        <tr>
                            <td>${item.name} <span class="badge bg-secondary ms-1">Saved</span></td>
                            <td>${item.qty}</td>
                            <td>PHP ${item.price.toFixed(2)}</td>
                            <td class="text-success fw-bold">PHP ${subtotal.toFixed(2)}</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary py-0 px-1 me-1" onclick="editManualItem(${index})" title="Edit Qty">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger py-0 px-1" onclick="removeManualItem(${index})" title="Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>`;
                });

                if (hasLowConfidence) {
                    htmlOutput += `
                        <tr class="table-warning">
                            <td colspan="5" class="text-danger fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>Item Unclear. Hold steady.</td>
                        </tr>`;
                }

                if (htmlOutput === "" && manualItems.length === 0) {
                    htmlOutput = "<tr><td colspan='5' class='text-muted text-center py-3'>No items detected on tray...</td></tr>";
                }

                list.innerHTML = htmlOutput;
                totalDueDisplay.innerText = `PHP ${currentTotal.toFixed(2)}`;
            }

            // 8. MANUAL ADD BUTTON LOGIC
            document.getElementById("btnAddProduct").addEventListener("click", async () => {
                const input = document.getElementById("manualProductInput");
                const name = input.value.trim();
                if (!name) return;

                const formattedItemName = name.toLowerCase().replaceAll(" ", "_");

                try {
                    const dbResponse = await fetch(`/Home/GetProductDetails?productName=${formattedItemName}`);
                    if (dbResponse.ok) {
                        const product = await dbResponse.json();

                        const existing = manualItems.find(i => i.name === product.name);
                        if (existing) {
                            existing.qty++;
                        } else {
                            manualItems.push({ name: product.name, price: product.price, qty: 1 });
                        }
                        input.value = "";

                        if (!isScanningActive) buildCartAndRender({}, false);
                    } else {
                        alert("Product not found in database.");
                    }
                } catch (err) {
                    alert("Database connection error.");
                }
            });

            // 9. VOID CART BUTTON
            document.getElementById("btnVoidCart").addEventListener("click", () => {
                if (confirm("Are you sure you want to void all saved items?")) {
                    manualItems = [];
                    if (!isScanningActive) {
                        buildCartAndRender({}, false);
                    }
                }
            });

            // --- NEW GLOBAL FUNCTIONS ---

            // Locks a scanned Auto item into the permanent Saved cart
            window.lockYoloItem = function (formattedName, displayName, price, qty) {
                const existing = manualItems.find(i => i.name === displayName);
                if (existing) {
                    existing.qty += qty;
                } else {
                    manualItems.push({ name: displayName, price: price, qty: qty });
                }

                if (!isScanningActive) buildCartAndRender({}, false);
            };

            // 10. EDIT MODAL LOGIC
            window.editManualItem = function (index) {
                const item = manualItems[index];

                // Fill the modal with the selected item's data
                document.getElementById("editItemIndex").value = index;
                document.getElementById("editProductName").value = item.name;
                document.getElementById("editProductPrice").value = `PHP ${item.price.toFixed(2)}`;

                const qtyInput = document.getElementById("editProductQuantity");
                qtyInput.value = item.qty;
                qtyInput.classList.remove("is-invalid"); // Clear old errors

                // Open the Bootstrap modal
                const adjustModal = new bootstrap.Modal(document.getElementById("adjustQuantityModal"));
                adjustModal.show();
            };

            // 11. CONFIRM ADJUSTMENT BUTTON
            document.getElementById("btnConfirmAdjust").addEventListener("click", function() {
                const index = document.getElementById("editItemIndex").value;
                const qtyInput = document.getElementById("editProductQuantity");
                const newQty = parseInt(qtyInput.value);

                // Validation Rule 1.1: Error if invalid or missing
                if (isNaN(newQty) || newQty <= 0) {
                    qtyInput.classList.add("is-invalid");
                    return;
                }

                // Update the quantity and close modal
                qtyInput.classList.remove("is-invalid");
                manualItems[index].qty = newQty;

                const adjustModalEl = document.getElementById("adjustQuantityModal");
                const adjustModal = bootstrap.Modal.getInstance(adjustModalEl);
                adjustModal.hide();

                // Refresh the receipt
                if (!isScanningActive) buildCartAndRender({}, false);
            });

            // Removes a Saved item
            window.removeManualItem = function (index) {
                manualItems.splice(index, 1);
                if (!isScanningActive) buildCartAndRender({}, false);
            };

            // 12. PROCEED TO PAYMENT BUTTON
            document.getElementById("btnProceedToPayment").addEventListener("click", () => {
                if (manualItems.length === 0) {
                    alert("The cart is empty! Please add or lock items before proceeding.");
                    return;
                }

                // Save the locked items to browser storage
                sessionStorage.setItem("smartScanCart", JSON.stringify(manualItems));

                // Redirect to the Payment page
                window.location.href = "/Home/Payment";
            });
        });
    </script>
}
