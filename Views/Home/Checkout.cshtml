@{
    ViewData["Title"] = "Checkout Page";
    ViewData["HeaderTitle"] = "Checkout";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(0deg, #95CCDD 0%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="container-fluid mt-3">
    <div class="row g-4" style="height: calc(100vh - 130px);">

        <!-- Left Column: Camera View -->
        <div class="col-md-7 d-flex flex-column h-100">
            <div class="card shadow-lg border-0 bg-dark text-white flex-grow-1 position-relative d-flex align-items-center justify-content-center overflow-hidden rounded-3">

                <!-- Container to hold camera feed and overlay bounding boxes -->
                <div id="videoContainer" class="position-relative w-100 h-100" style="display: none;">
                    <video id="webcamFeed" autoplay playsinline class="w-100 h-100" style="object-fit: cover;"></video>
                    <!-- Transparent canvas overlay for drawing boxes & labels -->
                    <canvas id="overlayCanvas" class="position-absolute top-0 start-0 w-100 h-100" style="pointer-events: none;"></canvas>
                </div>

                <!-- Hidden canvas for sending frames to Python -->
                <canvas id="captureCanvas" style="display: none;"></canvas>

                <div id="cameraPlaceholder" class="text-center p-4">
                    <i class="fa-solid fa-video-slash fa-4x text-secondary mb-3"></i>
                    <h4 class="text-secondary fw-semibold">Webcam Disabled</h4>
                    <p class="text-muted small">Select your webcam and click the button below to connect to the scanner.</p>
                </div>

                <!-- Action Controls: Camera Dropdown + Enable/Stop Buttons -->
                <div class="position-absolute bottom-0 start-50 translate-middle-x mb-3 z-3 d-flex gap-2 align-items-center">
                    <select id="cameraSelect" class="form-select form-select-sm shadow-sm" style="max-width: 220px;">
                        <option value="">Detecting cameras...</option>
                    </select>

                    <button id="startCamBtn" class="btn fw-semibold shadow px-4 py-2 text-white" style="background-color:#1ca9e1">
                        <i class="fa-solid fa-camera me-2"></i> Enable Webcam
                    </button>
                    <button id="stopCamBtn" class="btn btn-danger fw-semibold shadow px-4 py-2 d-none">
                        <i class="fa-solid fa-video-slash me-2"></i> Stop Feed
                    </button>
                </div>
            </div>
        </div>

        <!-- Right Column: Scanned Items & Database Prices -->
        <div class="col-md-5 d-flex flex-column h-100">
            <div class="card shadow-lg border-0 h-100 rounded-3">
                <div class="card-header text-white p-3 d-flex align-items-center justify-content-between" style="background-color:#1162a3">
                    <h5 class="mb-0"><i class="fa-solid fa-list-check text-white me-2"></i> Identified Items</h5>
                </div>

                <div class="card-body overflow-y-auto flex-grow-1 p-0" style="max-height: 100%;">
                    <div class="list-group list-group-flush p-3" id="logListItems">
                        <ul id="identifiedItemsList" class="list-unstyled m-0">
                            <li class="text-muted text-center py-3">Waiting for scanner to start...</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {
            const video = document.getElementById("webcamFeed");
            const videoContainer = document.getElementById("videoContainer");
            const captureCanvas = document.getElementById("captureCanvas");
            const captureCtx = captureCanvas.getContext("2d");
            const overlay = document.getElementById("overlayCanvas");
            const overlayCtx = overlay.getContext("2d");

            const placeholder = document.getElementById("cameraPlaceholder");
            const startBtn = document.getElementById("startCamBtn");
            const stopBtn = document.getElementById("stopCamBtn");
            const cameraSelect = document.getElementById("cameraSelect");
            const list = document.getElementById("identifiedItemsList");

            let isScanningActive = false;
            let isProcessingFrame = false;
            let mediaStream = null;

            // 1. POPULATE CONNECTED WEBCAMS (USB + BUILT-IN)
            async function loadCameras() {
                try {
                    const tempStream = await navigator.mediaDevices.getUserMedia({ video: true });
                    tempStream.getTracks().forEach(t => t.stop());

                    const devices = await navigator.mediaDevices.enumerateDevices();
                    const videoDevices = devices.filter(d => d.kind === "videoinput");

                    cameraSelect.innerHTML = "";
                    videoDevices.forEach((device, index) => {
                        const option = document.createElement("option");
                        option.value = device.deviceId;
                        option.text = device.label || `Camera ${index + 1}`;

                        const lowerLabel = (device.label || "").toLowerCase();
                        if (lowerLabel.includes("usb") || lowerLabel.includes("external") || lowerLabel.includes("webcam")) {
                            option.selected = true;
                        }

                        cameraSelect.appendChild(option);
                    });

                    if (videoDevices.length === 0) {
                        cameraSelect.innerHTML = "<option value=''>Default Camera</option>";
                    }
                } catch (err) {
                    console.warn("Could not enumerate camera labels:", err);
                    cameraSelect.innerHTML = "<option value=''>Default Camera</option>";
                }
            }
            loadCameras();

            // 2. START SELECTED CAMERA WITH HD FOCUS CONSTRAINTS
            async function startSelectedCamera() {
                if (mediaStream) {
                    mediaStream.getTracks().forEach(track => track.stop());
                }

                const selectedDeviceId = cameraSelect.value;
                const constraints = {
                    video: {
                        deviceId: selectedDeviceId ? { exact: selectedDeviceId } : undefined,
                        width: { ideal: 1280, min: 640 },
                        height: { ideal: 720, min: 480 },
                        frameRate: { ideal: 30, max: 30 },
                        focusMode: { ideal: "continuous" }
                    }
                };

                mediaStream = await navigator.mediaDevices.getUserMedia(constraints);
                video.srcObject = mediaStream;

                // Hardware autofocus command
                const track = mediaStream.getVideoTracks()[0];
                const capabilities = track.getCapabilities ? track.getCapabilities() : {};
                if (capabilities.focusMode && capabilities.focusMode.includes("continuous")) {
                    try {
                        await track.applyConstraints({ advanced: [{ focusMode: "continuous" }] });
                    } catch (e) {
                        console.warn("Autofocus constraint not applied:", e);
                    }
                }
            }

            // 3. START WEBCAM & LAUNCH SMOOTH LOOP
            startBtn.addEventListener("click", async function () {
                try {
                    await startSelectedCamera();

                    placeholder.style.display = "none";
                    videoContainer.style.display = "block";
                    startBtn.classList.add("d-none");
                    stopBtn.classList.remove("d-none");

                    isScanningActive = true;
                    startDetectionLoop();
                } catch (err) {
                    console.error("Camera access error:", err);
                    alert("Failed to access camera: " + err.message);
                }
            });

            // 4. SWITCH WEBCAM ON THE FLY
            cameraSelect.addEventListener("change", async function () {
                if (mediaStream) {
                    try {
                        await startSelectedCamera();
                    } catch (err) {
                        console.error("Failed to switch camera:", err);
                    }
                }
            });

            // 5. STOP WEBCAM
            stopBtn.addEventListener("click", function () {
                isScanningActive = false;
                isProcessingFrame = false;

                if (mediaStream) {
                    mediaStream.getTracks().forEach(track => track.stop());
                    mediaStream = null;
                }
                video.srcObject = null;

                overlayCtx.clearRect(0, 0, overlay.width, overlay.height);

                videoContainer.style.display = "none";
                placeholder.style.display = "block";
                stopBtn.classList.add("d-none");
                startBtn.classList.remove("d-none");

                list.innerHTML = "<li class='text-muted text-center py-3'>Scanner stopped.</li>";
            });

            // 6. NON-BLOCKING DETECTION LOOP (ELIMINATES LAG)
            async function startDetectionLoop() {
                while (isScanningActive) {
                    if (!isProcessingFrame && video.readyState === video.HAVE_ENOUGH_DATA) {
                        isProcessingFrame = true;
                        await captureAndDetect();
                        isProcessingFrame = false;
                    }
                    // Wait 200ms before sending next frame to keep camera smooth
                    await new Promise(resolve => setTimeout(resolve, 200));
                }
            }

            // 7. CAPTURE, DETECT, DRAW BOXES & DB LOOKUP
            async function captureAndDetect() {
                // Sync canvas with video resolution
                captureCanvas.width = video.videoWidth;
                captureCanvas.height = video.videoHeight;
                overlay.width = video.videoWidth;
                overlay.height = video.videoHeight;

                captureCtx.drawImage(video, 0, 0, captureCanvas.width, captureCanvas.height);
                // 0.5 quality keeps payload small and transfer fast
                const frameBase64 = captureCanvas.toDataURL("image/jpeg", 0.5);

                try {
                    const response = await fetch("http://localhost:5000/detect_frame", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ image: frameBase64 })
                    });

                    const data = await response.json();
                    const detections = data.detections || [];

                    overlayCtx.clearRect(0, 0, overlay.width, overlay.height);
                    list.innerHTML = "";

                    if (detections.length === 0) {
                        list.innerHTML = "<li class='text-muted text-center py-3'>No items detected on tray...</li>";
                        return;
                    }

                    for (const detected of detections) {
                        // Draw Bounding Box & Label
                        if (detected.box) {
                            const [x1, y1, x2, y2] = detected.box;
                            const boxWidth = x2 - x1;
                            const boxHeight = y2 - y1;
                            const boxColor = detected.confidence >= 80 ? "#00FF00" : "#FFA500";

                            overlayCtx.lineWidth = 3;
                            overlayCtx.strokeStyle = boxColor;
                            overlayCtx.strokeRect(x1, y1, boxWidth, boxHeight);

                            overlayCtx.fillStyle = boxColor;
                            overlayCtx.font = "bold 15px Arial";
                            overlayCtx.fillText(`${detected.name} (${detected.confidence}%)`, x1, Math.max(18, y1 - 8));
                        }

                        // Confidence below 80% Warning
                        if (detected.confidence < 80) {
                            list.innerHTML += `
                                <li class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                                    <div>
                                        <h6 class="mb-0 fw-bold text-warning"><i class="fa-solid fa-triangle-exclamation me-2"></i>Item Unclear (${detected.confidence}%)</h6>
                                        <small class="text-danger">Confidence below 80%. Please hold the item closer or steady.</small>
                                    </div>
                                    <span class="badge bg-warning text-dark">Try Again</span>
                                </li>`;
                            continue;
                        }

                        // Confidence >= 80%: Query database
                        const itemName = detected.name;
                        const formattedItemName = itemName.toLowerCase().replaceAll(" ", "_");

                        try {
                            const dbResponse = await fetch(`/Home/GetProductDetails?productName=${formattedItemName}`);

                            if (dbResponse.ok) {
                                const product = await dbResponse.json();
                                list.innerHTML += `
                                    <li class="p-3 border-bottom d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-0 fw-bold"><i class="fa-solid fa-box text-success me-2"></i>${product.name}</h6>
                                            <small class="text-muted">Confidence: ${detected.confidence}%</small>
                                        </div>
                                        <span class="text-success fw-bold fs-5">PHP ${product.price.toFixed(2)}</span>
                                    </li>`;
                            } else {
                                list.innerHTML += `
                                    <li class="p-3 border-bottom d-flex justify-content-between align-items-center text-muted">
                                        <div>
                                            <h6 class="mb-0 fw-bold"><i class="fa-solid fa-triangle-exclamation text-warning me-2"></i>${itemName}</h6>
                                            <small class="text-muted">Confidence: ${detected.confidence}%</small>
                                        </div>
                                        <span class="small text-danger">Not in DB</span>
                                    </li>`;
                            }
                        } catch (dbError) {
                            console.error("Database connection error for: " + itemName, dbError);
                        }
                    }
                } catch (error) {
                    console.error("Cannot connect to Python Server:", error);
                    list.innerHTML = "<li class='text-danger text-center py-3'>Lost connection to AI Scanner!</li>";
                }
            }
        });
    </script>
}