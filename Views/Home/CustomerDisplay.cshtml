@{
    ViewData["Title"] = "Customer Display Page";
    Layout = "_Layout";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(180deg, #95CCDD 0%, #eef6f9 100%);
            min-height: 100vh;
        }

        .customer-card {
            background-color: white;
            border: none;
            border-radius: 5px;
            overflow: hidden;
        }

        .blue-header {
            background-color: #1b6ec2;
            color: white;
            font-weight: bold;
            padding: 12px 16px;
        }

        .queue-table th,
        .queue-table td {
            padding: 10px;
            font-size: 0.85rem;
        }

        .grand-total {
            font-size: 1.1rem;
            font-weight: bold;
        }
    </style>
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            <!-- Customer Display Screen -->
            <div class="card shadow border-0">
                <div class="card-header text-white fw-bold p-3 d-flex justify-content-between align-items-center"
                     style="background-color: #1b6ec2;">
                    <div>
                        <i class="fa-solid fa-display me-2"></i>
                        Customer Display Screen
                    </div>
                    <!-- CHANGED: This button now closes the popup to reveal the main tab -->
                    <button type="button" class="btn btn-light btn-sm fw-bold" onclick="window.close()">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Checkout
                    </button>
                </div>

                <div class="card-body p-4" style="background-color: #95CCDD;">
                    <!-- Transaction Queue Panel -->
                    <div class="customer-card shadow-sm">

                        <div class="blue-header">
                            <i class="fa-solid fa-list-ul me-2"></i>
                            Transaction Queue
                        </div>

                        <div class="p-3">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle queue-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Product Name</th>
                                            <th>Qty</th>
                                            <th>Unit Price</th>
                                            <th>Subtotal</th>
                                        </tr>
                                    </thead>

                                    <tbody id="customerItems">
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                Waiting for cashier to add items...
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Grand Total -->
                            <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                                <span class="fw-bold">Grand Total Due:</span>
                                <span id="customerTotal" class="grand-total">
                                    PHP 0.00
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateCustomerDisplay() {
            const savedData = localStorage.getItem("smartScanCustomerDisplay");
            const itemsBody = document.getElementById("customerItems");
            const totalDisplay = document.getElementById("customerTotal");

            if (!savedData) return;

            try {
                const data = JSON.parse(savedData);
                const items = data.items || [];

                itemsBody.innerHTML = "";

                if (items.length === 0) {
                    itemsBody.innerHTML = `
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                Waiting for cashier to add items...
                            </td>
                        </tr>`;
                }

                items.forEach(item => {
                    const row = document.createElement("tr");

                    const name = document.createElement("td");
                    name.textContent = item.name;

                    const quantity = document.createElement("td");
                    quantity.textContent = item.qty;

                    const price = document.createElement("td");
                    price.textContent = "PHP " + Number(item.price).toFixed(2);

                    const subtotal = document.createElement("td");
                    subtotal.textContent = "PHP " + (Number(item.price) * Number(item.qty)).toFixed(2);

                    row.append(name, quantity, price, subtotal);
                    itemsBody.appendChild(row);
                });

                totalDisplay.textContent = "PHP " + Number(data.total || 0).toFixed(2);

            } catch (error) {
                console.error("Customer display error:", error);
            }
        }

        // Load the current display data
        updateCustomerDisplay();

        // Check for changes from the cashier's page
        setInterval(updateCustomerDisplay, 500);
        window.addEventListener("storage", updateCustomerDisplay);
    </script>
}