@{
    ViewData["Title"] = "Customer Display";
    if (ViewData["HeaderTitle"] == null)
    {
        ViewData["HeaderTitle"] = "Customer View";
    }
    Layout = "_Layout";
}

<!-- Viewport-Locked Outer Container -->
<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white"
     style="min-height: max(520px, calc(100dvh - 130px)); height: auto;">

    <!-- Top Navigation Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex justify-content-between align-items-center"
         style="background-color: #1162a3;">
        <div class="d-flex align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-desktop fs-5"></i>
                <h5 class="mb-0 fw-bold">Customer Display</h5>
            </div>
        </div>

        <!-- Close Window Button (Styled like Return link) -->
        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold text-primary"
                style="background-color: #dbeafe; border-color: #cfe2f3 !important;"
                onclick="window.close()">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to Checkout
        </button>
    </div>

    <!-- Scrollable Workspace -->
    <div class="card-body p-4 flex-grow-1 d-flex flex-column bg-light bg-opacity-50 overflow-hidden" style="min-height: 0;">

        <!-- Main Panel (Styled like the Right Column from Receipt Verification) -->
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden flex-grow-1 d-flex flex-column h-100">

            <!-- Panel Header -->
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center flex-shrink-0">
                <h4 class="fw-bold mb-0" style="color: #1162a3;">
                    <i class="fa-solid fa-cart-shopping me-2"></i>Your Order
                </h4>
                <span class="badge bg-light text-secondary border rounded-pill px-4 py-2 fs-6 shadow-sm" id="itemCountBadge">
                    0 Items
                </span>
            </div>

            <!-- Table Container -->
            <div class="card-body p-0 flex-grow-1 overflow-y-auto no-scrollbar">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light sticky-top shadow-sm">
                        <tr>
                            <th class="ps-4 py-3 text-secondary text-uppercase fw-bold" style="font-size: 14px;">Product</th>
                            <th class="py-3 text-center text-secondary text-uppercase fw-bold" style="font-size: 14px; width: 120px;">Qty</th>
                            <th class="py-3 text-end text-secondary text-uppercase fw-bold" style="font-size: 14px; width: 150px;">Unit Price</th>
                            <th class="pe-4 py-3 text-end text-secondary text-uppercase fw-bold" style="font-size: 14px; width: 180px;">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody id="customerItems">
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                <i class="fa-solid fa-basket-shopping fa-3x mb-3 opacity-25"></i>
                                <h5>Waiting for cashier to scan items...</h5>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Grand Total Footer -->
            <div class="card-footer bg-white border-top p-4 flex-shrink-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-uppercase text-secondary fw-bold d-block" style="font-size: 14px; letter-spacing: 1px;">Amount Payable</span>
                        <h3 class="fw-bold mb-0 text-dark">GRAND TOTAL</h3>
                    </div>
                    <div class="text-end">
                        <span id="customerTotal" class="fw-bold font-monospace" style="font-size: 1.8rem; color: #1162a3; line-height: 1;">
                            ₱0.00
                        </span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateCustomerDisplay() {
            const savedData = localStorage.getItem("smartScanCustomerDisplay");
            const itemsBody = document.getElementById("customerItems");
            const totalDisplay = document.getElementById("customerTotal");
            const countBadge = document.getElementById("itemCountBadge");

            if (!savedData) return;

            try {
                const data = JSON.parse(savedData);
                const items = data.items || [];

                let totalItems = 0;
                itemsBody.innerHTML = "";

                if (items.length === 0) {
                    itemsBody.innerHTML = `
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                <i class="fa-solid fa-basket-shopping fa-3x mb-3 opacity-25"></i>
                                <h5>Waiting for cashier to scan items...</h5>
                            </td>
                        </tr>`;
                    countBadge.textContent = "0 Items";
                } else {
                    items.forEach(item => {
                        const qty = Number(item.qty);
                        totalItems += qty;

                        const row = document.createElement("tr");

                        const nameTd = document.createElement("td");
                        nameTd.className = "ps-4 py-3";
                        nameTd.innerHTML = `<span class="fw-bold text-dark fs-5">${item.name}</span>`;

                        const qtyTd = document.createElement("td");
                        qtyTd.className = "text-center py-3";
                        qtyTd.innerHTML = `<span class="badge bg-light text-dark border px-3 py-2 fs-6 shadow-sm">${qty}</span>`;

                        const priceTd = document.createElement("td");
                        priceTd.className = "text-end text-secondary fw-medium fs-5 py-3";
                        priceTd.textContent = "₱" + Number(item.price).toFixed(2);

                        const subtotalTd = document.createElement("td");
                        subtotalTd.className = "pe-4 text-end fw-bold text-dark fs-4 py-3";
                        subtotalTd.textContent = "₱" + (Number(item.price) * qty).toFixed(2);

                        row.append(nameTd, qtyTd, priceTd, subtotalTd);
                        itemsBody.appendChild(row);
                    });

                    countBadge.innerHTML = `<i class="fa-solid fa-box me-1"></i>${totalItems} Items`;
                }

                totalDisplay.textContent = "₱" + Number(data.total || 0).toFixed(2);

            } catch (error) {
                console.error("Customer display error:", error);
            }
        }

        // Load the current display data
        updateCustomerDisplay();

        // Check for changes from the cashier's page seamlessly
        setInterval(updateCustomerDisplay, 300);
        window.addEventListener("storage", updateCustomerDisplay);
    </script>
}