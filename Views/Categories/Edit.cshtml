@model SmartScan.Models.Category

@{
    ViewData["Title"] = "Edit Category";
    ViewData["HeaderTitle"] = "Product Management";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(0deg, #95CCDD 0%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}
<div class="card shadow border-0 mt-4">
    <div class="card-header text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-tag"></i> Updating Category Details</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="CategoryId" />
                    <div class="form-group">
                        <label asp-for="CategoryName" class="control-label fw-medium" style="color:#1162a3">Category Name</label>
                        <input asp-for="CategoryName" class="form-control" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
                        <span asp-validation-for="CategoryName" class="text-danger"></span>
                    </div>
                    <div class="row row-cols-2 pt-5">
                        <div class="text-start">
                            <a asp-action="Index" class="btn btn-outline-secondary fw-medium">Back to List</a>
                        </div>
                        <div class="form-group text-end">
                            <input type="submit" value="Save" class="btn btn-primary fw-medium" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
