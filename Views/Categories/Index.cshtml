@model IEnumerable<SmartScan.Models.Category>

@{
    ViewData["Title"] = "Categories";
    ViewData["HeaderTitle"] = "Retail Management";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(0deg, #95CCDD 0%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="card shadow border-0 mt-4">
    <div class="card-header text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-tag"></i> Categories</h5>
    </div>
    <div class="p-3 d-flex justify-content-between align-items-center mb-3">
        <p>
            <a class="btn btn-success fw-semibold" asp-action="Create">Add New Category</a>
        </p>
        <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 450px; padding-bottom: 11px; width:100%;">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                </span>
                <input type="text" name="search" value="@ViewData["CurrentFilter"]" class="form-control border-start-0 ps-0 fw-semibold"
                       placeholder="Search..." aria-label="Search category" />
            </div>
            <button type="submit" class="btn btn-outline-primary fw-semibold">Search</button>

            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Search">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            }
        </form>
    </div>
    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center my-4 fw-semibold" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>No categories found matching "<strong>@ViewData["CurrentFilter"]</strong>".
        </div>
    }
    else
    {
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>
                            Category Name
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <i class="fa-solid fa-tag text-secondary"></i> @Html.DisplayFor(model => item.CategoryName)
                            </td>
                            <td>
                                <a class="btn btn-primary" asp-action="Edit" asp-route-categoryid="@item.CategoryId"><i class="fa-solid fa-pen-to-square"></i> Edit</a>
                                <form asp-controller="Categories" asp-action="Delete" asp-route-categoryid="@item.CategoryId" method="post" id="deleteForm-@item.CategoryId" class="d-inline">

                                    <a href="javascript:void(0);"
                                       class="btn btn-sm btn-danger p-2"
                                       onclick="if(confirm('Are you sure you want to delete this category instantly?')) { document.getElementById('deleteForm-@item.CategoryId').submit(); }">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </a>

                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Alert Message Function -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        @if (TempData["ErrorMessage"] != null)
        {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Action Blocked',
                    text: '@TempData["ErrorMessage"]',
                    confirmButtonColor: '#1162a3'
                });
                </text>
        }
    </script>
}
