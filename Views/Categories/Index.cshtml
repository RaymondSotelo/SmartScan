@model IEnumerable<SmartScan.Models.Category>

@{
    ViewData["Title"] = "Categories";
    ViewData["HeaderTitle"] = "Retail Management";
}

<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3"
     style="height: calc(100dvh - 130px); min-height: 500px;">

    <!-- Top Card Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0" style="background-color: #1162a3;">
        <h5 class="mb-0"><i class="fa-solid fa-tag me-2"></i>Categories</h5>
    </div>

    <!-- Header Info -->
    <div class="px-4 pt-4 pb-3">
        <h4 class="mb-0 fw-bold" style="color: #1162a3;">Category Directory</h4>
        <p class="fw-medium pt-1 text-secondary mb-0">Organize and manage catalog categories across your retail items.</p>
    </div>

    <!-- Action Bar & Search -->
    <div class="px-4 pb-3 pt-0 d-flex flex-wrap justify-content-between align-items-center gap-3 flex-shrink-0">
       
        <!-- Add Button -->
        <button type="button" class="btn btn-primary fw-medium rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1"
                style="background-color: #1162a3; border-color: #1162a3;"
                data-bs-toggle="modal" data-bs-target="#createCategoryModal">
            <i class="fa-solid fa-plus"></i>
            <span>Add New Category</span>
        </button>

        <!-- Search Bar -->
        <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 320px; width: 100%;">
            <div class="input-group shadow-sm rounded-3 overflow-hidden border">
                <span class="input-group-text bg-white border-0">
                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                </span>
                <input type="text"
                       name="search"
                       value="@ViewData["CurrentFilter"]"
                       class="form-control border-0 bg-white shadow-none ps-0 fw-semibold"
                       placeholder="Search category..."
                       aria-label="Search category" />
            </div>

            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
            {
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Clear Search">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            }
        </form>
    </div>

    <!-- Dynamic Body / Table Area -->
    <div class="card-body p-4 pt-0 d-flex flex-column flex-grow-1 overflow-hidden">
        @if (Model == null || !Model.Any())
        {
            @if (!string.IsNullOrWhiteSpace(ViewData["CurrentFilter"]?.ToString()))
            {
                <div class="alert alert-warning text-center my-3 fw-semibold shadow-sm" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>No categories found matching "<strong>@ViewData["CurrentFilter"]</strong>".
                </div>
            }
            else
            {
                <div class="text-center py-5 my-auto">
                    <div class="text-muted mb-3">
                        <i class="fa-solid fa-tags fa-3x text-secondary opacity-50"></i>
                    </div>
                    <h4 class="fw-semibold text-secondary">No Categories Yet</h4>
                    <p class="text-muted small">Click "Add new Category" above to register your first catalog category.</p>
                </div>
            }
        }
        else
        {
            <!-- Scrollable Table Container -->
            <div class="table-responsive flex-grow-1 overflow-y-auto pe-1">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th class="ps-3 py-3 text-secondary text-uppercase fw-bold" style="font-size: 14px; letter-spacing: 0.5px;">Category Name</th>
                            <th class="pe-3 py-3 text-end text-secondary text-uppercase fw-semibold" style="font-size: 14px; letter-spacing: 0.5px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 text-truncate fw-semibold" style="max-width: 280px; color: #1162a3;" title="@item.CategoryName">
                                    <i class="fa-solid fa-tag text-secondary me-2 opacity-75"></i>@item.CategoryName
                                </td>
                                <td class="pe-3 text-end">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary fw-medium rounded-pill px-3 me-1 shadow-sm edit-category-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editCategoryModal"
                                            data-id="@item.CategoryId"
                                            data-name="@item.CategoryName"
                                            style="font-size: 14px;">
                                        <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                                    </button>

                                    <form asp-controller="Categories" asp-action="Delete" asp-route-categoryid="@item.CategoryId" method="post" id="deleteForm-@item.CategoryId" class="d-inline mb-0">
                                        @Html.AntiForgeryToken()
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger fw-medium rounded-pill px-3 shadow-sm"
                                                style="font-size: 14px;"
                                                onclick="if(confirm('Are you sure you want to delete this category?')) { document.getElementById('deleteForm-@item.CategoryId').submit(); }">
                                            <i class="fa-solid fa-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Create Category Modal -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">

            <div class="modal-header rounded-top-4 text-white p-3" style="background-color: #1162a3;">
                <h5 class="modal-title mb-0" id="createCategoryModalLabel">
                    <i class="fa-solid fa-tag me-2"></i>Add New Category
                </h5>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="form-group mb-0 fw-medi">
                        <label for="CategoryName" class="control-label fw-medium mb-1" style="color: #1162a3;">Category Name</label>
                        <input type="text"
                               name="CategoryName"
                               id="CategoryName"
                               class="form-control"
                               oninput="this.value = this.value.replace(/[0-9]/g, '')"
                               placeholder="Enter category name..."
                               required />
                    </div>
                </div>

                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary fw-medium rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-medium rounded-pill px-4 shadow-sm" style="background-color: #1162a3; border-color: #1162a3;">Create</button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- Edit Category Modal -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">

            <div class="modal-header rounded-top-4 text-white p-3" style="background-color: #1162a3;">
                <h5 class="modal-title mb-0" id="editCategoryModalLabel">
                    <i class="fa-solid fa-pen-to-square me-2"></i>Update Category Details
                </h5>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" name="CategoryId" id="editCategoryId" />

                    <!-- Category Name -->
                    <div class="form-group mb-0">
                        <label for="editCategoryName" class="control-label fw-medium mb-1" style="color: #1162a3;">Category Name</label>
                        <div class="position-relative">
                            <input type="text"
                                   name="CategoryName"
                                   id="editCategoryName"
                                   class="form-control pe-5"
                                   oninput="this.value = this.value.replace(/[0-9]/g, '')"
                                   placeholder="Enter updated category name..."
                                   required />
                            <!-- Inner Clear Button -->
                            <button type="button"
                                    class="btn btn-sm text-secondary position-absolute top-50 end-0 translate-middle-y me-1 border-0 shadow-none"
                                    onclick="document.getElementById('editCategoryName').value = ''; document.getElementById('editCategoryName').focus();"
                                    title="Clear field">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary fw-medium rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-medium rounded-pill px-4 shadow-sm" style="background-color: #1162a3; border-color: #1162a3;">Save Changes</button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const editModal = document.getElementById("editCategoryModal");
            const editIdInput = document.getElementById("editCategoryId");
            const editNameInput = document.getElementById("editCategoryName");

            if (editModal) {
                editModal.addEventListener("show.bs.modal", function (event) {
                    const button = event.relatedTarget;
                    const categoryId = button.getAttribute("data-id");
                    const categoryName = button.getAttribute("data-name");

                    if (editIdInput) editIdInput.value = categoryId;
                    if (editNameInput) editNameInput.value = categoryName;
                });
            }

            @if (TempData["CategoryMessage"] != null)
            {
                    <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Action Blocked',
                        text: @Html.Raw(Json.Serialize(TempData["CategoryMessage"])),
                        confirmButtonColor: '#1162a3'
                    });
                    </text>
            }
        });
    </script>
}