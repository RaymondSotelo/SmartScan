@model SmartScan.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    ViewData["HeaderTitle"] = "Home";

    string ResolveAvatar(string? rawPath)
    {
        if (string.IsNullOrWhiteSpace(rawPath))
            return "/images/default-profile-pic.png";

        if (rawPath.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            rawPath.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            rawPath.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
            return rawPath;

        if (rawPath.StartsWith("~"))
            return Url.Content(rawPath);

        return rawPath.StartsWith("/") ? rawPath : "/" + rawPath;
    }
}

<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white"
     style="min-height: max(520px, calc(100dvh - 130px)); height: auto;">

    <!-- Top Card Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-border-all me-2"></i>Dashboard</h5>
    </div>

    <!-- Interior Content Body -->
    <div class="card-body p-3 p-lg-4 flex-grow-1 overflow-hidden d-flex flex-column">

        <div class="flex-shrink-0 mb-3">

            <!-- ========================================== -->
            <!-- SECTION 1: HIGH-LEVEL KPI SUMMARY TILES    -->
            <!-- ========================================== -->
            <div class="row g-3 mb-4">

                <!-- Recievables -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card kpi-card shadow-sm rounded-4 h-100 p-3"
                         style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-primary fw-bold text-uppercase">Receivables</span>
                            <div class="rounded-circle p-2 bg-primary-subtle text-primary">
                                <i class="fa-solid fa-hand-holding-dollar"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1 text-dark">₱@Model.TotalOutstandingDebt.ToString("N2")</h3>
                        <div class="d-flex align-items-center gap-1 small">
                            @if (Model.OverdueDebtAmount > 0)
                            {
                                <span class="text-danger fw-semibold"><i class="fa-solid fa-triangle-exclamation me-1"></i>₱@Model.OverdueDebtAmount.ToString("N2") overdue</span>
                            }
                            else
                            {
                                <span class="text-success fw-semibold"><i class="fa-solid fa-circle-check me-1"></i>All debts current</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Today's Sales -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card kpi-card shadow-sm rounded-4 h-100 p-3"
                         style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-primary fw-bold text-uppercase">Today's Sales</span>
                            <div class="rounded-circle p-2 bg-primary-subtle text-primary">
                                <i class="fa-solid fa-cash-register"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1 text-dark">₱@Model.TodaysSales.ToString("N2")</h3>
                        <span class="text-muted small">Settled transactions today</span>
                    </div>
                </div>

                <!-- Verified Shoppers -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card kpi-card shadow-sm rounded-4 h-100 p-3"
                         style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-primary fw-bold text-uppercase">Verified Shoppers</span>
                            <div class="rounded-circle p-2 bg-primary-subtle text-primary">
                                <i class="fa-solid fa-id-card-clip"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1 text-dark">@Model.VerifiedCustomersCount <small class="text-muted fs-6 fw-normal">/ @Model.TotalCustomers</small></h3>
                        <div class="d-flex align-items-center gap-2 small">
                            <span class="badge bg-primary-subtle text-primary border rounded-pill">@(Model.TotalCustomers > 0 ? (Model.VerifiedCustomersCount * 100 / Model.TotalCustomers) : 0)% Verified</span>
                        </div>
                    </div>
                </div>

                <!-- Store Outlet -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card kpi-card shadow-sm rounded-4 h-100 p-3"
                         style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-primary fw-bold text-uppercase">Store Outlets</span>
                            <div class="rounded-circle p-2 bg-primary-subtle text-secondary">
                                <i class="fa-solid fa-store"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold mb-1 text-dark">@Model.ActiveRetailCount <small class="text-muted fs-6 fw-normal">Active</small></h3>
                        <span class="text-muted small">@Model.TotalRetailCount total registered locations</span>
                    </div>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- SECTION 2: CRITICAL ATTENTION FEED         -->
            <!-- ========================================== -->
            <div class="row g-3 mb-4">

                <!-- Overdue Debts (Now Full Width) -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center pb-2 mb-2 border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                <div class="px-1 pb-1">
                                    <h4 class="mb-0 fw-bold" style="color: #1162a3;">Overdue Credit Watchlist</h4>
                                    <p class="fw-medium pt-1 text-secondary mb-0">Track past-due credit terms, maturing customer balances, and pending collection follow-ups.</p>
                                </div>
                            </div>
                        </div>

                        @if (!Model.OverdueAccounts.Any())
                        {
                            <div class="py-4 text-center text-muted small">
                                <i class="fa-solid fa-circle-check text-success fs-3 mb-2 d-block"></i>
                                No overdue accounts. All payments are up to date!
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2 pe-1 flex-grow-1 overflow-y-auto">
                                @foreach (var debt in Model.OverdueAccounts)
                                {
                                    <div class="d-flex align-items-center justify-content-between py-2 px-3 rounded-3 shadow-sm border"
                                         style="background-color: #fee2e2; border-color: #fecaca !important;">

                                        <!-- Left: Customer Name, Phone & Due Date (No Profile Picture) -->
                                        <div class="d-flex flex-column lh-1">
                                            <span class="fw-semibold text-dark text-truncate" style="max-width: 240px;">
                                                @debt.FullName
                                            </span>
                                            <span class="text-secondary small mt-1" style="font-size: 11px;">
                                                <i class="fa-solid fa-phone me-1 text-muted"></i>@(string.IsNullOrWhiteSpace(debt.ContactNumber) ? "No phone" : debt.ContactNumber)
                                                <span class="text-danger ms-2 fw-medium">
                                                    <i class="fa-regular fa-clock me-1"></i>Due @debt.DueDate.ToString("MMM dd") (@debt.DaysOverdue d ago)
                                                </span>
                                            </span>
                                        </div>

                                        <!-- Right: Debt Amount Pill Badge & Action Button -->
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge rounded-pill bg-white text-danger border border-danger-subtle fw-bold px-2 py-1 shadow-sm"
                                                  style="font-size: 11px;">
                                                <i class="fa-solid fa-hand-holding-dollar me-1"></i>₱@debt.AmountDue.ToString("N2")
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(debt.ContactNumber))
                                            {
                                                <a href="sms:@debt.ContactNumber"
                                                   class="btn btn-sm btn-outline-danger rounded-pill fw-semibold px-3 shadow-sm d-inline-flex align-items-center gap-1"
                                                   style="font-size: 12px;">
                                                    <i class="fa-solid fa-comment-sms"></i>
                                                    <span>Remind</span>
                                                </a>
                                            }
                                        </div>

                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Age-Gating Audit -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center pb-2 mb-2 border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                <div class="px-1 pb-1">
                                    <h4 class="mb-0 fw-bold" style="color: #1162a3;">PhilSys Verification Log</h4>
                                    <p class="fw-medium pt-1 text-secondary mb-0">Real-time audit trail for statutory age-gating, verified customer identity checks, and Zero-PII compliance.</p>
                                </div>
                            </div>
                        </div>

                        @if (!Model.RecentVerifications.Any())
                        {
                            <div class="py-4 text-center text-muted small">No customer registrations yet.</div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2 pe-1 flex-grow-1 overflow-y-auto">
                                @foreach (var audit in Model.RecentVerifications)
                                {
                                    <div class="d-flex align-items-center justify-content-between py-2 px-3 rounded-3 shadow-sm border"
                                         style="background-color: #dbeafe; border-color: #cfe2f3 !important;">

                                        <!-- Left: Customer Name & Timestamp (No Profile Picture) -->
                                        <div class="d-flex flex-column lh-1">
                                            <span class="fw-semibold text-primary text-truncate" style="max-width: 240px;">
                                                @audit.CustomerMaskedName
                                            </span>
                                            <span class="text-secondary small mt-1" style="font-size: 11px;">
                                                <i class="fa-regular fa-clock me-1 text-muted"></i>@audit.RegisteredAt.ToString("MMM dd, h:mm tt")
                                            </span>
                                        </div>

                                        <!-- Right: Status Badge -->
                                        <div class="d-flex align-items-center gap-2">
                                            @if (audit.IsUnderage)
                                            {
                                                <span class="badge rounded-pill bg-white text-warning border border-warning-subtle fw-semibold px-2 py-1 shadow-sm"
                                                      style="font-size: 11px;">
                                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Minor (Age: @audit.Age)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-white text-success border border-success-subtle fw-semibold px-2 py-1 shadow-sm"
                                                      style="font-size: 11px;">
                                                    <i class="fa-solid fa-circle-check me-1"></i>Adult Verified (Age: @audit.Age)
                                                </span>
                                            }
                                        </div>

                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>

        <!-- ========================================== -->
        <!-- SECTION 3: RETAIL OVERVIEW                 -->
        <!-- ========================================== -->
        <!-- Compact Unified Action & Search Bar -->
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3 pb-3 pt-2 border-bottom flex-shrink-0" id="retail-overview-section">

            <!-- Header Info -->
            <div class="px-1 pb-1">
                <h4 class="mb-0 fw-bold" style="color: #1162a3;">Retail Overview</h4>
                <p class="fw-medium pt-1 text-secondary mb-0">Branch locations, operational status, and assigned store owners.</p>
            </div>

            <!-- Search Bar -->
            <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 380px; width: 100%;">
                <div class="input-group shadow-sm rounded-3 overflow-hidden border">
                    <span class="input-group-text bg-white border-0">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text"
                           name="search"
                           value="@Model.CurrentFilter"
                           class="form-control border-0 bg-white shadow-none ps-0 fw-semibold"
                           placeholder="Search retail name, address..."
                           aria-label="Search retail" />
                </div>

                @if (!string.IsNullOrEmpty(Model.CurrentFilter))
                {
                    <a asp-action="Index" asp-fragment="retail-overview-section" class="btn btn-outline-secondary rounded-3" title="Clear Search">
                        <i class="fa-solid fa-xmark"></i>
                    </a>
                }
            </form>
        </div>

        <!-- Your Scrolling Grid Core -->
        <div class="flex-grow-1 pe-1">
            @if (!Model.Retails.Any())
            {
                <div class="h-100 d-flex flex-column align-items-center justify-content-center py-5">
                    <div class="rounded-circle bg-light p-4 mb-3 text-muted">
                        <i class="fa-solid fa-store-slash fa-3x opacity-50"></i>
                    </div>
                    <h6 class="fw-bold text-secondary mb-1">No Retail Stores Found</h6>
                    <p class="text-muted small mb-3">
                        @if (!string.IsNullOrEmpty(Model.CurrentFilter))
                        {
                            <span>No store matches "<strong>@Model.CurrentFilter</strong>".</span>
                        }
                        else
                        {
                            <span>There are currently no retail outlets registered.</span>
                        }
                    </p>
                    @if (!string.IsNullOrEmpty(Model.CurrentFilter))
                    {
                        <a asp-action="Index" asp-fragment="retail-overview-section" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-medium">
                            <i class="fa-solid fa-arrow-rotate-left me-1"></i>Reset Filter
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 pt-1 pb-3">
                    @foreach (var item in Model.Retails)
                    {
                        Model.ProfileMap.TryGetValue(item.AdminOwner ?? string.Empty, out var rawPic);
                        var avatarPath = ResolveAvatar(rawPic);

                        <div class="col">
                            <div class="card h-100 shadow-sm border retail-card position-relative overflow-hidden">
                                <!-- Store Image Banner -->
                                <div class="position-relative" style="height: 180px;">
                                    <img src="@(string.IsNullOrEmpty(item.ImagePath) ? "/images/default-retail-pic.png" : item.ImagePath)"
                                         onerror="this.onerror=null; this.src='/images/default-retail-pic.png';"
                                         alt="@item.RetailName"
                                         class="card-img-top w-100 h-100 object-fit-cover" />

                                    <!-- Status Badge -->
                                    <div class="position-absolute top-0 end-0 m-2">
                                        @if (item.Status?.StatusName == "Active")
                                        {
                                            <span class="badge bg-success rounded-pill px-3 shadow-sm">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3 shadow-sm">Inactive</span>
                                        }
                                    </div>
                                </div>

                                <!-- Card Body -->
                                <div class="card-body d-flex flex-column p-3">
                                    <h5 class="card-title fw-bold mb-1 text-truncate" style="color: #1162a3;" title="@item.RetailName">
                                        <!-- Stretched link triggers navigation to store details/view -->
                                        <a asp-controller="Retails" asp-action="View" asp-route-retailid="@item.RetailId" class="stretched-link text-decoration-none text-reset">
                                            @item.RetailName
                                        </a>
                                    </h5>

                                    <!-- Address -->
                                    <p class="card-text text-muted small mb-2 text-truncate" title="@item.Address">
                                        <i class="fa-solid fa-location-dot me-1 text-danger"></i> @item.Address
                                    </p>

                                    <!-- Description preview -->
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <p class="card-text text-secondary small line-clamp-2 mb-3">
                                            @item.Description
                                        </p>
                                    }

                                    <!-- Footer Info -->
                                    <div class="mt-auto d-flex align-items-center small text-muted pt-2">

                                        <!-- Owner Section -->
                                        <div class="d-flex align-items-center text-truncate me-2 position-relative" style="z-index: 2;" title="Store Owner">
                                            <img src="@avatarPath"
                                                 onerror="this.onerror=null; this.src='/images/default-pfp.jpg';"
                                                 alt="@(item.AdminOwnerNavigation?.UserName ?? "Owner")"
                                                 class="rounded-circle border border-1 object-fit-cover shadow-sm bg-white me-2 flex-shrink-0"
                                                 style="width: 38px; height: 38px;" />

                                            <div class="d-flex flex-column text-truncate" style="line-height: 1.1;">
                                                <span class="text-muted text-uppercase fw-medium" style="font-size: 9px; letter-spacing: 0.5px;">Owner</span>
                                                <span class="fw-semibold text-primary text-truncate" style="font-size: 12px;">
                                                    @(item.AdminOwnerNavigation?.UserName ?? "Unknown")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
@if (!string.IsNullOrEmpty(Model.CurrentFilter))
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const retailSection = document.getElementById("retail-overview-section");
            if (retailSection) {
                // Smoothly scroll down to Section 3
                retailSection.scrollIntoView({ behavior: "smooth", block: "start" });
            }
        });
    </script>
}
