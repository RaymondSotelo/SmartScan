@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    ViewData["Title"] = "User Manager";
    ViewData["HeaderTitle"] = "Account Management";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(180deg, #95CCDD 0%, #eef6f9 100%);
            background-repeat: no-repeat;
            background-size: cover;
            min-height: 100vh;
        }
    </style>
}

<div class="card shadow border-0 rounded-4 mt-4">
    <div class="card-header rounded-top-4 text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-users-gear me-2"></i>User Account Management</h5>
    </div>
    <div class="card-body">

        @if (TempData["UserMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-check me-1"></i> @TempData["UserMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["UserMessage2"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-exclamation me-1"></i> @TempData["UserMessage2"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="text-muted mb-3">
                    <i class="fa-solid fa-folder-open fa-3x text-secondary opacity-50"></i>
                </div>
                <h4 class="fw-semibold text-secondary">Empty User Accounts</h4>
                <p class="text-muted small">You currently have no existing user accounts.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Username / Email</th>
                            <th class="text-center">Account Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <i class="fa-solid fa-user text-secondary me-2"></i> @user.UserName
                                </td>
                                <td class="text-center">
                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="badge bg-success rounded-pill px-3">Active / Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill px-3">Disabled</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!user.EmailConfirmed)
                                    {
                                        <form asp-action="Approve" asp-route-id="@user.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="fa-solid fa-check me-1"></i> Unblock User
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Disable" asp-route-id="@user.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fa-solid fa-ban me-1"></i> Block User
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>