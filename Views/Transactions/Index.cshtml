@model IEnumerable<SmartScan.Models.Transaction>

@{
    ViewData["Title"] = "Transaction Logs";
    ViewData["HeaderTitle"] = "Statistics";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(0deg, #95CCDD 0%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="card shadow border-0 mt-4">
    <div class="card-header text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-receipt"></i> Transaction Logs</h5>
    </div>
    <div class="p-3 d-flex justify-content-end align-items-end mb-3">
        <form asp-action="Index" method="get" class="d-flex gap-2 w-100" style="max-width: 480px;">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                </span>
                <input type="text" name="search" value="@ViewData["CurrentFilter"]" class="form-control border-start-0 ps-0 fw-semibold"
                       placeholder="Search..." aria-label="Search transaction" />
            </div>
            <button type="submit" class="btn btn-outline-primary fw-semibold">Search</button>

            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Search">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            }
        </form>
    </div>
    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center my-4 fw-semibold" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>No transaction found matching "<strong>@ViewData["CurrentFilter"]</strong>".
        </div>
    }
    else
    {
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>
                            Receipt No.
                        </th>
                        <th>
                            Retail Name
                        </th>
                        <th>
                            Cashier
                        </th>
                        <th>
                            Customer
                        </th>
                        <th>
                            Total Amount
                        </th>
                        <th>
                            Payment Method
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Date
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(model => item.ReceiptNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.Retail.RetailName)
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.RetailStaff.Cashier.UserName)
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.Customer.FullName)
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.TotalAmount)
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.PaymentMethod.PaymentMethodName)
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.CreatedAt)
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.TransactionId">Edit</a> |
                                <a asp-action="Details" asp-route-id="@item.TransactionId">Details</a> |
                                <a asp-action="Delete" asp-route-id="@item.TransactionId">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
