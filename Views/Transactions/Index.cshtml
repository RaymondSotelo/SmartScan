@model IEnumerable<SmartScan.Models.Transaction>

@{
    ViewData["Title"] = "Transaction Logs";
    ViewData["HeaderTitle"] = "Statistics";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(0deg, #95CCDD 0%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="card shadow border-0 mt-4">
    <div class="card-header text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-receipt"></i> Transaction Logs</h5>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <!-- Decorator -->
            <div class="bg-light py-2 p-2" style="color:#1162a3;">
                <h3 class="mb-0 fw-semibold"><i class="fa-solid fa-receipt me-1"></i> Active Transaction History</h3>
                <p class="fw-medium pt-1 text-secondary">Select and view a transaction's information from the catalog below.</p>
            </div>

            <!-- Transaction Search Bar -->
            <form asp-action="Index" method="get" class="p-2 d-flex align-items-center gap-2 w-100" style="max-width: 500px;">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text" name="search" value="@ViewData["CurrentFilter"]"
                           class="form-control border-start-0 ps-0 fw-semibold"
                           placeholder="Search..." aria-label="Search transaction" />
                </div>

                <button type="submit" class="btn btn-outline-primary fw-semibold text-nowrap">Search</button>

                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary text-nowrap" title="Clear Search">
                        <i class="fa-solid fa-xmark"></i>
                    </a>
                }
            </form>
        </div>
    </div>
    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center my-4 fw-semibold" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>No transaction found matching "<strong>@ViewData["CurrentFilter"]</strong>".
        </div>
    }
    else
    {
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>
                            Receipt No.
                        </th>
                        <th>
                            Retail Name
                        </th>
                        <th>
                            Total Amount
                        </th>
                        <th>
                            Payment Method
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Date
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(model => item.ReceiptNumber)
                            </td>
                            <td class="text-truncate" style="max-width: 180px;" title="@item.Retail.RetailName">
                                @Html.DisplayFor(model => item.Retail.RetailName)
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.TotalAmount)
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.PaymentMethod.PaymentMethodName)
                            </td>
                            <td>
                                @if (item.Status.StatusName == "Active")
                                {
                                    <span class="badge bg-success rounded-pill px-3">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-light rounded-pill px-3">Inactive</span>
                                }
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.CreatedAt)
                            </td>
                            <td>
                                <a class="btn btn-info fw-medium" asp-action="Details" asp-route-transactionid="@item.TransactionId"><i class="fa-solid fa-eye"></i> View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
