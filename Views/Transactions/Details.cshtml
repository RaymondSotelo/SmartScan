@model SmartScan.Models.Transaction

@{
    ViewData["Title"] = "Transaction Receipt";
    ViewData["HeaderTitle"] = "Statistics";

    var staffNames = ViewData["StaffNames"] as Dictionary<int, string>;
    string staffDisplayName = "Self-Checkout / Automated";
    if (staffNames != null && staffNames.TryGetValue(Model.RetailStaffId, out var name))
    {
        staffDisplayName = name;
    }
    else if (Model.RetailStaff?.Staff?.UserName != null)
    {
        staffDisplayName = Model.RetailStaff.Staff.UserName;
    }

    var itemList = ViewBag.ItemList as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    int totalItems = 0;
    decimal subTotal = 0m;
    foreach (var item in itemList)
    {
        int q = (int)item.Quantity;
        decimal p = (decimal)item.UnitPrice;
        totalItems += q;
        subTotal += (q * p);
    }

    int? retailIdParam = ViewBag.RetailId as int? ?? Model.RetailId;
}

<!-- Viewport-Locked Card Container -->
<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white"
     style="height: calc(100dvh - 130px); min-height: 520px;">

    <!-- Top Navigation Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex justify-content-between align-items-center"
         style="background-color: #1162a3;">
        <div class="d-flex align-items-center gap-2">
            <h5 class="mb-0 fw-bold">
                <i class="fa-solid fa-receipt me-2"></i>Receipt Verification
            </h5>
        </div>

        <!-- Return Link -->
		<a href="javascript:history.back()" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold text-primary"
           style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
			<i class="fa-solid fa-arrow-left me-1"></i>Return
		</a>
    </div>

    <!-- Scrollable Workspace (Split Panel Layout) -->
    <div class="card-body p-4 flex-grow-1 overflow-y-auto overflow-x-hidden no-scrollbar bg-light bg-opacity-50">
        <div class="row g-4 justify-content-center h-100">

            <!-- LEFT COLUMN: Realistic Thermal POS Receipt -->
            <div class="col-xl-5 col-lg-6 col-md-10 d-flex flex-column align-items-center">
                <div id="printableReceipt" class="receipt-paper w-100 p-4 border border-bottom-0 pb-5 mb-4">

                    <!-- Store Branding & Meta -->
                    <div class="text-center mb-3">
                        <div class="d-inline-flex p-2 rounded-circle bg-opacity-10 text-primary mb-2">
                            <!-- Scaled Logo Image -->
                            <img src="~/images/SmartScanLogo.png"
                                 alt="Smart Scan Logo"
                                 width="55"
                                 height="55"
                                 class="object-fit-contain flex-shrink-0" />
                        </div>
                        <h5 class="fw-bold text-uppercase mb-0 text-dark" style="letter-spacing: 0.5px;">
                            @(Model.Retail?.RetailName ?? "SmartScan Retail Partner")
                        </h5>
                        <p class="text-muted small mb-1">
                            @(Model.Retail?.Address ?? "Automated Vision Checkout System")
                        </p>
                        <span class="badge rounded-pill bg-light text-secondary border fw-medium px-3 py-1" style="font-size: 10px;">
                            OFFICIAL TRANSACTION RECEIPT
                        </span>
                    </div>

                    <div class="receipt-dashed-line"></div>

                    <!-- Receipt Sub-Header Data -->
                    <div class="small text-secondary mb-2">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Receipt #:</span>
                            <strong class="font-monospace text-dark">@Model.ReceiptNumber</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Date & Time:</span>
                            <span class="text-dark">@Model.CreatedAt.ToString("yyyy-MM-dd hh:mm tt")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Cashier / POS:</span>
                            <span class="text-dark">@staffDisplayName</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Customer:</span>
                            <span class="text-dark">@(Model.Customer?.FullName ?? "Walk-in Guest")</span>
                        </div>
                    </div>

                    <div class="receipt-dashed-line"></div>

                    <!-- Itemized Purchase List -->
                    <div class="py-1">
                        <div class="d-flex justify-content-between text-muted fw-bold small text-uppercase mb-2" style="font-size: 11px;">
                            <span>Item Description</span>
                            <span class="text-end">Total</span>
                        </div>

                        <div class="d-flex flex-column gap-2 mb-2">
                            @foreach (var item in itemList)
                            {
                                decimal rowTotal = (decimal)item.UnitPrice * (int)item.Quantity;
                                <div>
                                    <div class="d-flex justify-content-between text-dark fw-semibold small">
                                        <span class="text-truncate pe-2" style="max-width: 220px;">@item.Product.ProductName</span>
                                        <span>₱@rowTotal.ToString("N2")</span>
                                    </div>
                                    <div class="text-muted small d-flex align-items-center gap-1" style="font-size: 11px;">
                                        <span>@item.Quantity x</span>
                                        <span>₱@(((decimal)item.UnitPrice).ToString("N2"))</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="receipt-double-line"></div>

                    <!-- Financial Summary & Tender -->
                    <div class="small">
                        <div class="d-flex justify-content-between text-secondary mb-1">
                            <span>Total Items Quantity:</span>
                            <span class="fw-semibold text-dark">@totalItems units</span>
                        </div>
                        <div class="d-flex justify-content-between text-secondary mb-2">
                            <span>Subtotal:</span>
                            <span class="fw-semibold text-dark">₱@subTotal.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fs-6 fw-bold text-dark">TOTAL PAID:</span>
                            <span class="fs-4 fw-bold text-success font-monospace">₱@Model.TotalAmount.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between text-secondary pt-1">
                            <span>Payment Tender:</span>
                            <span class="badge rounded-pill bg-light text-primary border border-primary-subtle fw-semibold px-2">
                                <i class="fa-solid fa-wallet me-1"></i>@(Model.PaymentMethod?.PaymentMethodName ?? "Cash")
                            </span>
                        </div>
                    </div>

                    <div class="receipt-dashed-line my-3"></div>

                    <!-- Barcode Stamp & Footer Thank You -->
                    <div class="text-center pt-2">
                        <div class="barcode-strip mb-2"></div>
                        <span class="font-monospace small text-muted d-block mb-2" style="letter-spacing: 2px;">
                            *@Model.ReceiptNumber*
                        </span>
                        <p class="small text-muted mb-0 fst-italic" style="font-size: 11px;">
                            Thank you for shopping with us!<br />
                            Verified by SmartScan Automated Vision System
                        </p>
                    </div>

                </div>
            </div>

            <!-- RIGHT COLUMN: Metadata & Product Image Preview -->
            <div class="col-xl-7 col-lg-6 col-md-10">
                <div class="d-flex flex-column gap-3">

                    <!-- Status & System Integrity Card -->
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-uppercase text-secondary fw-bold d-block" style="font-size: 11px; letter-spacing: 0.5px;">Verification Status</span>
                                <h6 class="fw-bold mb-0 text-dark">SmartScan Cloud Record</h6>
                            </div>
                            <div>
                                @if (Model.Status?.StatusName?.Equals("Active", StringComparison.OrdinalIgnoreCase) == true ||
                                                                Model.Status?.StatusName?.Equals("Completed", StringComparison.OrdinalIgnoreCase) == true)
                                {
                                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle fw-semibold px-3 py-2 shadow-sm" style="font-size: 12px;">
                                        <i class="fa-solid fa-circle-check me-1"></i>Completed Order
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle fw-semibold px-3 py-2 shadow-sm" style="font-size: 12px;">
                                        @(Model.Status?.StatusName ?? "Archived")
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Visual Inventory Checklist -->
                    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden flex-grow-1">
                        <div class="card-header bg-transparent border-0 pt-3 px-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0" style="color: #1162a3;">
                                <i class="fa-solid fa-images me-1"></i>Purchased Item Previews
                            </h6>
                            <span class="badge bg-light text-secondary border rounded-pill px-3 py-1 small">
                                @itemList.Count() catalog items
                            </span>
                        </div>

                        <div class="card-body p-3">
                            <div class="table-responsive no-scrollbar" style="max-height: 380px;">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th class="ps-3 py-2 text-secondary text-uppercase fw-bold" style="font-size: 11px;">Image</th>
                                            <th class="py-2 text-secondary text-uppercase fw-bold" style="font-size: 11px;">Product</th>
                                            <th class="py-2 text-center text-secondary text-uppercase fw-bold" style="font-size: 11px;">Qty</th>
                                            <th class="py-2 text-end text-secondary text-uppercase fw-bold" style="font-size: 11px;">Unit Price</th>
                                            <th class="pe-3 py-2 text-end text-secondary text-uppercase fw-bold" style="font-size: 11px;">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in itemList)
                                        {
                                            decimal lineTotal = (decimal)item.UnitPrice * (int)item.Quantity;
                                            string productImg = (string)item.Product.ProductImage;

                                            <tr>
                                                <td class="ps-3">
                                                    <div class="rounded-3 border overflow-hidden bg-light shadow-sm d-flex align-items-center justify-content-center"
                                                         style="width: 48px; height: 48px;">
                                                        @if (!string.IsNullOrEmpty(productImg))
                                                        {
                                                            <img src="@productImg"
                                                                 alt="@item.Product.ProductName"
                                                                 class="w-100 h-100 object-fit-cover"
                                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                                                            <i class="fa-solid fa-box text-secondary opacity-50" style="display: none;"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fa-solid fa-box text-secondary opacity-50"></i>
                                                        }
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="fw-semibold text-dark d-block">@item.Product.ProductName</span>
                                                    <small class="text-muted">Item ID: #@item.Product.ProductId</small>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-light text-dark border px-2 py-1">@item.Quantity</span>
                                                </td>
                                                <td class="text-end text-secondary small">
                                                    ₱@(((decimal)item.UnitPrice).ToString("N2"))
                                                </td>
                                                <td class="pe-3 text-end fw-bold text-dark">
                                                    ₱@lineTotal.ToString("N2")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Audit Bottom Action Bar -->
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <span class="text-muted small">
                            <i class="fa-solid fa-fingerprint me-1"></i>Internal Reference: #@Model.TransactionId
                        </span>

                        <div class="d-flex gap-2">
                            @if (retailIdParam != null && retailIdParam > 0)
                            {
                                <a asp-controller="Retails"
                                   asp-action="TransactionLogs"
                                   asp-route-retailId="@retailIdParam"
                                   class="btn btn-outline-secondary rounded-pill px-4 fw-medium shadow-sm"
                                   style="font-size: 13px;">
                                    <i class="fa-solid fa-store me-1"></i>Store Logs
                                </a>
                            }
                            <a asp-action="Index"
                               class="btn btn-primary rounded-pill px-4 fw-medium shadow-sm"
                               style="background-color: #1162a3; border-color: #1162a3; font-size: 13px;">
                                <i class="fa-solid fa-list me-1"></i>All Logs
                            </a>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>