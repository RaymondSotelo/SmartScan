@model SmartScan.Models.Inventory

@{
    ViewData["Title"] = "Updating Inventory Item";
    ViewData["HeaderTitle"] = "Retail Management";
    var barcodeList = ViewBag.BarcodeList as IEnumerable<SmartScan.Models.Barcode> ?? new List<SmartScan.Models.Barcode>();

}

@section Styles {
    <style>
        body {
            background: linear-gradient(0deg, #95CCDD 0%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="card shadow border-0 mt-4">
    <div class="card-header text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-boxes"></i> Updating Inventory Item</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="ProductId"/>
            <input type="hidden" asp-for="RetailId" value="@ViewBag.RetailId" />
            <input type="hidden" asp-for="InventoryId" />

            <div class="row g-3 p-2 align-items-end">
                <!-- Local Price -->
                <div class="col-md-3 position-relative">
                    <label asp-for="LocalPrice" class="control-label fw-medium" style="color:#1162a3;">Local Price</label>
                    <input asp-for="LocalPrice" class="form-control no-spin" type="number" step="0.01" min="0.01" onwheel="this.blur() "/>
                    <div class="invalid-tooltip">
                        <span asp-validation-for="LocalPrice" class="text-danger"></span>
                    </div>
                </div>

                <!-- Stock -->
                <div class="col-md-3 position-relative">
                    <label asp-for="Stock" class="control-label fw-medium" style="color:#1162a3;"></label>
                    <input asp-for="Stock" class="form-control no-spin" type="number" step="1" min="0" onwheel="this.blur() "/>
                    <div class="invalid-tooltip">
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                </div>

                <!-- Save Button -->
                <div class="col-md-3">
                    <input type="submit" value="Save" class="btn btn-primary fw-medium w-100" />
                </div>
            </div>
        </form>

        <!-- Barode Area -->
        <div class="card shadow-sm border-0 mt-4">
            <div class="bg-light py-2 p-2" style="color:#1162a3;">
                <h3 class="mb-0 fw-semibold"><i class="fa-solid fa-barcode me-1"></i> Active Barcode</h3>
                <p class="fw-medium pt-1 text-secondary mb-0">Manage registered barcodes associated with this inventory item for fast checkout and scanner lookups.</p>
            </div>

            <div class="card-body">
                <div class="row g-3 align-items-end mb-3">
                    <!-- Barcode Add Form -->
                    <div class="col-lg-6 col-md-12 position-relative">
                        <form asp-action="AddBarcode" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                            <input type="hidden" name="InventoryId" value="@Model.InventoryId" />
                            <input type="hidden" name="retailId" value="@ViewBag.RetailId" />

                            <label for="BarcodeLine" class="form-label fw-medium mb-1" style="color:#1162a3;">Barcode</label>
                            <div class="d-flex gap-2">
                                <div class="input-group">
                                    <input type="text"
                                           id="BarcodeLine"
                                           name="BarcodeLine"
                                           maxlength="13"
                                           class="form-control fw-semibold"
                                           autocomplete="off" />
                                </div>
                                <button type="submit" class="btn btn-primary fw-medium text-nowrap">
                                    Add Barcode
                                </button>
                            </div>
                            <span class="text-danger small position-absolute start-0 top-100 ps-2">
                                @Html.ValidationMessage("BarcodeLine")
                            </span>
                        </form>
                    </div>

                    <!-- Barcode Search Bar -->
                    <div class="col-lg-6 col-md-12 d-flex justify-content-lg-end">
                        <form asp-action="Edit" method="get" class="d-flex gap-2 ms-auto w-100" style="max-width: 450px;">
                            <!-- Preserve route parameters -->
                            <input type="hidden" name="inventoryid" value="@Model.InventoryId" />
                            <input type="hidden" name="retailId" value="@ViewBag.RetailId" />

                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                                </span>
                                <input type="text"
                                       name="barcodeSearch"
                                       value="@ViewBag.BarcodeSearch"
                                       class="form-control border-start-0 ps-0 fw-semibold"
                                       placeholder="Search barcode..."
                                       aria-label="Search barcode"
                                       autocomplete="off" />
                            </div>

                            <button type="submit" class="btn btn-outline-primary fw-semibold text-nowrap">Search</button>

                            @if (!string.IsNullOrEmpty(ViewBag.BarcodeSearch?.ToString()))
                            {
                                <a asp-action="Edit"
                                   asp-route-inventoryid="@Model.InventoryId"
                                   asp-route-retailId="@ViewBag.RetailId"
                                   class="btn btn-outline-secondary"
                                   title="Clear Search">
                                    <i class="fa-solid fa-xmark"></i>
                                </a>
                            }
                        </form>
                    </div>
                </div>
            </div>

            <!-- Barcode Table -->
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 380px; overflow-y: auto;">
                    @if (!barcodeList.Any())
                    {
                        @if (!string.IsNullOrWhiteSpace(ViewBag.BarcodeSearch))
                        {
                            <div class="alert alert-warning text-center my-4 fw-semibold" role="alert">
                                <i class="fa-solid fa-circle-exclamation me-2"></i>No barcode found matching "<strong>@ViewBag.BarcodeSearch</strong>".
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning text-center my-4 fw-semibold" role="alert">
                                <i class="fa-solid fa-barcode fa-2x mb-2 d-block opacity-50"></i>
                                No barcodes registered for this item yet.
                            </div>
                        }
                    }
                    else
                    {
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="ps-3" style="width: 220px;">Barcode</th>
                                    <th class="ps-2"><span class="visually-hidden">Actions</span></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in barcodeList)
                                {
                                    <tr>
                                        <td class="font-monospace fw-semibold text-dark ps-3">
                                            @Html.DisplayFor(model => item.BarcodeLine)
                                        </td>
                                        <td class="text-end pe-3">
                                            <form asp-action="DeleteBarcode" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this barcode?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="barcodeId" value="@item.BarcodeId" />
                                                <input type="hidden" name="inventoryId" value="@Model.InventoryId" />
                                                <input type="hidden" name="retailId" value="@ViewBag.RetailId" />
                                                <input type="hidden" name="barcodeSearch" value="@ViewBag.BarcodeSearch" />

                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Barcode">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <!-- Return Button -->
        <div class="text-start pt-3">
            <a asp-action="Index" asp-route-retailId="@ViewBag.RetailId" class="btn btn-outline-secondary fw-medium">Back to List</a>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
