@model SmartScan.Models.Inventory

@{
    ViewData["Title"] = "Update Inventory Item";
    ViewData["HeaderTitle"] = "Retail Management";

    var barcodeList = ViewBag.BarcodeList as IEnumerable<SmartScan.Models.Barcode> ?? new List<SmartScan.Models.Barcode>();
    var product = Model?.Product;
    var imgUrl = string.IsNullOrWhiteSpace(product?.ProductImage) ? "" : product.ProductImage;
}

<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3"
     style="height: calc(100dvh - 130px); min-height: 520px;">

    <!-- Top Card Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex justify-content-between align-items-center"
         style="background-color: #1162a3;">
        <h5 class="mb-0">
            <i class="fa-solid fa-boxes-stacked me-2"></i>Update Inventory Item
        </h5>
        @if (ViewBag.RetailName != null)
        {
            <span class="badge bg-white text-primary rounded-pill px-3 py-1 fw-semibold">
                <i class="fa-solid fa-shop me-1"></i>@ViewBag.RetailName
            </span>
        }
    </div>

    <!-- Interior Content Body -->
    <div class="card-body p-4 flex-grow-1 overflow-hidden d-flex flex-column">
        <!-- Main Inventory Update Form -->
        <form asp-action="Edit" method="post" id="editInventoryForm" class="h-100 d-flex flex-column justify-content-between">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="ProductId" />
            <input type="hidden" asp-for="RetailId" value="@ViewBag.RetailId" />
            <input type="hidden" asp-for="InventoryId" />

            <!-- Scrollable Workspace Row -->
            <div class="row g-4 flex-grow-1 overflow-y-auto pe-1">

                <!-- Left Column: Primary Details & Product Info Card -->
                <div class="col-lg-5 d-flex flex-column">
                    <h6 class="fw-bold text-uppercase text-secondary mb-3" style="font-size: 14px; letter-spacing: 0.5px;">
                        Inventory Stock Details
                    </h6>

                    <!-- Associated Product Summary Card -->
                    <div class="card border rounded-3 p-3 bg-light shadow-sm mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 border shadow-sm bg-white flex-shrink-0 d-flex align-items-center justify-content-center overflow-hidden"
                                 style="width: 58px; height: 58px;">
                                @if (!string.IsNullOrEmpty(imgUrl))
                                {
                                    <img src="@imgUrl"
                                         alt="@product?.ProductName"
                                         class="w-100 h-100 object-fit-cover"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                    <div class="text-muted align-items-center justify-content-center h-100 w-100" style="display: none;">
                                        <i class="fa-regular fa-image fa-2x opacity-25"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted d-flex align-items-center justify-content-center h-100 w-100">
                                        <i class="fa-regular fa-image fa-2x opacity-25"></i>
                                    </div>
                                }
                            </div>
                            <div class="overflow-hidden">
                                <span class="badge rounded-pill bg-white text-secondary border fw-medium px-2 py-1 mb-1" style="font-size: 11px;">
                                    <i class="fa-solid fa-tag me-1"></i>@(product?.Category?.CategoryName ?? "General")
                                </span>
                                <h6 class="mb-0 fw-bold text-truncate" style="color: #1162a3;" title="@product?.ProductName">
                                    @(product?.ProductName ?? "Inventory Item")
                                </h6>
                                <small class="text-muted d-block">
                                    Base Market Price: ₱@(product?.Price.ToString("N2") ?? "0.00")
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Local Price -->
                    <div class="form-group mb-3">
                        <label asp-for="LocalPrice" class="control-label fw-semibold mb-1" style="color: #1162a3;">Store Local Price (PHP)</label>
                        <div class="input-group shadow-sm rounded-3 overflow-hidden border">
                            <span class="input-group-text bg-light border-0 fw-bold text-secondary">₱</span>
                            <input asp-for="LocalPrice"
                                   class="form-control border-0 shadow-none fw-semibold no-spin"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   onwheel="this.blur()"
                                   placeholder="0.00" />
                        </div>
                        <span asp-validation-for="LocalPrice" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Stock Quantity -->
                    <div class="form-group mb-3">
                        <label asp-for="Stock" class="control-label fw-semibold mb-1" style="color: #1162a3;">Current Stock Count</label>
                        <input asp-for="Stock"
                               class="form-control rounded-3 no-spin shadow-sm"
                               type="number"
                               step="1"
                               min="0"
                               onwheel="this.blur()"
                               placeholder="e.g. 25" />
                        <span asp-validation-for="Stock" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <!-- Right Column: Barcodes Management -->
                <div class="col-lg-7 d-flex flex-column h-100 ps-lg-3 border-start">
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-shrink-0">
                        <div>
                            <h6 class="fw-bold text-uppercase text-secondary mb-0" style="font-size: 14px; letter-spacing: 0.5px;">
                                <i class="fa-solid fa-barcode me-1"></i>Active Barcodes
                            </h6>
                            <small class="text-muted">Register and search checkout scan codes for this item</small>
                        </div>
                        <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 small">
                            @barcodeList.Count() registered
                        </span>
                    </div>

                    <!-- Barcode Actions Row -->
                    <div class="d-flex gap-2 pb-3">
                        <div class="input-group shadow-sm rounded-3 overflow-hidden border bg-white flex-grow-1">
                            <span class="input-group-text bg-white border-0 pe-2">
                                <i class="fa-solid fa-magnifying-glass text-muted"></i>
                            </span>
                            <input type="text"
                                   id="barcodeFilterInput"
                                   class="form-control border-0 bg-white shadow-none ps-0 fw-semibold"
                                   placeholder="Filter barcodes..."
                                   autocomplete="off" />
                            <button class="btn btn-white border-0 text-secondary pe-3"
                                    type="button"
                                    id="clearBarcodeFilterBtn"
                                    style="display: none;">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                        <!-- Add Barcode Trigger Button -->
                        <button type="button"
                                class="btn btn-primary fw-medium rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1 text-nowrap"
                                data-bs-toggle="collapse"
                                data-bs-target="#addBarcodeCollapse"
                                aria-expanded="false"
                                aria-controls="addBarcodeCollapse"
                                style="background-color: #1162a3; border-color: #1162a3; font-size: 13px;">
                            <i class="fa-solid fa-plus"></i>
                            <span>Add</span>
                        </button>

                        <!-- Clear All Barcodes Button -->
                        @if (barcodeList.Any())
                        {
                            <button type="button"
                                    class="btn btn-outline-danger fw-medium rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1 text-nowrap"
                                    style="font-size: 13px;"
                                    onclick="confirmClearAllBarcodes()">
                                <i class="fa-solid fa-trash-can"></i>
                                <span>Clear All</span>
                            </button>
                        }
                    </div>

                    <!-- Overhead TempData Alert -->
                    @if (TempData["UserMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm fw-medium d-flex align-items-center mb-3 flex-shrink-0" role="alert">
                            <i class="fa-solid fa-circle-check fs-5 me-2 flex-shrink-0"></i>
                            <div>@TempData["UserMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Scrollable Barcode Table Box -->
                    <div class="border rounded-3 overflow-hidden shadow-sm flex-grow-1 d-flex flex-column bg-white">
                        <div class="table-responsive flex-grow-1 overflow-y-auto" style="max-height: 380px;">
                            <table class="table table-hover align-middle mb-0" id="barcodeTable">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th class="ps-3 py-2 text-secondary text-uppercase fw-bold" style="font-size: 14px;">Barcode Number</th>
                                        <th class="pe-3 py-2 text-end text-secondary text-uppercase fw-bold" style="font-size: 14px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!barcodeList.Any())
                                    {
                                        <tr id="emptyBarcodeRow">
                                            <td colspan="2" class="text-center py-4 text-muted small">
                                                <i class="fa-solid fa-barcode fa-2x mb-2 d-block opacity-50"></i>
                                                No barcodes registered for this item yet.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in barcodeList)
                                        {
                                            <tr class="barcode-row" data-code="@item.BarcodeLine.ToLower()">
                                                <td class="ps-3">
                                                    <span class="font-monospace fw-semibold text-dark fs-6">
                                                        <i class="fa-solid fa-barcode text-muted me-2 opacity-50"></i>@item.BarcodeLine
                                                    </span>
                                                </td>
                                                <td class="pe-3 text-end">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                            title="Remove Barcode"
                                                            onclick="confirmBarcodeRemoval('@item.BarcodeId', '@item.BarcodeLine')">
                                                        <i class="fa-solid fa-trash-can me-1"></i>Delete
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sticky Bottom Actions -->
            <div class="d-flex justify-content-end align-items-center gap-2 pt-3 mt-3 border-top flex-shrink-0">
                <a asp-action="Index"
                   asp-route-retailId="@ViewBag.RetailId"
                   class="btn btn-outline-secondary fw-medium rounded-pill px-4 shadow-sm"
                   style="font-size: 14px;">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary fw-medium rounded-pill px-4 shadow-sm"
                        style="font-size: 14px; background-color: #1162a3; border-color: #1162a3;">
                    <i class="fa-solid fa-check me-1"></i>Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Standalone Hidden Forms for Barcode Actions (To avoid HTML Form Nesting) -->
<form asp-action="AddBarcode" method="post" id="hiddenAddBarcodeForm" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="InventoryId" value="@Model.InventoryId" />
    <input type="hidden" name="retailId" value="@ViewBag.RetailId" />
    <input type="hidden" name="BarcodeLine" id="hiddenBarcodeLine" />
</form>

<form asp-action="DeleteBarcode" method="post" id="hiddenDeleteBarcodeForm" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="barcodeId" id="hiddenDeleteBarcodeId" />
    <input type="hidden" name="inventoryId" value="@Model.InventoryId" />
    <input type="hidden" name="retailId" value="@ViewBag.RetailId" />
</form>

<!-- Standalone Hidden Form for Bulk Clearing -->
<form asp-action="ClearAllBarcodes" method="post" id="hiddenClearAllBarcodesForm" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="inventoryId" value="@Model.InventoryId" />
    <input type="hidden" name="productId" value="@Model.ProductId" />
    <input type="hidden" name="retailId" value="@ViewBag.RetailId" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Cancel fallback navigation logic
        function handleCancelNavigation(event, fallbackUrl) {
            event.preventDefault();
            const hasInternalReferrer = document.referrer && document.referrer.startsWith(window.location.origin);
            const hasHistory = window.history.length > 1;

            if (hasHistory && hasInternalReferrer) {
                window.history.back();
            } else {
                window.location.href = fallbackUrl;
            }
        }

        // Delete confirmation via SweetAlert2
        function confirmBarcodeRemoval(barcodeId, barcodeLine) {
            Swal.fire({
                title: 'Delete Barcode?',
                text: `Are you sure you want to remove barcode "${barcodeLine}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('hiddenDeleteBarcodeId').value = barcodeId;
                    document.getElementById('hiddenDeleteBarcodeForm').submit();
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Add Barcode Form Submission Trigger
            const submitAddBtn = document.getElementById("submitAddBarcodeBtn");
            const newBarcodeInput = document.getElementById("newBarcodeLine");
            const hiddenBarcodeLine = document.getElementById("hiddenBarcodeLine");
            const barcodeErrorMsg = document.getElementById("barcodeErrorMsg");
            const addBarcodeForm = document.getElementById("hiddenAddBarcodeForm");

            if (submitAddBtn && newBarcodeInput) {
                submitAddBtn.addEventListener("click", function () {
                    const code = newBarcodeInput.value.trim();
                    if (!code) {
                        barcodeErrorMsg.textContent = "Please enter a valid barcode.";
                        barcodeErrorMsg.style.display = "block";
                        return;
                    }

                    barcodeErrorMsg.style.display = "none";
                    hiddenBarcodeLine.value = code;
                    addBarcodeForm.submit();
                });

                newBarcodeInput.addEventListener("keypress", function (e) {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        submitAddBtn.click();
                    }
                });
            }

            // Client-side Live Filter for Barcodes
            const filterInput = document.getElementById("barcodeFilterInput");
            const clearFilterBtn = document.getElementById("clearBarcodeFilterBtn");
            const barcodeRows = document.querySelectorAll(".barcode-row");

            if (filterInput) {
                filterInput.addEventListener("input", function () {
                    const query = this.value.trim().toLowerCase();
                    clearFilterBtn.style.display = query ? "block" : "none";

                    barcodeRows.forEach(row => {
                        const code = row.getAttribute("data-code") || "";
                        row.style.display = code.includes(query) ? "" : "none";
                    });
                });

                clearFilterBtn.addEventListener("click", function () {
                    filterInput.value = "";
                    this.style.display = "none";
                    barcodeRows.forEach(row => row.style.display = "");
                    filterInput.focus();
                });
            }
        });

        function confirmClearAllBarcodes() {
            Swal.fire({
                title: 'Clear All Barcodes?',
                text: 'This will permanently remove all barcodes associated with this inventory item. Are you sure?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, clear all',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('hiddenClearAllBarcodesForm').submit();
                }
            });
        }

        // Auto clear input
        document.addEventListener("DOMContentLoaded", function () {
            function setupAutoClearField(elementId) {
                const input = document.getElementById(elementId);
                if (!input) return;

                let previousValue = "";

                input.addEventListener("focus", function () {
                    previousValue = this.value;
                    this.value = "";
                });

                input.addEventListener("blur", function () {
                    // Restore previous value only if left empty or only whitespace
                    if (this.value.trim() === "") {
                        this.value = previousValue;
                    }
                });
            }

            // Attach to both fields
            setupAutoClearField("LocalPrice");
            setupAutoClearField("Stock");
        });
    </script>
}