@model IEnumerable<SmartScan.Models.Inventory>

@{
    ViewData["Title"] = "Inventory";
    ViewData["HeaderTitle"] = "Retail Management";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(0deg, #95CCDD 0%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="card shadow border-0 mt-4">
    <div class="card-header text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-boxes-stacked"></i> @ViewBag.RetailName Inventory</h5>
    </div>
    <div class="p-3 d-flex justify-content-between align-items-center mb-3">
        <p>
            <a class="btn btn-success fw-semibold" asp-action="Create" asp-route-retailId="@ViewBag.RetailId">Add Product</a>
        </p>
        <!--SEARCH Feature-->
        <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 450px; padding-bottom: 11px; width:100%;">
            <input type="hidden" name="retailId" value="@ViewBag.RetailId" />
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                </span>
                <input type="text" name="search" value="@ViewData["CurrentFilter"]" class="form-control border-start-0 ps-0 fw-semibold"
                       placeholder="Search..." aria-label="Search product" />
            </div>
            <button type="submit" class="btn btn-outline-primary fw-semibold">Search</button>

            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
            {
                <a asp-action="Index" asp-route-retailId="@ViewBag.RetailId" class="btn btn-outline-secondary" title="Clear Search">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            }
        </form>
    </div>
    @if(!Model.Any())
    {
        @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
        {
            <div class="alert alert-warning text-center my-4 fw-semibold" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i>No retail found matching "<strong>@ViewData["CurrentFilter"]</strong>".
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center my-4 fw-semibold" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i>No products have been added to the inventory yet.
            </div>
        }
    }
    else
    {
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>
                            Product
                        </th>
                        <th>
                            Local Price
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Stock)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Barcode)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(model => item.Product.ProductName)
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.LocalPrice)
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.Stock)
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.Barcode)
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.InventoryId">Edit</a> |
                                <a asp-action="Details" asp-route-id="@item.InventoryId">Details</a> |
                                <a asp-action="Delete" asp-route-id="@item.InventoryId">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="text-start p-3">
        <a asp-controller="Retails" asp-action="Index" class="btn btn-outline-secondary fw-medium">Back to List</a>
    </div>
</div>
