@model IEnumerable<SmartScan.Models.Inventory>

@{
    ViewData["Title"] = "Inventory";
    ViewData["HeaderTitle"] = "Retail Management";
    Layout = "_RetailLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0" style="color: #1162a3;">
        <i class="fa-solid fa-boxes-stacked me-2"></i> Inventory   
    </h4>
    <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">
        Total Products: @(ViewBag.TotalProducts ?? 0)
    </span>
</div>

<div class="p-2 d-flex justify-content-between align-items-center mb-3 bounded-header">
    <p>
        <a class="btn btn-success fw-semibold" asp-action="Create" asp-route-retailId="@ViewBag.RetailId">Add Product</a>
    </p>

    <!-- Search Feature -->
    <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 350px; width: 100%;">
        <input type="hidden" name="retailId" value="@ViewBag.RetailId" />

        <div class="input-group shadow-sm rounded-3 overflow-hidden border">
            <span class="input-group-text bg-white border-0">
                <i class="fa-solid fa-magnifying-glass text-muted"></i>
            </span>
            <input type="text"
                   name="search"
                   value="@ViewData["CurrentFilter"]"
                   class="form-control border-0 bg-white shadow-none ps-0 fw-semibold"
                   placeholder="Search product..."
                   aria-label="Search" />
        </div>

        @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
        {
            <a asp-action="Index" asp-route-retailId="@ViewBag.RetailId" class="btn btn-outline-secondary rounded-3" title="Clear Search">
                <i class="fa-solid fa-xmark"></i>
            </a>
        }
    </form>
</div>

@if (!Model.Any())
{
    @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
    {
        <div class="alert alert-warning text-center my-4 fw-semibold" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>No retail found matching "<strong>@ViewData["CurrentFilter"]</strong>".
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center my-4 fw-semibold" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>No products have been added to the inventory yet.
        </div>
    }
}
else
{
    <div class="card-body">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>
                        Product
                    </th>
                    <th>
                        Category
                    </th>
                    <th>
                        Local Price
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Stock)
                    </th>
                    <th>
                        Product Image
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-truncate" style="max-width: 180px;" title="@item.Product.ProductName">
                            @Html.DisplayFor(model => item.Product.ProductName)
                        </td>
                        <td>
                            @(item.Product?.Category?.CategoryName ?? "Uncategorized")
                        </td>
                        <td>
                            ₱@Html.DisplayFor(model => item.LocalPrice)
                        </td>
                        <td>
                            @Html.DisplayFor(model => item.Stock)
                        </td>
                        <td>
                            <img src="@item.Product.ProductImage" alt="@item.Product.ProductName" style="width: 90px; height: 90px; object-fit: cover; border-radius: 4px;" />
                        </td>
                        <td>
                            <a class="btn btn-primary fw-medium" asp-action="Edit" asp-route-inventoryId="@item.InventoryId" asp-route-retailId="@item.RetailId"><i class="fa-solid fa-pen-to-square"></i> Edit</a>
                            <form asp-action="Delete" asp-route-inventoryId="@item.InventoryId" method="post" onsubmit="return confirm('Are you sure you want to remove @item.Product?.ProductName from this inventory?');" style="display:inline;">
                                <button type="submit" class="btn btn-secondary fw-medium">
                                    <i class="fa-solid fa-xmark"></i> Remove
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
