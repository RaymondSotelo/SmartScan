@model SmartScan.Models.Retail

@{
    ViewData["Title"] = "Update Retail Info";
    ViewData["HeaderTitle"] = "Retail Management";
}

@section Styles {
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(180deg, #95CCDD 0%, #eef6f9 100%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="card shadow border-0 rounded-4 mt-4">
    <div class="card-header rounded-top-4 text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-shop"></i> Updating Retail Information</h5>
    </div>
    <div class="d-flex justify-content-center align-items-center w-100 py-4" style="min-height: 75vh;">
        <div style="width: 100%; max-width: 540px;">
			<form asp-action="Edit" asp-route-id="@Model.RetailId" method="post" enctype="multipart/form-data">
				<div asp-validation-summary="ModelOnly" class="text-danger"></div>
				<input type="hidden" asp-for="RetailId" />

				<!-- Store Image Preview & Upload -->
				<div class="mb-4 text-center">
					<div class="d-inline-block position-relative mb-2">
						<img id="retailPreview"
							 src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/images/default-store.png" : Model.ImagePath)"
							 onerror="this.onerror=null; this.src='/images/default-store.png';"
							 alt="Store Preview"
							 class="rounded-3 border shadow-sm object-fit-cover"
							 style="width: 480px; height: 320px;" />
					</div>
					<div>
						<label class="form-label d-block small fw-medium" style="color:#1162a3;">
							<i class="fa-solid fa-camera me-1"></i> Change Store Image
						</label>
						<input name="RetailImageFile" type="file" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" onchange="previewImage(this)" />
						<span asp-validation-for="ImagePath" class="text-danger small"></span>
					</div>
				</div>

				<hr />

				<!-- Retail Name -->
				<div class="form-group mb-3">
					<label asp-for="RetailName" class="control-label fw-medium" style="color:#1162a3">Retail Name</label>
					<input asp-for="RetailName" class="form-control" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
					<span asp-validation-for="RetailName" class="text-danger"></span>
				</div>

				<!-- Description -->
				<div class="form-floating mb-3">
					<textarea asp-for="Description" class="form-control" placeholder="Description" style="height: 100px;"></textarea>
					<label asp-for="Description" class="control-label fw-medium" style="color:#1162a3">Retail Description</label>
					<span asp-validation-for="Description" class="text-danger small"></span>
				</div>

				<!-- Address -->
				<div class="form-group">
					<label asp-for="Address" class="control-label fw-medium" style="color:#1162a3; padding-top:10px;"></label>
					<input asp-for="Address" class="form-control" />
					<span asp-validation-for="Address" class="text-danger"></span>
				</div>

				<!-- Status Id -->
				<div class="form-group">
					<label asp-for="StatusId" class="control-label fw-medium" style="color:#1162a3; padding-top:10px;">Status</label>
					<select asp-for="StatusId" class="form-control" asp-items="ViewBag.StatusId"></select>
					<span asp-validation-for="StatusId" class="text-danger"></span>
				</div>

				<!-- Button Placement -->
				<div class="row row-cols-2 pt-4">
					<div class="text-start">
						<a href="javascript:void(0);"
						   class="btn btn-outline-secondary fw-medium"
						   onclick="window.history.back();">
							<i class="fa-solid fa-arrow-left me-1"></i> Return
						</a>
					</div>
					<div class="form-group text-end">
						<input type="submit" value="Save" class="btn btn-primary fw-medium" />
					</div>
				</div>
			</form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('retailPreview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
