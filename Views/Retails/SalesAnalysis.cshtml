@model SmartScan.Models.ViewModels.SalesAnalysisViewModel

@{
    ViewData["Title"] = "Sales Analysis";
    Layout = "_RetailLayout";
}

<div class="h-100 d-flex flex-column">

    <!-- Header & Action Toolbar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 flex-shrink-0">
        <div>
            <h4 class="fw-bold mb-0" style="color: #1162a3;">
                Sales & Analytics
            </h4>
            <p class="text-secondary fw-medium mb-0">Track store performance, monitor revenue trends, and analyze top selling inventory.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- Date Filter Dropdown -->
            <form id="filterForm" method="get" asp-action="SalesAnalysis" asp-controller="Retails" class="m-0">
                <input type="hidden" name="retailId" value="@ViewBag.RetailId" />
                <div class="input-group shadow-sm rounded-pill overflow-hidden border bg-white"
                     style="width: 165px; height: 38px;">
                    <span class="input-group-text bg-white border-0 ps-3 pe-1 text-muted">
                        <i class="fa-regular fa-calendar-days"></i>
                    </span>
					<select name="range" class="form-select fw-medium shadow-sm border-0" onchange="document.getElementById('filterForm').submit();">
						<option value="7days" selected="@(Model.CurrentRange == "7days")">Last 7 Days</option>
						<option value="1month" selected="@(Model.CurrentRange == "1month")">Last Month</option>
						<option value="6months" selected="@(Model.CurrentRange == "6months")">Last 6 Months</option>
						<option value="1year" selected="@(Model.CurrentRange == "1year")">Last Year</option>
					</select>
                </div>
                
            </form>

            <!-- Hidden Form for Export Payload -->
            <form id="exportForm" method="post" target="_blank" class="d-none">
                <input type="hidden" name="retailId" value="@ViewBag.RetailId" />
                <input type="hidden" name="range" value="@Model.CurrentRange" />
                <input type="hidden" name="revenueChartImg" id="revenueChartImg" />
                <input type="hidden" name="productsChartImg" id="productsChartImg" />
                <input type="hidden" name="paymentChartImg" id="paymentChartImg" />
            </form>

            <!-- Export Dropdown Button -->
            <div class="dropdown">
                <button type="button"
                        class="btn btn-outline-secondary dropdown-toggle fw-medium rounded-pill px-3 shadow-sm d-flex align-items-center justify-content-center gap-2"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        style="width: 165px; height: 38px; font-size: 15px;">
                    <i class="fa-solid fa-download me-1"></i> Export Report
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-1 mt-1 p-0 overflow-hidden">
                    <li>
                        <button type="button" class="dropdown-item d-flex align-items-center fw-medium py-2" onclick="submitExport('ExportExcel')">
                            <i class="fa-solid fa-file-excel text-success me-2 fs-5"></i> Export to Excel (.xlsx)
                        </button>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item d-flex align-items-center fw-medium py-2" onclick="submitExport('ExportPdf')">
                            <i class="fa-solid fa-file-pdf text-danger me-2 fs-5"></i> Export to PDF (.pdf)
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Scrollable Body Workspace -->
    <div class="flex-grow-1 overflow-y-auto overflow-x-hidden px-1">
        <div class="d-flex flex-column gap-3 pb-3">

            <!-- KPI Cards -->
            <div class="row g-3 mx-0">
                <!-- Total Revenue -->
                <div class="col-md-6 col-12">
                    <div class="card kpi-card shadow-sm rounded-4 h-100 p-2"
                         style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="kpi-icon-bubble bg-primary bg-opacity-10 text-primary">
                                <i class="fa-solid fa-peso-sign fs-4"></i>
                            </div>
                            <div class="overflow-hidden">
                                <span class="text-uppercase text-secondary fw-bold d-block" style="font-size: 12px; letter-spacing: 0.5px;">Total Revenue</span>
                                <h4 class="fw-bold mb-0 text-dark text-truncate">₱@Model.TotalRevenue.ToString("N2")</h4>
                                <small class="text-muted" style="font-size: 12px;">@Model.RangeLabel</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Today's Orders -->
                <div class="col-md-6 col-12">
                    <div class="card kpi-card shadow-sm rounded-4 h-100 p-2"
                         style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="kpi-icon-bubble bg-primary bg-opacity-10 text-primary">
                                <i class="fa-solid fa-receipt fs-4"></i>
                            </div>
                            <div class="overflow-hidden">
                                <span class="text-uppercase text-secondary fw-bold d-block" style="font-size: 12px; letter-spacing: 0.5px;">Today's Orders</span>
                                <h4 class="fw-bold mb-0 text-dark">@Model.TodayTransactions</h4>
                                <small class="text-primary fw-semibold" style="font-size: 12px;">
                                    <i class="fa-solid fa-bolt me-1"></i>Live count
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Units Sold -->
                <div class="col-md-6 col-12">
                    <div class="card kpi-card shadow-sm rounded-4 h-100 p-2"
                         style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="kpi-icon-bubble bg-primary bg-opacity-10 text-primary">
                                <i class="fa-solid fa-boxes-stacked fs-4"></i>
                            </div>
                            <div class="overflow-hidden">
                                <span class="text-uppercase text-secondary fw-bold d-block" style="font-size: 12px; letter-spacing: 0.5px;">Units Sold</span>
                                <h4 class="fw-bold mb-0 text-dark">@Model.TotalItemsSold</h4>
                                <small class="text-muted" style="font-size: 12px;">Total units checked out</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Leading Product -->
                <div class="col-md-6 col-12">
                    <div class="card kpi-card shadow-sm rounded-4 h-100 p-2"
                         style="background-color: #dbeafe; border-color: #cfe2f3 !important;">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="kpi-icon-bubble bg-primary bg-opacity-10 text-primary">
                                <i class="fa-solid fa-crown fs-4"></i>
                            </div>
                            <div class="overflow-hidden">
                                <span class="text-uppercase text-secondary fw-bold d-block" style="font-size: 12px; letter-spacing: 0.5px;">Leading Product</span>
                                <h5 class="fw-bold mb-0 text-dark text-truncate" title="@Model.TopSellingItemName">
                                    @(string.IsNullOrWhiteSpace(Model.TopSellingItemName) ? "None Yet" : Model.TopSellingItemName)
                                </h5>
                                <small class="text-primary fw-medium" style="font-size: 12px;">Highest volume</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Row 1 -->
            <div class="row g-3 mx-0">
                <div class="col-lg-8">
                    <div class="card chart-card shadow-sm bg-white h-100 p-3">
                        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center pb-0">
                            <div>
                                <h6 class="fw-bold mb-1" style="color: #1162a3;">
                                    <i class="fa-solid fa-chart-area me-1"></i>Revenue Inflow
                                </h6>
                                <p class="text-muted small mb-0">Earnings trend over @Model.RangeLabel.ToLower()</p>
                            </div>
                            <span class="badge bg-light text-secondary border rounded-pill px-3 py-1 fw-medium" style="font-size: 12px;">
                                Trend
                            </span>
                        </div>
                        <div class="card-body pt-2">
                            <div style="height: 270px;">
                                <canvas id="revenueChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card chart-card shadow-sm bg-white h-100 p-3">
                        <div class="card-header bg-transparent border-0 pb-0">
                            <h6 class="fw-bold mb-1" style="color: #1162a3;">
                                <i class="fa-solid fa-wallet me-1"></i>Payment Channels
                            </h6>
                            <p class="text-muted small mb-0">Distribution by tender</p>
                        </div>
                        <div class="card-body pt-2 d-flex flex-column justify-content-center">
                            <div style="height: 230px; position: relative;">
                                <canvas id="paymentChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Row 2 -->
            <div class="card chart-card shadow-sm bg-white p-3">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center pb-0">
                    <div>
                        <h6 class="fw-bold mb-1" style="color: #1162a3;">
                            <i class="fa-solid fa-ranking-star me-1"></i>Top 5 Catalog Products
                        </h6>
                        <p class="text-muted small mb-0">Ranked by units purchased</p>
                    </div>
                    <span class="badge bg-light text-secondary border rounded-pill px-3 py-1 fw-medium" style="font-size: 12px;">
                        Volume
                    </span>
                </div>
                <div class="card-body pt-2">
                    <div style="height: 250px;">
                        <canvas id="topProductsChart"></canvas>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const brandPrimary = '#1162a3';
            const brandAccent = '#0dcaf0';
            const brandSuccess = '#198754';
            const brandWarning = '#ffc107';
            const brandSecondary = '#6c757d';

            Chart.defaults.font.family = 'system-ui, -apple-system, "Segoe UI", Roboto, sans-serif';
            Chart.defaults.color = '#6c757d';

            // 1. Revenue Line Chart
            const revCanvas = document.getElementById('revenueChart');
            const revCtx = revCanvas.getContext('2d');
            const revGradient = revCtx.createLinearGradient(0, 0, 0, 260);
            revGradient.addColorStop(0, 'rgba(17, 98, 163, 0.28)');
            revGradient.addColorStop(1, 'rgba(17, 98, 163, 0.01)');

            new Chart(revCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Model.RevenueDatesJson),
                    datasets: [{
                        label: 'Revenue',
                        data: @Html.Raw(Model.RevenueValuesJson),
                        borderColor: brandPrimary,
                        borderWidth: 2.5,
                        backgroundColor: revGradient,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: brandPrimary,
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        fill: true,
                        tension: 0.35
                    }]
                },
                options: {
                    animation: false, // Ensures canvas is ready immediately for exports
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0, 0, 0, 0.04)' },
                            ticks: {
                                callback: function (value) {
                                    return '₱' + (value >= 1000 ? (value / 1000).toFixed(1) + 'k' : value);
                                }
                            }
                        }
                    }
                }
            });

            // 2. Top Products Bar Chart
            const prodCanvas = document.getElementById('topProductsChart');
            new Chart(prodCanvas, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Model.TopProductNamesJson),
                    datasets: [{
                        label: 'Units Sold',
                        data: @Html.Raw(Model.TopProductQuantitiesJson),
                        backgroundColor: 'rgba(17, 98, 163, 0.85)',
                        borderRadius: 6,
                        maxBarThickness: 38
                    }]
                },
                options: {
                    animation: false,
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0, 0, 0, 0.04)' },
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });

            // 3. Payment Methods Doughnut
            const payCanvas = document.getElementById('paymentChart');
            new Chart(payCanvas, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Model.PaymentMethodLabelsJson),
                    datasets: [{
                        data: @Html.Raw(Model.PaymentMethodCountsJson),
                        backgroundColor: [brandPrimary, brandAccent, brandSuccess, brandWarning, brandSecondary],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    animation: false,
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 10, padding: 12, font: { size: 11 } }
                        }
                    }
                }
            });
        });

        function submitExport(actionName) {
            const revCanvas = document.getElementById('revenueChart');
            const prodCanvas = document.getElementById('topProductsChart');
            const payCanvas = document.getElementById('paymentChart');

            if (revCanvas) document.getElementById('revenueChartImg').value = revCanvas.toDataURL('image/png', 1.0);
            if (prodCanvas) document.getElementById('productsChartImg').value = prodCanvas.toDataURL('image/png', 1.0);
            if (payCanvas) document.getElementById('paymentChartImg').value = payCanvas.toDataURL('image/png', 1.0);

            const form = document.getElementById('exportForm');
            form.action = '@Url.Action("Placeholder", "Retails")'.replace("Placeholder", actionName);
            form.submit();
        }
    </script>
}