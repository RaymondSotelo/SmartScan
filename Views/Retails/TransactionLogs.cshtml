@model IEnumerable<SmartScan.Models.Transaction>

@{
    ViewData["Title"] = "Transaction Logs";
    ViewData["HeaderTitle"] = "Retail Management";
    Layout = "_RetailLayout";

    string currentFilter = ViewData["CurrentFilter"]?.ToString()?.Trim() ?? "";
}

<div class="h-100 d-flex flex-column">

    <!-- Header & Action Toolbar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 flex-shrink-0">
        <div>
            <h4 class="fw-bold mb-0" style="color: #1162a3;">
                Transaction Logs
            </h4>
            <p class="text-secondary fw-medium mb-0">Review all orders, tender types, and receipts recorded for this store.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- Search Filter -->
            <form asp-action="TransactionLogs" method="get" class="d-flex gap-2" style="width: 270px; max-width: 100%;">
				<input type="hidden" name="retailId" value="@ViewBag.RetailId" />
                <div class="input-group shadow-sm rounded-3 overflow-hidden border">
                    <span class="input-group-text bg-white border-0">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
					</span>
					<input type="text"
						   name="search"
						   value="@currentFilter"
                           class="form-control border-0 bg-white shadow-none ps-0 fw-semibold"
                           style="font-size: 13px;"
						   placeholder="Search receipt, cashier, payment..."
						   aria-label="Search transactions" />
                </div>

                @if (!string.IsNullOrEmpty(currentFilter))
                {
                    <a asp-action="TransactionLogs" asp-route-retailId="@ViewBag.RetailId" class="btn btn-outline-secondary rounded-pill px-3 d-flex align-items-center" title="Clear Search">
                        <i class="fa-solid fa-xmark"></i>
                    </a>
                }
            </form>

            <!-- Counter Badge -->
            <span class="badge rounded-pill fw-semibold px-3 shadow-sm text-white flex-shrink-0 d-flex align-items-center"
                  style="background-color: #1162a3; height: 38px; font-size: 13px;">
                <i class="fa-solid fa-receipt me-1"></i>@Model.Count() Orders
            </span>
        </div>
    </div>

    <!-- Main Workspace (Hidden Scrollbar) -->
    <div class="flex-grow-1 overflow-y-auto overflow-x-hidden no-scrollbar px-1">
        @if (!Model.Any())
        {
            @if (!string.IsNullOrEmpty(currentFilter))
            {
                <div class="alert alert-warning text-center my-4 fw-semibold shadow-sm border-0 rounded-4" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>No transaction found matching "<strong>@currentFilter</strong>".
                </div>
            }
            else
            {
                <div class="text-center py-5 my-auto">
                    <div class="text-muted mb-3">
                        <i class="fa-solid fa-receipt fa-3x text-secondary opacity-50"></i>
                    </div>
                    <h5 class="fw-semibold text-secondary">No TransactionLogs Recorded</h5>
                    <p class="text-muted small">Orders processed at this counter will appear here.</p>
                </div>
            }
        }
        else
        {
            <!-- Streamlined 5-Column Table Card -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-2">
                <div class="table-responsive no-scrollbar" style="max-height: calc(100dvh - 220px);">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="ps-4 py-3 text-secondary text-uppercase fw-bold" style="font-size: 14px; letter-spacing: 0.5px;">Receipt #</th>
                                <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 14px; letter-spacing: 0.5px;">Timestamp</th>
                                <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 14px; letter-spacing: 0.5px;">Processed By & Tender</th>
                                <th class="py-3 text-secondary text-uppercase fw-bold text-end" style="font-size: 14px; letter-spacing: 0.5px;">Total Amount</th>
                                <th class="pe-4 py-3 text-end text-secondary text-uppercase fw-bold" style="font-size: 14px; letter-spacing: 0.5px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                int itemsCount = item.TransactionItems?.Sum(ti => ti.Quantity) ?? 0;

                                <tr>
                                    <!-- 1. Receipt # -->
                                    <td class="ps-4">
                                        <span class="font-monospace fw-bold small" style="color: #1162a3;">
                                            @item.ReceiptNumber
                                        </span>
                                    </td>

                                    <!-- 2. Date & Time -->
                                    <td>
                                        <span class="fw-semibold text-dark d-block" style="font-size: 13px;">
                                            @item.CreatedAt.ToString("MMM dd, yyyy")
                                        </span>
                                        <small class="text-muted" style="font-size: 11px;">
                                            @item.CreatedAt.ToString("hh:mm tt")
                                        </small>
                                    </td>

                                    <!-- 3. Staff & Payment Combined -->
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="fa-solid fa-user-circle text-secondary opacity-75"></i>
                                                <span class="fw-semibold text-dark text-truncate" style="max-width: 170px; font-size: 13px;">
                                                    @(item.RetailStaff?.Staff?.UserName ?? "Self-Checkout")
                                                </span>
                                            </div>
                                            <div>
                                                <span class="badge rounded-pill bg-light text-secondary border fw-medium px-2 py-0" style="font-size: 10px;">
                                                    <i class="fa-solid fa-wallet me-1"></i>@(item.PaymentMethod?.PaymentMethodName ?? "Cash")
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- 4. Total Amount + Item Count -->
                                    <td class="text-end">
                                        <span class="fw-bold text-primary fs-6 d-block">
                                            ₱@item.TotalAmount.ToString("N2")
                                        </span>
                                        <small class="text-muted" style="font-size: 11px;">
                                            @itemsCount item@(itemsCount == 1 ? "" : "s")
                                        </small>
                                    </td>

                                    <!-- 5. Action -->
                                    <td class="pe-4 text-end">
                                        <a class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-medium"
                                           asp-controller="Transactions"
                                           asp-action="Details"
                                           asp-route-transactionid="@item.TransactionId"
                                           asp-route-retailId="@ViewBag.RetailId"
                                           style="font-size: 14px;">
                                            <i class="fa-solid fa-eye me-1"></i>View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>