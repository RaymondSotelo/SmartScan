@model SmartScan.Models.Retail

@{
    ViewData["Title"] = "View Retail Info";
    ViewData["HeaderTitle"] = "Retail Management";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(0deg, #95CCDD 0%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="card shadow border-0 mt-4">
    <div class="card-header text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-tag"></i> Retail Detail</h5>
    </div>
    <div class="card-body">
        <div class="col-sm-4">
            <dl class="row">
                <dt class="col-sm-5 fw-bold" style="color:#1162a3">
                    Retail Name
                </dt>
                <dd class="col-sm-5 text-nowrap fw-medium" style="color:#1162a3">
                    @Html.DisplayFor(model => model.RetailName)
                </dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-5 fw-bold" style="color:#1162a3">
                    Status
                </dt>
                <dd class="col-sm-5 fw-medium">
                    @if (Model.Status.StatusName == "Active")
                    {
                        <span class="badge bg-success rounded-pill px-3">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary text-light rounded-pill px-3">Inactive</span>
                    }
                </dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-5 fw-bold" style="color:#1162a3">
                    @Html.DisplayNameFor(model => model.Passcode)
                </dt>
                <dd class="col-sm-5  fw-medium">
                    ******
                </dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-5 fw-bold" style="color:#1162a3">
                    Admin Owner
                </dt>
                <dd class="col-sm-5 text-nowrap fw-medium">
                    @Html.DisplayFor(model => model.AdminOwnerNavigation.UserName)
                </dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-5 fw-bold" style="color:#1162a3">
                    @Html.DisplayNameFor(model => model.Address)
                </dt>
                <dd class="col-sm-5 text-nowrap fw-medium">
                    @Html.DisplayFor(model => model.Address)
                </dd>
            </dl>
            <div class="row row-cols-2 pt-4">
                <div class="form-group text-start"> <!-- Change this later for inventories-->
                    <a asp-action="" class="btn btn-primary fw-medium">View Inventory</a>
                </div>
                <div class="form-group text-end">
                    <a asp-action="Index" class="btn btn-outline-secondary fw-medium">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>
