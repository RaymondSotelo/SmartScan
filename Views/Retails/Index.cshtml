@model IEnumerable<SmartScan.Models.Retail>
@inject SmartScan.Data.ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Enroll Retail";
    ViewData["HeaderTitle"] = "Retail Management";

    // Collect all distinct AdminOwner IDs across all listed retail cards
    var ownerIds = Model
        .Select(r => r.AdminOwner)
        .Where(id => !string.IsNullOrEmpty(id))
        .Distinct()
        .ToList();

    // Fetch all matching UserProfiles in a single batched query
    var profileMap = DbContext.UserProfiles
        .Where(up => ownerIds.Contains(up.UserId))
        .ToDictionary(up => up.UserId, up => up.ProfilePicture);
}

<div class="card shadow border-0 rounded-4 mt-4 mb-5">
    <div class="card-header rounded-top-4 text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-shop me-2"></i>Enroll Retails</h5>
    </div>

    <!-- Alert Messages -->
    <div class="px-3 pt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="p-3 d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <a class="btn btn-success fw-semibold" asp-action="Create">
                <i class="fa-solid fa-plus me-1"></i> Add New Retail
            </a>
        </div>

        <!-- SEARCH Feature -->
        <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 450px; width: 100%;">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                </span>
                <input type="text" name="search" value="@ViewData["CurrentFilter"]" class="form-control border-start-0 ps-0 fw-semibold"
                       placeholder="Search retail name, address..." aria-label="Search retail" />
            </div>
            <button type="submit" class="btn btn-outline-primary fw-semibold">Search</button>

            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Search">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            }
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="p-4">
            <div class="alert alert-warning text-center my-2 fw-semibold" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i>No retail found matching "<strong>@ViewData["CurrentFilter"]</strong>".
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 p-3 pt-0">
            @foreach (var item in Model)
            {
                // Resolve avatar path for the store owner
                profileMap.TryGetValue(item.AdminOwner, out var customPic);
                var avatarPath = string.IsNullOrWhiteSpace(customPic)
                    ? "/images/default-pfp.jpg"
                    : customPic;

                <div class="col">
                    <div class="card h-100 shadow-sm border retail-card position-relative overflow-hidden">
                        <!-- Store Image Banner -->
                        <div class="position-relative" style="height: 180px;">
                            <img src="@(string.IsNullOrEmpty(item.ImagePath) ? "/images/default-retail-pic.png" : item.ImagePath)"
                                 onerror="this.onerror=null; this.src='/images/default-store.png';"
                                 alt="@item.RetailName"
                                 class="card-img-top w-100 h-100 object-fit-cover" />

                            <!-- Status Badge -->
                            <div class="position-absolute top-0 end-0 m-2">
                                @if (item.Status?.StatusName == "Active")
                                {
                                    <span class="badge bg-success rounded-pill px-3 shadow-sm">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-3 shadow-sm">Inactive</span>
                                }
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body d-flex flex-column p-3">
                            <h5 class="card-title fw-bold mb-1 text-truncate" style="color: #1162a3;" title="@item.RetailName">
                                <!-- Stretched link triggers navigation to store details/view -->
                                <a asp-action="View" asp-route-retailid="@item.RetailId" class="stretched-link text-decoration-none text-reset">
                                    @item.RetailName
                                </a>
                            </h5>

                            <!-- Address -->
                            <p class="card-text text-muted small mb-2 text-truncate" title="@item.Address">
                                <i class="fa-solid fa-location-dot me-1 text-danger"></i> @item.Address
                            </p>

                            <!-- Description preview -->
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p class="card-text text-secondary small line-clamp-2 mb-3">
                                    @item.Description
                                </p>
                            }

                            <!-- Footer Info -->
                            <div class="mt-auto d-flex align-items-center small text-muted pt-2">

                                <!-- Owner Section -->
                                <div class="d-flex align-items-center text-truncate me-2 position-relative" style="z-index: 2;" title="Store Owner">
                                    <img src="@avatarPath"
                                         onerror="this.onerror=null; this.src='/images/default-profile-pic.png';"
                                         alt="@(item.AdminOwnerNavigation?.UserName ?? "Owner")"
                                         class="rounded-circle border border-1 object-fit-cover shadow-sm bg-white me-2 flex-shrink-0"
                                         style="width: 38px; height: 38px;" />

                                    <div class="d-flex flex-column text-truncate" style="line-height: 1.1;">
                                        <span class="text-muted text-uppercase" style="font-size: 9px; letter-spacing: 0.5px;">Owner</span>
                                        <span class="fw-semibold text-dark text-truncate" style="font-size: 12px;">
                                            @(item.AdminOwnerNavigation?.UserName ?? "Unknown")
                                        </span>
                                    </div>
                                </div>

                                <!-- 3-Dot Actions Dropdown -->
                                <div class="dropdown ms-auto position-relative" style="z-index: 2;">
                                    <button class="btn btn-sm btn-link text-muted p-1 text-decoration-none shadow-none"
                                            type="button"
                                            id="retailDropdown-@item.RetailId"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            title="Options">
                                        <i class="fa-solid fa-ellipsis-vertical fs-6"></i>
                                    </button>

                                    <!-- Option Menu -->
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-1 p-0 overflow-hidden" aria-labelledby="retailDropdown-@item.RetailId">
                                        <!-- Edit -->
                                        <li>
                                            <a class="dropdown-item py-2 px-3 d-flex align-items-center text-primary fw-medium"
                                               asp-action="Edit"
                                               asp-route-retailid="@item.RetailId">
                                                <i class="fa-solid fa-pen-to-square me-2 text-primary" style="width: 18px;"></i>
                                                Edit
                                            </a>
                                        </li>

                                        <!-- Delete -->
                                        <li>
                                            <button type="button"
                                                    class="dropdown-item py-2 px-3 d-flex align-items-center text-danger fw-medium w-100 btn-delete-retail"
                                                    data-id="@item.RetailId"
                                                    data-name="@item.RetailName">
                                                <i class="fa-solid fa-trash-can me-2" style="width: 18px;"></i>
                                                Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <!-- Hidden POST form for Delete -->
            <form id="globalRetailDeleteForm" asp-controller="Retails" asp-action="Delete" method="post" style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="retailid" id="deleteFormRetailId" value="" />
            </form>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Handle retail delete clicks
            document.querySelectorAll('.btn-delete-retail').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation(); // Stops stretched-link from navigating

                    const retailId = this.getAttribute('data-id');
                    const retailName = this.getAttribute('data-name');
                    const form = document.getElementById('globalRetailDeleteForm');
                    const inputId = document.getElementById('deleteFormRetailId');

                    if (!form || !inputId) {
                        console.error('Delete form or input not found in DOM.');
                        return;
                    }

                    // Check if SweetAlert2 is loaded
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            title: 'Delete Retail Store?',
                            text: `Are you sure you want to delete "${retailName}"? This action cannot be undone.`,
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#dc3545',
                            cancelButtonColor: '#6c757d',
                            confirmButtonText: 'Yes, delete it'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                inputId.value = retailId;
                                form.submit();
                            }
                        });
                    } else {
                        // Fallback to standard confirm if Swal fails to load
                        if (confirm(`Are you sure you want to delete "${retailName}"?`)) {
                            inputId.value = retailId;
                            form.submit();
                        }
                    }
                });
            });
        });
    </script>
}