@model SmartScan.Models.Retail
@{
    ViewData["Title"] = "Store Overview";
    ViewData["RetailName"] = Model.RetailName;
    ViewData["RetailId"] = Model.RetailId;
    Layout = "_RetailLayout"; // <--- Binds to the nested card layout!
}

@section Styles {
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(180deg, #95CCDD 0%, #eef6f9 100%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<h4 class="fw-bold mb-3" style="color: #1162a3;">Store Overview</h4>

<div class="row g-3">
    <div class="col-md-4 text-center">
        <img src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/images/default-store.png" : Model.ImagePath)"
             alt="@Model.RetailName"
             class="img-fluid rounded-3 border shadow-sm object-fit-cover"
             style="height: 180px; width: 100%;" />
    </div>
    <div class="col-md-8">
        <h5>@Model.RetailName</h5>
        <p class="text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i> @Model.Address</p>
        <p>@Model.Description</p>
    </div>
</div>

