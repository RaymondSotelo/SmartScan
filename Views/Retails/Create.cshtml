@model SmartScan.Models.Retail

@{
    ViewData["Title"] = "Create Retail";
    ViewData["HeaderTitle"] = "Retail Management";
}

<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3"
     style="height: calc(100dvh - 130px); min-height: 520px;">

    <!-- Top Card Header (Fixed) -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0" style="background-color: #1162a3;">
        <h5 class="mb-0"><i class="fa-solid fa-shop me-2"></i>Enrolling Retail Store</h5>
    </div>

    <!-- Scrollable Form Container -->
    <div class="card-body p-4 flex-grow-1 overflow-y-auto">
        <form asp-action="Create" method="post" enctype="multipart/form-data" id="createRetailForm" class="h-100 d-flex flex-column justify-content-between">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-4">
                <!-- Left Column: Retail Details -->
                <div class="col-lg-6">
                    <h6 class="fw-bold text-uppercase text-secondary mb-3" style="font-size: 14px; letter-spacing: 0.5px;">Store Details</h6>

                    <!-- Retail Name -->
                    <div class="form-group mb-3">
                        <label asp-for="RetailName" class="control-label fw-semibold mb-1" style="color: #1162a3;">Retail Name</label>
                        <input asp-for="RetailName" class="form-control rounded-3" placeholder="Enter store name" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
                        <span asp-validation-for="RetailName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Description -->
                    <div class="form-group mb-3">
                        <label asp-for="Description" class="control-label fw-semibold mb-1" style="color: #1162a3;">Retail Description</label>
                        <textarea asp-for="Description" class="form-control rounded-3" placeholder="Enter store details or notes..." style="height: 110px;"></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Address -->
                    <div class="form-group mb-3">
                        <label asp-for="Address" class="control-label fw-semibold mb-1" style="color: #1162a3;">Store Address</label>
                        <input asp-for="Address" class="form-control rounded-3" placeholder="e.g. 123 Main Street, City" />
                        <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Initial Status Notice -->
                    <div class="form-group mb-3">
                        <label class="control-label fw-semibold mb-2 d-block" style="color: #1162a3;">Initial Status</label>

                        <!-- Hidden input setting default Active (StatusId = 1) -->
                        <input type="hidden" asp-for="StatusId" value="2" />

                        <div class="d-flex align-items-center p-3 bg-light rounded-3 border shadow-sm">
                            <div>
                                <span class="badge rounded-pill fw-semibold px-3 py-2 shadow-sm bg-secondary text-white">
                                    <i class="fa-solid fa-circle-check me-1"></i>Inactive by Default
                                </span>
                                <small class="text-muted d-block mt-2">
                                    New retail stores are automatically inactive upon creation. You can change this to Inactive anytime later in the Edit page.
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Store Media & Live Preview -->
                <div class="col-lg-6">
                    <h6 class="fw-bold text-uppercase text-secondary mb-3" style="font-size: 14px; letter-spacing: 0.5px;">Store Branding Image</h6>

                    <!-- File Upload Card -->
                    <div class="border rounded-3 p-3 bg-light shadow-sm mb-3">
                        <label for="retailFileInput" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="fa-solid fa-cloud-arrow-up me-1"></i> Upload Store Image
                        </label>
                        <input type="file"
                               name="RetailImageFile"
                               id="retailFileInput"
                               class="form-control rounded-3"
                               accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text small mt-1">Select a PNG, JPG, JPEG, or WebP file for the store profile.</div>
                        <span asp-validation-for="ImagePath" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Live Image Preview Box -->
                    <div class="image-preview-box shadow-sm" id="previewContainer" style="height: 250px;">
                        <img id="retailPreview"
                             src="/images/default-retail-pic.png"
                             onerror="this.onerror=null; this.src='/images/default-retail-pic.png';"
                             alt="Store Preview" />
                    </div>
                </div>
            </div>

            <!-- Sticky Bottom Actions -->
            <div class="d-flex justify-content-end align-items-center gap-2 pt-3 pb-3 mt-auto border-top">
                <a asp-action="Index" class="btn btn-outline-secondary fw-medium rounded-pill px-4 shadow-sm" style="font-size: 14px;">Cancel</a>
                <button type="submit" class="btn btn-primary fw-medium rounded-pill px-4 shadow-sm" style="font-size: 14px; background-color: #1162a3; border-color: #1162a3;">
                    <i class="fa-solid fa-check me-1"></i>Register Retail
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const fileInput = document.getElementById("retailFileInput");
            const previewImg = document.getElementById("retailPreview");
            const defaultImg = "/images/default-retail-pic.png";

            if (fileInput) {
                fileInput.addEventListener("change", function () {
                    const file = this.files[0];
                    if (file) {
                        const validTypes = ['image/jpeg', 'image/png', 'image/webp'];
                        if (!validTypes.includes(file.type)) {
                            alert('Please select a valid image file (.jpg, .jpeg, .png, .webp).');
                            this.value = '';
                            previewImg.src = defaultImg;
                            return;
                        }

                        const reader = new FileReader();
                        reader.onload = function (e) {
                            previewImg.src = e.target.result;
                        };
                        reader.readAsDataURL(file);
                    } else {
                        previewImg.src = defaultImg;
                    }
                });
            }
        });
    </script>
}