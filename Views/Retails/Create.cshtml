@model SmartScan.Models.Retail

@{
    ViewData["Title"] = "Create Retail";
    ViewData["HeaderTitle"] = "Retail Management";
}

@section Styles {
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(180deg, #95CCDD 0%, #eef6f9 100%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="card shadow border-0 rounded-4 mt-4">
    <div class="card-header rounded-top-4 text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-shop"></i> Enrolling Retail</h5>
    </div>
    <div class="d-flex justify-content-center align-items-center w-100 py-4" style="min-height: 75vh;">
		<div style="width: 100%; max-width: 540px;">
			<form asp-action="Create">
				<div asp-validation-summary="All" class="text-danger fw-medium"></div>

				<!-- Retail Image File -->
                <div class="mb-4 text-center">
                    <!-- Image Preview Thumbnail -->
                    <div class="d-inline-block position-relative mb-2">
                        <img id="retailImagePreview"
                             src="/images/default-retail-pic.png"
                             onerror="this.onerror=null; this.src='/images/default-store.png';"
                             alt="Store Preview"
                             class="rounded-3 border shadow-sm object-fit-cover"
                             style="width: 480px; height: 320px;" />
                        <p class="text-primary fw-medium small">Default Retail Image</p>
                    </div>

                    <!-- Upload Input -->
                    <div class="text-start">
                        <label class="form-label fw-medium" style="color:#1162a3;">
                            <i class="fa-solid fa-camera me-1"></i> Store Image
                        </label>
                        <input name="RetailImageFile"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp"
                               onchange="previewRetailImage(this)" />
                        <span asp-validation-for="ImagePath" class="text-danger small"></span>
                    </div>
                </div>

				<hr />
                
                <!-- Retail Name -->
				<div class="form-group mb-3">
					<label asp-for="RetailName" class="control-label fw-medium" style="color:#1162a3">Retail Name</label>
					<input asp-for="RetailName" class="form-control" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
					<span asp-validation-for="RetailName" class="text-danger"></span>
				</div>

                <!-- Address -->
                <div class="form-group mb-3">
                    <label asp-for="Address" class="control-label fw-medium" style="color:#1162a3"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

				<!-- Description -->
				<div class="form-floating mb-3">
					<textarea asp-for="Description" class="form-control" placeholder="Description" style="height: 100px;"></textarea>
					<label asp-for="Description" class="control-label fw-medium" style="color:#1162a3">Retail Description</label>
					<span asp-validation-for="Description" class="text-danger small"></span>
				</div>

				<!-- Button Placement -->
				<div class="row row-cols-2 pt-4">
					<div class="text-start">
						<a asp-action="Index" class="btn btn-outline-secondary fw-medium">Back to List</a>
					</div>
					<div class="form-group text-end">
						<input type="submit" value="Create" class="btn btn-primary fw-medium" />
					</div>
				</div>
			</form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function previewRetailImage(input) {
            const preview = document.getElementById('retailImagePreview');

            if (input.files && input.files[0]) {
                const file = input.files[0];

                // Client-side quick check for image types
                const validTypes = ['image/jpeg', 'image/png', 'image/webp'];
                if (!validTypes.includes(file.type)) {
                    alert('Please select a valid image file (.jpg, .jpeg, .png, .webp).');
                    input.value = ''; // Reset input
                    preview.src = '/images/default-store.png';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                };
                reader.readAsDataURL(file);
            } else {
                // If user clicks cancel or deselects
                preview.src = '/images/default-store.png';
            }
        }
    </script>
}