@model IEnumerable<SmartScan.Models.Product>

@{
    ViewData["Title"] = "Products";
    ViewData["HeaderTitle"] = "Retail Management";
}

<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white"
     style="height: calc(100dvh - 130px); min-height: 500px;">

    <!-- Top Card Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0" style="background-color: #1162a3;">
        <h5 class="mb-0"><i class="fa-solid fa-cart-flatbed me-2"></i>Products</h5>
    </div>

    <!-- Single Scrollable Workspace -->
    <div class="flex-grow-1 overflow-auto position-relative d-flex flex-column rounded-bottom-4">

        <!-- Header Info -->
        <div class="px-4 pt-4 pb-2 flex-shrink-0">
            <h4 class="mb-0 fw-bold" style="color: #1162a3;">Product Catalog</h4>
            <p class="fw-medium pt-1 text-secondary mb-0">Manage retail items, pricing, categories, and inventory status.</p>
        </div>

        <!-- Overhead TempData Alert -->
        @if (TempData["ProductMessage"] != null)
        {
            <div id="autoCloseAlert" class="alert alert-success alert-dismissible fade show shadow-sm fw-medium d-flex align-items-center mx-4 my-2 flex-shrink-0" role="alert">
                <i class="fa-solid fa-circle-check fs-5 me-2 flex-shrink-0"></i>
                <div>
                    @TempData["ProductMessage"]
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>

            <script>
                setTimeout(function () {
                    var alertNode = document.getElementById('autoCloseAlert');
                    if (alertNode) {
                        var bsAlert = new bootstrap.Alert(alertNode);
                        bsAlert.close();
                    }
                }, 2000);
            </script>
        }

        <!-- Unified Table with Sticky Action Bar AND Headers -->
        <div class="flex-grow-1 pb-3">
            <table class="table table-hover align-middle mb-0 w-100"
                   style="min-width: 850px; border-collapse: separate; border-spacing: 0;">

                <thead class="sticky-top bg-white shadow-sm z-3" style="top: 0;">

                    <!-- Sticky Action Bar Row -->
                    <tr class="bg-white">
                        <th colspan="6" class="p-0 border-0 border-bottom">
                            <div class="px-4 py-3 d-flex flex-wrap justify-content-between align-items-center gap-3">

                                <!-- Add Button -->
                                <a asp-action="Create"
                                   class="btn btn-primary fw-medium rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1"
                                   style="background-color: #1162a3; border-color: #1162a3;">
                                    <i class="fa-solid fa-plus"></i>
                                    <span>Add New Product</span>
                                </a>

                                <!-- Search Bar -->
                                <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 320px; width: 100%;">
                                    <div class="input-group shadow-sm rounded-3 overflow-hidden border">
                                        <span class="input-group-text bg-white border-0">
                                            <i class="fa-solid fa-magnifying-glass text-muted"></i>
                                        </span>
                                        <input type="text"
                                               name="search"
                                               value="@ViewData["CurrentFilter"]"
                                               class="form-control border-0 bg-white shadow-none ps-0 fw-semibold"
                                               placeholder="Search product..."
                                               aria-label="Search products" />
                                    </div>

                                    @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                                    {
                                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Clear Search">
                                            <i class="fa-solid fa-xmark"></i>
                                        </a>
                                    }
                                </form>
                            </div>
                        </th>
                    </tr>

                    <!-- Sticky Column Headers Row -->
                    <tr class="table-light">
                        <th class="ps-4 py-3 text-secondary text-uppercase fw-bold border-bottom" style="font-size: 14px; letter-spacing: 0.5px;">Product</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold border-bottom" style="font-size: 14px; letter-spacing: 0.5px;">Category</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold border-bottom" style="font-size: 14px; letter-spacing: 0.5px;">Market Price</th>
                        <th class="py-3 text-center text-secondary text-uppercase fw-bold border-bottom" style="font-size: 14px; letter-spacing: 0.5px;">Status</th>
                        <th class="py-3 text-center text-secondary text-uppercase fw-bold border-bottom" style="font-size: 14px; letter-spacing: 0.5px;">AI Ready</th>
                        <th class="pe-4 py-3 text-end text-secondary text-uppercase fw-bold border-bottom" style="font-size: 14px; letter-spacing: 0.5px;"></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="p-0 border-0 bg-white">
                                @if (!string.IsNullOrWhiteSpace(ViewData["CurrentFilter"]?.ToString()))
                                {
                                    <div class="alert alert-warning text-center mx-4 my-4 fw-semibold shadow-sm" role="alert">
                                        <i class="fa-solid fa-circle-exclamation me-2"></i>No products found matching "<strong>@ViewData["CurrentFilter"]</strong>".
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-5 my-4">
                                        <div class="text-muted mb-3">
                                            <i class="fa-solid fa-boxes-stacked fa-3x text-secondary opacity-50"></i>
                                        </div>
                                        <h4 class="fw-semibold text-secondary">No Products Yet</h4>
                                        <p class="text-muted small">Click "Add New Product" above to add your first inventory item.</p>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            var imgUrl = string.IsNullOrWhiteSpace(item.ProductImage) ? "/images/default-product.png" : item.ProductImage;

                            <tr>
                                <!-- Product Name -->
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@imgUrl"
                                             onerror="this.onerror=null; this.src='/images/default-product.png';"
                                             alt="@item.ProductName"
                                             class="rounded-3 border object-fit-cover shadow-sm bg-white flex-shrink-0"
                                             style="width: 48px; height: 48px;" />
                                        <span class="fw-semibold text-truncate" style="max-width: 200px; color: #1162a3;" title="@item.ProductName">
                                            @item.ProductName
                                        </span>
                                    </div>
                                </td>

                                <!-- Category -->
                                <td>
                                    <span class="badge rounded-pill bg-light text-secondary border fw-medium px-2 py-1">
                                        <i class="fa-solid fa-tag me-1"></i>@(item.Category?.CategoryName ?? "Unassigned")
                                    </span>
                                </td>

                                <!-- Market Price -->
                                <td>
                                    <span class="fw-bold text-dark">₱@item.Price.ToString("N2")</span>
                                </td>

                                <!-- Status Badge -->
                                <td class="text-center">
                                    @if (item.Status?.StatusName == "Active")
                                    {
                                        <span class="badge rounded-pill bg-white text-success border border-success-subtle fw-semibold px-2 py-1 shadow-sm" style="font-size: 11px;">
                                            <i class="fa-solid fa-circle-check me-1"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-white text-secondary border border-secondary-subtle fw-semibold px-2 py-1 shadow-sm" style="font-size: 11px;">
                                            <i class="fa-solid fa-circle-xmark me-1"></i>@(item.Status?.StatusName ?? "Inactive")
                                        </span>
                                    }
                                </td>

                                <!-- AI Scannable Badge -->
                                <td class="text-center">
                                    @if (item.CanScan)
                                    {
                                        <span class="badge rounded-pill bg-white text-primary border border-primary-subtle fw-semibold px-2 py-1 shadow-sm" style="font-size: 11px;">
                                            <i class="fa-solid fa-robot me-1"></i>Trained
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill fw-semibold px-2 py-1 shadow-sm" style="background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; font-size: 11px;">
                                            <i class="fa-solid fa-hourglass-half me-1"></i>Pending
                                        </span>
                                    }
                                </td>

                                <!-- Action Buttons -->
                                <td class="pe-4 text-end">
                                    <a class="btn btn-sm btn-outline-primary fw-medium rounded-pill px-3 me-1 shadow-sm"
                                       asp-action="Edit"
                                       asp-route-productid="@item.ProductId"
                                       style="font-size: 14px;">
                                        <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                                    </a>

                                    <form asp-controller="Products" asp-action="Delete" asp-route-productid="@item.ProductId" method="post" id="deleteForm-@item.ProductId" class="d-inline mb-0">
                                        @Html.AntiForgeryToken()
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger fw-medium rounded-pill px-3 shadow-sm"
                                                style="font-size: 14px;"
                                                onclick="if(confirm('Are you sure you want to delete this product?')) { document.getElementById('deleteForm-@item.ProductId').submit(); }">
                                            <i class="fa-solid fa-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            Swal.fire({
                icon: 'error',
                title: 'Action Blocked',
                text: @Html.Raw(Json.Serialize(TempData["ErrorMessage"])),
                confirmButtonColor: '#1162a3'
            });
            </text>
        }
    </script>
}