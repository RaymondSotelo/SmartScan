@model IEnumerable<SmartScan.Models.Product>

@{
    ViewData["Title"] = "Product Management";
    ViewData["HeaderTitle"] = "Product Management";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(0deg, #95CCDD 0%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="card shadow border-0 mt-4">
    <div class="card-header text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-boxes-stacked"></i> Products</h5>
    </div>
    <div class="p-2">
        <p>
            <a class="btn btn-success fw-semibold" asp-action="Create">Add New Product</a>
        </p>
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.ProductName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Category)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Price)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ProductImage)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Status)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(model => item.ProductName)
                        </td>
                        <td>
                            @Html.DisplayFor(model => item.Category.CategoryName)
                        </td>
                        <td>
                            @Html.DisplayFor(model => item.Price)
                        </td>
                        <td>
                            <img src="@item.ProductImage" alt="@item.ProductName" style="max-width: 100px; max-height: 100px;" />
                        </td>
                        <td>
                            @if (item.Status.StatusName == "Active")
                            {
                                <span class="badge bg-success rounded-pill px-3">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-light rounded-pill px-3">Inactive</span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-primary" asp-action="Edit" asp-route-productid="@item.ProductId"> <i class="fa-solid fa-pen-to-square"></i> Edit</a>
                            <form asp-controller="Products" asp-action="Delete" asp-route-productid="@item.ProductId" method="post" id="deleteForm-@item.ProductId" class="d-inline">

                                <a href="javascript:void(0);"
                                   class="btn btn-sm btn-danger p-2"
                                   onclick="if(confirm('Are you sure you want to delete this product instantly?')) { document.getElementById('deleteForm-@item.ProductId').submit(); }">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </a>

                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>