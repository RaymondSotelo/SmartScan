@model SmartScan.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    ViewData["HeaderTitle"] = "Product Management";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(0deg, #95CCDD 0%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="card shadow border-0 mt-4">
    <div class="card-header text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-boxes-stacked"></i> Updating Products Details</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="ProductId" />

                    <div class="position-absolute end-0 p-2">
                        <img src="@ViewBag.ProductImage" style="max-width: 350px; max-height: 350px; padding-right: 8px" />
                    </div>

                    <div class="form-group">
                        <label asp-for="ProductName" class="control-label fw-medium" style="color:#1162a3">Product Name</label>
                        <input asp-for="ProductName" class="form-control" oninput="this.value = this.value.replace(/[0-9]/g, '')"/>
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CategoryId" class="control-label fw-medium" style="color:#1162a3; padding-top:10px;">Category</label>
                        <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="StatusId" class="control-label fw-medium" style="color:#1162a3; padding-top:10px;">Status</label>
                        <select asp-for="StatusId" class="form-control" asp-items="ViewBag.StatusId"></select>
                        <span asp-validation-for="StatusId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Price" class="control-label fw-medium" style="color:#1162a3; padding-top:10px;"></label>
                        <input asp-for="Price" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <!--IMG URL so far! Copy Image Adress!-->
                        <label asp-for="ProductImage" class="control-label fw-medium" style="color:#1162a3; padding-top:10px;">Product Image</label>
                        <input asp-for="ProductImage" class="form-control" placeholder="https://sample.photos/200/300" />
                        <span asp-validation-for="ProductImage" class="text-danger"></span>
                    </div>
                    <div class="row row-cols-2 pt-4">
                        <div class="text-start">
                            <a asp-action="Index" class="btn btn-outline-secondary fw-medium">Back to List</a>
                        </div>
                        <div class="form-group text-end">
                            <input type="submit" value="Save" class="btn btn-primary fw-medium" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
