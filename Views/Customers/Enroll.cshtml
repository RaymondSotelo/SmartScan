@model SmartScan.Models.ViewModels.CustomerEnrollmentViewModel

@{
    ViewData["Title"] = "Customer Identity Enrollement";
    ViewData["HeaderTitle"] = "Miscellaneous";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(180deg, #95CCDD 0%, #eef6f9 100%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="card shadow border-0 rounded-4 mt-4">
    <div class="card-header rounded-top-4 text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-id-badge"></i> Manage Identity and Biometrics</h5>
    </div>

    <!-- Header: Customer Info -->
    <div class="d-flex justify-content-between align-items-center p-3">
        <div class="bg-light py-2 p-2" style="color:#1162a3;">
            <h3 class="mb-0 fw-semibold"><i class="fa-solid fa-id-card-clip me-2"></i> Identity Enrollment</h3>
            <p class="fw-medium pt-1 text-secondary">Manage digital identification and biometrics for customer verification.</p>
        </div>
        <div class="text-start">
            <a asp-action="Index" class="btn btn-outline-secondary fw-medium">Back to List</a>
        </div>
    </div>

    <!-- Alert Message -->
    <div class="p-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-check-circle me-1"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-1"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Customer Card -->
    <div class="card shadow-sm border-0 mb-4 bg-light p-3">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <span class="fw-medium" style="color:#1162a3">Customer Name:</span>
                <h5 class="fw-bold mb-0 text-dark">@Model.FullName</h5>
                <span class="fw-medium" style="color:#1162a3">Contact: @(Model.ContactNumber ?? "None")</span>
            </div>
            <div class="d-flex gap-2">
                <span class="badge @(Model.HasDigitalIdRegistered ? "bg-success" : "bg-secondary") p-2">
                    <i class="fa-solid fa-qrcode me-1"></i>
                    @(Model.HasDigitalIdRegistered ? "Digital ID Linked" : "Digital ID Missing")
                </span>
                <span class="badge @(Model.HasFaceRegistered ? "bg-success" : "bg-secondary") p-2">
                    <i class="fa-solid fa-user-check me-1"></i>
                    @(Model.HasFaceRegistered ? "Face Enrolled" : "Face Unregistered")
                </span>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- Section 1: Digital ID Card / QR Enrollment -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h4 class="card-title fw-bold mb-0" style="color:#1162a3;">
                        <i class="fa-solid fa-barcode me-2"></i>Digital ID / QR Scan
                    </h4>
                </div>
                <div class="card-body p-4">
                    <p class="fw-medium pt-1 text-secondary">
                        Scan the customer's national ID, loyalty card barcode, or mobile app QR code using the handheld scanner.
                    </p>

                    <form asp-action="EnrollDigitalId" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="customerId" value="@Model.CustomerId" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Scanner Input</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light" style="color:#1162a3;"><i class="fa-solid fa-id-card"></i></span>
                                <input type="text"
                                       name="digitalIdPayload"
                                       class="form-control"
                                       placeholder="Focus here and scan QR/Barcode..."
                                       autofocus
                                       required />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary fw-semibold w-100">
                            <i class="fa-solid fa-save me-1"></i> Save Digital ID
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Section 2: Facial Registration -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h4 class="card-title fw-bold mb-0" style="color:#1162a3;">
                        <i class="fa-solid fa-camera me-2"></i>Facial Biometric Enrollment
                    </h4>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="fw-medium pt-1 text-secondary">
                        Position the customer facing the webcam. Once aligned, capture and compute the embedding vector.
                    </p>

                    <!-- Status Display -->
                    <div id="enrollmentStatus" class="small mt-3 fw-semibold alert alert-secondary py-2 border-0">
                        Waiting to start...
                    </div>

                    <div id="enrollmentStatus" class="small mt-3"></div>

                    <!-- Video Feed -->
                    <div class="position-relative d-inline-block bg-dark rounded-4 overflow-hidden shadow-inner mb-3"
                         style="width: 100%; max-width: 460px; height: 360px; position: relative;">

                        <!-- 1. Video Feed (Added absolute positioning) -->
                        <video id="videoFeed" autoplay playsinline muted
                               style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; z-index: 1;"></video>

                        <!-- 2. Facial Mesh Canvas (Changed ID to faceCanvas and added z-index) -->
                        <canvas id="faceCanvas"
                                style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 10;"></canvas>

                        <!-- 3. Face ID Style Alignment Guide (New) -->
                        <div id="scanGuide" class="position-absolute top-50 start-50 translate-middle border border-2 border-primary rounded-circle"
                             style="width: 200px; height: 240px; pointer-events: none; opacity: 0.4; z-index: 5;">
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" id="btnStartCamera" class="btn btn-outline-secondary fw-medium px-4">
                            <i class="fa-solid fa-video me-1"></i> Start Scanning
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@vladmandic/face-api/dist/face-api.js"></script>

    <script>
        const video = document.getElementById('videoFeed');
        const canvas = document.getElementById('faceCanvas');
        const btnToggleCamera = document.getElementById('btnStartCamera');
        const statusDiv = document.getElementById('enrollmentStatus');

        let currentStream = null;
        let isModelReady = false;
        let drawLoop = null;

        // Auto-Scan Variables
        let isScanningActive = false;
        let stableFrames = 0;
        const REQUIRED_FRAMES = 25; // ~1.5 seconds of steady frames

        // NEW: Track face movement
        let previousFaceBox = null;
        const MOVEMENT_THRESHOLD = 8; // Max pixels the face can move between frames

        const MODEL_URL = 'https://cdn.jsdelivr.net/npm/@@vladmandic/face-api/model/';

        async function loadModels() {
            statusDiv.className = 'small mt-3 fw-semibold alert alert-info py-2 border-0';
            statusDiv.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Loading biometric mesh...';
            try {
                await Promise.all([
                    faceapi.nets.ssdMobilenetv1.loadFromUri(MODEL_URL),
                    faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL),
                    faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
                ]);
                isModelReady = true;
                statusDiv.className = 'small mt-3 fw-semibold alert alert-secondary py-2 border-0';
                statusDiv.innerHTML = '<i class="fa-solid fa-check-circle me-1 text-success"></i> Biometric engine ready.';
            } catch (err) {
                statusDiv.className = 'small mt-3 fw-semibold alert alert-danger py-2 border-0';
                statusDiv.innerHTML = 'Failed to load models.';
            }
        }
        loadModels();

        video.addEventListener('play', () => {
            const displaySize = { width: video.offsetWidth, height: video.offsetHeight };
            faceapi.matchDimensions(canvas, displaySize);

            async function drawFrame() {
                if (!currentStream) return;

                const detection = await faceapi.detectSingleFace(video)
                                               .withFaceLandmarks()
                                               .withFaceDescriptor();

                const ctx = canvas.getContext('2d');
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                if (detection) {
                    const resizedDetection = faceapi.resizeResults(detection, displaySize);
                    faceapi.draw.drawFaceLandmarks(canvas, resizedDetection, { drawLines: true, color: '#00ff00', lineWidth: 1 });

                    if (isScanningActive) {
                        // NEW: Calculate how much the face moved since the last frame
                        const currentBox = detection.detection.box;
                        let isSteady = false;

                        if (previousFaceBox) {
                            const deltaX = Math.abs(currentBox.x - previousFaceBox.x);
                            const deltaY = Math.abs(currentBox.y - previousFaceBox.y);

                            // If movement is under the threshold, the face is steady
                            if (deltaX < MOVEMENT_THRESHOLD && deltaY < MOVEMENT_THRESHOLD) {
                                isSteady = true;
                            }
                        } else {
                            isSteady = true; // First frame is assumed steady
                        }

                        previousFaceBox = currentBox; // Save for next frame check

                        if (isSteady) {
                            stableFrames++;
                            const progress = Math.min(100, Math.round((stableFrames / REQUIRED_FRAMES) * 100));

                            if (stableFrames < REQUIRED_FRAMES) {
                                statusDiv.className = 'small mt-3 fw-semibold alert alert-primary py-2 border-0';
                                statusDiv.innerHTML = `<i class="fa-solid fa-crosshairs fa-spin me-1"></i> Hold still... ${progress}%`;
                            } else {
                                // Locked!
                                isScanningActive = false;
                                statusDiv.className = 'small mt-3 fw-semibold alert alert-warning py-2 border-0';
                                statusDiv.innerHTML = '<i class="fa-solid fa-microchip fa-spin me-1"></i> Face locked! Saving...';

                                const vectorJson = JSON.stringify(Array.from(detection.descriptor));
                                saveFaceBiometrics(vectorJson);
                            }
                        } else {
                            // FACE MOVED! Reset progress.
                            stableFrames = 0;
                            statusDiv.className = 'small mt-3 fw-semibold alert alert-warning py-2 border-0 text-dark';
                            statusDiv.innerHTML = '<i class="fa-solid fa-arrows-up-down-left-right me-1"></i> Too much movement. Hold still!';
                        }
                    }
                } else {
                    // Face lost
                    stableFrames = 0;
                    previousFaceBox = null;
                    if (isScanningActive) {
                        statusDiv.className = 'small mt-3 fw-semibold alert alert-dark py-2 border-0 text-white';
                        statusDiv.innerHTML = '<i class="fa-solid fa-user me-1"></i> Align face inside the guide.';
                    }
                }

                if (currentStream) {
                    drawLoop = requestAnimationFrame(drawFrame);
                }
            }

            drawFrame();
        });

        async function saveFaceBiometrics(vectorJson) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            try {
                const response = await fetch('/Customers/EnrollFace', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        customerId: @Model.CustomerId,
                        faceEmbeddingJson: vectorJson
                    })
                });

                const result = await response.json();
                if (result.success) {
                    statusDiv.className = 'small mt-3 fw-semibold alert alert-success py-2 border-0 shadow-sm';
                    statusDiv.innerHTML = `<i class="fa-solid fa-check-circle me-1"></i> ${result.message}`;
                    stopCamera();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    statusDiv.className = 'small mt-3 fw-semibold alert alert-danger py-2 border-0';
                    statusDiv.innerHTML = result.message;
                    isScanningActive = true;
                    stableFrames = 0;
                    previousFaceBox = null;
                }
            } catch (e) {
                statusDiv.className = 'small mt-3 fw-semibold alert alert-danger py-2 border-0';
                statusDiv.innerHTML = 'Enrollment failed: Network error.';
                isScanningActive = true;
                stableFrames = 0;
                previousFaceBox = null;
            }
        }

        function stopCamera() {
            if (currentStream) {
                currentStream.getTracks().forEach(track => track.stop());
                currentStream = null;
            }
            if (drawLoop) cancelAnimationFrame(drawLoop);

            video.srcObject = null;
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            isScanningActive = false;
            stableFrames = 0;
            previousFaceBox = null;

            btnToggleCamera.className = 'btn btn-outline-secondary fw-medium px-4';
            btnToggleCamera.innerHTML = '<i class="fa-solid fa-video me-1"></i> Start Auto-Scan';
        }

        btnToggleCamera.addEventListener('click', async () => {
            if (currentStream) {
                stopCamera();
                statusDiv.className = 'small mt-3 fw-semibold alert alert-secondary py-2 border-0';
                statusDiv.innerHTML = '<i class="fa-solid fa-video-slash me-1"></i> Camera turned off.';
                return;
            }

            if (!isModelReady) return;

            const alreadyRegistered = @(Model.HasFaceRegistered ? "true" : "false");
            if (alreadyRegistered) {
                const confirmOverwrite = confirm("This customer already has a registered face profile. Starting the auto-scan will overwrite it. Proceed?");
                if (!confirmOverwrite) return;
            }

            try {
                currentStream = await navigator.mediaDevices.getUserMedia({ video: { width: 640, height: 480 } });
                video.srcObject = currentStream;

                isScanningActive = true;
                stableFrames = 0;
                previousFaceBox = null;

                btnToggleCamera.className = 'btn btn-danger fw-medium px-4';
                btnToggleCamera.innerHTML = '<i class="fa-solid fa-video-slash me-1"></i> Cancel Scan';

            } catch (err) {
                statusDiv.className = 'small mt-3 fw-semibold alert alert-danger py-2 border-0';
                statusDiv.innerHTML = 'Camera error: ' + err.message;
            }
        });

        window.addEventListener('beforeunload', stopCamera);
    </script>
}