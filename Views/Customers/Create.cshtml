@model SmartScan.Models.Customer

@{
    ViewData["Title"] = "Add Customer";
    ViewData["HeaderTitle"] = "Retail Management";
}

@section Styles {
    <style>
        /* Mobile & Tablet Stacking Adjustments (Desktop >= 992px stays untouched) */
        @@media (max-width: 991.98px) {
            .customer-create-form,
            .customer-create-row {
                height: auto !important;
            }

            .customer-form-col {
                border-right: none !important;
                border-bottom: 1px solid #dee2e6;
                padding-bottom: 1.25rem;
            }
        }

        @@media (max-width: 575.98px) {
            .biometric-viewport-box {
                height: 230px !important;
            }

            .biometric-scan-guide {
                width: 140px !important;
                height: 175px !important;
            }
        }
    </style>
}

<!-- Viewport-Locked Outer Card -->
<div class="card shadow border-0 rounded-4 d-flex flex-column mt-3 bg-white pos-viewport-card"
     style="height: calc(100dvh - 130px); min-height: 520px;">

    <!-- Card Header -->
    <div class="card-header rounded-top-4 text-white p-3 flex-shrink-0 d-flex flex-wrap justify-content-between align-items-center gap-2"
         style="background-color: #1162a3;">
        <h5 class="mb-0 fw-bold">
            <i class="fa-solid fa-id-badge me-2"></i>Customer Registration & Biometrics
        </h5>
    </div>

    <!-- Scrollable Workspace (Split Panel Layout) -->
    <div class="card-body p-3 p-md-4 flex-grow-1 overflow-y-auto overflow-x-hidden no-scrollbar">
        <form asp-action="Create" method="post" id="createCustomerForm" class="h-100 customer-create-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <!-- Hidden Field for Biometric Descriptor Vector -->
            <input type="hidden" name="faceEmbeddingJson" id="faceEmbeddingJson" />

            <div class="row g-3 g-md-4 h-100 customer-create-row">
                <!-- ================= LEFT COLUMN: CUSTOMER FORM ================= -->
                <div class="col-12 col-lg-5 d-flex flex-column justify-content-between border-end pe-lg-4 customer-form-col">
                    <div>
                        <!-- Header -->
                        <h6 class="fw-bold text-uppercase text-secondary mb-3" style="font-size: 14px; letter-spacing: 0.5px;">Profile Information</h6>

                        <!-- Full Name -->
                        <div class="form-group mb-3">
                            <label asp-for="FullName" class="control-label fw-semibold mb-1" style="color: #1162a3;">Full Name</label>
                            <input asp-for="FullName" id="FullName" class="form-control rounded-3" placeholder="e.g., Juan Dela Cruz" required autocomplete="off" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')" />
                            <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Mobile Contact Number -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <label asp-for="ContactNumber" class="control-label fw-semibold mb-1" style="color: #1162a3;">Mobile Contact Number</label>
                            </div>
                            <div class="input-group shadow-sm rounded-3 overflow-hidden border bg-white">
                                <input asp-for="ContactNumber"
                                       id="ContactNumber"
                                       type="tel"
                                       class="form-control rounded-3 border-0 font-monospace"
                                       maxlength="13"
                                       inputmode="numeric"
                                       required
                                       value="@(string.IsNullOrWhiteSpace(Model?.ContactNumber) ? "09" : Model.ContactNumber)"
                                       oninput="formatPhpPhone(this)"
                                       onkeydown="handlePhoneBackspace(this, event);"
                                       placeholder="09XX XXX XXXX" />
                            </div>
                            <span asp-validation-for="ContactNumber" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text small" style="font-size: 11px;">11-digit mobile number required for Store Credit SMS updates.</div>
                        </div>

                        <!-- Retail Store Selection with Live Filter -->
                        <div class="form-group position-relative mb-3" id="retailCombobox">
                            <label asp-for="RetailId" class="control-label fw-semibold mb-1" style="color: #1162a3;">Retail Store</label>
                            <input type="hidden" asp-for="RetailId" id="hiddenRetailId" />

                            <div class="input-group search-input-group shadow-sm rounded-3 overflow-hidden border bg-white">
                                <span class="input-group-text bg-white border-0 pe-2">
                                    <i class="fa-solid fa-shop text-muted"></i>
                                </span>
                                <input type="text"
                                       id="retailSearchInput"
                                       class="form-control border-0 bg-white shadow-none ps-0 fw-medium"
                                       placeholder="Type to search retail store..."
                                       autocomplete="off"
                                       oninput="this.value = this.value.replace(/[^a-zA-Z0-9\s]/g, '')" />

                                <button class="btn btn-white border-0 text-secondary pe-3"
                                        type="button"
                                        id="clearRetailBtn"
                                        style="display: none;">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>

                            <!-- Dropdown List limited to 5 results -->
                            <ul class="list-group shadow-sm position-absolute w-100 mt-1 rounded-3 border bg-white"
                                id="retailDropdownList"
                                style="display: none; z-index: 1050; max-height: 220px; overflow-y: auto;">
                            </ul>
                            <span asp-validation-for="RetailId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Biometric Status Indicator -->
                        <div class="card border rounded-3 p-3 bg-light shadow-sm mb-3">
                            <span class="text-uppercase text-secondary fw-bold d-block mb-2" style="font-size: 11px; letter-spacing: 0.5px;">Biometric Status</span>
                            <div>
                                <span id="badgeFaceStatus" class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">
                                    <i class="fa-solid fa-user-xmark me-1"></i>Face Unregistered
                                </span>
                            </div>
                        </div>

                        <!-- Store Policy Alert -->
                        <div class="alert alert-light border shadow-sm rounded-3 small text-muted mb-0">
                            <div class="d-flex align-items-start gap-2">
                                <i class="fa-solid fa-circle-info text-primary fs-5 mt-1 flex-shrink-0"></i>
                                <div>
                                    <strong class="text-primary">Store Credit Policy:</strong><br />
                                    Starting store credit limit is <strong>PHP 300.00</strong>. Facial enrollment ensures safe identity verification before ledger charging during checkout.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Action Buttons -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-4 border-top mt-4 mb-2 mb-lg-4 flex-shrink-0">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-medium shadow-sm text-nowrap" style="font-size: 13px;">
                            <i class="fa-solid fa-arrow-left me-1"></i>Back to List
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm text-nowrap" style="background-color: #1162a3; border-color: #1162a3; font-size: 13px;">
                            <i class="fa-solid fa-check me-1"></i>Create Customer
                        </button>
                    </div>
                </div>

                <!-- ================= RIGHT COLUMN: FACIAL ENROLLMENT VIEWPORT ================= -->
                <div class="col-12 col-lg-7 d-flex flex-column justify-content-between">
                    <div>
                        <!-- Header -->
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 flex-shrink-0">
                                    <i class="fa-solid fa-camera fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0 text-primary">Facial Biometrics Enrollment</h6>
                                    <small class="text-muted">Automated real-time descriptor vector capture</small>
                                </div>
                            </div>
                        </div>

                        <!-- Status Banner -->
                        <div id="enrollmentStatus" class="small fw-semibold alert alert-secondary py-2 border-0 w-100 mb-3 shadow-sm text-center">
                            <i class="fa-solid fa-spinner fa-spin me-1"></i> Initializing biometric engine...
                        </div>
                    </div>

                    <!-- Centered Camera Viewport -->
                    <div class="my-auto py-2 d-flex flex-column align-items-center justify-content-center">
                        <div class="position-relative bg-dark rounded-4 overflow-hidden shadow-sm mx-auto biometric-viewport-box"
                             style="width: 100%; max-width: 440px; height: 280px;">

                            <video id="videoFeed" autoplay playsinline muted
                                   style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; z-index: 1;"></video>

                            <canvas id="faceCanvas"
                                    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 10; pointer-events: none;"></canvas>

                            <div id="scanGuide" class="position-absolute top-50 start-50 translate-middle border border-2 border-primary rounded-circle biometric-scan-guide"
                                 style="width: 170px; height: 210px; pointer-events: none; opacity: 0.6; z-index: 5;">
                            </div>
                        </div>

                        <!-- Camera Toggle Button -->
                        <div class="mt-3 mb-3 mb-lg-0">
                            <button type="button"
                                    id="btnStartCamera"
                                    class="btn btn-outline-secondary rounded-pill fw-semibold px-4 shadow-sm"
                                    style="font-size: 13px;">
                                <i class="fa-solid fa-video me-1"></i>Start Auto-Scan
                            </button>
                        </div>
                    </div>

                    <!-- Privacy Notice -->
                    <div class="alert alert-light border small text-muted mb-0 py-2 flex-shrink-0 text-center">
                        <i class="fa-solid fa-shield-halved text-success me-1"></i>
                        <strong>Privacy Protected:</strong> Raw video frames are discarded immediately; only encrypted 128-float mathematical descriptors are saved.
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/@@vladmandic/face-api/dist/face-api.js"></script>

    <script>
        // ================= RETAIL COMBOBOX SEARCH LOGIC =================
        const retailSearchInput = document.getElementById("retailSearchInput");
        const hiddenRetailId = document.getElementById("hiddenRetailId");
        const retailDropdownList = document.getElementById("retailDropdownList");
        const clearRetailBtn = document.getElementById("clearRetailBtn");

        // Embedded list from ViewBag/ViewData (populated in CustomersController.Create GET)
        const retailItems = @Html.Raw(Json.Serialize(ViewBag.Retails ?? new List<object>()));

        // Tell jQuery Validation to evaluate ContactNumber without spaces (11 digits instead of 13 chars)
        if (window.jQuery && $.validator) {
            $(function () {
                const contactField = $("#ContactNumber");
                if (contactField.length && contactField.rules()) {
                    contactField.rules("add", {
                        normalizer: function (value) {
                            return value.replace(/\D/g, '');
                        }
                    });
                }
            });
        }

        function filterRetails(query) {
            retailDropdownList.innerHTML = "";
            const filtered = (retailItems || []).filter(item =>
                (item.name || item.text || "").toLowerCase().includes(query.toLowerCase())
            ).slice(0, 5);

            if (filtered.length === 0) {
                const noResult = document.createElement("li");
                noResult.className = "list-group-item text-muted small py-2";
                noResult.textContent = "No stores found...";
                retailDropdownList.appendChild(noResult);
            } else {
                filtered.forEach(item => {
                    const li = document.createElement("li");
                    li.className = "list-group-item list-group-item-action cursor-pointer py-2 small fw-medium";
                    li.style.cursor = "pointer";
                    li.innerHTML = `<i class="fa-solid fa-shop me-2 text-muted"></i>${item.name || item.text}`;
                    li.addEventListener("click", () => {
                        hiddenRetailId.value = item.id || item.value;
                        retailSearchInput.value = item.name || item.text;
                        retailDropdownList.style.display = "none";
                        clearRetailBtn.style.display = "block";
                    });
                    retailDropdownList.appendChild(li);
                });
            }
            retailDropdownList.style.display = "block";
        }

        if (retailSearchInput) {
            retailSearchInput.addEventListener("focus", () => filterRetails(retailSearchInput.value));
            retailSearchInput.addEventListener("input", (e) => {
                const query = e.target.value.trim();
                clearRetailBtn.style.display = query ? "block" : "none";
                filterRetails(query);
            });
        }

        if (clearRetailBtn) {
            clearRetailBtn.addEventListener("click", () => {
                retailSearchInput.value = "";
                hiddenRetailId.value = "";
                clearRetailBtn.style.display = "none";
                retailDropdownList.style.display = "none";
                retailSearchInput.focus();
            });
        }

        document.addEventListener("click", (e) => {
            if (!document.getElementById("retailCombobox")?.contains(e.target)) {
                if (retailDropdownList) retailDropdownList.style.display = "none";
            }
        });

        // ================= BIOMETRIC CAMERA SCANNER =================
        const video = document.getElementById('videoFeed');
        const canvas = document.getElementById('faceCanvas');
        const btnToggleCamera = document.getElementById('btnStartCamera');
        const statusDiv = document.getElementById('enrollmentStatus');
        const scanGuide = document.getElementById('scanGuide');

        let currentStream = null;
        let isModelReady = false;
        let drawLoop = null;

        let isScanningActive = false;
        let stableFrames = 0;
        const REQUIRED_FRAMES = 12;
        let previousFaceBox = null;
        const MOVEMENT_THRESHOLD = 12;

        const MODEL_URL = 'https://cdn.jsdelivr.net/npm/@@vladmandic/face-api/model/';

        async function loadModels() {
            if (!statusDiv) return;
            statusDiv.className = 'small fw-semibold alert alert-info py-2 border-0 w-100 mb-3 shadow-sm text-center';
            statusDiv.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Loading biometric models...';
            try {
                await Promise.all([
                    faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
                    faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL),
                    faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
                ]);
                isModelReady = true;
                statusDiv.className = 'small fw-semibold alert alert-secondary py-2 border-0 w-100 mb-3 shadow-sm text-center';
                statusDiv.innerHTML = '<i class="fa-solid fa-check-circle me-1 text-success"></i> Biometric engine ready. Click "Start Auto-Scan".';
            } catch (err) {
                statusDiv.className = 'small fw-semibold alert alert-danger py-2 border-0 w-100 mb-3 shadow-sm text-center';
                statusDiv.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-1"></i> Failed to initialize face models.';
            }
        }
        loadModels();

        if (video) {
            video.addEventListener('play', () => {
                const displaySize = { width: video.offsetWidth, height: video.offsetHeight };
                faceapi.matchDimensions(canvas, displaySize);

                async function drawFrame() {
                    if (!currentStream) return;

                    const detection = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions({ inputSize: 224, scoreThreshold: 0.5 }))
                        .withFaceLandmarks()
                        .withFaceDescriptor();

                    const ctx = canvas.getContext('2d');
                    ctx.clearRect(0, 0, canvas.width, canvas.height);

                    if (detection) {
                        if (isScanningActive) {
                            const currentBox = detection.detection.box;
                            let isSteady = false;

                            if (previousFaceBox) {
                                const deltaX = Math.abs(currentBox.x - previousFaceBox.x);
                                const deltaY = Math.abs(currentBox.y - previousFaceBox.y);
                                if (deltaX < MOVEMENT_THRESHOLD && deltaY < MOVEMENT_THRESHOLD) {
                                    isSteady = true;
                                }
                            } else {
                                isSteady = true;
                            }

                            previousFaceBox = currentBox;

                            if (isSteady) {
                                stableFrames++;
                                const progress = Math.min(100, Math.round((stableFrames / REQUIRED_FRAMES) * 100));

                                if (stableFrames < REQUIRED_FRAMES) {
                                    statusDiv.className = 'small fw-semibold alert alert-primary py-2 border-0 w-100 mb-3 shadow-sm text-center';
                                    statusDiv.innerHTML = `<i class="fa-solid fa-crosshairs fa-spin me-1"></i> Hold still... ${progress}%`;
                                    scanGuide.className = 'position-absolute top-50 start-50 translate-middle border border-2 border-primary rounded-circle biometric-scan-guide';
                                } else {
                                    isScanningActive = false;
                                    statusDiv.className = 'small fw-semibold alert alert-success py-2 border-0 w-100 mb-3 shadow-sm text-center';
                                    statusDiv.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Face profile captured successfully!';
                                    scanGuide.className = 'position-absolute top-50 start-50 translate-middle border border-3 border-success rounded-circle biometric-scan-guide';

                                    const vectorJson = JSON.stringify(Array.from(detection.descriptor));
                                    document.getElementById('faceEmbeddingJson').value = vectorJson;

                                    const faceBadge = document.getElementById('badgeFaceStatus');
                                    faceBadge.className = 'badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1';
                                    faceBadge.innerHTML = '<i class="fa-solid fa-user-check me-1"></i>Face Enrolled';

                                    setTimeout(() => stopBiometricCamera(), 1200);
                                }
                            } else {
                                stableFrames = 0;
                                statusDiv.className = 'small fw-semibold alert alert-warning py-2 border-0 text-dark w-100 mb-3 shadow-sm text-center';
                                statusDiv.innerHTML = '<i class="fa-solid fa-arrows-up-down-left-right me-1"></i> Steady your position inside the circle.';
                            }
                        }
                    } else {
                        stableFrames = 0;
                        previousFaceBox = null;
                        if (isScanningActive) {
                            statusDiv.className = 'small fw-semibold alert alert-dark py-2 border-0 text-white w-100 mb-3 shadow-sm text-center';
                            statusDiv.innerHTML = '<i class="fa-solid fa-user me-1"></i> Center your face inside the guide.';
                        }
                    }

                    if (currentStream) {
                        drawLoop = requestAnimationFrame(drawFrame);
                    }
                }

                drawFrame();
            });
        }

        function stopBiometricCamera() {
            if (currentStream) {
                currentStream.getTracks().forEach(track => track.stop());
                currentStream = null;
            }
            if (drawLoop) cancelAnimationFrame(drawLoop);

            if (video) video.srcObject = null;
            if (canvas) {
                const ctx = canvas.getContext('2d');
                ctx.clearRect(0, 0, canvas.width, canvas.height);
            }

            isScanningActive = false;
            stableFrames = 0;
            previousFaceBox = null;

            if (btnToggleCamera) {
                btnToggleCamera.className = 'btn btn-outline-secondary rounded-pill fw-semibold px-4 shadow-sm';
                btnToggleCamera.innerHTML = '<i class="fa-solid fa-video me-1"></i> Start Auto-Scan';
            }
        }

        if (btnToggleCamera) {
            btnToggleCamera.addEventListener('click', async () => {
                if (currentStream) {
                    stopBiometricCamera();
                    statusDiv.className = 'small fw-semibold alert alert-secondary py-2 border-0 w-100 mb-3 shadow-sm text-center';
                    statusDiv.innerHTML = '<i class="fa-solid fa-video-slash me-1"></i> Camera off.';
                    return;
                }

                if (!isModelReady) return;

                try {
                    currentStream = await navigator.mediaDevices.getUserMedia({
                        video: { width: { ideal: 640 }, height: { ideal: 480 }, facingMode: "user" }
                    });
                    video.srcObject = currentStream;

                    isScanningActive = true;
                    stableFrames = 0;
                    previousFaceBox = null;

                    btnToggleCamera.className = 'btn btn-danger rounded-pill fw-semibold px-4 shadow-sm';
                    btnToggleCamera.innerHTML = '<i class="fa-solid fa-video-slash me-1"></i> Cancel Scan';

                } catch (err) {
                    statusDiv.className = 'small fw-semibold alert alert-danger py-2 border-0 w-100 mb-3 shadow-sm text-center';
                    statusDiv.innerHTML = 'Camera error: ' + err.message;
                }
            });
        }

        window.addEventListener('beforeunload', stopBiometricCamera);

        // ================= PHONE FORMATTER (09XX XXX XXXX) =================
        function formatPhpPhone(input) {
            let digits = input.value.replace(/\D/g, '');

            if (!digits.startsWith('09')) {
                digits = '09' + digits.replace(/^0+/, '');
            }

            digits = digits.slice(0, 11);

            let formatted = '';
            if (digits.length <= 4) {
                formatted = digits;
            } else if (digits.length <= 7) {
                formatted = digits.slice(0, 4) + ' ' + digits.slice(4);
            } else {
                formatted = digits.slice(0, 4) + ' ' + digits.slice(4, 7) + ' ' + digits.slice(7, 11);
            }

            input.value = formatted;
        }

        function handlePhoneBackspace(input, event) {
            if (event.key === 'Backspace' && input.value.replace(/\D/g, '').length <= 2) {
                event.preventDefault();
                input.value = '09';
            }
        }

        // Format pre-existing model value on validation reload & enforce 11 digits on submit
        const contactInput = document.getElementById("ContactNumber");
        if (contactInput) {
            formatPhpPhone(contactInput);
        }

        document.getElementById("createCustomerForm")?.addEventListener("submit", function (e) {
            const digits = contactInput ? contactInput.value.replace(/\D/g, '') : '';
            if (digits.length !== 11 || !digits.startsWith('09')) {
                e.preventDefault();
                contactInput?.focus();
            }
        });
    </script>
}