@model IEnumerable<SmartScan.Models.Customer>

@{
    ViewData["Title"] = "Enroll Customers";
    ViewData["HeaderTitle"] = "Miscellaneous";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(0deg, #95CCDD 0%);
            background-repeat: no-repeat;
            background-size: cover;
        }
    </style>
}

<div class="card shadow border-0 mt-4">
    <div class="card-header text-white p-3" style="background-color:#1162a3">
        <h5 class="mb-0"><i class="fa-solid fa-id-badge"></i> Enroll Customer</h5>
    </div>
    <div class="p-3 d-flex justify-content-between align-items-center mb-3">
        <p>
            <a class="btn btn-success fw-semibold"  asp-action="Create">Add Customer Info</a>
        </p>
        <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 450px; padding-bottom: 11px; width:100%;">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                </span>
                <input type="text" name="search" value="@ViewData["CurrentFilter"]" class="form-control border-start-0 ps-0 fw-semibold"
                       placeholder="Search..." aria-label="Search customer" />
            </div>
            <button type="submit" class="btn btn-outline-primary fw-semibold">Search</button>

            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Search">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            }
        </form>
    </div>
    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center my-4 fw-semibold" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>No customer found matching "<strong>@ViewData["CurrentFilter"]</strong>".
        </div>
    }
    else
    {
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>
                            Full Name
                        </th>
                        <th>
                            Contact Number
                        </th>
                        <th>
                            Credit Limit
                        </th>
                        <th>
                            Credit Debt
                        </th>
                        <th>
                            Status
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(model => item.FullName)
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.ContactNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.CreditLimit)
                            </td>
                            <td>
                                @Html.DisplayFor(model => item.CurrentDebt)
                            </td>
                            <td>
                                @if (item.Status.StatusName == "Active")
                                {
                                    <span class="badge bg-success rounded-pill px-3">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-light rounded-pill px-3">Inactive</span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-primary fw-medium" asp-action="Edit" asp-route-customerid="@item.CustomerId"><i class="fa-solid fa-pen-to-square"></i> Edit</a>
                                <form asp-action="Delete" asp-route-customerid="@item.CustomerId" method="post" onsubmit="return confirm('Are you sure you want to delete @item.FullName?');" style="display:inline;">
                                    <button type="submit" class="btn btn-danger fw-medium">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
